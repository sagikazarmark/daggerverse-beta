let ALPINE_IMAGE = "alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b"

type DangImage {
  publish(
    registry: String!,
    repository: String!,
    username: String!,
    password: Secret!,
  ): String! {
    Dagger
      .container
      .withRegistryAuth(registry, username, password)
      .publish(
        address: `${registry}/${repository}`,

        platformVariants: ["linux/amd64", "linux/arm64"].map {
          Dagger
            .container(platform: _ :: Platform)
            .withFile(
              "/usr/local/bin/dang",
              Dagger.dang.binary(_),
              permissions: 755,
            )
        },
      )
  }
}
