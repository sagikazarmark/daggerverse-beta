type BuildEnvironment {
  mountPath: String!

  let defaultContainer: Container!

  let overlay: Overlay
  let envFile: File
  let envVariables: [EnvVariable!]! = []
  let sourceDateEpoch: String

  let gitignore: Boolean
  let include: [String!]
  let exclude: [String!]

  new(
    """
    Default container.
    """
    container: Container! = Dagger.container,
    """
    Overlay to apply to the container.
    """
    overlay: Overlay,
    """
    Environment file to load into the container.
    """
    envFile: File,
    """
    Source date epoch to set in the container.
    """
    sourceDateEpoch: String,
    """
    Ignore paths included in the gitignore file.
    """
    gitignore: Boolean,
    """
    Include only artifacts that match the given pattern (e.g., ["app/", "package.*"]).
    """
    include: [String!],
    """
    Exclude artifacts that match the given pattern (e.g., ["node_modules/", ".git*"]).
    """
    exclude: [String!],
    """
    Path to the mounted source directory.
    """
    mountPath: String! = "/work/src",
  ) {
    self.mountPath = mountPath

    self.defaultContainer = container

    self.overlay = overlay
    self.envFile = envFile
    self.sourceDateEpoch = sourceDateEpoch

    self.gitignore = gitignore
    self.include = include
    self.exclude = exclude

    self
  }

  """
  Set an environment variable in the container.
  """
  withEnvVariable(
    """
    Name of the environment variable (e.g., "HOST").
    """
    name: String!,
    """
    Value of the environment variable (e.g., "localhost").
    """
    value: String!,
    """
    Replace `${VAR}` or `$VAR` in the value according to the current environment
    variables defined in the container (e.g., "/opt/bin:$PATH").
    """
    expand: Boolean,
  ): BuildEnvironment! {
    self.envVariables += [EnvVariable(name: name, value: value, expand: expand)]

    self
  }

  """
  Returns a container with the configured environment.
  """
  container(
    ws: Workspace,
    """
    Custom base container to use.
    """
    base: Container,
    """
    Additional overlay to apply to the container.
    """
    overlay: Overlay,
    """
    Ignore paths included in the gitignore file.
    """
    gitignore: Boolean,
    """
    Include only artifacts that match the given pattern (e.g., ["app/", "package.*"]).
    """
    include: [String!],
    """
    Exclude artifacts that match the given pattern (e.g., ["node_modules/", ".git*"]).
    """
    exclude: [String!],
  ): Container! {
    (base ?? self.defaultContainer)
      .{ self.withOverlay(_, overlay) }
      .{ self.withEnvFile(_) }
      .{ self.withEpoch(_) }
      .{ self.withEnv(_) }
      .{
        self.withSource(
          _,
          ws.directory(
            "/",
            exclude: exclude ?? self.exclude,
            include: include ?? self.include,
            gitignore: gitignore ?? self.gitignore,
          ),
          ws.cwd,
        )
      }
  }

  """
  Returns the source.
  """
  source(
    ws: Workspace!,
    """
    Ignore paths included in the gitignore file.
    """
    gitignore: Boolean,
    """
    Include only artifacts that match the given pattern (e.g., ["app/", "package.*"]).
    """
    include: [String!],
    """
    Exclude artifacts that match the given pattern (e.g., ["node_modules/", ".git*"]).
    """
    exclude: [String!],
  ): Directory! {
    ws.directory(
      "/",
      exclude: exclude ?? self.exclude,
      include: include ?? self.include,
      gitignore: gitignore ?? self.gitignore,
    )
  }

  let withOverlay(container: Container!, overlay: Overlay): Container! {
    container
      .{ self.overlay.apply(_) ?? _ }
      .{ overlay.apply(_) ?? _ }
  }

  let withEnvFile(container: Container!): Container! {
    let envFile = self.envFile
    if (envFile == null) {
      return container
    }

    container.withEnvFileVariables(envFile.asEnvFile)
  }

  let withEnv(container: Container!): Container! {
    self.envVariables.reduce(container) { container, env => env.apply(container) }
  }

  let withEpoch(container: Container!): Container! {
    let epoch = self.sourceDateEpoch
    if (epoch == null) {
      return container
    }

    container.withEnvVariable("SOURCE_DATE_EPOCH", epoch)
  }

  let withSource(container: Container!, source: Directory, cwd: String): Container! {
    if (source == null or cwd == null) {
      return container
    }

    container
      .withMountedDirectory(self.mountPath, source)
      .withWorkdir(Path(self.mountPath).join(Path(cwd)).string)
  }
}

interface Overlay {
  apply(container: Container!): Container!
}

type EnvVariable {
  let name: String!
  let value: String!
  let expand: Boolean

  let apply(container: Container!): Container! {
    container.withEnvVariable(name: self.name, value: self.value, expand: self.expand)
  }
}
