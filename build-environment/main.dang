type BuildEnvironment {
  new { self }

  """
  Absolute path where the source is mounted in the container.
  """
  sourceRoot: Path! = Path("/work/src")

  """
  Path (current directory) within the source.

  Absolute paths are interpreted relative to the source root.
  """
  let sourcePath: Path! = Path("")

  """
  Current working directory (absolute path) within the container.
  """
  workdir: Path! { self.sourceRoot.join(sourcePath) }

  """
  Configured source directory.

  Raises an error if no source has been configured.
  """
  source: Directory! {
    let source = self._source

    if (source == null) {
      raise "build environment source is not configured; call withSource first"
    }

    source
  }

  let _source: Directory

  """
  Set the source directory to mount in the container.
  """
  withSource(
    """
    Source directory to mount in the container.
    """
    source: Directory!,
    """
    Path (current directory) within the source.

    Absolute paths are interpreted relative to the source root.
    """
    path: Path! = Path(""),
  ): BuildEnvironment! {
    let sourcePath = Path(path)

    if (!self.sourceRoot.contains(self.sourceRoot.join(sourcePath))) {
      raise "invalid source path: escapes the source root"
    }

    self._source = source
    self.sourcePath = sourcePath

    self
  }

  let envFile: File

  """
  Set an environment file in the build environment.
  """
  withEnvFile(
    """
    Environment file to load into the container.
    """
    file: File,
  ): BuildEnvironment! {
    if (file != null) {
      self.envFile = file
    }

    self
  }

  let envVariables: [EnvVariable!]! = []

  """
  Set an environment variable in the build environment.
  """
  withEnvVariable(
    """
    Name of the environment variable (e.g., "HOST").
    """
    name: String!,
    """
    Value of the environment variable (e.g., "localhost").
    """
    value: String!,
    """
    Replace `${VAR}` or `$VAR` in the value according to the current environment
    variables defined in the container (e.g., "/opt/bin:$PATH").
    """
    expand: Boolean,
  ): BuildEnvironment! {
    self.envVariables += [EnvVariable(name: name, value: value, expand: expand)]

    self
  }

  let sourceDateEpoch: String

  """
  Set the source date epoch in the build environment.
  """
  withSourceDateEpoch(
    """
    Source date epoch to set in the container.
    """
    epoch: String,
  ): BuildEnvironment! {
    if (epoch != null) {
      self.sourceDateEpoch = epoch
    }

    self
  }

  """
  Returns a container with the configured build environment.

  Equivalent to applying the environment (`applyEnvironment`) followed by the source (`applySource`).
  """
  apply(
    """
    Custom base container to use.
    """
    container: Container!,
  ): Container! {
    container
      .{ self.applyEnvironment(_) }
      .{ self.applySource(_) }
  }

  """
  Returns a container with the configured environment variables (env file, source date epoch, variables),
  without mounting the source.

  Useful when a step (e.g. dependency caching) has to run with the final environment
  but must not see the source; follow up with `applySource`.
  """
  applyEnvironment(
    """
    Custom base container to use.
    """
    container: Container!,
  ): Container! {
    container
      .{
        let envFile = self.envFile
        if (envFile != null) {
          _.withEnvFileVariables(envFile.asEnvFile)
        } else _
      }
      .{
        let epoch = self.sourceDateEpoch
        if (epoch != null) {
          _.withEnvVariable("SOURCE_DATE_EPOCH", epoch)
        } else _
      }
      .{ self.envVariables.reduce(_) { _, env => env.apply(_) } }
  }

  """
  Returns a container with the configured source mounted and the working directory set.

  Does nothing when no source has been configured.
  """
  applySource(
    """
    Custom base container to use.
    """
    container: Container!,
  ): Container! {
    let source = self._source
    if (source == null) {
      return container
    }

    container
      .withMountedDirectory(self.sourceRoot, source)
      .withWorkdir(self.workdir)
  }
}

type EnvVariable {
  let name: String!
  let value: String!
  let expand: Boolean

  let apply(container: Container!): Container! {
    container.withEnvVariable(name: self.name, value: self.value, expand: self.expand)
  }
}
