let alpine: Container! {
  Dagger.container.from("alpine:3.23.4@sha256:5b10f432ef3da1b8d4c7eb6c487f2f5a8f096bc91145e68878dd4a5019afde11")
}

let source: Directory! {
  Dagger
    .directory
    .withNewFile("app/marker.txt", "source-ok")
}

let envFile: File! {
  Dagger
    .directory
    .withNewFile(".env", "BUILD_ENV_TEST=from-env-file\nBUILD_ENV_EQUALS=a=b\n")
    .file(".env")
}

type Tests {
  sourceMountAndWorkdir: Void @check {
    let container = Dagger
      .buildEnvironment
      .withSource(source, path: "app")
      .apply(alpine)

    assert { container.mounts.contains("/work/src") or container.mounts.contains("/work/src/") }
    assert { container.file("/work/src/app/marker.txt").contents == "source-ok" }

    let output = container
      .withExec(["sh", "-c", "printf '%s|%s' \"$(pwd)\" \"$(cat marker.txt)\""])
      .stdout

    assert { output == "/work/src/app|source-ok" }
  }

  envFileAndEpoch: Void @check {
    let container = Dagger
      .buildEnvironment
      .withEnvFile(envFile)
      .withSourceDateEpoch("1234567890")
      .apply(alpine)

    assert { container.envVariable("BUILD_ENV_TEST") == "from-env-file" }
    assert { container.envVariable("BUILD_ENV_EQUALS") == "a=b" }
    assert { container.envVariable("SOURCE_DATE_EPOCH") == "1234567890" }

    let output = container
      .withExec(["sh", "-c", "printf '%s|%s|%s' \"$BUILD_ENV_TEST\" \"$BUILD_ENV_EQUALS\" \"$SOURCE_DATE_EPOCH\""])
      .stdout

    assert { output == "from-env-file|a=b|1234567890" }
  }

  envVariable: Void @check {
    let container = Dagger
      .buildEnvironment
      .withEnvVariable("BUILD_ENV_VARIABLE", "variable-ok")
      .apply(alpine)

    assert { container.envVariable("BUILD_ENV_VARIABLE") == "variable-ok" }
    assert { container.withExec(["printenv", "BUILD_ENV_VARIABLE"]).stdout.trimSpace == "variable-ok" }
  }

  sourcePathValidation: Void @check {
    assert { invalidSourcePath("../escape") }
    assert { invalidSourcePath("app/../../escape") }
    assert { Dagger.buildEnvironment.withSource(source, path: "/").workdir == "/work/src" }
    assert { Dagger.buildEnvironment.withSource(source, path: "/absolute").workdir == "/work/src/absolute" }
    assert { Dagger.buildEnvironment.withSource(source, path: "app/../app").workdir == "/work/src/app" }
  }

  sourceAccessor: Void @check {
    assert { Dagger.buildEnvironment.withSource(source).source.entries == ["app/"] }
    assert { missingSourceFails }
  }
}

let invalidSourcePath(path: Path!): Boolean! {
  {
    Dagger.buildEnvironment.withSource(source, path: path).workdir
    false
  } rescue {
    err: Error => err.message.contains("invalid source path: escapes the source root")
  }
}

let missingSourceFails: Boolean! {
  {
    Dagger.buildEnvironment.source.entries
    false
  } rescue {
    err: Error => err.message.contains("build environment source is not configured; call withSource first")
  }
}
