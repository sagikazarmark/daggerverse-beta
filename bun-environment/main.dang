type BunEnvironment {
  let defaultContainer: Container!

  let gitignore: Boolean
  let include: [String!]
  let exclude: [String!]

  let cache: CacheVolume
  let envFile: File
  let sourceDateEpoch: String

  let install: Boolean!
  let locked: Boolean!

  new(
    """
    Version (image tag) to use from the official Bun image repository.
    """
    version: String! = "latest",
    """
    Custom container to use as the default container.
    """
    container: Container! = Dagger.container.from("oven/bun:" + version),
    """
    Ignore paths included in the gitignore file.
    """
    gitignore: Boolean,
    """
    Include only artifacts that match the given pattern (e.g., ["app/", "package.*"]).
    """
    include: [String!],
    """
    Exclude artifacts that match the given pattern (e.g., ["node_modules/", ".git*"]).
    """
    exclude: [String!],
    """
    Environment file to load into the container.
    """
    envFile: File,
    """
    Source date epoch to set in the container.
    """
    sourceDateEpoch: String,
    """
    Automatically install dependencies.
    """
    install: Boolean! = false,
    """
    Install dependencies from the lockfile without updating it.
    """
    locked: Boolean! = false,
    """
    Whether to disable automatically mounted cache volumes.
    Useful if you want to mount cache volumes manually or use a different cache volume strategy.
    """
    noCache: Boolean! = false,
    """
    Cache volume for Bun's package cache.
    """
    cache: CacheVolume = if (!noCache) { Dagger.cacheVolume("bun") } else null,
  ) {
    self.defaultContainer = container

    self.gitignore = gitignore
    self.include = include
    self.exclude = exclude

    self.cache = cache
    self.envFile = envFile
    self.sourceDateEpoch = sourceDateEpoch

    self.install = install
    self.locked = locked

    self
  }

  """
  Returns a container with the Bun environment configured.
  """
  container(
    ws: Workspace,
    """
    Custom base container to use.
    """
    base: Container,
    """
    Ignore paths included in the gitignore file.
    """
    gitignore: Boolean = self.gitignore,
    """
    Include only artifacts that match the given pattern (e.g., ["app/", "package.*"]).
    """
    include: [String!] = self.include,
    """
    Exclude artifacts that match the given pattern (e.g., ["node_modules/", ".git*"]).
    """
    exclude: [String!] = self.exclude,
  ): Container! {
    let base = (base ?? self.defaultContainer).{ self.withCache(_) }

    base
      .{
        let envFile = self.envFile
        if (envFile != null) {
          _.withEnvFileVariables(envFile.asEnvFile)
        } else _
      }
      .{
        let epoch = self.sourceDateEpoch
        if (epoch != null) {
          _.withEnvVariable("SOURCE_DATE_EPOCH", epoch)
        } else _
      }
      .{
        if (ws != null) {
          let source = ws.directory(
            "/",
            exclude: exclude,
            include: include,
            gitignore: gitignore,
          )

          _
            .withMountedDirectory("/work/src", source)
            .withWorkdir(Path.join(["/work/src", ws.cwd]))
        } else _
      }
      .{ self.withDependencies(ws, _, base) }
  }

  let withCache(container: Container!): Container! {
    let cache = self.cache
    if (cache == null) {
      return container
    }

    container
      .{
        if (_.envVariable("BUN_INSTALL_CACHE_DIR") == null) {
          _.withEnvVariable("BUN_INSTALL_CACHE_DIR", "/root/.bun/install/cache")
        } else _
      }
      .withMountedCache("${BUN_INSTALL_CACHE_DIR}", cache, expand: true)
  }

  let withDependencies(
    ws: Workspace,
    container: Container!,
    installContainer: Container!,
  ): Container! {
    if (!self.install or ws == null) {
      return container
    }

    let root = findPackageRoot(ws)
    if (root == null) {
      return container
    }

    let source = ws.directory(
      "/",
      include: [
        "package.json",
        "bun.lock",
        "bun.lockb",
        ".npmrc",
        ".bunfig.toml",
        "bunfig.toml",
      ].map { packageFilePath(root, _) },
      gitignore: true,
    )

    let dependencies = installContainer
      .withMountedDirectory("/work/src", source)
      .withWorkdir(Path.join(["/work/src", root]))
      .{
        let args = ["bun", "install"]
        if (self.locked) {
          args += ["--frozen-lockfile"]
        }

        _.withExec(args)
      }
      .directory("node_modules")

    container.withMountedDirectory(
      Path.join(["/work/src", root, "node_modules"]),
      dependencies,
    )
  }

  let packageFilePath(root: String!, name: String!): String! {
    Path.clean(Path.join([root, name])).trimPrefix("/")
  }

  let findPackageRoot(workspace: Workspace!): String {
    [
      "bun.lock",
      "bun.lockb",
      "package.json",
    ].each { name =>
      let file = workspace.findUp(name)
      if (file != null) {
        return Path.dir(file)
      }
    }

    null
  }

  """
  Run a Bun package script in the source.
  """
  withRun(
    """
    Workspace containing the package script to run.
    """
    ws: Workspace!,
    """
    Package script to run.
    """
    script: String!,
    """
    Arguments to pass to the script.
    """
    args: [String!]! = [],
  ): Container! {
    self
      .container(ws: ws)
      .withExec(["bun", "run", script] + args)
  }
}
