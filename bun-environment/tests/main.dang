let bunVersion: String! = "1.2.22"

let bunProject: Directory! {
  Dagger
    .directory
    .withNewFile("bun.lock", """{
  "lockfileVersion": 1,
  "workspaces": {
    "": {
      "dependencies": {
        "dep": "file:dep",
      },
    },
  },
  "packages": {
    "dep": ["dep@file:dep", {}],
  }
}
""")
    .withNewFile("package.json", """{
  "scripts": {
    "check": "bun check.js"
  },
  "dependencies": {
    "dep": "file:dep"
  }
}
""")
    .withNewFile("check.js", """import dep from "dep";
console.log(dep);
""")
    .withNewFile("dep/package.json", """{
  "name": "dep",
  "version": "1.0.0",
  "type": "module",
  "exports": "./index.js"
}
""")
    .withNewFile("dep/index.js", """export default "bun-ok";
""")
}

let envFile: File! {
  Dagger
    .directory
    .withNewFile(".env", "BUN_ENV_TEST=from-env-file\n")
    .file(".env")
}

type Tests {
  container: Void @check {
    let container = Dagger
      .bunEnvironment(version: bunVersion, source: Dagger.directory)
      .container

    assert { container.mounts.contains("/root/.bun/install/cache") }
    assert { container.withExec(["bun", "--version"]).stdout.trimSpace == bunVersion }
  }

  noCache: Void @check {
    let container = Dagger
      .bunEnvironment(version: bunVersion, source: Dagger.directory, noCache: true)
      .container

    assert { !container.mounts.contains("/root/.bun/install/cache") }
  }

  envFileAndEpoch: Void @check {
    let container = Dagger
      .bunEnvironment(
        version: bunVersion,
        source: Dagger.directory,
        envFile: envFile,
        sourceDateEpoch: "1234567890",
      )
      .container

    assert { container.envVariable("BUN_ENV_TEST") == "from-env-file" }
    assert { container.envVariable("SOURCE_DATE_EPOCH") == "1234567890" }
  }

  withRun: Void @check {
    let output = Dagger
      .bunEnvironment(version: bunVersion, source: bunProject, install: true)
      .withRun("check")
      .stdout

    assert { output.contains("bun-ok") }
  }

  sourceWithRun: Void @check {
    let output = Dagger
      .bunEnvironment(version: bunVersion, source: bunProject, install: true)
      .withRun(script: "check")
      .stdout

    assert { output.contains("bun-ok") }
  }

  lockedWithRun: Void @check {
    let output = Dagger
      .bunEnvironment(version: bunVersion, source: bunProject)
      .withInstall(locked: true)
      .withRun("check")
      .stdout

    assert { output.contains("bun-ok") }
  }
}
