let bunVersion: String! = "1.2.22"

let bunProject: Directory! {
  Dagger.currentModule.source.directory("testdata/basic")
}

let bunLockedProject: Directory! {
  Dagger.currentModule.source.directory("testdata/locked")
}

let envFile: File! {
  Dagger.currentModule.source.file("testdata/env/.env")
}

type Tests {
  container: Void @check {
    let container = Dagger
      .bunEnvironment(version: bunVersion)
      .container(ws: null)

    assert { container.mounts.contains("/root/.bun/install/cache") }
    assert { container.withExec(["bun", "--version"]).stdout.trimSpace == bunVersion }
  }

  emptyCacheDir: Void @check {
    let container = Dagger
      .bunEnvironment(
        version: bunVersion,
        container: Dagger
          .container
          .from("oven/bun:" + bunVersion)
          .withEnvVariable("BUN_INSTALL_CACHE_DIR", ""),
      )
      .container(ws: null)

    assert { container.envVariable("BUN_INSTALL_CACHE_DIR") == "/root/.bun/install/cache" }
    assert { container.mounts.contains("/root/.bun/install/cache") or container.mounts.contains("/root/.bun/install/cache/") }
  }

  noCache: Void @check {
    let container = Dagger
      .bunEnvironment(version: bunVersion, noCache: true)
      .container(ws: null)

    assert { !container.mounts.contains("/root/.bun/install/cache") }
  }

  envFileAndEpoch: Void @check {
    let container = Dagger
      .bunEnvironment(
        version: bunVersion,
        envFile: envFile,
        sourceDateEpoch: "1234567890",
      )
      .container(ws: null)

    assert { container.envVariable("BUN_ENV_TEST") == "from-env-file" }
    assert { container.envVariable("SOURCE_DATE_EPOCH") == "1234567890" }
  }

  withRun: Void @check {
    let output = Dagger
      .bunEnvironment(version: bunVersion, install: true)
      .withRun(bunProject.asWorkspace, "check")
      .stdout

    assert { output.contains("bun-ok") }
  }

  withRunNamedArgs: Void @check {
    let output = Dagger
      .bunEnvironment(version: bunVersion, install: true)
      .withRun(ws: bunProject.asWorkspace, script: "check")
      .stdout

    assert { output.contains("bun-ok") }
  }

  lockedWithRun: Void @check {
    let output = Dagger
      .bunEnvironment(version: bunVersion, install: true, locked: true)
      .withRun(ws: bunLockedProject.asWorkspace, script: "check")
      .stdout

    assert { output.contains("bun-ok") }
  }
}
