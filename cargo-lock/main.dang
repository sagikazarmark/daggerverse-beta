type CargoLock {
  let lockFile: File!

  # TODO: why is this necessary?
  let lock: String

  new(workspace: Workspace!) {
    let lock: String = workspace.findUp("Cargo.lock")

    if (lock == null) {
      raise `No Cargo.lock found in ${workspace.cwd} (or any parent directory)`
    }

    self.lockFile = workspace.file(lock)

    self
  }

  """
  Find a package by name (if any).

  May return an empty list if no package is found, or a list of packages if multiple are found.
  """
  find(name: String!): [Package!]! {
    self.select(name)
  }

  """
  Report whether a package with the given name exists.
  """
  has(name: String!): Boolean! {
    !self.select(name).isEmpty
  }

  """
  Find a package by name (if any).
  """
  findOne(name: String!): Package {
    self.select(name)[0]
  }

  let select(name: String!): [Package!]! {
    let expr = `[.package[] | select(.name == "${name}") | {"name": .name, "version": .version}]`

    fromJSON(self.eval(expr)) :: [Package!]!
  }

  let eval(expr: String!): String! {
    yq
      .withMountedFile("Cargo.lock", self.lockFile)
      .withExec(
        [
          "yq",
          "-p", "toml", "-o", "json", "-I=0",
          expr,
          "Cargo.lock",
        ],
        redirectStdout: "/stdout",
      )
      .file("/stdout")
      .contents
  }

  let yq: Container! {
    Dagger.container.from("mikefarah/yq:4.53.2@sha256:0cb4a78491b6e62ee8a9bf4fbeacbd15b5013d19bc420591b05383a696315e60")
  }
}

type Package {
  name: String!
  version: String!
}
