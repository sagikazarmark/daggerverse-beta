type CargoLock {
  let file: File!

  new(
    ws: Workspace!,
    """
    Cargo.lock file to use.
    """
    file: File! = {
      let path: String = ws.findUp("Cargo.lock")

      if (path == null) {
        raise `No Cargo.lock found in ${ws.cwd} (or any parent directory)`
      }

      ws.file(path)
    },
  ) {
    self.file = file

    self
  }

  let parse: LockFile! {
    TOML.decode(self.file.contents) :: LockFile!
  }

  """
  The list of packages in the Cargo.lock file.
  """
  packages: [Package!]! {
    self.parse.packages
  }

  """
  Find a package by name (if any).

  May return an empty list if no package is found, or a list of packages if multiple are found.
  """
  find(name: String!): [Package!]! {
    self.packages.filter { _.name == name }
  }

  """
  Report whether a package with the given name exists.
  """
  has(name: String!): Boolean! {
    self.findOne(name) != null
  }

  """
  Find a package by name (if any).
  """
  findOne(name: String!): Package {
    self.packages.find { _.name == name }
  }
}

type LockFile {
  version: Int!
  packages: [Package!]! @TOML.field(name: "package")
}

type Package {
  name: String!
  version: String!
}
