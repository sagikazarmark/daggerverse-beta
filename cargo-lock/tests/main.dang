type Tests {
  wasmBindgen(workspace: Workspace!): Void @check {
    let package = Dagger.cargoLock(workspace).findOne("wasm-bindgen")!

    assert { package.name == "wasm-bindgen" }
    assert { package.version == "0.2.122" }

    null
  }

  dioxus(workspace: Workspace!): Void @check {
    let package = Dagger.cargoLock(workspace).findOne("dioxus")!

    assert { package.name == "dioxus" }
    assert { package.version == "0.7.9" }

    null
  }

  notFound(workspace: Workspace!): Void @check {
    assert { !Dagger.cargoLock(workspace).has("foobarbaz_THIS_SHOULD_NOT_EXIST") }
    assert { Dagger.cargoLock(workspace).has("dioxus") }

    null
  }
}
