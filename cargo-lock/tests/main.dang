type Tests {
  let file: File! = Dagger.currentModule.source.file("Cargo.lock")
  let ws: Workspace! = Dagger
    .directory
    .withFile("Cargo.lock", file)
    .asWorkspace

  let tests = ["wasm-bindgen": {{package: "wasm-bindgen", version: "0.2.122"}}, "dioxus": {{package: "dioxus", version: "0.7.9"}}]

  found: Void @check {
    tests.each { key, value =>
      let package = Dagger.cargoLock(ws: ws).findOne(key)!

      assert { package.name == key }
      assert { package.version == value.version }

      let package = Dagger.cargoLock(file: file).findOne(key)!

      assert { package.name == key }
      assert { package.version == value.version }
    }

    null
  }

  notFound: Void @check {
    assert { !Dagger.cargoLock(ws).has("foobarbaz_THIS_SHOULD_NOT_EXIST") }
    assert { Dagger.cargoLock(ws).has("dioxus") }

    assert { !Dagger.cargoLock(file: file).has("foobarbaz_THIS_SHOULD_NOT_EXIST") }
    assert { Dagger.cargoLock(file: file).has("dioxus") }
  }
}
