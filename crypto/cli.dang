let inputs = {{
  path: "/work/inputs/"
}}

let inputPath(name: String!): String! {
  `/work/inputs/${name}`
}

let secretPath(name: String!): String! {
  `/run/secrets/${name}`
}

type Command {
  let container: Container!
  let args: [String!]!

  new(args: [String!]! = []) {
    self.container = Dagger
      .container
      .from("smallstep/step-cli:0.30.2@sha256:c75414251d4d8234945fb01e1374707dcc6a7adced88679bae4f0fd526331e74")
      .withUser("root")
      .withWorkdir("/work/out")

    if (args[0] != "step") {
      args = ["step"] + args
    }

    self.args = args

    self
  }

  pub run(args: [String!]! = []): Container! {
    self.container.withExec(self.args + args)
  }

  pub withArgs(args: [String!]!): Command! {
    self.args += args

    self
  }

  let newArg(arg: String!, value: String!): [String!]! {
    ["--" + arg.trimPrefix("--"), value]
  }

  pub withFileArg(file: File!): Command! {
    let path = inputPath(file.name)

    self.container = self.container.withMountedFile(path, file)
    self.args += [path]

    self
  }

  pub withSecret(name: String!, secret: Secret!, arg: String = null): Command! {
    let path = secretPath(name)

    self.container = self.container.withMountedSecret(path, secret)

    if (arg != null) {
      self.args += newArg(arg, path)
    }

    self
  }

  pub withPassword(secret: Secret): Command! {
    if (secret != null) {
      self.withSecret("password", secret, "password-file")
    } else {
      self.withArgs(["--no-password", "--insecure"])
    }
  }

  let withKeyParams(params: KeyParams!): Command! {
    self.args += ["--kty", toString(params.keyType).trim("\"")] + params.args

    self
  }

  pub withKeyArg(file: File!, password: Secret = null): Command! {
    let cmd = self.withFileArg(file)

    if (password != null) {
      cmd = cmd.withSecret("password", password, "password-file")
    }

    cmd
  }

  pub withKey(file: File!, password: Secret = null): Command! {
    self.withArgs(["--key"]).withKeyArg(file, password)
  }
}

enum KeyType {
  EC
  OKP
  RSA
}

interface KeyParams {
  pub keyType: KeyType!
  pub args: [String!]!
  pub defaultName: String!
}

type RsaKeyParams implements KeyParams {
  pub size: Int

  pub keyType: KeyType! {
    KeyType.RSA
  }

  pub args: [String!]! {
    let args = []

    if (self.size != null) {
      args += ["--size", toString(self.size)]
    }

    args
  }

  pub defaultName: String! {
    "rsa"
  }
}

enum EcCurve {
  P256
  P384
  P521
}

type EcKeyParams implements KeyParams {
  pub curve: EcCurve

  pub keyType: KeyType! {
    KeyType.EC
  }

  pub args: [String!]! {
    let args = []

    if (self.curve != null) {
      args += ["--curve", self.curveString]
    }

    args
  }

  pub defaultName: String! {
    "ec_" + (
      if (self.curve != null) {
        self.curveString.replace("-", "").toLower
      } else {
        "p256"
      }
    )
  }

  let curveString: String! {
    case (self.curve) {
      EcCurve.P256 => "P-256"
      EcCurve.P384 => "P-384"
      EcCurve.P521 => "P-521"
    }
  }
}

type Ed25519KeyParams implements KeyParams {
  pub keyType: KeyType! {
    KeyType.OKP
  }

  pub args: [String!]! {
    ["--curve", "Ed25519"]
  }

  pub defaultName: String! {
    "ed25519"
  }
}
