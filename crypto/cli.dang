type Command {
  let container: Container!
  let args: [String!]!

  new(args: [String!]! = []) {
    self.container = Dagger
      .container
      .from("smallstep/step-cli:0.30.2@sha256:c75414251d4d8234945fb01e1374707dcc6a7adced88679bae4f0fd526331e74")
      .withUser("root")
      .withWorkdir("/work/out")

    if (args[0] != "step") {
      args = ["step"] + args
    }

    self.args = args

    self
  }

  pub run(
    args: [String!]! = [],
    expect: ReturnType = null,
    redirectStdout: String = null,
  ): Container! {
    self
      .container
      .withExec(
        self.args + args,
        expect: expect,
        redirectStdout: redirectStdout,
      )
  }

  pub with(&block(cmd: Command!): Command!): Command! {
    block(self)
  }

  pub withArgs(args: [String!]!): Command! {
    self.args += args

    self
  }

  pub withArg(arg: String!): Command! {
    self.withArgs([arg])
  }

  pub withFileArg(file: File!): Command! {
    let path = inputPath(file.name)

    self.container = self.container.withMountedFile(path, file)
    self.args += [path]

    self
  }

  pub withSecretArg(name: String!, secret: Secret!): Command! {
    let path = secretPath(name)

    self.container = self.container.withMountedSecret(path, secret)
    self.args += [path]

    self
  }

  pub withPassword(secret: Secret): Command! {
    if (secret != null) {
      self.withArg("--password-file").withSecretArg("password", secret)
    } else {
      self.withArgs(["--no-password", "--insecure"])
    }
  }

  let withKeyParams(params: KeyParams!): Command! {
    self.args += ["--kty", toString(params.keyType).trim("\"")] + params.args

    self
  }

  pub withKeyArg(file: File!, password: Secret = null): Command! {
    let cmd = self.withFileArg(file)

    if (password != null) {
      cmd = cmd.withArg("--password-file").withSecretArg("password", password)
    }

    cmd
  }

  pub withKey(file: File!, password: Secret = null): Command! {
    self.withArgs(["--key"]).withKeyArg(file, password)
  }
}

let inputPath(name: String!): String! {
  `/work/inputs/${name}`
}

let secretPath(name: String!): String! {
  `/run/secrets/${name}`
}
