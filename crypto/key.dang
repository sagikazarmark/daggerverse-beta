type PublicKey {
  """
  Key file in PEM format.
  """
  file: File!

  """
  Verify a signature of a file.
  """
  verify(
    """
    File to verify.
    """
    file: File!,
    """
    The base64-encoded signature.
    """
    signature: String!,
  ): VerificationResult! {
    let result = Command(["crypto", "key", "verify"])
      .withFileArg(self.file)
      .withKey(self.file)
      .withArgs(["--signature", signature])
      .run(expect: ReturnType.ANY)

    VerificationResult(
      verified: result.exitCode == 0,
      message: result.stdout,
    )
  }

  """
  Details of the key in a human readable format.
  """
  inspect: String! {
    Command(["crypto", "key", "inspect"]).withFileArg(self.file).run.stdout
  }

  """
  Fingerprint of the key.
  """
  fingerprint(
    """
    Fingerprint format.
    """
    format: FingerprintFormat,
  ): String! {
    Command(["crypto", "key", "fingerprint"])
      .withFileArg(self.file)
      .{ withFingerprintFormat(_, format) }
      .run
      .stdout
  }
}

type VerificationResult {
  """
  Whether the verification was successful.
  """
  verified: Boolean!

  """
  The verification message.
  """
  message: String!
}

enum FingerprintFormat {
  HEX
  BASE64
  BASE64_URL
  BASE64_RAW
  BASE64_URL_RAW
  EMOJI
}

let withFingerprintFormat(cmd: Command!, format: FingerprintFormat): Command! {
  if (format != null) {
    cmd = cmd.withArgs(["--format", toString(format).trim("\"").toLower.replace("_", "-")])
  }

  cmd
}

type PrivateKey {
  """
  Key file in PEM format.
  """
  file: File!

  """
  Whether the key is known to be encrypted.
  """
  let isEncrypted: Boolean

  let ensurePassword(password: Secret): Void {
    if (self.isEncrypted == true and password == null) {
      raise "Key is encrypted but no password was provided"
    } else if (self.isEncrypted == false and password != null) {
      raise "Key is not encrypted but a password was provided"
    }
  }

  """
  Generate a signature for a file.
  """
  sign(
    """
    File to sign.
    """
    file: File!,
    """
    Password used to decrypt the private key.
    """
    password: Secret,
  ): String! {
    self.ensurePassword(password)

    # This is a workaround: sign seems to try to read from TTY even when a password file is provided
    if (password != null) {
      return self.changePassword(password, null).sign(file, null)
    }

    Command(["crypto", "key", "sign"])
      .withFileArg(file)
      .withKey(self.file, password)
      .run
      .stdout
  }

  """
  Get the public key associated with this private key.
  """
  publicKey(
    """
    Password used to decrypt the private key.
    """
    password: Secret,
  ): PublicKey! {
    self.ensurePassword(password)

    let fileName = self.file.name.trimSuffix(".key") + ".pub"

    PublicKey(
      Command(["crypto", "key", "public"])
        .withKeyArg(self.file, password)
        .withArgs(["--out", fileName])
        .run
        .file(fileName),
    )
  }

  """
  Details of a key in a human readable format.
  """
  inspect(
    """
    Password used to decrypt the private key.
    """
    password: Secret,
  ): String! {
    self.ensurePassword(password)

    Command(["crypto", "key", "inspect"]).withKeyArg(self.file, password).run.stdout
  }

  """
  Change the password of the private key.
  """
  changePassword(
    """
    Old password (if any).
    """
    old: Secret,
    """
    New password (do not provide if you want to remove the password).
    """
    new: Secret,
  ): PrivateKey! {
    self.ensurePassword(old)

    let fileName = self.file.name

    let result = Command(["crypto", "change-pass"])
      .withFileArg(self.file)
      .withArgs(["--out", fileName])
      .{
        if (old != null) {
          _.withArg("--password-file").withSecretArg("old-password", old)
        } else _
      }
      .{
        if (new != null) {
          _
            .withArg("--new-password-file")
            .withSecretArg("new-password", new)
        } else {
          _.withArgs(["--no-password", "--insecure"])
        }
      }
      .run

    PrivateKey(result.file(fileName), isEncrypted: new != null)
  }
}

type KeyPair {
  """
  Public key.
  """
  publicKey: PublicKey!

  """
  Private key.
  """
  privateKey: PrivateKey!

  """
  Directory containing the key pair files.
  """
  directory: Directory! {
    Dagger.directory.withFiles("", [self.publicKey.file, self.privateKey.file])
  }
}

enum KeyType {
  EC
  OKP
  RSA
}

interface KeyParams {
  keyType: KeyType!
  args: [String!]!
  defaultName: String!
}

type RsaKeyParams implements KeyParams {
  size: Int

  keyType: KeyType! {
    KeyType.RSA
  }

  args: [String!]! {
    let args = []

    let size = self.size
    if (size != null) {
      args += ["--size", toString(size)]
    }

    args
  }

  defaultName: String! {
    "rsa"
  }
}

enum EcCurve {
  P256
  P384
  P521
}

type EcKeyParams implements KeyParams {
  curve: EcCurve

  keyType: KeyType! {
    KeyType.EC
  }

  args: [String!]! {
    let args = []

    let curve = self.curve
    if (curve != null) {
      args += ["--curve", self.curveString]
    }

    args
  }

  defaultName: String! {
    "ec_" + (
      if (self.curve != null) {
        self.curveString.replace("-", "").toLower
      } else {
        "p256"
      }
    )
  }

  let curveString: String! {
    case (self.curve) {
      EcCurve.P256 => "P-256"
      EcCurve.P384 => "P-384"
      EcCurve.P521 => "P-521"
      else => raise `unsupported curve: ${self.curve}`
    }
  }
}

type Ed25519KeyParams implements KeyParams {
  keyType: KeyType! {
    KeyType.OKP
  }

  args: [String!]! {
    ["--curve", "Ed25519"]
  }

  defaultName: String! {
    "ed25519"
  }
}

type Keys {
  """
  Generate a new key pair in PEM format.
  """
  generate(
    """
    File name for the key pair (default: selected algorithm).

    Resulting keys will be called NAME.pub and NAME.key.
    """
    name: String,
    """
    Password used to encrypt the generated private key.
    """
    password: Secret,
  ): KeyGenerator! {
    KeyGenerator(name, password)
  }

  """
  Load a public key from a file.
  """
  publicKey(file: File!): PublicKey! {
    PublicKey(file)
  }

  """
  Load a private key from a file.
  """
  privateKey(file: File!): PrivateKey! {
    PrivateKey(file)
  }

  """
  Load a key pair from a public and private key file.
  """
  pair(publicKey: File!, privateKey: File!): KeyPair! {
    KeyPair(PublicKey(publicKey), PrivateKey(privateKey))
  }
}

type KeyGenerator {
  let name: String
  let password: Secret

  """
  Generate a new RSA key pair.
  """
  rsa(
    """
    RSA key size (default: 2048).
    """
    size: Int,
  ): KeyPair! {
    self.generate(RsaKeyParams(size))
  }

  """
  Generate a new EC private key pair.
  """
  ec(
    """
    Elliptic curve to use for the generated EC key (default: P256).
    """
    curve: EcCurve,
  ): KeyPair! {
    self.generate(EcKeyParams(curve))
  }

  """
  Generate a new Ed25519 key pair.
  """
  ed25519: KeyPair! {
    self.generate(Ed25519KeyParams)
  }

  let generate(params: KeyParams!): KeyPair! {
    let name = self.name ?? params.defaultName

    let result = Command(["crypto", "keypair", name + ".pub", name + ".key"])
      .withKeyParams(params)
      .withPassword(self.password)
      .run

    KeyPair(
      PublicKey(result.file(name + ".pub")),
      PrivateKey(result.file(name + ".key"), isEncrypted: self.password != null),
    )
  }
}
