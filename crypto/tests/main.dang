type Tests {
  key: KeysTests! { KeysTests }

  x509: X509Tests! { X509Tests }

  fixtures: Changeset! {
    Fixtures.generate
  }
}

type Fixtures {
  fixtures: Directory! {
    let password = Dagger.setSecret("password", Random.string)

    Dagger
      .directory
      .withDirectory("without-password", self.keypairs(Dagger.crypto.key.generate))
      .withDirectory(
        "with-password",
        self
          .keypairs(Dagger.crypto.key.generate(password: password))
          .withNewFile("password", password.plaintext),
      )
  }

  let keypairs(generator: CryptoKeyGenerator!): Directory! {
    Dagger
      .directory
      .withDirectory("", generator.rsa.directory)
      .withDirectory("", generator.ec.directory)
      .withDirectory("", generator.ed25519.directory)
  }

  let source: Directory! = Dagger.currentModule.source

  let changes(dir: Directory!): Changeset! {
    self.source.withDirectory("fixtures", dir).changes(self.source)
  }

  generate: Changeset! {
    self.changes(self.fixtures)
  }
}
