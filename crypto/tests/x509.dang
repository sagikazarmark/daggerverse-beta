type X509Tests {
  """
  Root CA creation returns certificate and key files.
  """
  pub root: File! @check {
    x509.create.rsa.root("test-root-ca").certificate.file
  }

  """
  Create-level validity parameters are applied to certificate creation.
  """
  pub createValidity: File! @check {
    x509.create(notAfter: "24h", notBefore: "0s").rsa.root("create-validity-root-ca").certificate.file
  }

  """
  Intermediate and leaf certificate chains are created and can be verified.
  """
  pub leafChain: String! @check {
    let root = x509.create.rsa.root("test-root-ca")
    let intermediate = x509.create.rsa.intermediate("test-intermediate-ca", root.issuer)
    let leaf = x509.create.rsa.certificate("test.local", intermediate.issuer, sans: ["test.local"])

    stepContainer
      .withMountedFile("root.crt", root.certificate.file)
      .withMountedFile("leaf.crt", leaf.certificate.fullChain)
      .withExec(["step", "certificate", "verify", "--roots", "root.crt", "leaf.crt"])
      .stdout
  }

  """
  Self-signed certificates expose the certificate itself as the full chain.
  """
  pub selfSigned: File! @check {
    x509
      .create
      .ec(CryptoEcCurve.P_256)
      .selfSigned("self-signed.local", sans: ["self-signed.local"])
      .certificate
      .fullChain
  }

  """
  Certificate templates can be used with CA-signed certificates.
  """
  pub templatedCertificate: File! @check {
    let root = x509.create.rsa.root("template-root-ca")

    x509
      .create(template: Dagger.file("template.json", clientTemplate))
      .rsa
      .certificate("templated-client", root.issuer)
      .certificate
      .file
  }

  """
  Encrypted CA keys can sign certificates when the issuer provides the password.
  """
  pub passwordProtectedCa: File! @check {
    let password = Dagger.setSecret("x509-ca-password", Random.string)
    let root = x509.create.rsa.root("password-root-ca", password: password)

    x509
      .create
      .rsa
      .intermediate("password-intermediate-ca", root.issuer(password))
      .certificate
      .file
  }

  """
  Signing with an encrypted CA key requires a password.
  """
  pub passwordRequired: Void @check {
    let password = Dagger.setSecret("x509-required-password", Random.string)
    let root = x509.create.rsa.root("required-root-ca", password: password)

    try {
      x509.create.rsa.intermediate("required-intermediate-ca", root.issuer).certificate.file.contents

      raise "CA key is encrypted, this should have failed"
    } catch {
      err => assert { err.message.contains("Key is encrypted but no password was provided") }
    }
  }

  """
  Generated private keys can be encrypted with a password.
  """
  pub encryptedKey: String! @check {
    let password = Dagger.setSecret("x509-leaf-password", Random.string)
    let root = x509.create.rsa.root("encrypted-key-root-ca")

    x509
      .create
      .rsa
      .certificate("encrypted.local", root.issuer, name: "encrypted", password: password)
      .key
      .inspect(password)
  }

  """
  Existing private keys can be used instead of generating a new key.
  """
  pub existingKeyCsr: File! @check {
    let first = x509.create.rsa.csr("existing-key.local")

    x509.create.key(first.key).csr("existing-key.local", name: "existing-key").csr
  }

  """
  Keys generated by the crypto module can be used to create certificates.
  """
  pub existingKeyRoot: File! @check {
    let pair = Dagger.crypto.key.generate.ec

    x509.create.key(pair.privateKey).root("existing-key-root-ca").certificate.file
  }

  """
  CSR creation returns a CSR file.
  """
  pub csr: File! @check {
    x509.create.ec(CryptoEcCurve.P_256).csr("test.local", sans: ["test.local"]).csr
  }

  """
  Certificate and CSR details can be inspected.
  """
  pub inspect: Void @check {
    x509.create.rsa.selfSigned("inspect.local", name: "inspect").certificate.inspect
    x509.create.rsa.csr("inspect-csr.local", name: "inspect-csr").inspect

    null
  }

  """
  Certificate fingerprints can be printed in all formats.
  """
  pub fingerprint: Void @check {
    let certificate = x509.create.rsa.root("fingerprint-root-ca").certificate

    certificate.fingerprint

    CryptoFingerprintFormat.values.each { format =>
      certificate.fingerprint(format)
    }

    null
  }

  """
  Certificate details can be linted.
  """
  pub lint: String! @check {
    x509.create.rsa.root("lint-root-ca").certificate.lint
  }

  """
  Certificates report whether they need renewal.
  """
  pub needsRenewal: Void @check {
    let certificate = x509.create(notAfter: "240h").rsa.root("needs-renewal-root-ca").certificate

    assert { !certificate.needsRenewal }
    assert { certificate.needsRenewal("241h") }
  }

  """
  The public key embedded in a certificate or CSR can be extracted.
  """
  pub publicKey: Void @check {
    x509.create.ec.root("public-key-root-ca").certificate.publicKey.inspect
    x509.create.ec.csr("public-key.local", name: "public-key").publicKey.inspect

    null
  }

  """
  CSRs can be signed verbatim without modifying the CSR.
  """
  pub signCsrVerbatim: Void @check {
    let root = x509.create.rsa.root("sign-verbatim-root-ca")

    x509
      .create
      .rsa
      .csr("sign-verbatim.local", name: "sign-verbatim")
      .sign(root.issuer)
      .verbatim
      .certificate
      .inspect

    null
  }
}

let x509: CryptoX509! {
  Dagger.crypto.x509
}

let stepContainer: Container! {
  Dagger
    .container
    .from("smallstep/step-cli:0.30.2@sha256:c75414251d4d8234945fb01e1374707dcc6a7adced88679bae4f0fd526331e74")
    .withUser("root")
    .withWorkdir("/work")
}

let clientTemplate: String! = """{
  "subject": {
    "commonName": {{ toJson .Subject.CommonName }}
  },
  "keyUsage": ["digitalSignature"],
  "extKeyUsage": ["clientAuth"]
}
"""
