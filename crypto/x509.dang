type Certificate {
  """
  A certificate file.
  """
  file: File!

  """
  The issuer chain file, if any.
  """
  chain: File

  new(file: File!, chain: File = null) {
    self.file = file
    self.chain = chain

    self
  }

  """
  The full certificate chain (including the certificate and the issuer chain) file.
  """
  fullChain: File! {
    let fileName = self.file.name.trimSuffix(".crt") + "-fullchain.crt"

    let chain = self.chain
    if (chain == null) {
      return self.file.withName(fileName)
    }

    Command(["certificate", "bundle"])
      .withFileArg(self.file)
      .withFileArg(chain)
      .withArg(fileName)
      .run
      .file(fileName)
  }

  """
  Details of the certificate in a human readable format.
  """
  inspect: String! {
    Command(["certificate", "inspect"]).withFileArg(self.file).run.stdout
  }

  """
  Fingerprint of the certificate.
  """
  fingerprint(
    """
    Fingerprint format.
    """
    format: FingerprintFormat = null,
  ): String! {
    Command(["certificate", "fingerprint"])
      .withFileArg(self.file)
      .{ withFingerprintFormat(_, format) }
      .run
      .stdout
  }

  """
  Lint the certificate details.
  """
  lint: String! {
    Command(["certificate", "lint"]).withFileArg(self.file).run.stdout
  }

  """
  Check if the certificate needs to be renewed.
  """
  needsRenewal(
    """
    Renewal window as a duration (e.g. "8h") or a percentage
    of the certificate lifetime (e.g. "25%") (default: 66%).
    """
    expiresIn: String = null,
  ): Boolean! {
    let result = Command(["certificate", "needs-renewal"])
      .withFileArg(self.file)
      .{ cmd =>
        if (expiresIn != null) {
          cmd = cmd.withArgs(["--expires-in", expiresIn])
        }

        cmd
      }
      .run(expect: ReturnType.ANY)

    case (result.exitCode) {
      0 => true
      1 => false
      else => raise "checking certificate renewal failed: " + result.stderr
    }
  }

  """
  The public key embedded in the certificate.
  """
  publicKey: PublicKey! {
    let fileName = self.file.name.trimSuffix(".crt") + ".pub"

    PublicKey(
      Command(["certificate", "key"])
        .withFileArg(self.file)
        .withArgs(["--out", fileName])
        .run
        .file(fileName),
    )
  }
}

type CertificateIdentity {
  """
  The certificate.
  """
  certificate: Certificate!

  """
  The private key.
  """
  key: PrivateKey!
}

type CertificateAuthority {
  """
  The certificate.
  """
  certificate: Certificate!

  """
  The private key.
  """
  key: PrivateKey!

  """
  Create an issuer from the certificate and private key.
  """
  issuer(
    """
    Password used to decrypt the private key.
    """
    password: Secret = null,
  ): CertificateIssuer! {
    self.key.ensurePassword(password)

    CertificateIssuer(
      certificate: self.certificate.file,
      chain: self.certificate.fullChain,
      key: self.key,
      password: password,
    )
  }
}

type CertificateIssuer {
  """
  The issuer certificate.
  """
  certificate: File!

  """
  The full issuer certificate chain (including the certificate itself).
  """
  chain: File!

  """
  The private key.
  """
  key: PrivateKey!

  """
  Password used to decrypt the private key (null if the key is not encrypted).
  """
  password: Secret
}

type CertificateRequest {
  """
  The certificate signing request file.
  """
  csr: File!

  """
  The private key.
  """
  key: PrivateKey!

  """
  Details of the certificate signing request in a human readable format.
  """
  inspect: String! {
    Command(["certificate", "inspect"]).withFileArg(self.csr).run.stdout
  }

  """
  The public key embedded in the certificate signing request.
  """
  publicKey: PublicKey! {
    let fileName = self.csr.name.trimSuffix(".csr") + ".pub"

    PublicKey(
      Command(["certificate", "key"])
        .withFileArg(self.csr)
        .withArgs(["--out", fileName])
        .run
        .file(fileName),
    )
  }

  """
  Sign the CSR to create a certificate.
  """
  sign(
    """
    Issuing authority that signs the certificate.
    """
    issuer: CertificateIssuer!,
    """
    Certificate template file.
    """
    template: File = null,
    """
    Certificate validity end time or duration.
    """
    notAfter: String = null,
    """
    Certificate validity start time or duration.
    """
    notBefore: String = null,
  ): CertificateRequestSigner! {
    CertificateRequestSigner(
      csr: self.csr,
      key: self.key,
      issuer: issuer,
      template: template,
      notAfter: notAfter,
      notBefore: notBefore,
    )
  }
}

type CertificateRequestSigner {
  let csr: File!
  let key: PrivateKey!
  let issuer: CertificateIssuer!

  let template: File
  let notAfter: String
  let notBefore: String

  """
  Sign a leaf certificate.
  """
  certificate(
    """
    Certificate template file.
    """
    template: File = self.template,
    """
    Certificate validity end time or duration.
    """
    notAfter: String = self.notAfter,
    """
    Certificate validity start time or duration.
    """
    notBefore: String = self.notBefore,
  ): CertificateIdentity! {
    CertificateIdentity(
      certificate: self.signed("leaf", template, notAfter, notBefore),
      key: self.key,
    )
  }

  """
  Sign an intermediate CA certificate.
  """
  intermediate(
    """
    Maximum path length to set in the pathLenConstraint of the certificate (default: 0; -1 for no limit).
    """
    pathLen: Int = null,
    """
    Certificate template file.
    """
    template: File = self.template,
    """
    Certificate validity end time or duration.
    """
    notAfter: String = self.notAfter,
    """
    Certificate validity start time or duration.
    """
    notBefore: String = self.notBefore,
  ): CertificateAuthority! {
    let args = []

    if (pathLen != null) {
      args = ["--path-len", toString(pathLen)]
    }

    CertificateAuthority(
      certificate: self.signed(
        "intermediate-ca",
        template,
        notAfter,
        notBefore,
        args,
      ),
      key: self.key,
    )
  }

  """
  Sign a certificate without modifying the CSR.
  """
  verbatim(
    """
    Certificate template file.
    """
    template: File = self.template,
    """
    Certificate validity end time or duration.
    """
    notAfter: String = self.notAfter,
    """
    Certificate validity start time or duration.
    """
    notBefore: String = self.notBefore,
  ): CertificateIdentity! {
    CertificateIdentity(
      certificate: self.signed("csr", template, notAfter, notBefore),
      key: self.key,
    )
  }

  let signed(
    profile: String!,
    template: File,
    notAfter: String,
    notBefore: String,
    args: [String!]! = [],
  ): Certificate! {
    let fileName = self.csr.name.trimSuffix(".csr") + ".crt"

    let result = Command(["certificate", "sign"])
      .withFileArg(self.csr)
      .withFileArg(self.issuer.certificate)
      .withFileArg(self.issuer.key.file)
      .{ cmd =>
        let password = self.issuer.password
        if (password != null) {
          cmd = cmd.withArg("--password-file").withSecretArg("password", password)
        }

        cmd
      }
      .{ withTemplate(_, template, profile) }
      .withArgs(validityArgs(notAfter, notBefore))
      .withArgs(args)
      .run(redirectStdout: fileName)

    Certificate(result.file(fileName), self.issuer.chain)
  }
}

type X509 {
  """
  Create a certificate or a certificate signing request (CSR).
  """
  create(
    """
    Certificate template file.
    """
    template: File = null,
    """
    Certificate validity end time or duration.
    """
    notAfter: String = null,
    """
    Certificate validity start time or duration.
    """
    notBefore: String = null,
  ): CreateCertificateKeySelector! {
    CreateCertificateKeySelector(template, notAfter, notBefore)
  }
}

let withTemplate(cmd: Command!, template: File, profile: String!): Command! {
  if (template == null) {
    return cmd.withArgs(["--profile", profile])
  }

  cmd.withArgs(["--template"]).withFileArg(template)
}

let validityArgs(notAfter: String, notBefore: String): [String!]! {
  let args = []

  if (notAfter != null) {
    args += ["--not-after", notAfter]
  }

  if (notBefore != null) {
    args += ["--not-before", notBefore]
  }

  args
}
