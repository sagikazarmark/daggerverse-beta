type CreateCertificateKeySelector {
  let template: File
  let notAfter: String
  let notBefore: String

  """
  Generate a new RSA private key for the certificate.
  """
  rsa(
    """
    RSA key size (default: 2048).
    """
    size: Int,
  ): CertificateCreator! {
    self.creator(RsaKeyParams(size))
  }

  """
  Generate a new EC private key for the certificate.
  """
  ec(
    """
    Elliptic curve to use for the generated EC key (default: P256).
    """
    curve: EcCurve,
  ): CertificateCreator! {
    self.creator(EcKeyParams(curve))
  }

  """
  Generate a new Ed25519 private key for the certificate.
  """
  ed25519: CertificateCreator! {
    self.creator(Ed25519KeyParams)
  }

  """
  Use an existing private key for the certificate instead of generating one.
  """
  key(
    """
    Existing private key.
    """
    key: PrivateKey!,
    """
    Password used to decrypt the existing private key.
    """
    password: Secret,
  ): CertificateCreator! {
    CertificateCreator(
      keyArgs: null,
      key: key,
      keyPassword: password,
      template: self.template,
      notAfter: self.notAfter,
      notBefore: self.notBefore,
    )
  }

  let creator(keyParams: KeyParams!): CertificateCreator! {
    CertificateCreator(
      keyArgs: ["--kty", toString(keyParams.keyType).trim("\"")] + keyParams.args,
      key: null,
      keyPassword: null,
      template: self.template,
      notAfter: self.notAfter,
      notBefore: self.notBefore,
    )
  }
}

type CertificateCreator {
  let keyArgs: [String!]
  let key: PrivateKey
  let keyPassword: Secret

  let template: File
  let notAfter: String
  let notBefore: String

  """
  Create a self-signed root CA certificate.
  """
  root(
    """
    The subject of the certificate.
    """
    subject: String!,
    """
    Base name for generated files.
    """
    name: String! = "root-ca",
    """
    Certificate template file.
    """
    template: File = self.template,
    """
    Certificate validity end time or duration.
    """
    notAfter: String = self.notAfter,
    """
    Certificate validity start time or duration.
    """
    notBefore: String = self.notBefore,
    """
    Password used to encrypt the generated private key.
    """
    password: Secret,
  ): CertificateAuthority! {
    let certFile = name + ".crt"
    let keyFile = name + ".key"

    let result = self
      .command(subject, certFile, keyFile, password)
      .{ withTemplate(_, template, "root-ca") }
      .withArgs(validityArgs(notAfter, notBefore))
      .run

    CertificateAuthority(
      certificate: Certificate(result.file(certFile)),
      key: key ?? PrivateKey(result.file(keyFile), isEncrypted: password != null),
    )
  }

  """
  Create an intermediate CA certificate signed by an issuing authority.
  """
  intermediate(
    """
    The subject of the certificate.
    """
    subject: String!,
    """
    Issuing authority that signs the certificate.
    """
    issuer: CertificateIssuer!,
    """
    Base name for generated files.
    """
    name: String! = "intermediate-ca",
    """
    Certificate template file.
    """
    template: File = self.template,
    """
    Certificate validity end time or duration.
    """
    notAfter: String = self.notAfter,
    """
    Certificate validity start time or duration.
    """
    notBefore: String = self.notBefore,
    """
    Password used to encrypt the generated private key.
    """
    password: Secret,
  ): CertificateAuthority! {
    let certFile = name + ".crt"
    let keyFile = name + ".key"

    let result = self
      .command(subject, certFile, keyFile, password)
      .{ self.withIssuer(_, issuer) }
      .{ withTemplate(_, template, "intermediate-ca") }
      .withArgs(validityArgs(notAfter, notBefore))
      .run

    CertificateAuthority(
      certificate: Certificate(result.file(certFile), issuer.chain),
      key: key ?? PrivateKey(result.file(keyFile), isEncrypted: password != null),
    )
  }

  """
  Create a leaf certificate signed by an issuing authority.
  """
  certificate(
    """
    The subject of the certificate.
    """
    subject: String!,
    """
    Issuing authority that signs the certificate.
    """
    issuer: CertificateIssuer!,
    """
    Base name for generated files.
    """
    name: String! = "leaf",
    """
    Subject alternative names.
    """
    sans: [String!]! = [],
    """
    Certificate template file.
    """
    template: File = self.template,
    """
    Certificate validity end time or duration.
    """
    notAfter: String = self.notAfter,
    """
    Certificate validity start time or duration.
    """
    notBefore: String = self.notBefore,
    """
    Password used to encrypt the generated private key.
    """
    password: Secret,
  ): CertificateIdentity! {
    let certFile = name + ".crt"
    let keyFile = name + ".key"

    let result = self
      .command(subject, certFile, keyFile, password)
      .{ self.withIssuer(_, issuer) }
      .{ withTemplate(_, template, "leaf") }
      .withArgs(validityArgs(notAfter, notBefore))
      .withArgs(self.sanArgs(sans))
      .run

    CertificateIdentity(
      certificate: Certificate(result.file(certFile), issuer.chain),
      key: key ?? PrivateKey(result.file(keyFile), isEncrypted: password != null),
    )
  }

  """
  Create a self-signed certificate.
  """
  selfSigned(
    """
    The subject of the certificate.
    """
    subject: String!,
    """
    Base name for generated files.
    """
    name: String! = "leaf",
    """
    Subject alternative names.
    """
    sans: [String!]! = [],
    """
    Certificate template file.
    """
    template: File = self.template,
    """
    Certificate validity end time or duration.
    """
    notAfter: String = self.notAfter,
    """
    Certificate validity start time or duration.
    """
    notBefore: String = self.notBefore,
    """
    Password used to encrypt the generated private key.
    """
    password: Secret,
  ): CertificateIdentity! {
    let certFile = name + ".crt"
    let keyFile = name + ".key"

    let result = self
      .command(subject, certFile, keyFile, password)
      .{ withTemplate(_, template, "self-signed") }
      .withArgs(validityArgs(notAfter, notBefore))
      .withArgs(self.sanArgs(sans))
      .withArg("--subtle")
      .run

    CertificateIdentity(
      certificate: Certificate(result.file(certFile)),
      key: key ?? PrivateKey(result.file(keyFile), isEncrypted: password != null),
    )
  }

  """
  Create a certificate signing request (CSR).
  """
  csr(
    """
    The subject of the certificate.
    """
    subject: String!,
    """
    Base name for generated files.
    """
    name: String! = "certificate",
    """
    Subject alternative names.
    """
    sans: [String!]! = [],
    """
    Certificate template file.
    """
    template: File = self.template,
    """
    Password used to encrypt the generated private key.
    """
    password: Secret,
  ): CertificateRequest! {
    let csrFile = name + ".csr"
    let keyFile = name + ".key"

    let result = self
      .command(subject, csrFile, keyFile, password)
      .withArg("--csr")
      .withArgs(self.sanArgs(sans))
      .{ if (template != null) _.withArg("--template").withFileArg(template) else _ }
      .run

    CertificateRequest(
      csr: result.file(csrFile),
      key: key ?? PrivateKey(result.file(keyFile), isEncrypted: password != null),
    )
  }

  let command(
    subject: String!,
    outFile: String!,
    keyFile: String!,
    password: Secret,
  ): Command! {
    let cmd = Command(["certificate", "create", subject, outFile])

    let key = self.key
    if (key != null) {
      return cmd.withKey(key.file, self.keyPassword)
    }

    let keyArgs = self.keyArgs
    if (keyArgs == null) {
      raise "no key source provided"
    }

    cmd.withArgs([keyFile]).withArgs(keyArgs).withPassword(password)
  }

  let withIssuer(cmd: Command!, issuer: CertificateIssuer!): Command! {
    cmd = cmd
      .withArg("--ca")
      .withFileArg(issuer.certificate)
      .withArg("--ca-key")
      .withFileArg(issuer.key.file)

    let password = issuer.password
    if (password != null) {
      cmd = cmd.withArg("--ca-password-file").withSecretArg("ca-password", password)
    }

    cmd
  }

  let sanArgs(sans: [String!]!): [String!]! {
    sans.reduce([]) { args, san =>
      args + ["--san", san]
    }
  }
}
