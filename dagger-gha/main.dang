"""
How the actions used in the workflow are pinned.
"""
enum ActionPin {
  VERSION
  COMMIT
}

type DaggerGha {
  let include: [String!]!
  let skip: [String!]!
  let noGenerate: Boolean!
  let onlyGenerate: Boolean!
  let expand: Boolean!
  let groupLevel: Int
  let workspace: String
  let env: String
  let daggerVersion: String
  let daggerCommit: String
  let pin: ActionPin!
  let concurrency: Int

  new(
    """
    Include patterns using the same matching rules as dagger check selectors.

    Exact prefixes match all descendants, * matches one segment, and ** matches any remaining segments.
    """
    include: [String!]! = [],
    """
    Skip patterns using the same matching rules as dagger check selectors.

    Exact prefixes match all descendants, * matches one segment, and ** matches any remaining segments.
    """
    skip: [String!]! = [],
    """
    Only run annotated check functions, skip generate-as-checks.
    """
    noGenerate: Boolean! = false,
    """
    Only run generate-as-checks, skip annotated check functions.
    """
    onlyGenerate: Boolean! = false,
    """
    Expand checks into separate matrix jobs.
    """
    expand: Boolean! = false,
    """
    Number of check path segments to group by in each expanded matrix entry.
    """
    groupLevel: Int,
    """
    Workspace directory relative to the workspace root (the repository root
    for git workspaces). Drives the workflow file name, the workflow display
    name, and the workdir of the generated check step, so multiple
    workspaces in one repository produce distinct workflows.

    Defaults to the directory of the selected workspace config file: empty
    for the root workspace, "helm" for a workspace at helm/dagger.toml.
    """
    workspace: String = null,
    """
    Dagger environment to use in the workflow, passed to the generated check
    command as --env. No environment is passed when omitted.
    """
    env: String,
    """
    Dagger version to use in the workflow. Detected from the workspace when omitted.
    """
    daggerVersion: String,
    """
    Dagger dev commit to use in the workflow instead of a version. Mutually exclusive with daggerVersion.
    """
    daggerCommit: String,
    """
    Pin the actions used in the workflow to the latest release version or its commit hash.
    """
    pin: ActionPin! = ActionPin.VERSION,
    """
    Maximum number of matrix checks running concurrently in the expanded
    workflow. No limit when omitted.
    """
    concurrency: Int,
  ) {
    if (noGenerate and onlyGenerate) {
      raise "noGenerate and onlyGenerate cannot both be true"
    }

    if (daggerVersion != null and daggerCommit != null) {
      raise "daggerVersion and daggerCommit cannot both be set"
    }

    if (concurrency != null and concurrency! < 1) {
      raise "concurrency must be at least 1"
    }

    self.include = include
    self.skip = skip
    self.noGenerate = noGenerate
    self.onlyGenerate = onlyGenerate
    self.expand = expand
    self.groupLevel = groupLevel
    self.workspace = workspace
    self.env = env
    self.daggerVersion = daggerVersion
    self.daggerCommit = daggerCommit
    self.pin = pin
    self.concurrency = concurrency

    self
  }

  """
  Check selectors included in the expanded GitHub Actions matrix.
  """
  checks(ws: Workspace!): [String!]! {
    self.resolveChecks(
      checkSelectors(ws, [], [], self.noGenerate, self.onlyGenerate),
      checkSelectors(ws, self.include, self.skip, self.noGenerate, self.onlyGenerate),
    )
  }

  """
  Resolve the final matrix selectors from explicit check name lists.

  allChecks is every check in the workspace, included is the subset selected by
  the include and skip filters. This is the pure core of checks, exposed so the
  grouping logic can be exercised without a workspace.
  """
  resolveChecks(allChecks: [String!]!, included: [String!]!): [String!]! {
    resolvedChecks(allChecks, included, self.include, self.groupLevel)
  }

  """
  Render the Dagger GitHub Actions workflow.

  The file name is derived from the workspace directory (dagger.yaml for the
  root workspace, dagger-<dir>.yaml for nested ones) so workspaces sharing a
  repository do not collide.

  When checks is provided, it is used verbatim as the expanded matrix instead
  of discovering checks from the workspace.
  """
  workflow(ws: Workspace!, checks: [String!] = null): File! {
    self.workflowConfig(ws, checks).file(workflowFileName(self.workspaceDir(ws)))
  }

  """
  Write the generated Dagger GitHub Actions workflow to the .github/workflows
  directory at the workspace root (the repository root), where GitHub picks
  it up even when the generating workspace is nested.

  When checks is provided, it is used verbatim as the expanded matrix instead
  of discovering checks from the workspace.
  """
  generate(ws: Workspace!, checks: [String!]): Changeset! @generate {
    let source = ws.directory("/", gitignore: true)
    let workflowFile = self.workflow(ws, checks)

    source.withFile(
      ".github/workflows/" + workflowFile.name,
      workflowFile,
    ).changes(source)
  }

  """
  Workspace directory relative to the workspace root: the workspace
  constructor argument when set, otherwise derived from the selected
  workspace config file. Empty for the root workspace.
  """
  let workspaceDir(ws: Workspace!): String! {
    self.workspace ?? configDir(ws.configFile)
  }

  let workflowConfig(ws: Workspace!, checks: [String!]): GhaWorkflow! {
    validateWorkflowOptions(expand, self.groupLevel, self.concurrency, self.noGenerate, self.onlyGenerate)

    if (checks != null and !expand) {
      raise "checks can only be provided when expand is true"
    }

    let workspaceDir = self.workspaceDir(ws)

    Dagger.gha.workflow(workflowTitle(workspaceDir))
      .onPush(branches: ["main"])
      .onPullRequest
      .withPermission("contents")
      .withJob(
        "check",
        if (expand) {
          self.expandedCheckJob(ws, checks, workspaceDir)
        } else {
          self.normalCheckJob(workspaceDir)
        },
      )
  }

  let normalCheckJob(workspaceDir: String!): GhaJob! {
    self.checkJob("Check", checkArgs(
      self.env,
      self.include,
      self.skip,
      self.noGenerate,
      self.onlyGenerate,
    ), workspaceDir)
  }

  let expandedCheckJob(ws: Workspace!, checks: [String!], workspaceDir: String!): GhaJob! {
    self.checkJob("${{ matrix.check }}", checkArgs(
      self.env,
      ["${{ matrix.check }}"],
      self.skip,
      self.noGenerate,
      self.onlyGenerate,
    ), workspaceDir)
      .withMatrix("check", checks ?? self.checks(ws))
      .withFailFast(false)
      .{
        let concurrency = self.concurrency

        if (concurrency != null) {
          _.withMaxParallel(concurrency!)
        } else _
      }
  }

  let checkJob(name: String!, args: String!, workdir: String!): GhaJob! {
    Dagger.gha.job
      .withName(name)
      .withStep(
        Dagger.gha.step("Checkout repository")
          .withUses("actions/checkout@" + actionRef("actions/checkout", self.pin)),
      )
      .withStep(self.daggerStep("Check", "check", args, workdir))
  }

  let daggerStep(name: String!, verb: String!, args: String!, workdir: String!): GhaStep! {
    Dagger.gha.step(name)
      .withUses("dagger/dagger-for-github@" + actionRef("dagger/dagger-for-github", self.pin))
      .withInput("verb", verb)
      .{
        if (workdir != "") {
          _.withInput("workdir", workdir)
        } else _
      }
      .{
        if (args != "") {
          _.withInput("args", args)
        } else _
      }
      .{
        let version = self.actionVersion

        if (version != null) {
          _.withInput("version", version!)
        } else _
      }
      .{
        let commit = self.actionCommit

        if (commit != null) {
          _.withInput("commit", commit!)
        } else _
      }
  }

  let resolvedDaggerVersion: String! {
    if (self.daggerVersion != null) {
      self.daggerVersion!
    } else {
      Dagger.version
    }
  }

  # Exactly one of the action's version and commit inputs is rendered: an
  # explicit daggerCommit is used verbatim, otherwise both derive from the
  # (explicit or detected) version: release tags pin the action version, dev
  # builds pin the commit.
  let actionVersion: String {
    if (self.daggerCommit != null) {
      null
    } else {
      daggerActionVersion(self.resolvedDaggerVersion)
    }
  }

  let actionCommit: String {
    if (self.daggerCommit != null) {
      self.daggerCommit
    } else {
      daggerActionCommit(self.resolvedDaggerVersion)
    }
  }
}

"""
Directory of the selected workspace config file relative to the workspace
root: "" for the root workspace (or when no config is selected, e.g. value
workspaces), "helm" for a workspace at helm/dagger.toml.
"""
let configDir(configFile: String!): String! {
  let segments = configFile.split("/")

  if (segments.length < 2) {
    return ""
  }

  segments.takeFirst(segments.length - 1).join("/")
}

let workflowFileName(workspaceDir: String!): String! {
  if (workspaceDir == "") {
    return "dagger.yaml"
  }

  "dagger-" + workspaceDir.split("/").join("-") + ".yaml"
}

let workflowTitle(workspaceDir: String!): String! {
  if (workspaceDir == "") {
    return "Dagger"
  }

  "Dagger (" + workspaceDir + ")"
}

let checkSelectors(
  ws: Workspace!,
  include: [String!]! = [],
  skip: [String!]! = [],
  noGenerate: Boolean! = false,
  onlyGenerate: Boolean! = false,
): [String!]! {
  let checks = (
    ws.checks(
      include: optionalStringList(include),
      skip: optionalStringList(skip),
      noGenerate: noGenerate,
      onlyGenerate: onlyGenerate,
    ).list
  ).{{name}}

  checks.map { _.name }
}

let optionalStringList(values: [String!]!): [String!] {
  if (values.isEmpty) {
    return null
  }

  values
}

let resolvedChecks(
  allChecks: [String!]!,
  included: [String!]!,
  include: [String!]!,
  groupLevel: Int,
): [String!]! {
  if (groupLevel == null or groupLevel! < 1) {
    return included
  }

  included
    .map { check => checkAtLevel(check, groupLevel!) }
    .uniq
    .reduce([]) { result, check =>
      let includePatterns = includePatternsForPrefix(include, check)

      result += if (!includePatterns.isEmpty) {
        includePatterns
      } else if (prefixIncludesUnselectedCheck(allChecks, included, check)) {
        included.filter { checkMatchesPrefix(_, check) }
      } else {
        [check]
      }
    }
    .uniq
}

let checkAtLevel(check: String!, level: Int!): String! {
  let segments = check.split(":")

  if (level >= segments.length) {
    return check
  }

  segments.takeFirst(level).join(":")
}

let includePatternsForPrefix(include: [String!]!, prefix: String!): [String!]! {
  include.filter { pattern => pattern == prefix or pattern.hasPrefix(prefix + ":") }
}

let prefixIncludesUnselectedCheck(
  checks: [String!]!,
  included: [String!]!,
  prefix: String!,
): Boolean! {
  checks.reduce(false) { found, check =>
    found or (checkMatchesPrefix(check, prefix) and !included.contains(check))
  }
}

let checkMatchesPrefix(check: String!, prefix: String!): Boolean! {
  check == prefix or check.hasPrefix(prefix + ":")
}

let validateWorkflowOptions(
  expand: Boolean!,
  groupLevel: Int,
  concurrency: Int,
  noGenerate: Boolean!,
  onlyGenerate: Boolean!,
): Void {
  validateCheckOptions(noGenerate, onlyGenerate)

  if (!expand and groupLevel != null) {
    raise "groupLevel can only be used when expand is true"
  }

  if (!expand and concurrency != null) {
    raise "concurrency can only be used when expand is true"
  }
}

let validateCheckOptions(noGenerate: Boolean!, onlyGenerate: Boolean!): Void {
  if (noGenerate and onlyGenerate) {
    raise "noGenerate and onlyGenerate cannot both be true"
  }
}

let checkArgs(
  env: String,
  patterns: [String!]!,
  skip: [String!]!,
  noGenerate: Boolean!,
  onlyGenerate: Boolean!,
): String! {
  let args = skip.reduce([]) { args, pattern => args + ["--skip", pattern] }

  if (noGenerate) {
    args += ["--no-generate"]
  }

  if (onlyGenerate) {
    args += ["--generate"]
  }

  if (env != null) {
    args = ["--env", env!] + args
  }

  (args + patterns).join(" ")
}

let daggerActionVersion(version: String!): String {
  if (isDaggerVersionTag(version)) {
    version
  } else {
    null
  }
}

let daggerActionCommit(version: String!): String {
  if (isDaggerVersionTag(version)) {
    null
  } else if (version.contains("-dev-")) {
    let parts = version.split("-dev-")

    parts[parts.length - 1]
  } else {
    version
  }
}

let isDaggerVersionTag(version: String!): Boolean! {
  version.hasPrefix("v") and !version.contains("-dev-")
}

let latestReleaseTag(repository: String!): String! {
  Dagger.github.release(repository: repository).tagName
}

"""
Reference for the latest release of an action: the release tag itself, or the
commit hash it points to.
"""
let actionRef(repository: String!, pin: ActionPin!): String! {
  let tag = latestReleaseTag(repository)

  if (pin == ActionPin.COMMIT) {
    Dagger.github.commit(tag, repository)
  } else {
    tag
  }
}
