type Tests {
  # Value workspaces (Directory.asWorkspace) cannot enumerate checks, so the
  # fixture workspace only backs workflow rendering and generate. The check
  # names below mirror the modules in fixtures/workspace and drive the pure
  # resolveChecks tests.
  let ws: Workspace! {
    Dagger
      .currentModule
      .source
      .directory("fixtures/workspace")
      .asWorkspace
  }

  let golden: Directory! {
    Dagger.currentModule.source.directory("fixtures/golden")
  }

  let allChecks: [String!]! = [
    "alpha:build",
    "alpha:fmt",
    "alpha:test:integration",
    "alpha:test:unit",
    "beta:lint",
  ]

  # Mirrors the [env.*] tables in fixtures/workspace/dagger.toml. Environments,
  # unlike checks, are readable on a value workspace, so allEnvs discovery is
  # exercised against these for real.
  let envs: [String!]! = ["ci", "nightly"]

  defaultWorkflow: Void @check {
    let contents = Dagger.daggerGha.workflow(ws).contents

    assert { contents.hasPrefix("# Code generated by Dagger. DO NOT EDIT.\n\n") }

    assertGolden(contents, golden.file("default.yaml").contents)

    let wf = decodeWorkflow(contents)

    assert { wf.name == "Dagger" }
    assert { wf.triggers.push.branches.join(",") == "main" }
    assert { wf.permissions.contents == "read" }
    assert { wf.jobs.check.name == "Check" }
    assert { wf.jobs.check.runsOn == "ubuntu-latest" }
    assert { wf.jobs.check.strategy == null }
    assert { wf.jobs.check.steps.length == 2 }

    # The steps are pinned to the latest release tag of each action.
    assert { wf.jobs.check.steps[0].uses.hasPrefix("actions/checkout@v") }
    assert { wf.jobs.check.steps[1].uses.hasPrefix("dagger/dagger-for-github@v") }

    let inputs = wf.jobs.check.steps[1].inputs!

    assert { inputs.verb == "check" }
    assert { inputs.args == null }
  }

  expandedWorkflow: Void @check {
    let contents = Dagger.daggerGha(expand: true).workflow(ws, allChecks).contents

    assertGolden(contents, golden.file("expanded.yaml").contents)

    let wf = decodeWorkflow(contents)

    assert { wf.jobs.check.name == "${{ matrix.check }}" }

    let strategy = wf.jobs.check.strategy!

    assert { strategy.failFast == false }
    assertList(strategy.matrix.check!, allChecks)
    assert { strategy.matrix.env == null }

    assert { wf.jobs.check.steps[1].inputs!.args == "${{ matrix.check }}" }
  }

  envMatrix: Void @check {
    # An explicit envs list expands the single check job into one run per
    # environment, without touching check selection.
    let contents = Dagger.daggerGha(envs: envs).workflow(ws).contents

    assertGolden(contents, golden.file("envs.yaml").contents)

    let wf = decodeWorkflow(contents)

    assert { wf.jobs.check.name == "Check (${{ matrix.env }})" }

    let strategy = wf.jobs.check.strategy!

    assert { strategy.failFast == false }
    assertList(strategy.matrix.env!, envs)
    assert { strategy.matrix.check == null }

    assertEqual(workflowArgs(contents), "--env ${{ matrix.env }}")

    # The env axis composes with the other check options, keeping the --env
    # flag in front of them.
    assertEqual(
      workflowArgs(Dagger.daggerGha(envs: envs, skip: ["alpha:fmt"], lock: DaggerGhaLockMode.PINNED).workflow(ws).contents),
      "--env ${{ matrix.env }} --lock pinned --skip alpha:fmt",
    )
  }

  envMatrixWithExpand: Void @check {
    # Both axes together render a check x environment cartesian product.
    let contents = Dagger.daggerGha(expand: true, envs: envs).workflow(ws, allChecks).contents

    assertGolden(contents, golden.file("envs-expanded.yaml").contents)

    let wf = decodeWorkflow(contents)

    assert { wf.jobs.check.name == "${{ matrix.env }} / ${{ matrix.check }}" }

    let strategy = wf.jobs.check.strategy!

    assertList(strategy.matrix.check!, allChecks)
    assertList(strategy.matrix.env!, envs)

    assertEqual(workflowArgs(contents), "--env ${{ matrix.env }} ${{ matrix.check }}")
  }

  envMatrixDiscovery: Void @check {
    # Unlike checks, environments are enumerable on a value workspace, so
    # allEnvs discovers the fixture's [env.*] tables for real.
    assertList(Dagger.daggerGha(allEnvs: true).matrixEnvs(ws), envs)

    assertList(
      decodeWorkflow(Dagger.daggerGha(allEnvs: true).workflow(ws).contents).jobs.check.strategy!.matrix.env!,
      envs,
    )

    # Without either option there is no env axis to discover.
    assert { Dagger.daggerGha.matrixEnvs(ws).isEmpty }
    assert { Dagger.daggerGha(env: "ci").matrixEnvs(ws).isEmpty }
    assert { decodeWorkflow(Dagger.daggerGha(env: "ci").workflow(ws).contents).jobs.check.strategy == null }

    # The envs argument overrides discovery, the way checks overrides check
    # discovery.
    assertList(
      decodeWorkflow(Dagger.daggerGha(allEnvs: true).workflow(ws, envs: ["staging"]).contents).jobs.check.strategy!.matrix.env!,
      ["staging"],
    )
  }

  envMatrixConcurrency: Void @check {
    # An env matrix is a matrix, so it can be limited without expand.
    let limited = decodeWorkflow(Dagger.daggerGha(envs: envs, concurrency: 1).workflow(ws).contents)

    assert { limited.jobs.check.strategy!.maxParallel == 1 }
  }

  invalidEnvOptions: Void @check {
    # env selects one environment, envs and allEnvs expand several: combining
    # them would silently drop one of the two.
    assert { raises { Dagger.daggerGha(env: "ci", envs: envs).workflow(ws).contents } }
    assert { raises { Dagger.daggerGha(env: "ci", allEnvs: true).workflow(ws).contents } }
    assert { raises { Dagger.daggerGha(envs: envs, allEnvs: true).workflow(ws).contents } }

    # The envs argument needs an env matrix to fill.
    assert { raises { Dagger.daggerGha.workflow(ws, envs: envs).contents } }
    assert { raises { Dagger.daggerGha(env: "ci").workflow(ws, envs: envs).contents } }

    # It is valid as soon as either option turns the axis on.
    assert { Dagger.daggerGha(envs: ["ci"]).workflow(ws, envs: envs).contents != "" }
    assert { Dagger.daggerGha(allEnvs: true).workflow(ws, envs: envs).contents != "" }
  }

  checkArguments: Void @check {
    assertEqual(workflowArgs(Dagger.daggerGha(include: ["alpha:**", "beta:lint"]).workflow(ws).contents), "alpha:** beta:lint")
    assertEqual(workflowArgs(Dagger.daggerGha(skip: ["alpha:fmt"]).workflow(ws).contents), "--skip alpha:fmt")
    assertEqual(workflowArgs(Dagger.daggerGha(noGenerate: true).workflow(ws).contents), "--no-generate")
    assertEqual(workflowArgs(Dagger.daggerGha(onlyGenerate: true).workflow(ws).contents), "--generate")
    assertEqual(workflowArgs(Dagger.daggerGha(env: "ci").workflow(ws).contents), "--env ci")
    # The env flag leads the other arguments.
    assertEqual(
      workflowArgs(Dagger.daggerGha(env: "ci", skip: ["alpha:fmt"]).workflow(ws).contents),
      "--env ci --skip alpha:fmt",
    )
    # The lock mode renders as its lowercase flag value, after env and before
    # the other arguments.
    assertEqual(workflowArgs(Dagger.daggerGha(lock: DaggerGhaLockMode.DISABLED).workflow(ws).contents), "--lock disabled")
    assertEqual(workflowArgs(Dagger.daggerGha(lock: DaggerGhaLockMode.LIVE).workflow(ws).contents), "--lock live")
    assertEqual(workflowArgs(Dagger.daggerGha(lock: DaggerGhaLockMode.PINNED).workflow(ws).contents), "--lock pinned")
    assertEqual(workflowArgs(Dagger.daggerGha(lock: DaggerGhaLockMode.FROZEN).workflow(ws).contents), "--lock frozen")
    assertEqual(
      workflowArgs(Dagger.daggerGha(env: "ci", lock: DaggerGhaLockMode.PINNED, skip: ["alpha:fmt"]).workflow(ws).contents),
      "--env ci --lock pinned --skip alpha:fmt",
    )
    assertEqual(
      workflowArgs(Dagger.daggerGha(include: ["alpha:**"], skip: ["beta:**"], noGenerate: true).workflow(ws).contents),
      "--skip beta:** --no-generate alpha:**",
    )
    # Expanded workflows select checks per matrix entry, but keep the skip
    # patterns and generate flags on the command line.
    assertEqual(
      workflowArgs(Dagger.daggerGha(skip: ["alpha:fmt"], onlyGenerate: true, expand: true).workflow(ws).contents),
      "--skip alpha:fmt --generate ${{ matrix.check }}",
    )
  }

  daggerVersionOverride: Void @check {
    # Release tags pin the action version, dev builds and bare refs pin the
    # commit, mirroring the detection applied to the engine version.
    let release = stepInputs(Dagger.daggerGha(daggerVersion: "v1.2.3").workflow(ws).contents)

    assert { release.version == "v1.2.3" }
    assert { release.commit == null }

    let dev = stepInputs(Dagger.daggerGha(daggerVersion: "v1.0.0-dev-abc123def").workflow(ws).contents)

    assert { dev.version == null }
    assert { dev.commit == "abc123def" }

    let ref = stepInputs(Dagger.daggerGha(daggerVersion: "0123abc").workflow(ws).contents)

    assert { ref.version == null }
    assert { ref.commit == "0123abc" }
  }

  daggerCommitOverride: Void @check {
    # An explicit daggerCommit pins the action's commit input verbatim.
    let inputs = stepInputs(Dagger.daggerGha(daggerCommit: "abc123def").workflow(ws).contents)

    assert { inputs.version == null }
    assert { inputs.commit == "abc123def" }

    # daggerVersion and daggerCommit are mutually exclusive.
    assert { raises { Dagger.daggerGha(daggerVersion: "v1.2.3", daggerCommit: "abc123def").workflow(ws).contents } }
  }

  concurrency: Void @check {
    # By default there is no limit, so no max-parallel is rendered.
    let unlimited = decodeWorkflow(Dagger.daggerGha(expand: true).workflow(ws, allChecks).contents)

    assert { unlimited.jobs.check.strategy!.maxParallel == null }

    let limited = decodeWorkflow(Dagger.daggerGha(expand: true, concurrency: 2).workflow(ws, allChecks).contents)

    assert { limited.jobs.check.strategy!.maxParallel == 2 }

    # The limit applies to a matrix, so it requires an axis to limit.
    assert { raises { Dagger.daggerGha(concurrency: 2).workflow(ws).contents } }

    assert { raises { Dagger.daggerGha(expand: true, concurrency: 0).workflow(ws, allChecks).contents } }
  }

  actionPin: Void @check {
    # Commit pinning replaces each action's release tag with the commit hash
    # the tag points to.
    let wf = decodeWorkflow(Dagger.daggerGha(pin: DaggerGhaActionPin.COMMIT).workflow(ws).contents)

    assert { wf.jobs.check.steps[0].uses.containsMatch(`^actions/checkout@[0-9a-f]{40}$`) }
    assert { wf.jobs.check.steps[1].uses.containsMatch(`^dagger/dagger-for-github@[0-9a-f]{40}$`) }
  }

  engineRef: Void @check {
    let inputs = stepInputs(Dagger.daggerGha.workflow(ws).contents)

    # Without an explicit daggerVersion, exactly one of version and commit is
    # rendered, derived from the engine version: release tags pin the action
    # version, dev builds pin the commit.
    if (Dagger.version.hasPrefix("v") and !Dagger.version.contains("-dev-")) {
      assert { inputs.version == Dagger.version }
      assert { inputs.commit == null }
    } else {
      assert { inputs.version == null }
      assert { inputs.commit != null }

      if (Dagger.version.contains("-dev-")) {
        let parts = Dagger.version.split("-dev-")

        assert { inputs.commit == parts[parts.length - 1] }
      } else {
        assert { inputs.commit == Dagger.version }
      }
    }
  }

  generateChangeset: Void @check {
    let changes = Dagger.daggerGha.generate(ws)

    # addedPaths lists the created parent directories too, keep the files only.
    let addedFiles = changes.addedPaths.filter { path => !path.hasSuffix("/") }

    assertEqual(addedFiles.join(","), ".github/workflows/dagger.yaml")
    assert { changes.after.file(".github/workflows/dagger.yaml").contents == Dagger.daggerGha.workflow(ws).contents }
  }

  workspaceNaming: Void @check {
    # Value workspaces report no config file, so the workspace constructor
    # arg stands in for the config-file-derived directory here. Nested
    # workspaces get unique workflow file and display names, and their check
    # step runs from the workspace directory via workdir.
    let file = Dagger.daggerGha(workspace: "helm").workflow(ws)

    assertEqual(file.name, "dagger-helm.yaml")
    assertEqual(decodeWorkflow(file.contents).name, "Dagger (helm)")
    assertEqual(stepInputs(file.contents).workdir ?? "", "helm")
    assertEqual(workflowArgs(file.contents), "")

    # Deeper nesting joins path segments with dashes in the file name.
    let deep = Dagger.daggerGha(workspace: "foo/bar").workflow(ws)

    assertEqual(deep.name, "dagger-foo-bar.yaml")
    assertEqual(decodeWorkflow(deep.contents).name, "Dagger (foo/bar)")
    assertEqual(stepInputs(deep.contents).workdir ?? "", "foo/bar")

    # The workspace only sets the workdir, the check arguments stay untouched.
    let nested = Dagger.daggerGha(workspace: "helm", skip: ["fmt"], noGenerate: true).workflow(ws).contents

    assertEqual(stepInputs(nested).workdir ?? "", "helm")
    assertEqual(workflowArgs(nested), "--skip fmt --no-generate")

    # An empty workspace matches the root default and renders no workdir.
    let root = Dagger.daggerGha(workspace: "").workflow(ws)

    assertEqual(root.name, "dagger.yaml")
    assert { stepInputs(root.contents).workdir == null }
  }

  workspaceGenerate: Void @check {
    # Nested workspaces write their workflow to the root .github/workflows,
    # not one nested inside the workspace directory.
    let changes = Dagger.daggerGha(workspace: "helm").generate(ws)
    let addedFiles = changes.addedPaths.filter { path => !path.hasSuffix("/") }

    assertEqual(addedFiles.join(","), ".github/workflows/dagger-helm.yaml")
  }

  groupingDisabled: Void @check {
    # Without a group level the included checks pass through untouched, and
    # levels below 1 are treated the same as unset.
    assertList(Dagger.daggerGha.resolveChecks(allChecks, allChecks), allChecks)
    assertList(Dagger.daggerGha(groupLevel: 0).resolveChecks(allChecks, allChecks), allChecks)
    assertList(Dagger.daggerGha(groupLevel: -1).resolveChecks(allChecks, allChecks), allChecks)

    # A group level deeper than any check name changes nothing either.
    assertList(Dagger.daggerGha(groupLevel: 5).resolveChecks(allChecks, allChecks), allChecks)
  }

  groupingCollapsesFullPrefixes: Void @check {
    # Fully included prefixes collapse into one selector per group.
    assertList(
      Dagger.daggerGha(groupLevel: 1).resolveChecks(allChecks, allChecks),
      ["alpha", "beta"],
    )
    assertList(
      Dagger.daggerGha(groupLevel: 2).resolveChecks(allChecks, allChecks),
      ["alpha:build", "alpha:fmt", "alpha:test", "beta:lint"],
    )

    # Groups keep the order in which their first check appears.
    assertList(
      Dagger.daggerGha(groupLevel: 1).resolveChecks(
        allChecks,
        ["beta:lint", "alpha:build", "alpha:fmt", "alpha:test:integration", "alpha:test:unit"],
      ),
      ["beta", "alpha"],
    )

    # Checks shorter than the group level stay untouched next to collapsed ones.
    let mixedDepth = ["alpha:build", "alpha:fmt", "solo"]

    assertList(
      Dagger.daggerGha(groupLevel: 1).resolveChecks(mixedDepth, mixedDepth),
      ["alpha", "solo"],
    )

    # Grouping applies at any depth, not just module level.
    let deep = ["alpha:test:unit:fast", "alpha:test:unit:slow", "alpha:test:integration:api"]

    assertList(
      Dagger.daggerGha(groupLevel: 3).resolveChecks(deep, deep),
      ["alpha:test:unit", "alpha:test:integration"],
    )
  }

  groupingKeepsPartialPrefixesExpanded: Void @check {
    # A partially included prefix cannot collapse: its selector would also run
    # the excluded checks, so the included ones stay listed individually.
    let withoutFmt = allChecks.filter { _ != "alpha:fmt" }

    assertList(
      Dagger.daggerGha(groupLevel: 1).resolveChecks(allChecks, withoutFmt),
      ["alpha:build", "alpha:test:integration", "alpha:test:unit", "beta"],
    )

    # The same holds for deeper groups: only the partial prefix stays expanded.
    let withoutUnit = allChecks.filter { _ != "alpha:test:unit" }

    assertList(
      Dagger.daggerGha(groupLevel: 2).resolveChecks(allChecks, withoutUnit),
      ["alpha:build", "alpha:fmt", "alpha:test:integration", "beta:lint"],
    )

    # Nothing included, nothing resolved.
    assertList(Dagger.daggerGha(groupLevel: 1).resolveChecks(allChecks, []), [])
  }

  groupingHonorsIncludePatterns: Void @check {
    # Include patterns below a grouped prefix survive as-is instead of being
    # widened to the whole group.
    assertList(
      Dagger.daggerGha(include: ["alpha:test:**"], groupLevel: 1).resolveChecks(
        allChecks,
        ["alpha:test:integration", "alpha:test:unit"],
      ),
      ["alpha:test:**"],
    )

    # An include pattern equal to the grouped prefix is kept verbatim.
    assertList(
      Dagger.daggerGha(include: ["alpha"], groupLevel: 1).resolveChecks(
        allChecks,
        ["alpha:build", "alpha:fmt", "alpha:test:integration", "alpha:test:unit"],
      ),
      ["alpha"],
    )

    # So is a glob covering the whole prefix.
    assertList(
      Dagger.daggerGha(include: ["alpha:**"], groupLevel: 1).resolveChecks(
        allChecks,
        ["alpha:build", "alpha:fmt", "alpha:test:integration", "alpha:test:unit"],
      ),
      ["alpha:**"],
    )

    # Multiple patterns under one prefix are all kept, in include order.
    assertList(
      Dagger.daggerGha(include: ["alpha:test:unit", "alpha:build"], groupLevel: 1).resolveChecks(
        allChecks,
        ["alpha:build", "alpha:test:unit"],
      ),
      ["alpha:test:unit", "alpha:build"],
    )

    # Prefixes without an include pattern still collapse independently.
    assertList(
      Dagger.daggerGha(include: ["alpha:test:**"], groupLevel: 1).resolveChecks(
        allChecks,
        ["alpha:test:integration", "alpha:test:unit", "beta:lint"],
      ),
      ["alpha:test:**", "beta"],
    )
  }

  groupedWorkflow: Void @check {
    # Composition: grouped selectors flow into the expanded matrix.
    let grouped = Dagger.daggerGha(expand: true, groupLevel: 1)
    let contents = grouped.workflow(ws, grouped.resolveChecks(allChecks, allChecks)).contents

    assertList(decodeWorkflow(contents).jobs.check.strategy!.matrix.check!, ["alpha", "beta"])
  }

  emptyWorkspaceChecks: Void @check {
    # Canary for the engine limitation described on the ws field: discovery
    # finds no checks on a value workspace, so an expanded workflow without an
    # explicit check list renders an empty matrix. If this ever fails, the
    # engine learned to enumerate checks on value workspaces and the expanded
    # tests can switch to real discovery.
    assert { Dagger.daggerGha.checks(ws).isEmpty }

    let wf = decodeWorkflow(Dagger.daggerGha(expand: true).workflow(ws).contents)

    assert { wf.jobs.check.strategy!.matrix.check!.isEmpty }
  }

  invalidOptions: Void @check {
    assert { raises { Dagger.daggerGha(noGenerate: true, onlyGenerate: true).workflow(ws).contents } }
    assert { raises { Dagger.daggerGha(groupLevel: 1).workflow(ws).contents } }
    assert { raises { Dagger.daggerGha.workflow(ws, allChecks).contents } }

    # groupLevel is valid once expand is set.
    assert { Dagger.daggerGha(expand: true, groupLevel: 1).workflow(ws).contents != "" }
  }

  # Temporary helpers to (re)generate the golden files:
  #   dagger -m dagger-gha/tests call golden-default export --path dagger-gha/tests/fixtures/golden/default.yaml
  goldenDefault: File! {
    Dagger.file("default.yaml", stripVolatileRefs(Dagger.daggerGha.workflow(ws).contents))
  }

  goldenExpanded: File! {
    Dagger.file("expanded.yaml", stripVolatileRefs(Dagger.daggerGha(expand: true).workflow(ws, allChecks).contents))
  }

  goldenEnvs: File! {
    Dagger.file("envs.yaml", stripVolatileRefs(Dagger.daggerGha(envs: envs).workflow(ws).contents))
  }

  goldenEnvsExpanded: File! {
    Dagger.file(
      "envs-expanded.yaml",
      stripVolatileRefs(Dagger.daggerGha(expand: true, envs: envs).workflow(ws, allChecks).contents),
    )
  }
}

"""
Whether rendering the workflow in the block fails, which is how the module
rejects an invalid option combination.
"""
let raises(&body: String!): Boolean! {
  try {
    # Comparing the block's value forces it; only whether producing it raised
    # matters, so the comparison is discarded.
    body == "" and false
  } catch {
    err => true
  }
}

let workflowArgs(contents: String!): String! {
  stepInputs(contents).args ?? ""
}

let stepInputs(contents: String!): TestStepInputs! {
  decodeWorkflow(contents).jobs.check.steps[1].inputs!
}

let decodeWorkflow(contents: String!): TestWorkflow! {
  YAML.decode(contents) :: TestWorkflow!
}

"""
Drop the volatile lines so the golden file stays stable: version/commit derive
from the engine build (release engines render a version line, dev engines a
commit line, and the two sort differently in the encoded output), and the uses
pins track the latest release of each action.
"""
let stripVolatileRefs(contents: String!): String! {
  contents
    .split("\n")
    .filter { line =>
      !line.contains("version: ") and !line.contains("commit: ") and !line.contains("uses: ")
    }
    .join("\n")
}

let assertGolden(actual: String!, expected: String!): Void {
  let normalized = stripVolatileRefs(actual)

  if (normalized != expected) {
    raise "generated workflow does not match golden file\n--- expected ---\n" + expected + "\n--- actual (volatile refs stripped) ---\n" + normalized
  }
}

let assertEqual(actual: String!, expected: String!): Void {
  if (actual != expected) {
    raise "expected \"" + expected + "\", got \"" + actual + "\""
  }
}

let assertList(actual: [String!]!, expected: [String!]!): Void {
  assertEqual(actual.join(", "), expected.join(", "))
}

# Mirrors of the workflow document shape rendered by the dagger-gha module. Kept
# independent from the module's own types on purpose: decoding through these
# asserts the on-disk YAML field names, not just that encoding round-trips.
type TestWorkflow {
  name: String!
  triggers: TestTriggers! @YAML.field(name: "on")
  permissions: TestPermissions!
  jobs: TestJobs!
}

type TestTriggers {
  push: TestPush!
  pullRequest: TestPullRequest! @YAML.field(name: "pull_request")
}

type TestPush {
  branches: [String!]!
}

type TestPullRequest {
}

type TestPermissions {
  contents: String!
}

type TestJobs {
  check: TestJob!
}

type TestJob {
  name: String!
  runsOn: String! @YAML.field(name: "runs-on")
  strategy: TestStrategy
  steps: [TestStep!]!
}

type TestStrategy {
  failFast: Boolean! @YAML.field(name: "fail-fast")
  maxParallel: Int @YAML.field(name: "max-parallel")
  matrix: TestMatrix!
}

# Both axes are optional: a workflow renders only the ones it expands.
type TestMatrix {
  check: [String!]
  env: [String!]
}

type TestStep {
  name: String!
  uses: String!
  inputs: TestStepInputs @YAML.field(name: "with")
}

type TestStepInputs {
  verb: String!
  workdir: String
  args: String
  version: String
  commit: String
}
