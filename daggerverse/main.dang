let GENERATED_NOTICE = "# Code generated by the daggerverse module. DO NOT EDIT.\n\n"

"""
How the actions used in the workflow are pinned.
"""
enum ActionPin {
  VERSION
  COMMIT
}

type Daggerverse {
  let exclude: [String!]!
  let prefix: String!
  let workflowName: String!
  let daggerVersion: String
  let daggerCommit: String
  let pin: ActionPin!
  let concurrency: Int

  new(
    """
    Module names excluded from the generated workflow.
    """
    exclude: [String!]! = [],
    """
    Prefix prepended to the generated workflow file names (ci.yaml and dispatch.yaml).
    """
    prefix: String! = "",
    """
    Name of the generated workflow.
    """
    workflowName: String! = "Daggerverse",
    """
    Dagger version to use in the workflow. Detected from the workspace when omitted.
    """
    daggerVersion: String,
    """
    Dagger dev commit to use in the workflow instead of a version. Mutually exclusive with daggerVersion.
    """
    daggerCommit: String,
    """
    Pin the actions used in the workflow to the latest release version or its commit hash.
    """
    pin: ActionPin! = ActionPin.VERSION,
    """
    Maximum number of module checks running concurrently in the CI workflow. No limit when omitted.
    """
    concurrency: Int,
  ) {
    validatePrefix(prefix)

    if (daggerVersion != null and daggerCommit != null) {
      raise "daggerVersion and daggerCommit cannot both be set"
    }

    if (concurrency != null and concurrency! < 1) {
      raise "concurrency must be at least 1"
    }

    self.exclude = exclude
    self.prefix = prefix
    self.workflowName = workflowName
    self.daggerVersion = daggerVersion
    self.daggerCommit = daggerCommit
    self.pin = pin
    self.concurrency = concurrency

    self
  }

  """
  Modules (first-level directories containing a dagger-module.toml file) with a tests module.
  """
  modules(ws: Workspace!): [String!]! {
    let exclude = self.exclude
    let source = ws.directory("/", gitignore: true)

    let moduleNames = source.glob("*/dagger-module.toml").map { _.split("/")[0]! }
    let testModuleNames = source.glob("*/tests/dagger-module.toml").map { _.split("/")[0]! }

    moduleNames.filter { module =>
      testModuleNames.contains(module) and !exclude.contains(module)
    }
  }

  """
  Render the Daggerverse GitHub Actions workflow.
  """
  workflow(ws: Workspace!): File! {
    Dagger.file(self.ciFileName, GENERATED_NOTICE + YAML.encode(self.workflowConfig(ws)) + "\n")
  }

  """
  Render the Daggerverse dispatch GitHub Actions workflow, checking a
  manually selected module.
  """
  dispatchWorkflow(ws: Workspace!): File! {
    Dagger.file(self.dispatchFileName, GENERATED_NOTICE + YAML.encode(self.dispatchWorkflowConfig(ws)) + "\n")
  }

  """
  Write the generated Daggerverse GitHub Actions workflows.
  """
  generate(ws: Workspace!): Changeset! @generate {
    let source = ws.directory("/", gitignore: true)

    source
      .withFile(".github/workflows/" + self.ciFileName, self.workflow(ws))
      .withFile(".github/workflows/" + self.dispatchFileName, self.dispatchWorkflow(ws))
      .changes(source)
  }

  let ciFileName: String! {
    self.prefix + "ci.yaml"
  }

  let dispatchFileName: String! {
    self.prefix + "dispatch.yaml"
  }

  let workflowConfig(ws: Workspace!): Workflow! {
    Workflow(
      name: self.workflowName,
      triggers: WorkflowTriggers(
        push: Push(branches: ["main"]),
        pullRequest: PullRequest,
      ),
      permissions: Permissions(contents: "read"),
      jobs: WorkflowJobs(
        check: self.checkJob(ws),
      ),
    )
  }

  let dispatchWorkflowConfig(ws: Workspace!): DispatchWorkflow! {
    DispatchWorkflow(
      name: self.workflowName + " Dispatch",
      triggers: DispatchTriggers(
        workflowDispatch: WorkflowDispatch(
          inputs: DispatchInputs(
            module: ModuleInput(
              description: "Module to check",
              required: true,
              inputType: "choice",
              options: self.modules(ws),
            ),
          ),
        ),
      ),
      permissions: Permissions(contents: "read"),
      jobs: WorkflowJobs(
        check: self.dispatchCheckJob,
      ),
    )
  }

  let dispatchCheckJob: CheckJob! {
    CheckJob(
      name: "${{ inputs.module }}",
      runsOn: "ubuntu-latest",
      strategy: null,
      steps: [
        checkoutStep(self.pin),
        daggerStep(
          "Check",
          self.pin,
          daggerActionInputs("check", "${{ inputs.module }}/tests", self.actionVersion, self.actionCommit),
        ),
      ],
    )
  }

  let resolvedDaggerVersion: String! {
    if (self.daggerVersion != null) {
      self.daggerVersion!
    } else {
      Dagger.version
    }
  }

  # Exactly one of the action's version and commit inputs is rendered: an
  # explicit daggerCommit is used verbatim, otherwise both derive from the
  # (explicit or detected) version.
  let actionVersion: String {
    if (self.daggerCommit != null) {
      null
    } else {
      daggerActionVersion(self.resolvedDaggerVersion)
    }
  }

  let actionCommit: String {
    if (self.daggerCommit != null) {
      self.daggerCommit
    } else {
      daggerActionCommit(self.resolvedDaggerVersion)
    }
  }

  let checkJob(ws: Workspace!): CheckJob! {
    CheckJob(
      name: "${{ matrix.module }}",
      runsOn: "ubuntu-latest",
      strategy: Strategy(
        failFast: false,
        maxParallel: self.concurrency,
        matrix: Matrix(
          module: self.modules(ws),
        ),
      ),
      steps: [
        checkoutStep(self.pin),
        daggerStep(
          "Check",
          self.pin,
          daggerActionInputs("check", "${{ matrix.module }}/tests", self.actionVersion, self.actionCommit),
        ),
      ],
    )
  }
}

let validatePrefix(prefix: String!): Void {
  if (prefix.contains("/") or prefix.contains("\\")) {
    raise "prefix must be a file name prefix, not a path"
  }
}

let daggerActionInputs(verb: String!, module: String!, version: String, commit: String): DaggerActionInputs! {
  DaggerActionInputs(
    verb: verb,
    module: module,
    version: version,
    commit: commit,
  )
}

let daggerActionVersion(version: String!): String {
  if (isDaggerVersionTag(version)) {
    version
  } else {
    null
  }
}

let daggerActionCommit(version: String!): String {
  if (isDaggerVersionTag(version)) {
    null
  } else if (version.contains("-dev-")) {
    let parts = version.split("-dev-")

    parts[parts.length - 1]
  } else {
    version
  }
}

let isDaggerVersionTag(version: String!): Boolean! {
  version.hasPrefix("v") and !version.contains("-dev-")
}

let latestReleaseTag(repository: String!): String! {
  Dagger.github.release(repository: repository).tagName
}

"""
Reference for the latest release of an action: the release tag itself, or the
commit hash it points to.
"""
let actionRef(repository: String!, pin: ActionPin!): String! {
  let tag = latestReleaseTag(repository)

  if (pin == ActionPin.COMMIT) {
    Dagger.github.commit(tag, repository)
  } else {
    tag
  }
}

let checkoutStep(pin: ActionPin!): Step! {
  Step(
    name: "Checkout repository",
    uses: "actions/checkout@" + actionRef("actions/checkout", pin),
    inputs: null,
  )
}

let daggerStep(name: String!, pin: ActionPin!, inputs: DaggerActionInputs!): Step! {
  Step(
    name: name,
    uses: "dagger/dagger-for-github@" + actionRef("dagger/dagger-for-github", pin),
    inputs: inputs,
  )
}

type Workflow {
  name: String!
  triggers: WorkflowTriggers! @YAML.field(name: "on")
  permissions: Permissions!
  jobs: WorkflowJobs!
}

type WorkflowTriggers {
  push: Push!
  pullRequest: PullRequest! @YAML.field(name: "pull_request")
}

type Push {
  branches: [String!]!
}

type PullRequest {
}

type Permissions {
  contents: String!
}

type WorkflowJobs {
  check: CheckJob!
}

type DispatchWorkflow {
  name: String!
  triggers: DispatchTriggers! @YAML.field(name: "on")
  permissions: Permissions!
  jobs: WorkflowJobs!
}

type DispatchTriggers {
  workflowDispatch: WorkflowDispatch! @YAML.field(name: "workflow_dispatch")
}

type WorkflowDispatch {
  inputs: DispatchInputs!
}

type DispatchInputs {
  module: ModuleInput!
}

type ModuleInput {
  description: String!
  required: Boolean!
  inputType: String! @YAML.field(name: "type")
  options: [String!]!
}

type CheckJob {
  name: String!
  runsOn: String! @YAML.field(name: "runs-on")
  strategy: Strategy @YAML.field(omitEmpty: true)
  steps: [Step!]!
}

type Strategy {
  failFast: Boolean! @YAML.field(name: "fail-fast")
  maxParallel: Int @YAML.field(name: "max-parallel", omitEmpty: true)
  matrix: Matrix!
}

type Matrix {
  module: [String!]!
}

type Step {
  name: String!
  uses: String!
  inputs: DaggerActionInputs @YAML.field(name: "with", omitEmpty: true)
}

type DaggerActionInputs {
  verb: String!
  module: String!
  version: String @YAML.field(omitEmpty: true)
  commit: String @YAML.field(omitEmpty: true)
}
