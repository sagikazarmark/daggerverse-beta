type Tests {
  # The fixture workspace covers every discovery case: alpha and beta are
  # modules with a tests module, gamma has no tests directory, delta has a
  # tests module but no module file at its root, and epsilon's tests
  # directory is not a module itself.
  let ws: Workspace! {
    Dagger
      .currentModule
      .source
      .directory("fixtures/workspace")
      .asWorkspace
  }

  let golden: Directory! {
    Dagger.currentModule.source.directory("fixtures/golden")
  }

  modules: Void @check {
    assertList(Dagger.daggerverse.modules(ws), ["alpha", "beta"])
  }

  excludedModules: Void @check {
    assertList(Dagger.daggerverse(exclude: ["alpha"]).modules(ws), ["beta"])
    assertList(Dagger.daggerverse(exclude: ["alpha", "beta"]).modules(ws), [])

    # Unknown names are ignored.
    assertList(Dagger.daggerverse(exclude: ["unknown"]).modules(ws), ["alpha", "beta"])
  }

  defaultWorkflow: Void @check {
    let contents = Dagger.daggerverse.workflow(ws).contents

    assert { contents.hasPrefix("# Code generated by the daggerverse module. DO NOT EDIT.\n\n") }

    assertGolden(contents, golden.file("default.yaml").contents)

    let wf = decodeWorkflow(contents)

    assert { wf.name == "Daggerverse" }
    assert { wf.triggers.push.branches.join(",") == "main" }
    assert { wf.permissions.contents == "read" }
    assert { wf.jobs.check.name == "${{ matrix.module }}" }
    assert { wf.jobs.check.runsOn == "ubuntu-latest" }
    assert { wf.jobs.check.strategy!.failFast == false }
    assertList(wf.jobs.check.strategy!.matrix.module, ["alpha", "beta"])
    assert { wf.jobs.check.steps.length == 2 }

    # The steps are pinned to the latest release tag of each action.
    assert { wf.jobs.check.steps[0].uses.hasPrefix("actions/checkout@v") }
    assert { wf.jobs.check.steps[1].uses.hasPrefix("dagger/dagger-for-github@v") }

    let inputs = wf.jobs.check.steps[1].inputs!

    assert { inputs.verb == "check" }
    assert { inputs.module == "${{ matrix.module }}/tests" }
  }

  excludedWorkflow: Void @check {
    let excluded = Dagger.daggerverse(exclude: ["beta"])

    assertList(decodeWorkflow(excluded.workflow(ws).contents).jobs.check.strategy!.matrix.module, ["alpha"])
    assertList(
      decodeDispatchWorkflow(excluded.dispatchWorkflow(ws).contents).triggers.workflowDispatch.inputs.module.options,
      ["alpha"],
    )
  }

  dispatchWorkflow: Void @check {
    let contents = Dagger.daggerverse.dispatchWorkflow(ws).contents

    assert { contents.hasPrefix("# Code generated by the daggerverse module. DO NOT EDIT.\n\n") }

    assertGolden(contents, golden.file("dispatch.yaml").contents)

    let wf = decodeDispatchWorkflow(contents)

    assert { wf.name == "Daggerverse Dispatch" }
    assert { wf.permissions.contents == "read" }

    let input = wf.triggers.workflowDispatch.inputs.module

    assert { input.description == "Module to check" }
    assert { input.required == true }
    assert { input.inputType == "choice" }
    assertList(input.options, ["alpha", "beta"])

    assert { wf.jobs.check.name == "${{ inputs.module }}" }
    assert { wf.jobs.check.runsOn == "ubuntu-latest" }

    # The dispatch job checks a single selected module, so there is no matrix.
    assert { wf.jobs.check.strategy == null }

    assert { wf.jobs.check.steps.length == 2 }
    assert { wf.jobs.check.steps[0].uses.hasPrefix("actions/checkout@v") }
    assert { wf.jobs.check.steps[1].uses.hasPrefix("dagger/dagger-for-github@v") }

    let inputs = wf.jobs.check.steps[1].inputs!

    assert { inputs.verb == "check" }
    assert { inputs.module == "${{ inputs.module }}/tests" }
  }

  workflowName: Void @check {
    let contents = Dagger.daggerverse(workflowName: "Custom Modules").workflow(ws).contents

    assert { decodeWorkflow(contents).name == "Custom Modules" }
  }

  fileNames: Void @check {
    assertEqual(Dagger.daggerverse.workflow(ws).name, "ci.yaml")
    assertEqual(Dagger.daggerverse.dispatchWorkflow(ws).name, "dispatch.yaml")

    # The prefix is prepended verbatim to both file names.
    assertEqual(Dagger.daggerverse(prefix: "dagger-").workflow(ws).name, "dagger-ci.yaml")
    assertEqual(Dagger.daggerverse(prefix: "dagger-").dispatchWorkflow(ws).name, "dagger-dispatch.yaml")
  }

  prefixValidation: Void @check {
    assertInvalidPrefix(ws, "nested/")
    assertInvalidPrefix(ws, "nested\\")
  }

  daggerVersionOverride: Void @check {
    # Release tags pin the action version, dev builds and bare refs pin the
    # commit, mirroring the detection applied to the engine version.
    let release = stepInputs(Dagger.daggerverse(daggerVersion: "v1.2.3").workflow(ws).contents)

    assert { release.version == "v1.2.3" }
    assert { release.commit == null }

    let dev = stepInputs(Dagger.daggerverse(daggerVersion: "v1.0.0-dev-abc123def").workflow(ws).contents)

    assert { dev.version == null }
    assert { dev.commit == "abc123def" }

    let ref = stepInputs(Dagger.daggerverse(daggerVersion: "0123abc").workflow(ws).contents)

    assert { ref.version == null }
    assert { ref.commit == "0123abc" }
  }

  daggerCommitOverride: Void @check {
    # An explicit daggerCommit pins the action's commit input verbatim, in
    # both workflows.
    let matrix = stepInputs(Dagger.daggerverse(daggerCommit: "abc123def").workflow(ws).contents)

    assert { matrix.version == null }
    assert { matrix.commit == "abc123def" }

    let dispatch = decodeDispatchWorkflow(
      Dagger.daggerverse(daggerCommit: "abc123def").dispatchWorkflow(ws).contents,
    ).jobs.check.steps[1].inputs!

    assert { dispatch.version == null }
    assert { dispatch.commit == "abc123def" }

    # daggerVersion and daggerCommit are mutually exclusive.
    let failed = try {
      Dagger.daggerverse(daggerVersion: "v1.2.3", daggerCommit: "abc123def").workflow(ws).contents

      false
    } catch {
      err => true
    }

    assert { failed }
  }

  concurrency: Void @check {
    # By default there is no limit, so no max-parallel is rendered.
    assert { decodeWorkflow(Dagger.daggerverse.workflow(ws).contents).jobs.check.strategy!.maxParallel == null }

    let limited = decodeWorkflow(Dagger.daggerverse(concurrency: 2).workflow(ws).contents)

    assert { limited.jobs.check.strategy!.maxParallel == 2 }

    let invalid = try {
      Dagger.daggerverse(concurrency: 0).workflow(ws).contents

      false
    } catch {
      err => true
    }

    assert { invalid }
  }

  actionPin: Void @check {
    # Commit pinning replaces each action's release tag with the commit hash
    # the tag points to, in both workflows.
    let commitPinned = Dagger.daggerverse(pin: DaggerverseActionPin.COMMIT)

    let wf = decodeWorkflow(commitPinned.workflow(ws).contents)

    assert { wf.jobs.check.steps[0].uses.containsMatch(`^actions/checkout@[0-9a-f]{40}$`) }
    assert { wf.jobs.check.steps[1].uses.containsMatch(`^dagger/dagger-for-github@[0-9a-f]{40}$`) }

    let dispatch = decodeDispatchWorkflow(commitPinned.dispatchWorkflow(ws).contents)

    assert { dispatch.jobs.check.steps[0].uses.containsMatch(`^actions/checkout@[0-9a-f]{40}$`) }
    assert { dispatch.jobs.check.steps[1].uses.containsMatch(`^dagger/dagger-for-github@[0-9a-f]{40}$`) }
  }

  engineRef: Void @check {
    let inputs = stepInputs(Dagger.daggerverse.workflow(ws).contents)

    # Without an explicit daggerVersion, exactly one of version and commit is
    # rendered, derived from the engine version.
    if (Dagger.version.hasPrefix("v") and !Dagger.version.contains("-dev-")) {
      assert { inputs.version == Dagger.version }
      assert { inputs.commit == null }
    } else {
      assert { inputs.version == null }
      assert { inputs.commit != null }

      if (Dagger.version.contains("-dev-")) {
        let parts = Dagger.version.split("-dev-")

        assert { inputs.commit == parts[parts.length - 1] }
      } else {
        assert { inputs.commit == Dagger.version }
      }
    }
  }

  generateChangeset: Void @check {
    let changes = Dagger.daggerverse.generate(ws)

    # addedPaths lists the created parent directories too, keep the files only.
    let addedFiles = changes.addedPaths.filter { path => !path.hasSuffix("/") }

    assertEqual(addedFiles.join(","), ".github/workflows/ci.yaml,.github/workflows/dispatch.yaml")
    assert { changes.after.file(".github/workflows/ci.yaml").contents == Dagger.daggerverse.workflow(ws).contents }
    assert { changes.after.file(".github/workflows/dispatch.yaml").contents == Dagger.daggerverse.dispatchWorkflow(ws).contents }
  }

  generateCustomPrefix: Void @check {
    let changes = Dagger.daggerverse(prefix: "dagger-").generate(ws)

    let addedFiles = changes.addedPaths.filter { path => !path.hasSuffix("/") }

    assertEqual(addedFiles.join(","), ".github/workflows/dagger-ci.yaml,.github/workflows/dagger-dispatch.yaml")
  }

  # Temporary helpers to (re)generate the golden files:
  #   dagger -m daggerverse/tests call golden-default export --path daggerverse/tests/fixtures/golden/default.yaml
  #   dagger -m daggerverse/tests call golden-dispatch export --path daggerverse/tests/fixtures/golden/dispatch.yaml
  goldenDefault: File! {
    Dagger.file("default.yaml", stripVolatileRefs(Dagger.daggerverse.workflow(ws).contents))
  }

  goldenDispatch: File! {
    Dagger.file("dispatch.yaml", stripVolatileRefs(Dagger.daggerverse.dispatchWorkflow(ws).contents))
  }
}

let stepInputs(contents: String!): TestStepInputs! {
  decodeWorkflow(contents).jobs.check.steps[1].inputs!
}

let assertInvalidPrefix(ws: Workspace!, prefix: String!): Void {
  let failed = try {
    Dagger.daggerverse(prefix: prefix).workflow(ws).contents

    false
  } catch {
    err => true
  }

  if (!failed) {
    raise "expected prefix \"" + prefix + "\" to be rejected"
  }
}

let decodeWorkflow(contents: String!): TestWorkflow! {
  YAML.decode(contents) :: TestWorkflow!
}

let decodeDispatchWorkflow(contents: String!): TestDispatchWorkflow! {
  YAML.decode(contents) :: TestDispatchWorkflow!
}

"""
Drop the volatile lines so the golden file stays stable: version/commit derive
from the engine build (release engines render a version line, dev engines a
commit line, and the two sort differently in the encoded output), and the uses
pins track the latest release of each action.
"""
let stripVolatileRefs(contents: String!): String! {
  contents
    .split("\n")
    .filter { line =>
      !line.contains("version: ") and !line.contains("commit: ") and !line.contains("uses: ")
    }
    .join("\n")
}

let assertGolden(actual: String!, expected: String!): Void {
  let normalized = stripVolatileRefs(actual)

  if (normalized != expected) {
    raise "generated workflow does not match golden file\n--- expected ---\n" + expected + "\n--- actual (volatile refs stripped) ---\n" + normalized
  }
}

let assertEqual(actual: String!, expected: String!): Void {
  if (actual != expected) {
    raise "expected \"" + expected + "\", got \"" + actual + "\""
  }
}

let assertList(actual: [String!]!, expected: [String!]!): Void {
  assertEqual(actual.join(", "), expected.join(", "))
}

# Mirrors of the workflow document shape rendered by the daggerverse
# module. Kept independent from the module's own types on purpose: decoding
# through these asserts the on-disk YAML field names, not just that encoding
# round-trips.
type TestWorkflow {
  name: String!
  triggers: TestTriggers! @YAML.field(name: "on")
  permissions: TestPermissions!
  jobs: TestJobs!
}

type TestTriggers {
  push: TestPush!
  pullRequest: TestPullRequest! @YAML.field(name: "pull_request")
}

type TestPush {
  branches: [String!]!
}

type TestPullRequest {
}

type TestPermissions {
  contents: String!
}

type TestJobs {
  check: TestJob!
}

type TestDispatchWorkflow {
  name: String!
  triggers: TestDispatchTriggers! @YAML.field(name: "on")
  permissions: TestPermissions!
  jobs: TestJobs!
}

type TestDispatchTriggers {
  workflowDispatch: TestWorkflowDispatch! @YAML.field(name: "workflow_dispatch")
}

type TestWorkflowDispatch {
  inputs: TestDispatchInputs!
}

type TestDispatchInputs {
  module: TestModuleInput!
}

type TestModuleInput {
  description: String!
  required: Boolean!
  inputType: String! @YAML.field(name: "type")
  options: [String!]!
}

type TestJob {
  name: String!
  runsOn: String! @YAML.field(name: "runs-on")
  strategy: TestStrategy
  steps: [TestStep!]!
}

type TestStrategy {
  failFast: Boolean! @YAML.field(name: "fail-fast")
  maxParallel: Int @YAML.field(name: "max-parallel")
  matrix: TestMatrix!
}

type TestMatrix {
  module: [String!]!
}

type TestStep {
  name: String!
  uses: String!
  inputs: TestStepInputs @YAML.field(name: "with")
}

type TestStepInputs {
  verb: String!
  module: String!
  version: String
  commit: String
}
