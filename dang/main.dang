enum InstallType {
  FROM_SOURCE
  FROM_DIST
}

type Dang {
  let exclude: [String!]!

  """
  A container with the dang binary.
  """
  container: Container!

  let source: Directory

  new(
    """
    Exclude paths from formatting.
    """
    exclude: [String!]! = [],
    """
    Install type.
    """
    installType: InstallType! = InstallType.FROM_DIST,
    """
    Dang version.
    """
    version: String! = if (installType == InstallType.FROM_DIST) "latest" else "HEAD",
    """
    Custom container to use as the default container.
    """
    container: Container = if (installType == InstallType.FROM_DIST) Dagger.container.from("ghcr.io/sagikazarmark/dang:" + version),
    """
    Dang source (when installing from source).
    """
    source: Directory = if (installType == InstallType.FROM_SOURCE) Dagger.git("https://github.com/vito/dang.git").ref(version).tree(depth: 1),
  ) {
    if (installType == InstallType.FROM_SOURCE) {
      if (source == null) {
        raise "source is required when installing from source"
      }

      container = alpine.withFile(
        "/usr/local/bin/dang",
        build(source, alpine.platform),
        permissions: 755,
      )
    }

    if (container == null) {
      raise "container is required when installing from dist"
    }

    self.exclude = exclude
    self.container = container
    self.source = source

    self
  }

  """
  Run a Dang script or module.
  """
  run(
    ws: Workspace!,
    """
    Source directory to evaluate.
    """
    source: Directory! = ws.directory(
      "",
      gitignore: true,
      include: ["**/*.dang", "**/dang.toml"],
      exclude: self.exclude,
    ),
    """
    Paths to evaluate within the source directory.
    """
    path: String,
  ): Container {
    let args = ["dang"] + [if (path == null) "." else path]

    self
      .container
      .withWorkdir("/work")
      .withMountedDirectory(".", source)
      .withExec(args)
  }

  """
  Format dang files.
  """
  fmt(
    ws: Workspace!,
    """
    Paths to format (default: all dang files in the workspace).
    """
    paths: [String!]! = [],
  ): Changeset! @generate {
    let source = ws.directory(
      "/",
      gitignore: true,
      include: ["**/*.dang", "**/dang.toml"],
      exclude: self.exclude,
    )

    if (paths.isEmpty) {
      paths = source
        .glob("**/*.dang")
        .map { _.split("/").dropLast.join("/") }
        .uniq
    }

    self
      .container
      .withWorkdir("/work")
      .withMountedDirectory(".", source)
      .withExec(["dang", "fmt", "-w"] + paths)
      .directory("/work")
      .changes(source)
  }

  """
  Format dang files.
  """
  binary(
    """
    Platform to use for building the binary.
    """
    platform: Platform! = Dagger.defaultPlatform,
  ): File! {
    let source = self.source
    if (source == null) {
      raise "source is required for building a binary"
    }

    build(source, platform)
  }
}

"""
Builds the dang binary for the given platform.
"""
let build(source: Directory!, platform: Platform!): File! {
  Dagger
    .container
    .from("golang:1.26.4-trixie@sha256:bbf22ddccb3205344f2755ea8fa4fe39f7a8b2b77b9f7b764ec2aad31406f6fc")
    .withMountedCache("/go/pkg/mod", Dagger.cacheVolume("dang-dang-go-mod"))
    .withMountedCache("/root/.cache/go-build", Dagger.cacheVolume("dang-dang-go-build"))
    .{
      let segments = toString(platform).trim("\"").split("/", 3)
      let os = segments[0]
      let arch = segments[1]

      _.withEnvVariable("GOOS", os!).withEnvVariable("GOARCH", arch!)
    }
    .withEnvVariable("CGO_ENABLED", "0")
    .withWorkdir("/usr/local/src/dang")
    .withMountedDirectory(".", source)
    .withExec(["go", "build", "./cmd/dang"])
    .file("dang")
}
