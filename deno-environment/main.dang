type DenoEnvironment {
  let defaultContainer: Container!

  let cache: CacheVolume
  let buildEnv: BuildEnvironment!

  let install: Boolean!
  let locked: Boolean!

  new(
    """
    Version (image tag) to use from the official Deno image repository.
    """
    version: String! = "latest",
    """
    Custom container to use as the default container.
    """
    container: Container! = Dagger.container.from("denoland/deno:" + version),
    """
    Ignore paths included in the gitignore file.
    """
    gitignore: Boolean,
    """
    Include only artifacts that match the given pattern (e.g., ["app/", "deno.*"]).
    """
    include: [String!],
    """
    Exclude artifacts that match the given pattern (e.g., ["node_modules/", ".git*"]).
    """
    exclude: [String!],
    """
    Environment file to load into the container.
    """
    envFile: File,
    """
    Source date epoch to set in the container.
    """
    sourceDateEpoch: String,
    """
    Automatically install dependencies.
    """
    install: Boolean! = false,
    """
    Install dependencies from the lockfile without updating it.
    """
    locked: Boolean! = false,
    """
    Whether to disable automatically mounted cache volumes.
    Useful if you want to mount cache volumes manually or use a different cache volume strategy.
    """
    noCache: Boolean! = false,
    """
    Cache volume for Deno's dependency cache.
    """
    cache: CacheVolume = if (!noCache) { Dagger.cacheVolume("deno") } else null,
  ) {
    self.defaultContainer = container

    self.cache = cache
    self.buildEnv = Dagger.buildEnvironment(
      envFile: envFile,
      sourceDateEpoch: sourceDateEpoch,

      gitignore: gitignore,
      include: include,
      exclude: exclude,
    )

    self.install = install
    self.locked = locked

    self
  }

  """
  Configure this environment to install dependencies when a source-backed container is retrieved.
  """
  withInstall(
    """
    Install dependencies from the lockfile without updating it.
    """
    locked: Boolean! = false,
  ): DenoEnvironment! {
    self.install = true
    self.locked = locked

    self
  }

  """
  Returns a container with the configured Deno environment.
  """
  container(
    ws: Workspace,
    """
    Custom base container to use.
    """
    base: Container,
    """
    Ignore paths included in the gitignore file.
    """
    gitignore: Boolean,
    """
    Include only artifacts that match the given pattern (e.g., ["app/", "deno.*"]).
    """
    include: [String!],
    """
    Exclude artifacts that match the given pattern (e.g., ["node_modules/", ".git*"]).
    """
    exclude: [String!],
  ): Container! {
    (base ?? self.defaultContainer)
      .{ self.withCache(_) }
      .{ self.withDependencies(ws, _) }
      .{ self.buildEnv.container(ws, _, gitignore, include, exclude) }
  }

  let withCache(container: Container!): Container! {
    let cache = self.cache
    if (cache == null) {
      return container
    }

    container
      .{
        if (_.envVariable("DENO_DIR") == null) {
          _.withEnvVariable("DENO_DIR", "/usr/local/cache/deno")
        } else _
      }
      .withMountedCache("${DENO_DIR}", cache, expand: true)
  }

  let withDependencies(
    ws: Workspace,
    container: Container!,
  ): Container! {
    if (!self.install or ws == null) {
      return container
    }

    let root = findPackageRoot(ws)
    if (root == null) {
      return container
    }

    let source = ws.directory(
      "/",
      include: [
        "deno.json",
        "deno.jsonc",
        "deno.lock",
        "import_map.json",
        "import-map.json",
      ].map { Path.clean(Path.join([root, _])).trimPrefix("/") },
      gitignore: true,
    )

    container
      .withMountedDirectory("/work/src", source)
      .withWorkdir(Path.join(["/work/src", root]))
      .{
        let args = ["deno", "install"]
        if (self.locked) {
          args += ["--frozen"]
        }

        _.withExec(args)
      }
  }

  let findPackageRoot(workspace: Workspace!): String {
    [
      "deno.json",
      "deno.jsonc",
    ].each { name =>
      let file = workspace.findUp(name)
      if (file != null) {
        return Path.dir(file)
      }
    }

    null
  }

  """
  Run a Deno task in the source.
  """
  withRun(
    ws: Workspace!,
    """
    Deno task to run.
    """
    task: String!,
    """
    Arguments to pass to the task.
    """
    args: [String!]! = [],
  ): Container! {
    self.container(ws).withExec(["deno", "task", task] + args)
  }
}

interface Overlay implements BuildEnvironmentOverlay {
  apply(container: Container!): Container!
}
