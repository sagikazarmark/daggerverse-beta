let denoVersion: String! = "2.4.5"

let denoProject: Directory! {
  Dagger.currentModule.source.directory("testdata/basic")
}

let denoLockedProject: Directory! {
  Dagger.currentModule.source.directory("testdata/locked")
}

let envFile: File! {
  Dagger.currentModule.source.file("testdata/env/.env")
}

type Tests {
  container: Void @check {
    let container = Dagger
      .denoEnvironment(version: denoVersion)
      .container(ws: null)

    assert { container.envVariable("DENO_DIR") == "/deno-dir/" }
    assert { container.mounts.contains("/deno-dir") or container.mounts.contains("/deno-dir/") }
    assert { container.withExec(["deno", "--version"]).stdout.contains("deno " + denoVersion) }
  }

  unsetDenoDir: Void @check {
    let container = Dagger
      .denoEnvironment()
      .container(ws: null, base: Dagger.container)

    assert { container.envVariable("DENO_DIR") == "/usr/local/cache/deno" }
    assert { container.mounts.contains("/usr/local/cache/deno") or container.mounts.contains("/usr/local/cache/deno/") }
  }

  customDenoDir: Void @check {
    let container = Dagger
      .denoEnvironment(
        version: denoVersion,
        container: Dagger
          .container
          .from("denoland/deno:" + denoVersion)
          .withEnvVariable("DENO_DIR", "/custom/deno"),
      )
      .container(ws: null)

    assert { container.envVariable("DENO_DIR") == "/custom/deno" }
    assert { container.mounts.contains("/custom/deno") or container.mounts.contains("/custom/deno/") }
  }

  emptyDenoDir: Void @check {
    let container = Dagger
      .denoEnvironment(
        version: denoVersion,
        container: Dagger
          .container
          .from("denoland/deno:" + denoVersion)
          .withEnvVariable("DENO_DIR", ""),
      )
      .container(ws: null)

    assert { container.envVariable("DENO_DIR") == "/usr/local/cache/deno" }
    assert { container.mounts.contains("/usr/local/cache/deno") or container.mounts.contains("/usr/local/cache/deno/") }
  }

  noCache: Void @check {
    let container = Dagger
      .denoEnvironment(version: denoVersion, noCache: true)
      .container(ws: null)

    assert { !container.mounts.contains("/deno-dir") and !container.mounts.contains("/deno-dir/") }
    assert { !container.mounts.contains("/usr/local/cache/deno") and !container.mounts.contains("/usr/local/cache/deno/") }
  }

  envFileAndEpoch: Void @check {
    let container = Dagger
      .denoEnvironment(
        version: denoVersion,
        envFile: envFile,
        sourceDateEpoch: "1234567890",
      )
      .container(ws: null)

    assert { container.envVariable("DENO_ENV_TEST") == "from-env-file" }
    assert { container.envVariable("SOURCE_DATE_EPOCH") == "1234567890" }
  }

  withRun: Void @check {
    let output = Dagger
      .denoEnvironment(version: denoVersion, install: true)
      .withRun(denoProject.asWorkspace, "check")
      .stdout

    assert { output.contains("deno-ok") }
  }

  withRunNamedArgs: Void @check {
    let output = Dagger
      .denoEnvironment(version: denoVersion, install: true)
      .withRun(ws: denoProject.asWorkspace, task: "check")
      .stdout

    assert { output.contains("deno-ok") }
  }

  lockedWithRun: Void @check {
    let output = Dagger
      .denoEnvironment(version: denoVersion, install: true, locked: true)
      .withRun(ws: denoLockedProject.asWorkspace, task: "check")
      .stdout

    assert { output.contains("deno-ok") }
  }
}
