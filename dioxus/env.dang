type RustToolchain {
  let rust: Rust!

  new(
    version: String!,
    source: Directory,
    cwd: String!,
    targets: [String!]!,
    components: [String!]!,
    overlay: Overlay,
    envFile: File,
    sourceDateEpoch: String,
    cargoRegistryIndexCache: CacheVolume,
    cargoRegistryArchiveCache: CacheVolume,
    cargoGitDbCache: CacheVolume,
    cargoTargetCache: CacheVolume,
  ) {
    # TODO: extend overlay
    self.rust = Dagger.rust(
      version: version,
      container: container,
      source: source,
      cwd: cwd,
      targets: targets + ["wasm32-unknown-unknown"],
      components: components + ["rust-std"],
      overlay: overlay,
      envFile: envFile,
      sourceDateEpoch: sourceDateEpoch,
      cargoRegistryIndexCache: cargoRegistryIndexCache,
      cargoRegistryArchiveCache: cargoRegistryArchiveCache,
      cargoGitDbCache: cargoGitDbCache,
      cargoTargetCache: cargoTargetCache,
    )

    self
  }

  # let withSource(source: Directory!, cwd: String!, overlay: Overlay): RustToolchain! {
  #   self.rust = self.rust.withSource(source, cwd, overlay)

  #   self
  # }
}

type DioxusOverlay implements RustOverlay & Overlay {
  let dioxusVersion: String
  let wasmBindgenVersion: String
  let wasmPackVersion: String
  let binaryenVersion: String
  let esbuildVersion: String!
  let tailwindVersion: String

  let overlay: Overlay

  new(
    source: Directory,
    cwd: String!,
    dioxusVersion: String,
    wasmPackVersion: String,
    binaryenVersion: String,
    esbuildVersion: String!,
    tailwindVersion: String,
    overlay: Overlay,
  ) {
    let wasmBindgenVersion: String = null

    if (source != null) {
      dioxusVersion = dioxusVersion ?? packageVersion(source, cwd, "dioxus")
      wasmBindgenVersion = wasmBindgenVersion ?? packageVersion(source, cwd, "wasm-bindgen")
    }

    self.dioxusVersion = dioxusVersion
    self.wasmBindgenVersion = wasmBindgenVersion
    self.wasmPackVersion = wasmPackVersion
    self.binaryenVersion = binaryenVersion
    self.esbuildVersion = esbuildVersion
    self.tailwindVersion = tailwindVersion
    self.overlay = overlay

    self
  }

  apply(container: Container!): Container! {
    container
      .withEnvVariable("NO_DOWNLOADS", "1") # Prevent dioxus CLI from downloading tool dependencies
      .{ withDioxus(dioxusVersion).apply(_) }
      .{ withWasmBindgen(wasmBindgenVersion).apply(_) }
      .{ withWasmPack(wasmPackVersion).apply(_) }
      .{ withBinaryen(binaryenVersion).apply(_) }
      .{ withEsbuild(esbuildVersion).apply(_) }
      .{ withTailwind(tailwindVersion).apply(_) }
      .{ self.overlay.apply(_) ?? _ }
  }
}

let packageVersion(source: Directory!, cwd: String!, name: String!): String {
  let path = source.findUp("Cargo.lock", cwd)
  if (path == null) {
    return null
  }

  let package = Dagger.cargoLock(file: source.file(path)).findOne(name)

  if (package == null) {
    return null
  }

  package.version
}
