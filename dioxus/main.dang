type Dioxus {
  let rustEnv: RustEnvironment!
  let buildEnv: BuildEnvironment!

  let baseContainer: Container!
  let source: Directory
  let cwd: String!

  new(
    ws: Workspace,
    """
    Dioxus CLI version to use (default: auto-detect from Cargo.lock).
    """
    version: String,
    """
    wasm-bindgen CLI version to use (default: auto-detect from Cargo.lock).
    """
    wasmBindgenVersion: String,
    """
    Version of wasm-pack to use (default: latest).
    """
    wasmPackVersion: String,
    """
    Version of Binaryen to use (default: latest).
    """
    binaryenVersion: String,
    """
    Version of esbuild to use (default: latest).
    """
    esbuildVersion: String,
    """
    Version of Tailwind CSS to use.
    """
    tailwindVersion: String,
    """
    Version (image tag) to use from the official Rust image repository as a base container.
    """
    rustVersion: String! = "latest",
    """
    Custom container to use as a base container.
    """
    container: Container! = Dagger.container.from("rust:" + rustVersion),
    """
    Path to the source directory within the workspace.
    """
    path: String! = "/",
    """
    Ignore paths included in the gitignore file.
    """
    gitignore: Boolean,
    """
    Include only artifacts that match the given pattern (e.g., ["app/", "package.*"]).
    """
    include: [String!],
    """
    Exclude artifacts that match the given pattern (e.g., ["node_modules/", ".git*"]).
    """
    exclude: [String!],
    """
    Source directory. Defaults to the workspace directory at the given path.
    """
    source: Directory = { ws.directory(path, exclude, include, gitignore) },
    """
    Current working directory within the source.
    """
    cwd: String! = {
      Path.mustBeRelativeTo(ws.cwd ?? "/", Path.abs(path))
    },
    """
    Targets to install for cross-compilation.
    """
    targets: [String!]! = [],
    """
    Additional components to install.
    """
    components: [String!]! = [],
    """
    Overlay to apply to the base container.
    """
    overlay: Overlay,
    """
    Env file to load into the container.

    Relative paths are resolved from the working directory absolute paths are resolved from the root.
    """
    envFile: File,
    """
    Override the source date epoch for reproducible builds.

    If not set, the epoch is determined from the git log (if available).
    """
    sourceDateEpoch: String,
    """
    Whether to disable automatically mounted cache volumes.
    Useful if you want to mount cache volumes manually or use a different cache volume strategy.
    """
    noCache: Boolean! = false,
    """
    Cache volume for cargo registry index.
    """
    cargoRegistryIndexCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-registry-index")
    } else null,
    """
    Cache volume for cargo registry archive.
    """
    cargoRegistryArchiveCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-registry-cache")
    } else null,
    """
    Cache volume for cargo git db.
    """
    cargoGitDbCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-git-db")
    } else null,
    """
    Cache volume for cargo target.
    """
    cargoTargetCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-target")
    } else null,
  ) {
    self.rustEnv = Dagger.rustEnvironment(
      cargoRegistryIndexCache: cargoRegistryIndexCache,
      cargoRegistryArchiveCache: cargoRegistryArchiveCache,
      cargoGitDbCache: cargoGitDbCache,

      targets: ["wasm32-unknown-unknown"] + targets,
      components: ["rust-std"] + components,
      cargoTargetCache: cargoTargetCache,
    )

    self.buildEnv = Dagger.buildEnvironment(
      overlay: dioxusOverlay(
        source: source,
        cwd: cwd,
        dioxusVersion: version,
        wasmBindgenVersion: wasmBindgenVersion,
        wasmPackVersion: wasmPackVersion,
        binaryenVersion: binaryenVersion,
        esbuildVersion: esbuildVersion,
        tailwindVersion: tailwindVersion,
        overlay: overlay,
      ),
      envFile: envFile,
      sourceDateEpoch: sourceDateEpoch,
    )

    self.baseContainer = container
    self.source = source
    self.cwd = cwd

    self
  }

  """
  Container with the Rust and Dioxus toolchains installed.
  """
  container: Container! {
    self
      .baseContainer
      .{ self.rustEnv.applyWorkspace(self.source.asWorkspace(self.cwd), _) }
      .{ self.buildEnv.applySource(_, self.source, self.cwd) }
  }

  """
  Bundle the Dioxus app into a shippable object.
  """
  bundle(
    """
    Package types to bundle.
    """
    packageTypes: [PackageType!]! = [],
    """
    Enable fullstack mode.
    """
    fullstack: Boolean,
    """
    Pre-render all routes returned from the app's /static_routes endpoint.
    """
    ssg: Boolean! = false,
    """
    Use verbose output.
    """
    verbose: Boolean! = false,
    """
    Use trace output.
    """
    trace: Boolean! = false,
    """
    Output logs in JSON format.
    """
    jsonOutput: Boolean! = false,
    """
    Manually set the platform.
    """
    platform: Platform,
    """
    Which renderer to use? By default, this is usually inferred from the platform.
    """
    renderer: Renderer,
    """
    The bundle format to target for the build: supports web, macos, windows, linux, ios, android, and server.
    """
    bundle: Bundle,
    """
    Build in release mode.
    """
    release: Boolean! = false,
    """
    The package to build.
    """
    package: String,
    """
    Build a specific binary.
    """
    bin: String,
    """
    Build a specific example.
    """
    example: String,
    """
    Build the app with custom a profile.
    """
    profile: String,
    """
    List of features to activate.
    """
    features: [String!]! = [],
    """
    Don't include the default features in the build.
    """
    noDefaultFeatures: Boolean! = false,
    """
    Include all features in the build.
    """
    allFeatures: Boolean! = false,
    """
    Rustc platform triple.
    """
    target: String,
    """
    Extra arguments passed to cargo.

    To see a list of args, run cargo rustc --help.

    Note that dx sets many of these args directly from other args in this command.
    """
    cargoArgs: String,
    """
    Extra arguments passed to rustc. This can be used to customize the linker, or other flags.

    For example, specifying dx build --rustc-args "-Clink-arg=-Wl,-blah" will pass -Clink-arg=-Wl,-blah to the underlying cargo rustc command.
    """
    rustcArgs: String,
    """
    Skip collecting assets from dependencies.
    """
    skipAssets: Boolean! = false,
    """
    Inject scripts to load the wasm and js files for your Dioxus app if they are not already present.
    """
    injectLoadingScripts: Boolean,
    """
    Bundle split the wasm binary into multiple chunks based on #[wasm_split] annotations.
    """
    wasmSplit: Boolean! = false,
    """
    Generate debug symbols for the wasm binary.

    This will make the binary larger and take longer to compile, but will allow you to debug the wasm binary.
    """
    debugSymbols: Boolean,
    """
    Keep the name section in the wasm binary, useful for profiling and debugging.

    Unlike --debug-symbols which preserves DWARF debug info, the name section allows tools like console_error_panic_hook to print backtraces with human-readable function names without any browser extension.
    """
    keepNames: Boolean! = false,
    """
    The base path the build will fetch assets relative to. This will override the base path set in the dioxus config.
    """
    basePath: String,
    """
    Should dx attempt to codesign the app bundle?
    """
    codesign: Boolean,
    """
    The path to the Apple entitlements file to used to sign the resulting app bundle.

    On iOS, this is required for deploy to a device and some configurations in the simulator.
    """
    appleEntitlements: String,
    """
    The Apple team ID to use when signing the app bundle.

    Usually this is an email or name associated with your Apple Developer account, usually in the format Signing Name (GXTEAMID123). This is passed directly to the codesign tool.
    """
    appleTeamId: String,
    """
    The target for the client build, used for specifying which target the server should end up in when merging @client and @server targets together.
    """
    clientTarget: String,
    """
    Specify the arguments for the client build.
    """
    clientArgs: [String!]! = [],
    """
    Specify the arguments for the server build.
    """
    serverArgs: [String!]! = [],
  ): Directory! @check {
    let args = DioxusCommand.bundle(
      packageTypes: packageTypes,
      fullstack: fullstack,
      ssg: ssg,
      verbose: verbose,
      trace: trace,
      jsonOutput: jsonOutput,
      platform: platform,
      renderer: renderer,
      bundle: bundle,
      release: release,
      package: package,
      bin: bin,
      example: example,
      profile: profile,
      features: features,
      noDefaultFeatures: noDefaultFeatures,
      allFeatures: allFeatures,
      target: target,
      cargoArgs: cargoArgs,
      rustcArgs: rustcArgs,
      skipAssets: skipAssets,
      injectLoadingScripts: injectLoadingScripts,
      wasmSplit: wasmSplit,
      debugSymbols: debugSymbols,
      keepNames: keepNames,
      basePath: basePath,
      codesign: codesign,
      appleEntitlements: appleEntitlements,
      appleTeamId: appleTeamId,
      clientTarget: clientTarget,
      clientArgs: clientArgs,
      serverArgs: serverArgs,
    )

    self
      .container
      .withExec(args)
      .directory("/work/out")
  }

  """
  Build and serve the Dioxus app.
  """
  serve(
    """
    The port the server will run on.
    """
    port: Int! = 8080,
    """
    Enable fullstack mode.
    """
    fullstack: Boolean,
    """
    Pre-render all routes returned from the app's /static_routes endpoint.
    """
    ssg: Boolean! = false,
    """
    Use verbose output.
    """
    verbose: Boolean! = false,
    """
    Use trace output.
    """
    trace: Boolean! = false,
    """
    Output logs in JSON format.
    """
    jsonOutput: Boolean! = false,
    """
    Build in release mode.
    """
    release: Boolean! = false,
    """
    The package to build.
    """
    package: String,
    """
    Build a specific binary.
    """
    bin: String,
    """
    Build a specific example.
    """
    example: String,
    """
    Build the app with custom a profile.
    """
    profile: String,
    """
    List of features to activate.
    """
    features: [String!]! = [],
    """
    Don't include the default features in the build.
    """
    noDefaultFeatures: Boolean! = false,
    """
    Include all features in the build.
    """
    allFeatures: Boolean! = false,
    """
    Rustc platform triple.
    """
    target: String,
    """
    Extra arguments passed to cargo.

    To see a list of args, run cargo rustc --help. Note that dx sets many of these args directly from other args in this command.
    """
    cargoArgs: String,
    """
    Extra arguments passed to rustc. This can be used to customize the linker, or other flags.

    For example, specifying dx build --rustc-args "-Clink-arg=-Wl,-blah" will pass -Clink-arg=-Wl,-blah to the underlying cargo rustc command.
    """
    rustcArgs: String,
    """
    Skip collecting assets from dependencies.
    """
    skipAssets: Boolean! = false,
    """
    Inject scripts to load the wasm and js files for your Dioxus app if they are not already present.
    """
    injectLoadingScripts: Boolean,
    """
    Experimental: Bundle split the wasm binary into multiple chunks based on #[wasm_split] annotations.
    """
    wasmSplit: Boolean! = false,
    """
    Generate debug symbols for the wasm binary.

    This will make the binary larger and take longer to compile, but will allow you to debug the wasm binary.
    """
    debugSymbols: Boolean,
    """
    Keep the name section in the wasm binary, useful for profiling and debugging.

    Unlike --debug-symbols which preserves DWARF debug info, the name section allows tools like console_error_panic_hook to print backtraces with human-readable function names without any browser extension.
    """
    keepNames: Boolean! = false,
    """
    The base path the build will fetch assets relative to. This will override the base path set in the dioxus config.
    """
    basePath: String,
    """
    The target for the client build, used for specifying which target the server should end up in when merging @client and @server targets together.
    """
    clientTarget: String,
    """
    Specify the arguments for the client build.
    """
    clientArgs: [String!]! = [],
    """
    Specify the arguments for the server build.
    """
    serverArgs: [String!]! = [],
  ): Service! {
    let args = DioxusCommand.serve(
      port: port,
      fullstack: fullstack,
      ssg: ssg,
      verbose: verbose,
      trace: trace,
      jsonOutput: jsonOutput,
      release: release,
      package: package,
      bin: bin,
      example: example,
      profile: profile,
      features: features,
      noDefaultFeatures: noDefaultFeatures,
      allFeatures: allFeatures,
      target: target,
      cargoArgs: cargoArgs,
      rustcArgs: rustcArgs,
      skipAssets: skipAssets,
      injectLoadingScripts: injectLoadingScripts,
      wasmSplit: wasmSplit,
      debugSymbols: debugSymbols,
      keepNames: keepNames,
      basePath: basePath,
      clientTarget: clientTarget,
      clientArgs: clientArgs,
      serverArgs: serverArgs,
    )

    self
      .container
      .withExposedPort(port)
      .asService(args: args)
  }

  """
  Initializes a new Dioxus project with the given name.
  """
  init(
    """
    Name of the project to initialize.
    """
    name: String!,
    """
    Template directory to use for the project.

    Defaults to the official Dioxus template repository from GitHub.
    """
    template: Directory! = Dagger.git("https://github.com/DioxusLabs/dioxus-template.git").branch("v0.7").tree,
    """
    Subtemplate to use within the template directory.
    """
    subtemplate: String,
  ): Init! {
    Init(
      name: name,
      template: template,
      subtemplate: subtemplate,
      container: self.container,
    )
  }
}

type Init {
  let name: String!
  let template: Directory!
  let subtemplate: String
  let options: Map[String!]! = [:]

  let container: Container!

  """
  Set an option for the template initialization.
  """
  withOption(key: String!, value: String!): Init! {
    self.options = self.options.with(key, value)

    self
  }

  """
  Returns the directory of the initialized project.
  """
  directory: Directory! {
    let args = [
      "dx", "init",
      "--yes",
      "--name", self.name,
      "--template", "/work/template",
    ]

    let subtemplate = self.subtemplate
    if (subtemplate != null) {
      args += ["--subtemplate", subtemplate]
    }

    self.options.each { key, value => args += ["--option", `${key}=${value}`] }

    self
      .container
      .withEnvVariable("USER", "root") # This is needed for dx for some reason
      .withWorkdir("/work/out")
      .withMountedDirectory("/work/template", self.template)
      .withExec(args)
      .withExec(["cargo", "generate-lockfile"])
      .directory(".")
  }
}

type DioxusCommand {
  bundle(
    packageTypes: [PackageType!]! = [],
    fullstack: Boolean,
    ssg: Boolean! = false,
    verbose: Boolean! = false,
    trace: Boolean! = false,
    jsonOutput: Boolean! = false,
    platform: Platform,
    renderer: Renderer,
    bundle: Bundle,
    release: Boolean! = false,
    package: String,
    bin: String,
    example: String,
    profile: String,
    features: [String!]! = [],
    noDefaultFeatures: Boolean! = false,
    allFeatures: Boolean! = false,
    target: String,
    cargoArgs: String,
    rustcArgs: String,
    skipAssets: Boolean! = false,
    injectLoadingScripts: Boolean,
    wasmSplit: Boolean! = false,
    debugSymbols: Boolean,
    keepNames: Boolean! = false,
    basePath: String,
    codesign: Boolean,
    appleEntitlements: String,
    appleTeamId: String,
    clientTarget: String,
    clientArgs: [String!]! = [],
    serverArgs: [String!]! = [],
  ): [String!]! {
    let args = ["dx", "bundle", "--force-sequential", "true", "--out-dir", "/work/out"]

    args = packageTypes.reduce(args) { args, packageType =>
      args += ["--package-types", toString(packageType).trim("\"").toLower]
    }

    args += self.options(
      fullstack: fullstack,
      ssg: ssg,
      verbose: verbose,
      trace: trace,
      jsonOutput: jsonOutput,
    )

    if (platform != null) { args += ["--platform", toString(platform).trim("\"").toLower] }
    if (renderer != null) { args += ["--renderer", toString(renderer).trim("\"").toLower] }
    if (bundle != null) { args += ["--bundle", toString(bundle).trim("\"").toLower] }

    args += self.targetOptions(
      release: release,
      package: package,
      bin: bin,
      example: example,
      profile: profile,
      features: features,
      noDefaultFeatures: noDefaultFeatures,
      allFeatures: allFeatures,
      target: target,
      cargoArgs: cargoArgs,
      rustcArgs: rustcArgs,
      skipAssets: skipAssets,
      injectLoadingScripts: injectLoadingScripts,
      wasmSplit: wasmSplit,
      debugSymbols: debugSymbols,
      keepNames: keepNames,
      basePath: basePath,
      clientTarget: clientTarget,
    )

    if (codesign != null) { args += ["--codesign", toString(codesign)] }
    if (appleEntitlements != null and appleEntitlements != "") { args += ["--apple-entitlements", appleEntitlements] }
    if (appleTeamId != null and appleTeamId != "") { args += ["--apple-team-id", appleTeamId] }

    args += self.buildCommands(clientArgs, serverArgs)

    args
  }

  serve(
    port: Int! = 8080,
    fullstack: Boolean,
    ssg: Boolean! = false,
    verbose: Boolean! = false,
    trace: Boolean! = false,
    jsonOutput: Boolean! = false,
    release: Boolean! = false,
    package: String,
    bin: String,
    example: String,
    profile: String,
    features: [String!]! = [],
    noDefaultFeatures: Boolean! = false,
    allFeatures: Boolean! = false,
    target: String,
    cargoArgs: String,
    rustcArgs: String,
    skipAssets: Boolean! = false,
    injectLoadingScripts: Boolean,
    wasmSplit: Boolean! = false,
    debugSymbols: Boolean,
    keepNames: Boolean! = false,
    basePath: String,
    clientTarget: String,
    clientArgs: [String!]! = [],
    serverArgs: [String!]! = [],
  ): [String!]! {
    let args = ["dx", "serve", "--addr", "0.0.0.0", "--port", toString(port), "--web"]

    args += self.options(
      fullstack: fullstack,
      ssg: ssg,
      verbose: verbose,
      trace: trace,
      jsonOutput: jsonOutput,
    )
    args += self.targetOptions(
      release: release,
      package: package,
      bin: bin,
      example: example,
      profile: profile,
      features: features,
      noDefaultFeatures: noDefaultFeatures,
      allFeatures: allFeatures,
      target: target,
      cargoArgs: cargoArgs,
      rustcArgs: rustcArgs,
      skipAssets: skipAssets,
      injectLoadingScripts: injectLoadingScripts,
      wasmSplit: wasmSplit,
      debugSymbols: debugSymbols,
      keepNames: keepNames,
      basePath: basePath,
      clientTarget: clientTarget,
    )
    args += self.buildCommands(clientArgs, serverArgs)

    args
  }

  options(
    fullstack: Boolean,
    ssg: Boolean! = false,
    verbose: Boolean! = false,
    trace: Boolean! = false,
    jsonOutput: Boolean! = false,
  ): [String!]! {
    let args = []

    if (fullstack != null) { args += ["--fullstack", toString(fullstack)] }
    if (ssg) { args += ["--ssg"] }
    if (verbose) { args += ["--verbose"] }
    if (trace) { args += ["--trace"] }
    if (jsonOutput) { args += ["--json-output"] }

    args
  }

  targetOptions(
    release: Boolean! = false,
    package: String,
    bin: String,
    example: String,
    profile: String,
    features: [String!]! = [],
    noDefaultFeatures: Boolean! = false,
    allFeatures: Boolean! = false,
    target: String,
    cargoArgs: String,
    rustcArgs: String,
    skipAssets: Boolean! = false,
    injectLoadingScripts: Boolean,
    wasmSplit: Boolean! = false,
    debugSymbols: Boolean,
    keepNames: Boolean! = false,
    basePath: String,
    clientTarget: String,
  ): [String!]! {
    let args = []

    if (release) { args += ["--release"] }
    if (package != null and package != "") { args += ["--package", package] }
    if (bin != null and bin != "") { args += ["--bin", bin] }
    if (example != null and example != "") { args += ["--example", example] }
    if (profile != null and profile != "") { args += ["--profile", profile] }

    features.each { feature => args += ["--features", feature] }

    if (noDefaultFeatures) { args += ["--no-default-features"] }
    if (allFeatures) { args += ["--all-features"] }
    if (target != null and target != "") { args += ["--target", target] }
    if (cargoArgs != null and cargoArgs != "") { args += ["--cargo-args", cargoArgs] }
    if (rustcArgs != null and rustcArgs != "") { args += ["--rustc-args", rustcArgs] }
    if (skipAssets) { args += ["--skip-assets"] }
    if (injectLoadingScripts != null) { args += ["--inject-loading-scripts", toString(injectLoadingScripts)] }
    if (wasmSplit) { args += ["--wasm-split"] }
    if (debugSymbols != null) { args += ["--debug-symbols", toString(debugSymbols)] }
    if (keepNames) { args += ["--keep-names"] }
    if (basePath != null and basePath != "") { args += ["--base-path", basePath] }
    if (clientTarget != null and clientTarget != "") { args += ["--client-target", clientTarget] }

    args
  }

  buildCommands(
    clientArgs: [String!]! = [],
    serverArgs: [String!]! = [],
  ): [String!]! {
    let args = []

    if (!clientArgs.isEmpty) { args += ["@client"] + clientArgs }
    if (!serverArgs.isEmpty) { args += ["@server"] + serverArgs }

    args
  }
}

enum PackageType {
  MACOS
  IOS
  IPA
  MSI
  NSIS
  DEB
  RPM
  APPIMAGE
  DMG
  UPDATER
  APK
  AAB
}

enum Platform {
  WEB
  DESKTOP
  MACOS
  WINDOWS
  LINUX
  IOS
  ANDROID
  SERVER
  LIVEVIEW
}

enum Renderer {
  WEBVIEW
  NATIVE
  SERVER
  LIVEVIEW
  WEB
}

enum Bundle {
  WEB
  MACOS
  WINDOWS
  LINUX
  IOS
  ANDROID
  SERVER
}
