type Dioxus {
  let rust: Rust!

  new(
    ws: Workspace,
    """
    Dioxus CLI version to use (default: auto-detect from Cargo.lock).
    """
    version: String,
    """
    Version (image tag) to use from the official Rust image repository as a base container.
    """
    rustVersion: String! = "latest",
    """
    Custom container to use as a base container.
    """
    container: Container! = Dagger.container.from("rust:" + rustVersion),
    """
    Version of wasm-pack to use (default: latest).
    """
    wasmPackVersion: String,
    """
    Version of Binaryen to use (default: latest).
    """
    binaryenVersion: String,
    """
    Version of esbuild to use.
    """
    esbuildVersion: String! = "0.28.0",
    """
    Version of Tailwind CSS to use.
    """
    tailwindVersion: String,
    """
    Path to the source directory within the workspace.
    """
    path: String! = "/",
    """
    Ignore paths included in the gitignore file.
    """
    gitignore: Boolean = true,
    """
    Include only artifacts that match the given pattern (e.g., ["app/", "package.*"]).
    """
    include: [String!],
    """
    Exclude artifacts that match the given pattern (e.g., ["node_modules/", ".git*"]).
    """
    exclude: [String!],
    """
    Source directory. Defaults to the workspace directory at the given path.
    """
    source: Directory = { ws.directory(path, exclude, include, gitignore) },
    """
    Current working directory within the source.
    """
    cwd: String! = {
      Path.mustBeRelativeTo(ws.cwd ?? "/", "/" + path.trimPrefix("/"))
    },
    """
    Targets to install for cross-compilation.
    """
    targets: [String!]! = [],
    """
    Additional components to install.
    """
    components: [String!]! = [],
    """
    Overlay to apply to the base container.
    """
    overlay: Overlay,
    """
    Env file to load into the container.

    Relative paths are resolved from the working directory absolute paths are resolved from the root.
    """
    envFile: File,
    """
    Override the source date epoch for reproducible builds.

    If not set, the epoch is determined from the git log (if available).
    """
    sourceDateEpoch: String,
    """
    Whether to disable automatically mounted cache volumes.
    Useful if you want to mount cache volumes manually or use a different cache volume strategy.
    """
    noCache: Boolean! = false,
    """
    Cache volume for cargo registry index.
    """
    cargoRegistryIndexCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-registry-index")
    } else {
      null
    },
    """
    Cache volume for cargo registry archive.
    """
    cargoRegistryArchiveCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-registry-cache")
    } else {
      null
    },
    """
    Cache volume for cargo git db.
    """
    cargoGitDbCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-git-db")
    } else {
      null
    },
    """
    Cache volume for cargo target.
    """
    cargoTargetCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-target")
    } else {
      null
    },
  ) {
    self.rust = Dagger.rust(
      version: version,
      container: container,
      source: source,
      cwd: cwd,
      targets: targets + ["wasm32-unknown-unknown"],
      components: components + ["rust-std"],
      overlay: dioxusOverlay(
        source: source,
        cwd: cwd,
        dioxusVersion: version,
        wasmPackVersion: wasmPackVersion,
        binaryenVersion: binaryenVersion,
        esbuildVersion: esbuildVersion,
        tailwindVersion: tailwindVersion,
        overlay: overlay,
      ),
      envFile: envFile,
      sourceDateEpoch: sourceDateEpoch,
      cargoRegistryIndexCache: cargoRegistryIndexCache,
      cargoRegistryArchiveCache: cargoRegistryArchiveCache,
      cargoGitDbCache: cargoGitDbCache,
      cargoTargetCache: cargoTargetCache,
    )

    self
  }

  """
  Container with the Rust and Dioxus toolchains installed.
  """
  container: Container! {
    self.rust.container
  }

  """
  Initializes a new Dioxus project with the given name.
  """
  init(
    """
    Name of the project to initialize.
    """
    name: String!,
    """
    Template directory to use for the project.

    Defaults to the official Dioxus template repository from GitHub.
    """
    template: Directory! = Dagger.git("https://github.com/DioxusLabs/dioxus-template.git").branch("v0.7").tree,
    """
    Subtemplate to use within the template directory.
    """
    subtemplate: String,
  ): Init! {
    Init(
      name: name,
      template: template,
      subtemplate: subtemplate,
      container: self.container,
    )
  }
}

type Init {
  let name: String!
  let template: Directory!
  let subtemplate: String
  let options: Map[String!]! = [:]

  let container: Container!

  """
  Set an option for the template initialization.
  """
  withOption(key: String!, value: String!): Init! {
    self.options = self.options.with(key, value)

    self
  }

  """
  Returns the directory of the initialized project.
  """
  directory: Directory! {
    let args = [
      "dx", "init",
      "--yes",
      "--name", self.name,
      "--template", "/work/template",
    ]

    let subtemplate = self.subtemplate
    if (subtemplate != null) {
      args += ["--subtemplate", subtemplate]
    }

    self.options.each { key, value => args += ["--option", `${key}=${value}`] }

    self
      .container
      .withEnvVariable("USER", "root") # This is needed for dx for some reason
      .withWorkdir("/work/out")
      .withMountedDirectory("/work/template", self.template)
      .withExec(args)
      .withExec(["cargo", "generate-lockfile"])
      .directory(".")
  }
}
