interface Overlay implements OverlaysOverlay {
  apply(container: Container!): Container!
}

let moduleOverlay(
  source: Directory,
  cwd: String!,
  dioxusVersion: String,
  wasmBindgenVersion: String,
  wasmPackVersion: String,
  binaryenVersion: String,
  esbuildVersion: String,
  tailwindVersion: String,
  overlay: Overlay,
): OverlaysList! {
  if (source != null) {
    dioxusVersion = dioxusVersion ?? packageVersion(source, cwd, "dioxus")
    wasmBindgenVersion = wasmBindgenVersion ?? packageVersion(source, cwd, "wasm-bindgen")
  }

  Dagger.overlays.combine([
    Dagger.overlays.withEnvVariable("NO_DOWNLOADS", "1"), # Prevent dioxus CLI from downloading tool dependencies
    withDioxus(dioxusVersion),
    Dagger
      .wasmTools
      .withTool(WasmToolsTool.WASM_BINDGEN, wasmBindgenVersion)
      .withTool(WasmToolsTool.WASM_PACK, wasmPackVersion)
      .withTool(WasmToolsTool.BINARYEN, binaryenVersion)
      .withTool(WasmToolsTool.ESBUILD, esbuildVersion),

    withTailwind(tailwindVersion),
    overlay,
  ])
}

let packageVersion(source: Directory!, cwd: String!, name: String!): String {
  let path = source.findUp("Cargo.lock", cwd)
  if (path == null) {
    return null
  }

  let package = Dagger.cargoLock(file: source.file(path)).findOne(name)

  if (package == null) {
    return null
  }

  package.version
}

let withDioxus(version: String): OverlaysOverlay! {
  if (version != null and version != "") {
    version = "v" + version.trimPrefix("v")
  }

  let binary = Dagger
    .github
    .release(version, "DioxusLabs/dioxus")
    .asset(`dx-${arch}-unknown-linux-gnu.tar.gz`)
    .extracted
    .file("dx")!

  Dagger.overlays.withFile(path: "/usr/local/bin/", source: binary)
}

let withTailwind(version: String): OverlaysOverlay! {
  let binary = Dagger
    .github
    .release(version, "tailwindlabs/tailwindcss")
    .{ _.asset(`tailwindcss-linux-${esbuildArch}`) }
    .file!
    .withName("tailwindcss")

  Dagger.overlays.withFile(path: "/usr/local/bin/", source: binary, permissions: 755)
}
