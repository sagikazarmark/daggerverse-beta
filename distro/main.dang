type Distro {
  """
  Install packages in a container.
  """
  packages(
    """
    Packages to install on Alpine distros.
    """
    apk: [String!]! = [],
    """
    Packages to install on Debian distros.
    """
    apt: [String!]! = [],
    """
    Run package manager updates before installing packages.
    """
    update: Boolean! = true,
    """
    Mount the package manager cache volume before installing packages.
    """
    cache: Boolean! = true,
  ): Packages! {
    Packages(apk: apk, apt: apt, update: update, cache: cache)
  }

  """
  Detect the kind of distro.
  """
  kind(container: Container!): Kind! {
    detectKind(container)
  }
}

type Packages implements OverlaysOverlay {
  """
  Packages to install on Alpine distros.
  """
  apk: [String!]! = []

  """
  Packages to install on Debian distros.
  """
  apt: [String!]! = []

  """
  Run package manager updates before installing packages.
  """
  update: Boolean! = true

  """
  Mount the package manager cache volume before installing packages.
  """
  cache: Boolean! = true

  """
  Install the packages in the container.
  """
  install(container: Container!): Container! {
    self.apply(container)
  }

  apply(container: Container!): Container! {
    case (detectKind(container)) {
      Kind.ALPINE => {
        if (self.apk.isEmpty) {
          return container
        }

        if (self.cache and !container.mounts.contains("/var/cache/apk")) {
          container = container.withMountedCache(
            "/var/cache/apk",
            Dagger.cacheVolume("alpine-apk"),
          )
        }

        if (self.update) {
          container = container.withExec(["apk", "update"])
        }

        container.withExec(["apk", "add"] + self.apk)
      }

      Kind.DEBIAN => {
        if (self.apt.isEmpty) {
          return container
        }

        if (self.cache and !container.mounts.contains("/var/cache/apt/archives")) {
          container = container.withMountedCache(
            "/var/cache/apt/archives",
            Dagger.cacheVolume("debian-apt-archives"),
          )
        }

        container = container.withEnvVariable("DEBIAN_FRONTEND", "noninteractive")

        if (self.update) {
          container = container.withExec(["apt-get", "update"])
        }

        container.withExec(["apt-get", "install", "-y", "--no-install-recommends"] + self.apt)
      }

      else => raise "unsupported distro"
    }
  }
}

let detectKind(container: Container!): Kind! {
  if (container.exists("/etc/alpine-release", expectedType: ExistsType.REGULAR_TYPE)) {
    Kind.ALPINE
  } else if (container.exists("/etc/debian_version", expectedType: ExistsType.REGULAR_TYPE)) {
    Kind.DEBIAN
  } else {
    Kind.UNKNOWN
  }
}

enum Kind {
  ALPINE
  DEBIAN
  UNKNOWN
}
