let GENERATED_NOTICE = "# Code generated by dpm. DO NOT EDIT.\n\n"

type Dpm {
  """
  Bundled packages available to install from dpm.json.
  """
  packages: [String!]! {
    self.manifest.map { pkg => pkg.name }
  }

  """
  Validate every bundled package source file.
  """
  validate: Void {
    self.manifest.each { pkg => self.validatePackage(pkg) }

    null
  }

  """
  Generate dpm.gen.dang from dpm.json in a source directory.
  """
  install(
    """
    Source directory containing dpm.json.
    """
    source: Directory!,
    """
    Dang module directory within source where dpm.json and dpm.gen.dang live.
    """
    cwd: String! = "/",
  ): Directory! {
    let config = self.config(source, cwd)
    let generated = self.render(config.packages)

    source.withNewFile(self.sourcePath(cwd, "dpm.gen.dang"), generated)
  }

  """
  Generate dpm.gen.dang for every dpm.json found under a workspace.
  """
  installWorkspace(
    """
    Workspace to scan.
    """
    ws: Workspace!,
    """
    Only generate for the current working directory.
    """
    here: Boolean! = false,
  ): Directory! {
    let source = ws.directory("/", gitignore: true)

    self.dpmDirectories(ws, here).reduce(source) { generated, dir => self.install(generated, cwd: dir) }
  }

  """
  Generate dpm.gen.dang from dpm.json as a Dagger code-generation changeset.
  """
  generate(
    ws: Workspace!,
    """
    Only generate for the current working directory.
    """
    here: Boolean! = false,
  ): Changeset! @generate {
    let source = ws.directory("/", gitignore: true)

    self
      .installWorkspace(ws, here: here)
      .changes(source)
  }

  let dpmDirectories(ws: Workspace!, here: Boolean!): [String!]! {
    if (here) {
      if (ws.directory("", gitignore: true).exists("dpm.json", expectedType: ExistsType.REGULAR_TYPE)) {
        [ws.cwd]
      } else {
        []
      }
    } else {
      ws.directory("/", gitignore: true).glob("**/dpm.json").map { path => self.dpmDirectory(path) }.uniq
    }
  }

  let dpmDirectory(path: String!): String! {
    let file = path.trimPrefix("./")

    if (file == "dpm.json") {
      "/"
    } else {
      "/" + file.trimSuffix("/dpm.json")
    }
  }

  let config(source: Directory!, cwd: String!): DpmConfig! {
    let path = self.sourcePath(cwd, "dpm.json")

    if (!source.exists(path, expectedType: ExistsType.REGULAR_TYPE)) {
      raise "dpm.json not found: " + path
    }

    fromJSON(source.file(path).contents) :: DpmConfig!
  }

  let render(packages: [String!]!): String! {
    self.validateSelection(packages)

    GENERATED_NOTICE + packages.map { name => self.packageSource(self.package(name)) }.join("\n")
  }

  let validateSelection(packages: [String!]!): Void {
    if (packages.length != packages.uniq.length) {
      raise "dpm.json packages must not contain duplicates"
    }

    packages.each { name => self.validatePackage(self.package(name)) }

    null
  }

  let packageSource(pkg: DpmPackage!): String! {
    Dagger.currentModule.source.file(pkg.path).contents.trimSpace + "\n"
  }

  let validatePackage(pkg: DpmPackage!): Void {
    let source = Dagger.currentModule.source

    if (!source.exists(pkg.path, expectedType: ExistsType.REGULAR_TYPE)) {
      raise "bundled package source not found: " + pkg.path
    }

    self.compilerValidator.withExec([
      "go", "run", ".",
      "../" + pkg.path,
      pkg.name,
      pkg.typeName,
    ]).stdout

    null
  }

  let compilerValidator: Container! {
    Dagger
      .container
      .from("golang:1.25.4-bookworm")
      .withMountedCache("/go/pkg/mod", Dagger.cacheVolume("dpm-go-mod"))
      .withMountedCache("/root/.cache/go-build", Dagger.cacheVolume("dpm-go-build"))
      .withMountedDirectory("/src", Dagger.currentModule.source)
      .withWorkdir("/src/validator")
  }

  let package(name: String!): DpmPackage! {
    case (name) {
      "base64" => DpmPackage("base64", "Base64", "packages/base64.dang")
      "lists" => DpmPackage("lists", "Lists", "packages/lists.dang")
      "maps" => DpmPackage("maps", "Maps", "packages/maps.dang")
      "path" => DpmPackage("path", "Path", "packages/path.dang")
      "strings" => DpmPackage("strings", "Strings", "packages/strings.dang")
      else => raise "unknown DPM package: " + name
    }
  }

  let manifest: [DpmPackage!]! {
    [
      DpmPackage("base64", "Base64", "packages/base64.dang"),
      DpmPackage("lists", "Lists", "packages/lists.dang"),
      DpmPackage("maps", "Maps", "packages/maps.dang"),
      DpmPackage("path", "Path", "packages/path.dang"),
      DpmPackage("strings", "Strings", "packages/strings.dang"),
    ]
  }

  let sourcePath(cwd: String!, file: String!): String! {
    let dir = cwd.trimPrefix("/").trimSuffix("/")

    if (dir == "") {
      file
    } else {
      dir + "/" + file
    }
  }
}

type DpmConfig {
  packages: [String!]!
}

type DpmPackage {
  name: String!
  typeName: String!
  path: String!
}
