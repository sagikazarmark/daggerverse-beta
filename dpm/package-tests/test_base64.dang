type Base64Tests {
  encode: Void @check {
    assert { Base64.encode("") == "" }
    assert { Base64.encode("hello") == "aGVsbG8=" }
    assert { Base64.encode("hello world") == "aGVsbG8gd29ybGQ=" }
    assert { Base64.encode("héllo") == "aMOpbGxv" }

    null
  }

  decode: Void @check {
    assert { Base64.decode("") == "" }
    assert { Base64.decode("aGVsbG8=") == "hello" }
    assert { Base64.decode("aGVsbG8gd29ybGQ=") == "hello world" }
    assert { Base64.decode("aMOpbGxv") == "héllo" }

    null
  }
}
