type ListsTests {
  sortIntegers: Void @check {
    assert { Lists.sort([]) == [] }
    assert { Lists.sort([3, 1, 2, 1]) == [1, 1, 2, 3] }

    null
  }

  sortWithComparator: Void @check {
    let sorted = Lists.sortWith(["bbb", "a", "cc"]) { left, right =>
      if (left < right) {
        -1
      } else if (left > right) {
        1
      } else {
        0
      }
    }

    assert { sorted == ["a", "bbb", "cc"] }

    null
  }

  sortWithDescendingComparator: Void @check {
    let sorted = Lists.sortWith([1, 3, 2]) { left, right =>
      if (left > right) {
        -1
      } else if (left < right) {
        1
      } else {
        0
      }
    }

    assert { sorted == [3, 2, 1] }

    null
  }
}
