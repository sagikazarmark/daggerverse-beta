type MapsTests {
  reduceValues: Void @check {
    let sum = Maps.reduce(["a": 1, "b": 2, "c": 3], 0) { acc, key, value => acc + value }

    assert { sum == 6 }

    null
  }

  reduceKeysAndValuesInInsertionOrder: Void @check {
    let combined = Maps.reduce(["a": "x", "b": "y"], "") { acc, key, value => acc + key + value }

    assert { combined == "axby" }

    null
  }

  reduceEmpty: Void @check {
    let empty: Map[Int!]! = [:]
    let result = Maps.reduce(empty, 42) { acc, key, value => acc + value }

    assert { result == 42 }

    null
  }
}
