type Tests {
  base64: Base64Tests! { Base64Tests }

  path: PathTests! { PathTests }

  strings: StringsTests! { StringsTests }
}

type PathTests {
  cleanEmpty: Void @check {
    assert { Path.clean("") == "." }

    null
  }

  cleanAbsolute: Void @check {
    assert { Path.clean("/a/../b") == "/b" }
    assert { Path.clean("/a//./b/") == "/a/b" }
    assert { Path.clean("/") == "/" }

    null
  }

  cleanRelative: Void @check {
    assert { Path.clean("a/./b") == "a/b" }
    assert { Path.clean("a/../../b") == "../b" }

    null
  }

  join: Void @check {
    assert { Path.join(["a", "", "b"]) == "a/b" }
    assert { Path.join(["/a", "..", "b"]) == "/b" }
    assert { Path.join(["a/", "/b"]) == "a/b" }
    assert { Path.join(["/a/", "/b"]) == "/a/b" }
    assert { Path.join(["a/", "/b/", "/c"]) == "a/b/c" }

    null
  }

  isRelativeToRelative: Void @check {
    assert { Path.isRelativeTo("a/../b", ".") }
    assert { Path.isRelativeTo(".", ".") }
    assert { Path.isRelativeTo("a/../b", "") }
    assert { !Path.isRelativeTo("../b", ".") }
    assert { !Path.isRelativeTo("a/../../b", ".") }

    null
  }

  isRelativeToAbsolute: Void @check {
    assert { Path.isRelativeTo("/foo/bar/../bar/baz/bat/../baz/bat", "/foo/bar") }
    assert { Path.isRelativeTo("/foo/bar", "/foo/bar") }
    assert { !Path.isRelativeTo("/foo/barista", "/foo/bar") }
    assert { !Path.isRelativeTo("/foo/baz", "/foo/bar") }
    assert { !Path.isRelativeTo("foo/bar", "/foo/bar") }

    null
  }
}
