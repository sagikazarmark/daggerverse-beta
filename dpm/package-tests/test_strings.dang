type StringsTests {
  slug: Void @check {
    assert { Strings.slug("Hello World") == "hello-world" }
    assert { Strings.slug("  Dagger Module  ") == "dagger-module" }

    null
  }

  truncate: Void @check {
    assert { Strings.truncate("hello", 10) == "hello" }
    assert { Strings.truncate("hello", 5) == "hello" }
    assert { Strings.truncate("hello world", 8) == "hello..." }
    assert { Strings.truncate("hello world", 4, omission: "~") == "hel~" }
    assert { Strings.truncate("hello world", 4, omission: "") == "hell" }
    assert { Strings.truncate("hello world", 2) == ".." }
    assert { Strings.truncate("hello world", 0) == "" }

    null
  }
}
