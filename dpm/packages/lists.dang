type Lists {
  sort(list: [Int!]!): [Int!]! {
    self.sortWith(list) { left, right => self.compare(left, right) }
  }

  let sortWith(list: [a]!, &compare(left: a, right: a): Int!): [a]! {
    let initial: [a]! = []
    list.reduce(initial) { sorted, item => self.insert(sorted, item) { left, right => compare(left, right) } }
  }

  let insert(sorted: [a]!, item: a, &compare(left: a, right: a): Int!): [a]! {
    if (sorted.isEmpty) {
      return [item]
    }

    let first = sorted[0]

    if (compare(item, first) <= 0) {
      [item] + sorted
    } else {
      [first] + self.insert(sorted.dropFirst, item) { left, right => compare(left, right) }
    }
  }

  let compare(left: Int!, right: Int!): Int! {
    if (left < right) {
      -1
    } else if (left > right) {
      1
    } else {
      0
    }
  }
}
