type Path {
  separator: String! { "/" }

  clean(path: String!): String! {
    if (path == "") {
      return "."
    }

    let absolute = path.hasPrefix(self.separator)
    let initial: [String!]! = []
    let parts = path
      .split(self.separator)
      .reduce(initial) { parts, part =>
        if (part == "" or part == ".") {
          parts
        } else if (part == "..") {
          if (!parts.isEmpty and parts[parts.length - 1] != "..") {
            parts.dropLast
          } else if (absolute) {
            parts
          } else {
            parts + [part]
          }
        } else {
          parts + [part]
        }
      }

    let joined = parts.join(self.separator)

    let cleaned = if (absolute and joined != "") {
      self.separator + joined
    } else {
      joined
    }

    if (cleaned == "") {
      if (absolute) {
        self.separator
      } else {
        "."
      }
    } else {
      cleaned
    }
  }

  join(parts: [String!]!): String! {
    self.clean(parts.reject { part => part == "" }.join(self.separator))
  }

  isRelativeTo(path: String!, base: String!): Boolean! {
    let cleanBase = self.clean(base)
    let cleanPath = self.clean(path)

    if (cleanBase.hasPrefix(self.separator) != cleanPath.hasPrefix(self.separator)) {
      return false
    }

    if (cleanBase == cleanPath) {
      return true
    }

    if (cleanBase == self.separator) {
      return cleanPath.hasPrefix(self.separator)
    }

    if (cleanBase == ".") {
      return cleanPath != ".." and !cleanPath.hasPrefix(".." + self.separator)
    }

    cleanPath.hasPrefix(cleanBase + self.separator)
  }
}
