type Strings {
  slug(s: String!): String! {
    s.trimSpace.toLower.replace(" ", "-")
  }

  truncate(s: String!, maxLength: Int!): String! {
    if (maxLength <= 0) {
      return ""
    }

    let chars = s.split("")
    if (chars.length <= maxLength) {
      return s
    }

    chars.takeFirst(maxLength).join("")
  }
}
