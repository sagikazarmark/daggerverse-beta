type Tests {
  bundledPackagesAreValid: Void @check {
    Dagger.dpm.validate
  }

  availablePackages: Void @check {
    assert { Dagger.dpm.packages == ["base64", "path", "strings"] }

    null
  }

  generatesSelectedPackages: Void @check {
    let source = Dagger.directory.withNewFile("dpm.json", """{"packages":["base64","path","strings"]}""")
    let generated = Dagger.dpm.install(source).file("dpm.gen.dang").contents

    assert { generated.hasPrefix("# Code generated by dpm. DO NOT EDIT.") }
    assert { generated.contains("type Base64 {") }
    assert { generated.contains("type Path {") }
    assert { generated.contains("type Strings {") }

    null
  }

  writesIntoCwd: Void @check {
    let source = Dagger.directory.withNewFile("module/dpm.json", """{"packages":["path"]}""")
    let generated = Dagger.dpm.install(source, cwd: "/module").file("module/dpm.gen.dang").contents

    assert { generated.contains("type Path {") }
    assert { !generated.contains("type Strings {") }

    null
  }

  installWorkspaceGeneratesAllConfigs(workspace: Workspace!): Void @check {
    let generated = Dagger.dpm.installWorkspace(workspace)

    let root = generated.file("dpm/tests/fixtures/root/dpm.gen.dang").contents
    assert { root.contains("type Path {") }
    assert { !root.contains("type Strings {") }

    let nested = generated.file("dpm/tests/fixtures/nested/module/dpm.gen.dang").contents
    assert { nested.contains("type Strings {") }
    assert { !nested.contains("type Path {") }

    null
  }

  installWorkspaceHereOnlyGeneratesCwd(workspace: Workspace!): Void @check {
    let source = workspace.directory("/", gitignore: true)
    let generated = Dagger.dpm.installWorkspace(workspace, here: true)

    assert { !generated.exists("dpm/tests/dpm.gen.dang", expectedType: ExistsType.REGULAR_TYPE) }
    self.assertFileUnchanged(source, generated, "dpm/tests/fixtures/root/dpm.gen.dang")
    self.assertFileUnchanged(source, generated, "dpm/tests/fixtures/nested/module/dpm.gen.dang")

    null
  }

  packageTestsGeneratedFileIsCurrent(workspace: Workspace!): Void @check {
    let source = workspace.directory("/", gitignore: true)
    let fixture = source.directory("dpm/package-tests")

    let expected = fixture.file("dpm.gen.dang").contents
    let actual = Dagger.dpm.install(fixture).file("dpm.gen.dang").contents

    assert { actual == expected }

    null
  }

  unknownPackageFails: Void @check {
    let source = Dagger.directory.withNewFile("dpm.json", """{"packages":["missing"]}""")

    try {
      Dagger.dpm.install(source).file("dpm.gen.dang").contents

      raise "expected unknown package to fail"
    } catch {
      err => assert { err.message.contains("unknown DPM package: missing") }
    }
  }

  duplicatePackageFails: Void @check {
    let source = Dagger.directory.withNewFile("dpm.json", """{"packages":["path","path"]}""")

    try {
      Dagger.dpm.install(source).file("dpm.gen.dang").contents

      raise "expected duplicate package to fail"
    } catch {
      err => assert { err.message.contains("packages must not contain duplicates") }
    }
  }

  missingConfigFails: Void @check {
    try {
      Dagger.dpm.install(Dagger.directory).file("dpm.gen.dang").contents

      raise "expected missing config to fail"
    } catch {
      err => assert { err.message.contains("dpm.json not found") }
    }
  }

  let assertFileUnchanged(source: Directory!, generated: Directory!, path: String!): Void {
    if (source.exists(path, expectedType: ExistsType.REGULAR_TYPE)) {
      assert { generated.file(path).contents == source.file(path).contents }
    } else {
      assert { !generated.exists(path, expectedType: ExistsType.REGULAR_TYPE) }
    }

    null
  }
}
