type Tests {
  let golden: Directory! {
    Dagger.currentModule.source.directory("fixtures/golden")
  }

  # A small workflow exercising the common path: one trigger, one job, one
  # action step. Built fresh on each access so tests cannot leak state.
  let minimal: GhaWorkflow! {
    Dagger.gha.workflow("CI")
      .onPush(branches: ["main"])
      .withJob(
        "test",
        Dagger.gha.job
          .withStep(
            Dagger.gha.step("Checkout")
              .withUses("actions/checkout@v4"),
          ),
      )
  }

  # A workflow using every builder feature at least once.
  let full: GhaWorkflow! {
    Dagger.gha.workflow("Full")
      .onPush(branches: ["main"], tags: ["v*"], pathsIgnore: ["docs/**"])
      .onPullRequest(types: ["opened", "synchronize"])
      .onSchedule("30 5 * * 1")
      .onSchedule("0 12 * * *")
      .withDispatchInput("environment", description: "Target environment", inputType: GhaInputType.CHOICE, options: ["staging", "production"], defaultValue: "staging")
      .withDispatchInput("dry-run", inputType: GhaInputType.BOOLEAN, defaultValue: "true")
      .withPermission("contents")
      .withPermission("id-token", GhaAccess.WRITE)
      .withPermission("actions", GhaAccess.NONE)
      .withEnvVariable("CI", "true")
      .withConcurrency("ci-${{ github.ref }}", cancelInProgress: true)
      .withJob("lint", Dagger.gha.job
        .withStep(Dagger.gha.step.withRun("make lint")))
      .withJob("build", Dagger.gha.job("ubuntu-24.04")
        .withName("Build ${{ matrix.target }}")
        .withNeeds("lint")
        .withCondition("github.event_name != 'schedule'")
        .withEnvironment("production")
        .withPermission("packages", GhaAccess.WRITE)
        .withEnvVariable("CARGO_TERM_COLOR", "always")
        .withTimeoutMinutes(30)
        .withContinueOnError(false)
        .withMatrix("target", ["linux", "darwin"])
        .withMatrix("arch", ["amd64", "arm64"])
        .withFailFast(false)
        .withMaxParallel(2)
        .withOutput("digest", "${{ steps.push.outputs.digest }}")
        .withStep(Dagger.gha.step("Checkout")
          .withUses("actions/checkout@v4")
          .withInput("fetch-depth", "0"))
        .withStep(Dagger.gha.step("Build")
          .withId("push")
          .withCondition("success()")
          .withRun("make build\nmake push\n")
          .withShell("bash")
          .withWorkingDirectory("src")
          .withEnvVariable("TARGET", "${{ matrix.target }}")
          .withTimeoutMinutes(10)
          .withContinueOnError))
  }

  minimalWorkflow: Void @check {
    let contents = minimal.yaml

    assertGolden(contents, golden.file("minimal.yaml").contents)

    let wf = YAML.decode(contents) :: TestMinimalWorkflow!

    assert { wf.name == "CI" }
    assert { wf.triggers.push.branches.join(",") == "main" }
    assert { wf.jobs.test.runsOn == "ubuntu-latest" }
    assert { wf.jobs.test.steps.length == 1 }
    assert { wf.jobs.test.steps[0].name == "Checkout" }
    assert { wf.jobs.test.steps[0].uses == "actions/checkout@v4" }
  }

  fullWorkflow: Void @check {
    let contents = full.yaml

    assertGolden(contents, golden.file("full.yaml").contents)

    let wf = YAML.decode(contents) :: TestFullWorkflow!

    assert { wf.triggers.push.tags.join(",") == "v*" }
    assert { wf.triggers.push.pathsIgnore.join(",") == "docs/**" }
    assert { wf.triggers.pullRequest.types.join(",") == "opened,synchronize" }
    assert { wf.triggers.schedule.map { _.cron }.join(";") == "30 5 * * 1;0 12 * * *" }
    assert { wf.triggers.workflowDispatch.inputs.environment.inputType == "choice" }
    assert { wf.triggers.workflowDispatch.inputs.environment.options.join(",") == "staging,production" }
    assert { wf.triggers.workflowDispatch.inputs.dryRun.inputType == "boolean" }
    assert { wf.triggers.workflowDispatch.inputs.dryRun.defaultValue == "true" }
    assert { wf.permissions.contents == "read" }
    assert { wf.permissions.idToken == "write" }
    assert { wf.permissions.actions == "none" }
    assert { wf.env.ci == "true" }
    assert { wf.concurrency.group == "ci-${{ github.ref }}" }
    assert { wf.concurrency.cancelInProgress == true }

    let build = wf.jobs.build

    assert { build.name == "Build ${{ matrix.target }}" }
    assert { build.runsOn == "ubuntu-24.04" }
    assert { build.needs.join(",") == "lint" }
    assert { build.condition == "github.event_name != 'schedule'" }
    assert { build.environment == "production" }
    assert { build.permissions.packages == "write" }
    assert { build.timeoutMinutes == 30 }
    assert { build.continueOnError == false }
    assert { build.strategy.failFast == false }
    assert { build.strategy.maxParallel == 2 }
    assert { build.strategy.matrix.target.join(",") == "linux,darwin" }
    assert { build.strategy.matrix.arch.join(",") == "amd64,arm64" }
    assert { build.outputs.digest == "${{ steps.push.outputs.digest }}" }
    assert { build.steps.length == 2 }
    assert { build.steps[0].inputs!.fetchDepth == "0" }

    let push = build.steps[1]

    assert { push.stepId == "push" }
    assert { push.condition == "success()" }
    assert { push.run == "make build\nmake push\n" }
    assert { push.shell == "bash" }
    assert { push.workingDirectory == "src" }
    assert { push.timeoutMinutes == 10 }
    assert { push.continueOnError == true }
  }

  # The generic builder reproduces the gha module's golden workflow (minus the
  # engine-version-derived action inputs, which are consumer logic there).
  daggerParity: Void @check {
    let contents = Dagger.gha.workflow("Dagger")
      .onPush(branches: ["main"])
      .onPullRequest
      .withPermission("contents")
      .withJob("check", Dagger.gha.job
        .withName("Check")
        .withStep(Dagger.gha.step("Checkout repository")
          .withUses("actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd"))
        .withStep(Dagger.gha.step("Check")
          .withUses("dagger/dagger-for-github@27b130bf0f79a7f6fbbbe0fbca6760dc9bb40a77")
          .withInput("verb", "check")))
      .yaml

    assertGolden(contents, golden.file("dagger.yaml").contents)
  }

  # with functions fork the builder: deriving two variants from a shared base
  # must not let them bleed into each other.
  copyOnWrite: Void @check {
    let base = Dagger.gha.workflow("CI").onPush(branches: ["main"])

    let one = base.withJob("one", runJob("true"))
    let two = base.withJob("two", runJob("false"))

    assert { one.yaml.contains("one:") }
    assert { !one.yaml.contains("two:") }
    assert { two.yaml.contains("two:") }
    assert { !two.yaml.contains("one:") }
  }

  invalidWorkflows: Void @check {
    assertRaises("workflow without triggers") {
      Dagger.gha.workflow("CI").withJob("test", runJob("true")).yaml
    }

    assertRaises("workflow without jobs") {
      Dagger.gha.workflow("CI").onPush.yaml
    }

    assertRaises("job without steps") {
      Dagger.gha.workflow("CI").onPush.withJob("test", Dagger.gha.job).yaml
    }

    assertRaises("duplicate job name") {
      Dagger.gha.workflow("CI").onPush
        .withJob("test", runJob("true"))
        .withJob("test", runJob("true"))
        .yaml
    }

    # An empty matrix axis renders as-is (legitimate intermediate for
    # runtime-discovered values, e.g. check discovery on value workspaces).
    assert {
      Dagger.gha.workflow("CI").onPush
        .withJob("test", runJob("true").withMatrix("target", []))
        .yaml
        .contains("target: []")
    }
  }

  invalidSteps: Void @check {
    assertRaises("step with neither uses nor run") {
      wrap(Dagger.gha.step("empty")).yaml
    }

    assertRaises("step with both uses and run") {
      wrap(Dagger.gha.step.withUses("actions/checkout@v4").withRun("true")).yaml
    }

    assertRaises("inputs on a run step") {
      wrap(Dagger.gha.step.withRun("true").withInput("key", "value")).yaml
    }

    assertRaises("shell on a uses step") {
      wrap(Dagger.gha.step.withUses("actions/checkout@v4").withShell("bash")).yaml
    }
  }

  invalidDispatchInputs: Void @check {
    assertRaises("choice input without options") {
      Dagger.gha.workflow("CI")
        .withDispatchInput("environment", inputType: GhaInputType.CHOICE)
        .yaml
    }

    assertRaises("options on a non-choice input") {
      Dagger.gha.workflow("CI")
        .withDispatchInput("environment", options: ["staging"])
        .yaml
    }
  }

  workflowFile: Void @check {
    let file = minimal.file("ci.yaml")

    assert { file.name == "ci.yaml" }
    assert { file.contents == minimal.yaml }
  }

  # Temporary helpers to (re)generate the golden files:
  #   dagger -m gha/tests call golden-minimal export --path gha/tests/fixtures/golden/minimal.yaml
  goldenMinimal: File! {
    Dagger.file("minimal.yaml", minimal.yaml)
  }

  goldenFull: File! {
    Dagger.file("full.yaml", full.yaml)
  }
}

let runJob(script: String!): GhaJob! {
  Dagger.gha.job.withStep(Dagger.gha.step.withRun(script))
}

let wrap(step: GhaStep!): GhaWorkflow! {
  Dagger.gha.workflow("CI").onPush
    .withJob("test", Dagger.gha.job.withStep(step))
}

let assertRaises(label: String!, &body: String!): Void {
  let raised = try {
    body

    false
  } catch {
    err => true
  }

  if (!raised) {
    raise "expected an error: " + label
  }
}

let assertGolden(actual: String!, expected: String!): Void {
  if (actual != expected) {
    raise "generated workflow does not match golden file\n--- expected ---\n" + expected + "\n--- actual ---\n" + actual
  }
}

# Mirrors of the rendered document shape. Kept independent from the module's
# own types on purpose: decoding through these asserts the on-disk YAML field
# names, not just that encoding round-trips.
type TestMinimalWorkflow {
  name: String!
  triggers: TestMinimalTriggers! @YAML.field(name: "on")
  jobs: TestMinimalJobs!
}

type TestMinimalTriggers {
  push: TestPush!
}

type TestPush {
  branches: [String!]
  tags: [String!]
  pathsIgnore: [String!] @YAML.field(name: "paths-ignore")
}

type TestMinimalJobs {
  test: TestJob!
}

type TestFullWorkflow {
  name: String!
  triggers: TestFullTriggers! @YAML.field(name: "on")
  permissions: TestPermissions!
  env: TestEnv!
  concurrency: TestConcurrency!
  jobs: TestFullJobs!
}

type TestFullTriggers {
  push: TestPush!
  pullRequest: TestPullRequest! @YAML.field(name: "pull_request")
  schedule: [TestSchedule!]!
  workflowDispatch: TestWorkflowDispatch! @YAML.field(name: "workflow_dispatch")
}

type TestPullRequest {
  types: [String!]
}

type TestSchedule {
  cron: String!
}

type TestWorkflowDispatch {
  inputs: TestDispatchInputs!
}

type TestDispatchInputs {
  environment: TestDispatchInput!
  dryRun: TestDispatchInput! @YAML.field(name: "dry-run")
}

type TestDispatchInput {
  description: String
  required: Boolean!
  inputType: String! @YAML.field(name: "type")
  defaultValue: String @YAML.field(name: "default")
  options: [String!]
}

type TestPermissions {
  contents: String!
  idToken: String! @YAML.field(name: "id-token")
  actions: String!
}

type TestEnv {
  ci: String! @YAML.field(name: "CI")
}

type TestConcurrency {
  group: String!
  cancelInProgress: Boolean! @YAML.field(name: "cancel-in-progress")
}

type TestFullJobs {
  lint: TestJob!
  build: TestJob!
}

type TestJob {
  name: String
  runsOn: String! @YAML.field(name: "runs-on")
  needs: [String!]
  condition: String @YAML.field(name: "if")
  environment: String
  permissions: TestJobPermissions
  timeoutMinutes: Int @YAML.field(name: "timeout-minutes")
  continueOnError: Boolean @YAML.field(name: "continue-on-error")
  strategy: TestStrategy
  outputs: TestOutputs
  steps: [TestStep!]!
}

type TestJobPermissions {
  packages: String!
}

type TestStrategy {
  failFast: Boolean @YAML.field(name: "fail-fast")
  maxParallel: Int @YAML.field(name: "max-parallel")
  matrix: TestMatrix!
}

type TestMatrix {
  target: [String!]!
  arch: [String!]!
}

type TestOutputs {
  digest: String!
}

type TestStep {
  name: String
  stepId: String @YAML.field(name: "id")
  condition: String @YAML.field(name: "if")
  uses: String
  run: String
  shell: String
  workingDirectory: String @YAML.field(name: "working-directory")
  timeoutMinutes: Int @YAML.field(name: "timeout-minutes")
  continueOnError: Boolean @YAML.field(name: "continue-on-error")
  inputs: TestStepInputs @YAML.field(name: "with")
}

type TestStepInputs {
  fetchDepth: String @YAML.field(name: "fetch-depth")
}
