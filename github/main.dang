type Github {
  let repository: String

  let client: Client!

  new(
    """
    GitHub repository in one of the following formats:

    - `owner/repo`
    - `https://github.com/owner/repo[.git|...]`
    - `git@github.com:owner/repo.git`
    """
    repository: String = null,
    """
    GitHub token
    """
    token: Secret = null,
  ) {
    if (repository != null) {
      self.repository = normalizeRepository(repository)
    }
    self.client = Client(token)

    self
  }

  """
  Interact with GitHub releases for the given repository.
  """
  releases(repository: String! = self.repository!): Releases! {
    Releases(self.client, repository)
  }

  """
  Get a GitHub release by version. Use null or an empty string for the latest release.
  """
  release(version: String = null, repository: String! = self.repository!): Release! {
    self
      .releases(repository)
      .{
        if (version == null or version == "") {
          _.latest
        } else {
          _.get(version)
        }
      }
  }
}

"""
A GitHub release.
"""
type Releases {
  let client: Client!

  new(client: Client!, repository: String!) {
    repository = normalizeRepository(repository)

    self.client = client.appendPath(`/repos/${repository}/releases`)

    self
  }

  """
  Get the latest, non-draft, non-prerelease release.
  """
  latest: Release! {
    fromJSON(self.client.get("/latest"))
  }

  """
  Get a GitHub release by version.
  """
  get(
    """
    Release tag, or null (or empty) for latest, non-draft, non-prerelease release.
    """
    version: String!,
  ): Release! {
    fromJSON(self.client.get(`/tags/${version}`))
  }
}

"""
A GitHub release.
"""
type Release {
  url: String!

  let html_url: String!

  htmlUrl: String! { self.html_url }

  let tarball_url: String!

  tarballUrl: String! { self.tarball_url }

  let zipball_url: String!

  zipballUrl: String! { self.zipball_url }

  let tag_name: String!

  tagName: String! { self.tag_name }

  name: String!
  body: String!
  draft: Boolean!
  prerelease: Boolean!
  immutable: Boolean!
  assets: [ReleaseAsset!]!

  """
  Returns the asset with the given name, or null if no such asset exists.
  """
  asset(name: String!): ReleaseAsset {
    self.assets.filter { asset => asset.name == name }[0]
  }
}

"""
A resolved GitHub release asset.
"""
type ReleaseAsset {
  name: String!
  label: String

  let content_type: String!

  contentType: String! { self.content_type }

  size: Int!

  digest: String

  let browser_download_url: String!

  downloadUrl: String! {
    self.browser_download_url
  }

  """
  Downloaded asset file with GitHub's asset digest enforced by Dagger.
  """
  file: File! {
    Dagger.http(
      url: self.downloadUrl,
      name: self.name,
      checksum: self.digest,
    )
  }

  """
  Downloaded and extracted asset file.
  """
  extracted(
    """
    If stripParent is true, the parent directory will be stripped from the extracted file.
    """
    stripParent: Boolean! = false,
    """
    Number of components to strip from the extracted file.
    """
    stripComponents: Int = if (stripParent) { 1 } else { null },
  ): Directory! {
    extractArchive(self.file, stripComponents)
  }
}
