"""
A GitHub release.
"""
type Releases {
  let repository: String!

  let api: Client!

  let client: Client!

  new(client: Client!, repository: String!) {
    self.repository = normalizeRepository(repository)
    self.api = client
    self.client = client.appendPath(`/repos/${self.repository}/releases`)

    self
  }

  """
  Get the latest, non-draft, non-prerelease release.
  """
  latest: Release! {
    JSON.decode(self.client.get("/latest")) rescue {
      err: Error => if (err.message.contains("404 Not Found")) {
        self.ensureRepositoryExists

        raise `repository "${self.repository}" has no stable releases yet`
      } else {
        raise err
      }
    }
  }

  """
  Get a GitHub release by version.
  """
  get(
    """
    Release tag, or null (or empty) for latest, non-draft, non-prerelease release.
    """
    version: String!,
  ): Release! {
    JSON.decode(self.client.get(`/tags/${version}`)) rescue {
      err: Error => if (err.message.contains("404 Not Found")) {
        self.ensureRepositoryExists

        raise ReleaseNotFound(self.repository, version)
      } else {
        raise err
      }
    }
  }

  let ensureRepositoryExists: Void {
    {
      self.api.get(`/repos/${self.repository}`)
      null
    } rescue {
      err: Error => if (err.message.contains("404 Not Found")) {
        raise RepositoryNotFound(self.repository)
      } else {
        raise err
      }
    }
  }
}

type RepositoryNotFound implements Error {
  repository: String!

  message: String! = `repository "${repository}" is not found`
}

type ReleaseNotFound implements Error {
  repository: String!
  version: String!

  message: String! = `release "${version}" is not found in repository "${repository}"`
}

"""
A GitHub release.
"""
type Release {
  url: String!
  htmlUrl: String! @JSON.field(name: "html_url", omitEmpty: true)
  tarballUrl: String! @JSON.field(name: "tarball_url", omitEmpty: true)
  zipballUrl: String! @JSON.field(name: "zipball_url", omitEmpty: true)
  tagName: String! @JSON.field(name: "tag_name")
  name: String!
  body: String!
  draft: Boolean!
  prerelease: Boolean!
  immutable: Boolean!
  assets: [ReleaseAsset!]!

  """
  The asset with the given name, or an error if no such asset exists.
  """
  asset(name: String!): ReleaseAsset! {
    let asset = self.assets.find { _.name == name }

    if (asset == null) {
      raise ReleaseAssetNotFound(name, self)
    }

    asset
  }
}

type ReleaseAssetNotFound implements Error {
  name: String!
  release: Release!

  # TODO: this isn't very nice
  let repository: String! {
    release.htmlUrl.trimPrefix("https://github.com/").split("/").takeFirst(2).join("/")
  }

  message: String! = `asset "${name}" is not found in release "${release.tagName}" of repository "${repository}"`
}

"""
A resolved GitHub release asset.
"""
type ReleaseAsset {
  name: String!
  label: String
  contentType: String! @JSON.field(name: "content_type")
  size: Int!
  digest: String
  downloadUrl: String! @JSON.field(name: "browser_download_url")

  """
  Downloaded asset file with GitHub's asset digest enforced by Dagger.
  """
  file: File! {
    Dagger.http(
      url: self.downloadUrl,
      name: self.name,
      checksum: self.digest,
    )
  }

  """
  Downloaded and extracted asset file.
  """
  extracted(
    """
    If stripParent is true, the parent directory will be stripped from the extracted file.
    """
    stripParent: Boolean! = false,
    """
    Number of components to strip from the extracted file.
    """
    stripComponents: Int = if (stripParent) { 1 } else { null },
  ): Directory! {
    extract(self.file, stripComponents)
  }
}
