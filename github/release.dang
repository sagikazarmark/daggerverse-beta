"""
A GitHub release.
"""
type Releases {
  let repository: String!

  let client: Client!

  new(client: Client!, repository: String!) {
    self.repository = normalizeRepository(repository)
    self.client = client.appendPath(`/repos/${repository}/releases`)

    self
  }

  """
  Get the latest, non-draft, non-prerelease release.
  """
  latest: Release! {
    try {
      JSON.decode(self.client.get("/latest"))
    } catch {
      err => if (err.message.contains("404 Not Found")) {
        raise `repository "${self.repository}" has no stable releases yet`
      } else {
        raise err
      }
    }
  }

  """
  Get a GitHub release by version.
  """
  get(
    """
    Release tag, or null (or empty) for latest, non-draft, non-prerelease release.
    """
    version: String!,
  ): Release! {
    try {
      JSON.decode(self.client.get(`/tags/${version}`))
    } catch {
      err => if (err.message.contains("404 Not Found")) {
        raise ReleaseNotFound(self.repository, version)
      } else {
        raise err
      }
    }
  }
}

type ReleaseNotFound implements Error {
  repository: String!
  version: String!

  message: String! = `version "${self.version}" is not found in repository "${self.repository}"`
}

"""
A GitHub release.
"""
type Release {
  url: String!
  htmlUrl: String! @JSON.field(name: "html_url", omitEmpty: true)
  tarballUrl: String! @JSON.field(name: "tarball_url", omitEmpty: true)
  zipballUrl: String! @JSON.field(name: "zipball_url", omitEmpty: true)
  tagName: String! @JSON.field(name: "tag_name")
  name: String!
  body: String!
  draft: Boolean!
  prerelease: Boolean!
  immutable: Boolean!
  assets: [ReleaseAsset!]!

  """
  Returns the asset with the given name, or null if no such asset exists.
  """
  asset(name: String!): ReleaseAsset {
    self.assets.find { _.name == name }
  }
}

"""
A resolved GitHub release asset.
"""
type ReleaseAsset {
  name: String!
  label: String
  contentType: String! @JSON.field(name: "content_type")
  size: Int!
  digest: String
  downloadUrl: String! @JSON.field(name: "browser_download_url")

  """
  Downloaded asset file with GitHub's asset digest enforced by Dagger.
  """
  file: File! {
    Dagger.http(
      url: self.downloadUrl,
      name: self.name,
      checksum: self.digest,
    )
  }

  """
  Downloaded and extracted asset file.
  """
  extracted(
    """
    If stripParent is true, the parent directory will be stripped from the extracted file.
    """
    stripParent: Boolean! = false,
    """
    Number of components to strip from the extracted file.
    """
    stripComponents: Int = if (stripParent) { 1 } else { null },
  ): Directory! {
    extractArchive(self.file, stripComponents)
  }
}
