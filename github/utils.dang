let normalizeRepository(repository: String!): String! {
  repository
    .match(`^(?:https://github\.com/|git@github\.com:)?(?P<repo>[^/\s]+/[^/\s]+?)(?:\.git)?(?:/.*)?$`)
    .named["repo"]
    .{
      if (_ == null) {
        raise "invalid repository name: " + toString(repository)
      }

      _
    }
}
