let REPO_REGEX: Regexp! = `^(?:https://github\.com/|git@github\.com:)?(?P<repo>[^/\s]+/[^/\s]+?)(?:\.git)?(?:/.*)?$`

let normalizeRepository(repository: String!): String! {
  let normalized = repository.match(REPO_REGEX).named["repo"]

  if (normalized == null) {
    raise "invalid repository name: " + repository
  }

  normalized
}
