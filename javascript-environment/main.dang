type JavascriptEnvironment {
  let runtime: Runtime
  let source: Directory
  let cwd: String!

  let nodeEnv: NodeEnvironment!
  let nodeContainer: Container!

  let bunEnv: BunEnvironment!
  let bunContainer: Container!

  let denoEnv: DenoEnvironment!
  let denoContainer: Container!

  new(
    """
    Runtime to use. If unset, the runtime is detected from package files starting at the source cwd.
    """
    runtime: Runtime,
    """
    Source directory to mount into source-backed containers.
    """
    source: Directory,
    """
    Current working directory within the source.
    """
    cwd: String! = "/",
    """
    Overlay to apply to the selected runtime container after the initial setup.
    """
    overlay: Overlay,
    """
    Environment file to load into selected runtime containers.
    """
    envFile: File,
    """
    Source date epoch to set in selected runtime containers.
    """
    sourceDateEpoch: String,
    """
    Install dependencies when the selected runtime container is retrieved.
    """
    install: Boolean! = false,
    """
    Install dependencies from the lockfile without updating it.
    """
    locked: Boolean! = false,
    """
    Whether to disable automatically mounted cache volumes for all runtimes.
    """
    noCache: Boolean! = false,
    """
    Version (image tag) to use from the official Node image repository.
    """
    nodeVersion: String! = "latest",
    """
    Custom Node container to use as the default container.
    """
    nodeContainer: Container! = Dagger.container.from("node:" + nodeVersion),
    """
    Cache volume for npm's package cache.
    """
    nodeCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("node-npm")
    } else null,
    """
    Version (image tag) to use from the official Bun image repository.
    """
    bunVersion: String! = "latest",
    """
    Custom Bun container to use as the default container.
    """
    bunContainer: Container! = Dagger.container.from("oven/bun:" + bunVersion),
    """
    Cache volume for Bun's package cache.
    """
    bunCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("bun-install")
    } else null,
    """
    Version (image tag) to use from the official Deno image repository.
    """
    denoVersion: String! = "latest",
    """
    Custom Deno container to use as the default container.
    """
    denoContainer: Container! = Dagger.container.from("denoland/deno:" + denoVersion),
    """
    Cache volume for Deno's dependency cache.
    """
    denoCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("deno")
    } else null,
  ) {
    self.runtime = runtime
    self.source = source
    self.cwd = cwd

    self.nodeContainer = nodeContainer
    self.nodeEnv = Dagger.nodeEnvironment(
      container: nodeContainer,
      source: source,
      cwd: packageCwdOrDefault(source, cwd, Runtime.NODE),
      overlay: overlay,
      envFile: envFile,
      sourceDateEpoch: sourceDateEpoch,
      install: install,
      locked: locked,
      noCache: noCache,
      cache: nodeCache,
    )

    self.bunContainer = bunContainer
    self.bunEnv = Dagger.bunEnvironment(
      container: bunContainer,
      source: source,
      cwd: packageCwdOrDefault(source, cwd, Runtime.BUN),
      overlay: overlay,
      envFile: envFile,
      sourceDateEpoch: sourceDateEpoch,
      install: install,
      locked: locked,
      noCache: noCache,
      cache: bunCache,
    )

    self.denoContainer = denoContainer
    self.denoEnv = Dagger.denoEnvironment(
      container: denoContainer,
      source: source,
      cwd: packageCwdOrDefault(source, cwd, Runtime.DENO),
      overlay: overlay,
      envFile: envFile,
      sourceDateEpoch: sourceDateEpoch,
      install: install,
      locked: locked,
      noCache: noCache,
      cache: denoCache,
    )

    self
  }

  """
  Configure this environment to install dependencies when the selected runtime container is retrieved.
  """
  withInstall(
    """
    Install dependencies from the lockfile without updating it.
    """
    locked: Boolean! = false,
  ): JavascriptEnvironment! {
    self.nodeEnv = self.nodeEnv.withInstall(locked: locked)
    self.bunEnv = self.bunEnv.withInstall(locked: locked)
    self.denoEnv = self.denoEnv.withInstall(locked: locked)

    self
  }

  """
  Container for the detected or configured JavaScript runtime.
  """
  container: Container! {
    self.applySource
  }

  apply(container: Container!): Container! {
    self.applySource(container)
  }

  applyWorkspace(
    workspace: Workspace,
    container: Container,
    gitignore: Boolean,
    include: [String!],
    exclude: [String!],
  ): Container! {
    self.applySource(
      container,
      workspace.directory(
        "/",
        exclude: exclude,
        include: include,
        gitignore: gitignore,
      ),
      cwd: workspace.cwd,
    )
  }

  applySource(container: Container, source: Directory, cwd: String): Container! {
    let source = source ?? self.source
    let cwd = cwd ?? self.cwd
    let runtime = self.selectedRuntime(source, cwd)
    let packageCwd = packageCwd(source, cwd, runtime)
    let container = container ?? self.defaultContainer(runtime)

    case (runtime) {
      Runtime.DENO => self.denoEnv.applySource(container, source, packageCwd)
      Runtime.BUN => self.bunEnv.applySource(container, source, packageCwd)
      Runtime.NODE => self.nodeEnv.applySource(container, source, packageCwd)

      else => raise "unsupported JavaScript runtime: " + toString(runtime)
    }
  }

  """
  Run a task with the selected JavaScript runtime.
  """
  withRun(
    """
    Runtime task or package script to run.
    """
    task: String!,
    """
    Arguments to pass to the task or package script.
    """
    args: [String!]! = [],
  ): Container! {
    let source = self.source
    let cwd = self.cwd
    let runtime = self.selectedRuntime(source, cwd)

    case (runtime) {
      Runtime.DENO => self.denoEnv.withRun(task, args: args)
      Runtime.BUN => self.bunEnv.withRun(script: task, args: args)
      Runtime.NODE => self.nodeEnv.withRun(script: task, args: args)
      else => raise "unsupported JavaScript runtime: " + toString(runtime)
    }
  }

  let defaultContainer(runtime: Runtime!): Container! {
    case (runtime) {
      Runtime.DENO => self.denoContainer
      Runtime.BUN => self.bunContainer
      Runtime.NODE => self.nodeContainer
      else => raise "unsupported JavaScript runtime: " + toString(runtime)
    }
  }

  let selectedRuntime(source: Directory, cwd: String!): Runtime! {
    let runtime = self.runtime
    if (runtime != null) {
      return runtime
    }

    if (source == null) {
      raise "No Deno, Bun, or npm package file found: no source directory was provided"
    }

    detectRuntime(source, cwd)
  }
}

enum Runtime {
  DENO
  BUN
  NODE
}

interface Overlay implements NodeEnvironmentOverlay & BunEnvironmentOverlay & DenoEnvironmentOverlay {
  apply(container: Container!): Container!
}

let detectRuntime(source: Directory!, cwd: String!): Runtime! {
  if (denoPackageFile(source, cwd) != null) {
    return Runtime.DENO
  }

  if (bunPackageFile(source, cwd) != null) {
    return Runtime.BUN
  }

  if (nodePackageFile(source, cwd) != null) {
    return Runtime.NODE
  }

  raise "No Deno, Bun, or npm package file found in " + cwd + " (or any parent directory)"
}

let packageCwd(source: Directory, cwd: String!, runtime: Runtime!): String! {
  if (source == null) {
    return cwd
  }

  let file = packageFile(source, cwd, runtime)

  if (file == null) {
    raise "No package file found for JavaScript runtime " + toString(runtime) + " in " + cwd + " (or any parent directory)"
  }

  packageDir(file)
}

let packageCwdOrDefault(source: Directory, cwd: String!, runtime: Runtime!): String! {
  if (source == null) {
    return cwd
  }

  let file = packageFile(source, cwd, runtime)
  if (file == null) {
    return cwd
  }

  packageDir(file)
}

let packageFile(source: Directory!, cwd: String!, runtime: Runtime!): String {
  case (runtime) {
    Runtime.DENO => denoPackageFile(source, cwd)
    Runtime.BUN => bunPackageFile(source, cwd)
    Runtime.NODE => nodePackageFile(source, cwd)
    else => null
  }
}

let denoPackageFile(source: Directory!, cwd: String!): String {
  let path: String = findUp(source, cwd, "deno.json")
  if (path == null) {
    path = findUp(source, cwd, "deno.jsonc")
  }

  path
}

let bunPackageFile(source: Directory!, cwd: String!): String {
  let path: String = findUp(source, cwd, "bun.lock")
  if (path == null) {
    path = findUp(source, cwd, "bun.lockb")
  }

  path
}

let nodePackageFile(source: Directory!, cwd: String!): String {
  let path: String = findUp(source, cwd, "package-lock.json")
  if (path == null) {
    path = findUp(source, cwd, "package.json")
  }

  path
}

let findUp(source: Directory!, cwd: String!, name: String!): String {
  source.asWorkspace(cwd).findUp(name)
}

let packageDir(path: String!): String! {
  let parts = path.split("/")
  if (parts.length == 1) {
    return ""
  }

  parts.dropLast.join("/")
}
