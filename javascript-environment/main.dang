type JavascriptEnvironment {
  let runtime: Runtime

  let gitignore: Boolean
  let include: [String!]
  let exclude: [String!]

  let envFile: File
  let sourceDateEpoch: String

  let install: Boolean!
  let locked: Boolean!

  let nodeVersion: String!
  let nodeContainer: Container!
  let nodeCache: CacheVolume

  let bunVersion: String!
  let bunContainer: Container!
  let bunCache: CacheVolume

  let denoVersion: String!
  let denoContainer: Container!
  let denoCache: CacheVolume

  new(
    """
    Runtime to use. If unset, the runtime is detected from package files starting at the workspace cwd.
    """
    runtime: Runtime,
    """
    Ignore paths included in the gitignore file.
    """
    gitignore: Boolean,
    """
    Include only artifacts that match the given pattern (e.g., ["app/", "package.*"]).
    """
    include: [String!],
    """
    Exclude artifacts that match the given pattern (e.g., ["node_modules/", ".git*"]).
    """
    exclude: [String!],
    """
    Environment file to load into selected runtime containers.
    """
    envFile: File,
    """
    Source date epoch to set in selected runtime containers.
    """
    sourceDateEpoch: String,
    """
    Install dependencies when the selected runtime container is retrieved.
    """
    install: Boolean! = false,
    """
    Install dependencies from the lockfile without updating it.
    """
    locked: Boolean! = false,
    """
    Whether to disable automatically mounted cache volumes for all runtimes.
    """
    noCache: Boolean! = false,
    """
    Version (image tag) to use from the official Node image repository.
    """
    nodeVersion: String! = "latest",
    """
    Custom Node container to use as the default container.
    """
    nodeContainer: Container! = Dagger.container.from("node:" + nodeVersion),
    """
    Cache volume for npm's package cache.
    """
    nodeCache: CacheVolume = if (!noCache) { Dagger.cacheVolume("npm") } else null,
    """
    Version (image tag) to use from the official Bun image repository.
    """
    bunVersion: String! = "latest",
    """
    Custom Bun container to use as the default container.
    """
    bunContainer: Container! = Dagger.container.from("oven/bun:" + bunVersion),
    """
    Cache volume for Bun's package cache.
    """
    bunCache: CacheVolume = if (!noCache) { Dagger.cacheVolume("bun") } else null,
    """
    Version (image tag) to use from the official Deno image repository.
    """
    denoVersion: String! = "latest",
    """
    Custom Deno container to use as the default container.
    """
    denoContainer: Container! = Dagger.container.from("denoland/deno:" + denoVersion),
    """
    Cache volume for Deno's dependency cache.
    """
    denoCache: CacheVolume = if (!noCache) { Dagger.cacheVolume("deno") } else null,
  ) {
    self.runtime = runtime

    self.gitignore = gitignore
    self.include = include
    self.exclude = exclude

    self.envFile = envFile
    self.sourceDateEpoch = sourceDateEpoch

    self.install = install
    self.locked = locked

    self.nodeVersion = nodeVersion
    self.nodeContainer = nodeContainer
    self.nodeCache = nodeCache

    self.bunVersion = bunVersion
    self.bunContainer = bunContainer
    self.bunCache = bunCache

    self.denoVersion = denoVersion
    self.denoContainer = denoContainer
    self.denoCache = denoCache

    self
  }

  """
  Container for the detected or configured JavaScript runtime.
  """
  container(
    ws: Workspace,
    """
    Custom base container to use.
    """
    base: Container,
    """
    Ignore paths included in the gitignore file.
    """
    gitignore: Boolean,
    """
    Include only artifacts that match the given pattern (e.g., ["app/", "package.*"]).
    """
    include: [String!],
    """
    Exclude artifacts that match the given pattern (e.g., ["node_modules/", ".git*"]).
    """
    exclude: [String!],
  ): Container! {
    let runtime = self.resolveRuntime(ws)

    case (runtime) {
      Runtime.DENO => self.denoEnv.container(
        ws: ws,
        base: base,
        gitignore: gitignore ?? self.gitignore,
        include: include ?? self.include,
        exclude: exclude ?? self.exclude,
      )

      Runtime.BUN => self.bunEnv.container(
        ws: ws,
        base: base,
        gitignore: gitignore ?? self.gitignore,
        include: include ?? self.include,
        exclude: exclude ?? self.exclude,
      )

      Runtime.NODE => self.nodeEnv.container(
        ws: ws,
        base: base,
        gitignore: gitignore ?? self.gitignore,
        include: include ?? self.include,
        exclude: exclude ?? self.exclude,
      )

      else => raise "unsupported JavaScript runtime: " + toString(runtime)
    }
  }

  """
  Run a task with the selected JavaScript runtime.
  """
  withRun(
    ws: Workspace!,
    """
    Runtime task or package script to run.
    """
    task: String!,
    """
    Arguments to pass to the task or package script.
    """
    args: [String!]! = [],
  ): Container! {
    let runtime = self.resolveRuntime(ws)

    case (runtime) {
      Runtime.DENO => self.denoEnv.withRun(ws: ws, task: task, args: args)
      Runtime.BUN => self.bunEnv.withRun(ws: ws, script: task, args: args)
      Runtime.NODE => self.nodeEnv.withRun(ws: ws, script: task, args: args)

      else => raise "unsupported JavaScript runtime: " + toString(runtime)
    }
  }

  let nodeEnv: NodeEnvironment! {
    Dagger.nodeEnvironment(
      container: self.nodeContainer,
      envFile: self.envFile,
      sourceDateEpoch: self.sourceDateEpoch,
      install: self.install,
      locked: self.locked,
      cache: self.nodeCache,
    )
  }

  let bunEnv: BunEnvironment! {
    Dagger.bunEnvironment(
      container: self.bunContainer,
      envFile: self.envFile,
      sourceDateEpoch: self.sourceDateEpoch,
      install: self.install,
      locked: self.locked,
      cache: self.bunCache,
    )
  }

  let denoEnv: DenoEnvironment! {
    Dagger.denoEnvironment(
      container: self.denoContainer,
      envFile: self.envFile,
      sourceDateEpoch: self.sourceDateEpoch,
      install: self.install,
      locked: self.locked,
      cache: self.denoCache,
    )
  }

  let resolveRuntime(ws: Workspace): Runtime! {
    let runtime = self.runtime
    if (runtime != null) {
      return runtime
    }

    if (ws == null) {
      raise "No Deno, Bun, or npm package file found: no workspace was provided"
    }

    detectRuntime(ws)
  }
}

interface Overlay {
  apply(container: Container!): Container!
}

enum Runtime {
  DENO
  BUN
  NODE
}

let detectRuntime(ws: Workspace!): Runtime! {
  let file = firstFindUp(ws, [
    "deno.json",
    "deno.jsonc",
  ])
  if (file != null) {
    return Runtime.DENO
  }

  file = firstFindUp(ws, [
    "bun.lock",
    "bun.lockb",
  ])
  if (file != null) {
    return Runtime.BUN
  }

  file = firstFindUp(ws, [
    "package-lock.json",
    "npm-shrinkwrap.json",
    "package.json",
  ])
  if (file != null) {
    return Runtime.NODE
  }

  raise "No Deno, Bun, or npm package file found in " + ws.cwd + " (or any parent directory)"
}

let firstFindUp(ws: Workspace!, names: [String!]!): String {
  names.each { name =>
    let file = ws.findUp(name)
    if (file != null) {
      return file
    }
  }

  null
}
