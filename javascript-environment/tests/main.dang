let nodeVersion: String! = "22.20.0-bookworm-slim"
let bunVersion: String! = "1.2.22"
let denoVersion: String! = "2.4.5"

let denoProject: Directory! {
  Dagger.currentModule.source.directory("testdata/deno")
}

let bunProject: Directory! {
  Dagger.currentModule.source.directory("testdata/bun")
}

let nodeProject: Directory! {
  Dagger.currentModule.source.directory("testdata/node")
}

let nodeLockedProject: Directory! {
  Dagger.currentModule.source.directory("testdata/node-locked")
}

let envFile: File! {
  Dagger.currentModule.source.file("testdata/env/.env")
}

let mixedProject: Directory! {
  Dagger
    .directory
    .withDirectory(".", denoProject)
    .withDirectory("node", nodeProject)
}

let nestedNodeProject: Directory! {
  Dagger
    .directory
    .withDirectory("app", nodeProject)
}

let tailwindProject: Directory! {
  Dagger.currentModule.source.directory("testdata/tailwind")
}

let tailwindBunProject: Directory! {
  tailwindProject
    .withFile("bun.lock", Dagger.currentModule.source.file("testdata/tailwind-bun/bun.lock"))
}

type Tests {
  detectsDenoFirst: Void @check {
    let output = Dagger
      .javascriptEnvironment(
        install: true,
        denoVersion: denoVersion,
      )
      .withRun(denoProject.asWorkspace, "check")
      .stdout

    assert { output.contains("deno-auto") }
  }

  detectsBunBeforeNode: Void @check {
    let output = Dagger
      .javascriptEnvironment(
        install: true,
        bunVersion: bunVersion,
      )
      .withRun(bunProject.asWorkspace, "check")
      .stdout

    assert { output.contains("bun-auto") }
  }

  detectsNode: Void @check {
    let output = Dagger
      .javascriptEnvironment(
        install: true,
        nodeVersion: nodeVersion,
      )
      .withRun(nodeProject.asWorkspace, "check")
      .stdout

    assert { output.contains("node-auto") }
  }

  sourceAndCwd: Void @check {
    let output = Dagger
      .javascriptEnvironment(
        install: true,
        nodeVersion: nodeVersion,
      )
      .withRun(nestedNodeProject.asWorkspace("/app"), "check")
      .stdout

    assert { output.contains("node-auto") }
  }

  runtimeOverrideWithoutSource: Void @check {
    let output = Dagger
      .javascriptEnvironment(
        runtime: JavascriptEnvironmentRuntime.NODE,
        nodeVersion: nodeVersion,
      )
      .container(ws: null)
      .withExec(["node", "--version"])
      .stdout

    assert { output.contains("v22.") }
  }

  envFileAndEpoch: Void @check {
    let container = Dagger
      .javascriptEnvironment(
        runtime: JavascriptEnvironmentRuntime.NODE,
        envFile: envFile,
        sourceDateEpoch: "1234567890",
        nodeVersion: nodeVersion,
      )
      .container(ws: null)

    assert { container.envVariable("JAVASCRIPT_ENV_TEST") == "from-env-file" }
    assert { container.envVariable("SOURCE_DATE_EPOCH") == "1234567890" }
  }

  runtimeOverride: Void @check {
    let output = Dagger
      .javascriptEnvironment(
        runtime: JavascriptEnvironmentRuntime.NODE,
        install: true,
        nodeVersion: nodeVersion,
      )
      .withRun(ws: mixedProject.asWorkspace("/node"), task: "check")
      .stdout

    assert { output.contains("node-auto") }
  }

  locked: Void @check {
    let output = Dagger
      .javascriptEnvironment(
        runtime: JavascriptEnvironmentRuntime.NODE,
        install: true,
        locked: true,
        nodeVersion: nodeVersion,
      )
      .withRun(ws: nodeLockedProject.asWorkspace, task: "check")
      .stdout

    assert { output.contains("node-auto") }
  }

  tailwindBun: Void @check {
    let css = Dagger
      .javascriptEnvironment(
        install: true,
        bunVersion: bunVersion,
      )
      .withRun(tailwindBunProject.asWorkspace, "build")
      .file("/work/src/assets/tailwind.css")
      .contents

    assert { css.contains("--color-primary") }
    assert { css.contains(".btn") }
  }

  tailwindNode: Void @check {
    let css = Dagger
      .javascriptEnvironment(
        install: true,
        nodeVersion: nodeVersion,
      )
      .withRun(tailwindProject.asWorkspace, "build")
      .file("/work/src/assets/tailwind.css")
      .contents

    assert { css.contains("--color-primary") }
    assert { css.contains(".btn") }
  }

}
