type CertGenerator {
  let container: Container!

  new(
    version: String! = "latest",
    container: Container! = Dagger.container.from("alpine/openssl:" + version),
  ) {
    self.container = container

    self
  }

  let generate(seed: String!): Directory! {
    self
      .container
      .withWorkdir("/work")
      .withExec(["mkdir", "-p", ".ca/certs"])
      .withExec(["touch", ".ca/index"])
      .withNewFile(".ca/config", self.config)
      .withEnvVariable("SEED", seed) # set the seed for reproducible random number generation
      .withExec(["openssl", "rand", "-hex", "8"], redirectStdout: ".ca/serial")
      # Service account key
      .withExec(["openssl", "genrsa", "-out", "service.key", "2048"])
      # Root CA
      .withExec(["openssl", "genrsa", "-out", "root-ca.key", "2048"])
      .withExec(["openssl", "req", "-x509", "-new", "-nodes", "-sha256", "-days", "7300", "-subj", "/CN=k3s-root-ca", "-key", "root-ca.key", "-out", "root-ca.pem", "-config", ".ca/config", "-extensions", "v3_ca"])
      .withExec(["cat", "root-ca.pem"], redirectStdout: "root-ca.crt")
      # Intermediate CA
      .withExec(["openssl", "genrsa", "-out", "intermediate-ca.key", "2048"])
      .withExec(["openssl", "req", "-new", "-nodes", "-subj", "/CN=k3s-intermediate-ca", "-key", "intermediate-ca.key", "-out", "intermediate-ca.pem", "-config", ".ca/config", "-extensions", "v3_ca"])
      .withExec(["cat", "intermediate-ca.pem"], redirectStdout: "intermediate-ca.crt")

    Dagger.directory
  }

  let config: String! = """[ca]
  default_ca = ca_default
  [ca_default]
  dir = ./.ca
  database = $dir/index
  serial = $dir/serial
  new_certs_dir = $dir/certs
  default_md = sha256
  policy = policy_anything
  [policy_anything]
  commonName = supplied
  [req]
  distinguished_name = req_distinguished_name
  [req_distinguished_name]
  [v3_ca]
  subjectKeyIdentifier = hash
  authorityKeyIdentifier = keyid:always
  basicConstraints = critical, CA:true
  keyUsage = critical, digitalSignature, keyEncipherment, keyCertSign
  """
}
