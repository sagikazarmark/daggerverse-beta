type K3s {
  let baseContainer: Container!
  let clientContainer: Container!

  # Cluster name, also used as the TLS SAN and service hostname.
  let name: String!

  # Generated cluster certificates, shared between the server and kubectl.
  let certs: Directory!

  # Manifests to auto-deploy, accumulated by withManifestFile/withManifestDirectory.
  let manifests: Directory! = Dagger.directory

  # Node ports to expose on the k3s service.
  let nodePorts: [Int!]! = []

  # Registry mirrors keyed by registry host. Rendered into
  # /etc/rancher/k3s/registries.yaml and used to bind backing services lazily.
  let mirrors: Map[RegistryMirror!] = [:]

  new(
    """
    Name of the cluster (used as the TLS SAN and service name).

    Make sure to use a unique name for each cluster in the same session.
    Avoid using generated names to maximize cache hits.
    """
    name: String! = "k3s",
    """
    Pre-generated cluster certificates to use instead of generating fresh ones.

    Keep the same cluster identity across cache busts and restarts,
    so a previously generated kubeconfig keeps working.
    When null, a fresh set is generated (and cached for future use).
    """
    certs: Directory,
    """
    Node ports to expose on the k3s service.
    """
    nodePorts: [Int!]! = [],
    """
    Version (image tag) to use from the official image repository as a base container.
    """
    version: String! = "latest",
    """
    Custom container to use as a base container.
    """
    container: Container! = Dagger.container.from("rancher/k3s:" + version),
  ) {
    self.name = name
    self.certs = certs ?? gencerts(name)
    self.nodePorts = nodePorts
    self.clientContainer = container
    self.baseContainer = container
      .withMountedTemp("/etc/lib/cni")
      .withMountedTemp("/var/lib/kubelet")
      .withMountedTemp("/var/log")

    self
  }

  """
  Expose an additional NodePort on the K3s service.
  """
  withNodePort(
    """
    NodePort to expose.
    """
    port: Int!,
  ): K3s! {
    self.nodePorts += [port]

    self
  }

  """
  Auto-deploy a single manifest file to the cluster.

  K3s applies manifests dropped into its server manifests directory at startup
  (and reconciles them while running), so the manifest is created without any
  explicit `kubectl apply`.

  Documentation: https://docs.k3s.io/installation/packaged-components
  """
  withManifestFile(
    """
    Path to write the manifest to in the server manifests directory.
    """
    path: String!,
    """
    Manifest file.
    """
    file: File!,
  ): K3s! {
    self.manifests = self.manifests.withFile(path, file)

    self
  }

  """
  Auto-deploy a directory of manifests to the cluster.

  The directory contents are merged into the server manifests directory, where
  K3s applies them at startup (and reconciles them while running).

  Documentation: https://docs.k3s.io/installation/packaged-components
  """
  withManifestDirectory(directory: Directory!): K3s! {
    self.manifests = self.manifests.withDirectory(".", directory)

    self
  }

  """
  Configure a registry mirror.

  Endpoints must be reachable from inside the cluster. Use withRegistryService
  to bind a Dagger registry service and configure the mirror in one step.

  Calling this function again for the same registry replaces the existing mirror.
  """
  withRegistryMirror(
    """
    Registry host to mirror, as it appears in image references (for example "docker.io").
    """
    registry: String!,
    """
    Mirror endpoint URLs (for example ["http://registry.local:5000"]).
    """
    endpoints: [String!]!,
    """
    Optional image path rewrite rules in REGEX=REPLACEMENT form.
    """
    rewrites: [String!]! = [],
  ): K3s! {
    self.mirrors = self
      .mirrors
      .with(registry, RegistryMirror(endpoints, rewrites, null))

    self
  }

  """
  Bind a Dagger registry service and configure it as a mirror for the given registry host.

  The service is bound to the k3s server container when that container is
  assembled, and its HTTP endpoint is added to the registry configuration. Pulls
  for images on the registry host are then served from the bound registry.
  """
  withRegistryService(
    """
    Registry service to use as the mirror endpoint.
    """
    service: Service!,
    """
    Port the registry service listens on (in case it exposes multiple ports).
    """
    port: Int,
    """
    Registry host to mirror, as it appears in image references (for example "registry.local").

    When omitted, this defaults to the service endpoint without the URL scheme.

    It must contain a dot or a port so that it is treated as a registry rather
    than a Docker Hub namespace.
    """
    registry: String! = service.endpoint(scheme: "http", port: port).trimPrefix("http://"),
    """
    Optional image path rewrite rules in REGEX=REPLACEMENT form.
    """
    rewrites: [String!]! = [],
  ): K3s! {
    let endpoint = service.endpoint(scheme: "http", port: port)

    self.mirrors = self.mirrors.with(
      registry,
      RegistryMirror([endpoint], rewrites, service),
    )

    self
  }

  """
  The K3s server service.
  """
  service: Service! {
    self
      .serverContainer
      .asService(
        args: [
          "k3s", "server",
          "--debug",
          "--tls-san", self.name,
          "--disable", "metrics-server",
          "--egress-selector-mode", "disabled",
          "--snapshotter=native",
        ],
        insecureRootCapabilities: true,
        noInit: true,
      )
      .withHostname(self.name)
  }

  """
  A kubectl client preconfigured to access the cluster.
  """
  kubectl: Kubectl! {
    # Binding the K3s service stays lazy: kubeconfig execs run unbound (and
    # cache), and the service only starts when a container actually runs.
    Kubectl(self.clientContainer, self.service, self.tlsCerts)
  }

  """
  The cluster certificates (CA material, service key and admin credentials).

  Export this directory and feed it back via the `certs` constructor argument to
  pin the cluster identity across cache busts and restarts. Because the server
  and admin CAs stay the same, a kubeconfig generated against this cluster keeps
  working without regenerating anything.
  """
  certificates: Directory! {
    self.certs
  }

  """
  A kubeconfig for reaching the cluster from the host over localhost.

  This is a plain config file: it needs no running service to build and only
  embeds the admin credentials and the cluster CA. Publish the API server to the
  host (for example `service up --ports <port>:6443`) and point kubectl at this
  config. The TLS server name is the cluster name, which the server advertises
  as a SAN, so verification succeeds even though the connection is to localhost.
  """
  kubeconfig(
    """
    Local port the API server is published on.
    """
    port: Int! = 6443,
  ): File! {
    Dagger
      .kubectl(self.clientContainer)
      .withCluster(
        "default",
        `https://localhost:${toString(port)}`,
        ca: self.tlsCerts.file("server-ca.crt"),
        tlsServerName: self.name,
      )
      .withCredentials(
        "default",
        self.tlsCerts.file("client-admin.crt"),
        self.tlsCerts.file("client-admin.key"),
      )
      .withContext("default", cluster: "default", user: "default", use: true)
      .config
  }

  """
  Everything needed to reach the cluster from the host, in a single directory:
  a `kubeconfig` file and a `certs` subdirectory.

  Export it once (`local-access export --path ./mycluster`), then bring the
  cluster up reusing the saved certs:

      dagger call --certs ./mycluster/certs service up --ports 6443:6443

  and point kubectl at `./mycluster/kubeconfig`. Re-running against the same
  certs keeps the saved kubeconfig valid.
  """
  localAccess(
    """
    Local port the API server is published on.
    """
    port: Int! = 6443,
  ): Directory! {
    Dagger
      .directory
      .withDirectory("certs", self.certs)
      .withFile("kubeconfig", self.kubeconfig(port))
  }

  # The cluster certs to actually use: validated against the cluster name and
  # with the ownership marker stripped so it never reaches k3s's TLS directory.
  #
  # Computed lazily, so the name guard only runs when the cluster (or a
  # kubeconfig) is built, never during construction.
  let tlsCerts: Directory! {
    let owner = self.certsOwner

    if (owner != null and owner! != self.name) {
      raise `these certificates were generated for cluster "${owner!}", but this cluster is named "${self.name}"; pass the matching --certs or change --name`
    }

    self.certs.withoutFile(".cluster-name")
  }

  # The cluster name recorded in the certs directory, or null when the certs
  # carry no marker (for example an externally assembled set).
  let certsOwner: String {
    if (self.certs.entries.contains(".cluster-name")) {
      self.certs.file(".cluster-name").contents
    } else {
      null
    }
  }

  # The k3s server container with manifests and the registry config layered on.
  let serverContainer: Container! {
    # Mount the cluster certs here (not in baseContainer) so the cluster-name
    # guard in tlsCerts runs lazily, only when the server is actually built.
    let container = self.baseContainer.withDirectory(
      "/var/lib/rancher/k3s/server/tls",
      self.tlsCerts,
    )

    container = ([6443] + self.nodePorts).uniq.reduce(container) { container, port =>
      if (port == 6443) {
        container.withExposedPort(port)
      } else {
        container.withExposedPort(port, experimentalSkipHealthcheck: true)
      }
    }

    let manifests = self.manifests
    let mirrors = self.mirrors

    if (!manifests.entries.isEmpty) {
      container = container.withDirectory(
        "/var/lib/rancher/k3s/server/manifests",
        manifests,
      )
    }

    # K3s needs /etc/rancher/k3s writable for the runtime-generated kubeconfig.
    # Without registries it is a throwaway temp mount; with registries it is a
    # writable directory mount that also carries registries.yaml (a file nested
    # inside a temp mount is not delivered to the container).
    container = mirrors.keys.reduce(container) { container, registry =>
      let mirror = mirrors.get(registry)!

      if (mirror.service != null) {
        container = container.withServiceBinding(mirror.service!.hostname, mirror.service!)
      }

      container
    }

    if (mirrors.keys.isEmpty) {
      container = container.withMountedTemp("/etc/rancher/k3s")
    } else {
      let registriesFile = self.registriesFile

      container = container.withMountedDirectory(
        "/etc/rancher/k3s",
        Dagger.directory.withFile("registries.yaml", registriesFile),
      )
    }

    container
  }

  # The rendered /etc/rancher/k3s/registries.yaml mirror configuration.
  let registriesFile: File! {
    let config = {{
      mirrors: mirrors.map { registry, mirror =>
        {{
          endpoint: mirror.endpoints,
          rewrite: mirror.rewrites.reduce([:]) { config, rewrite =>
            let parts = rewrite.split("=")

            if (parts.length < 2) {
              raise "registry rewrite must be in REGEX=REPLACEMENT form: " + rewrite
            }

            config.with(parts[0]!, parts[1]!)
          }
        }}
      }
    }}

    Dagger.file("registries.yaml", YAML.encode(config))
  }

  let gencerts(seed: String!): Directory! {
    let suffix = "@" + seed

    let crypto = Dagger.crypto
    let x509 = crypto.x509

    let service = crypto.key.generate(name: "service" + suffix).rsa(2048)

    let rsagen = x509.create.rsa(4096)

    let root = rsagen.root("k3s-root-ca" + suffix, notAfter: "175200h")

    let intermediate = rsagen.intermediate(
      "k3s-intermediate-ca" + suffix,
      root.issuer,
      notAfter: "88800h",
    )

    let issuer = intermediate.issuer

    let ecgen = x509.create(notAfter: "88800h").ec(CryptoEcCurve.P256)

    let client = ecgen.intermediate(
      "k3s-client-ca" + suffix,
      issuer,
      name: "client-ca",
    )

    let server = ecgen.intermediate(
      "k3s-server-ca" + suffix,
      issuer,
      name: "server-ca",
    )

    let requestHeader = ecgen.intermediate(
      "k3s-request-header-ca" + suffix,
      issuer,
      name: "request-header-ca",
    )

    let etcdPeer = ecgen.intermediate(
      "k3s-etcd-peer-ca" + suffix,
      issuer,
      name: "etcd-peer-ca",
    )

    let etcdServer = ecgen.intermediate(
      "k3s-etcd-server-ca" + suffix,
      issuer,
      name: "etcd-server-ca",
    )

    let admin = x509
      .create(template: Dagger.currentModule.source.file("client.json"), notAfter: "8760h")
      .rsa(2048)
      .certificate("system:admin", client.issuer, name: "client-admin")

    Dagger
      .directory
      .withFile("service.key", service.privateKey.file)
      .withFile("root-ca.key", root.key.file)
      .withFile("root-ca.pem", root.certificate.file)
      .withFile("root-ca.crt", root.certificate.fullChain)
      .withFile("intermediate-ca.key", intermediate.key.file)
      .withFile("intermediate-ca.pem", intermediate.certificate.file)
      .withFile("intermediate-ca.crt", intermediate.certificate.fullChain)
      .withFile("client-ca.key", client.key.file)
      .withFile("client-ca.pem", client.certificate.file)
      .withFile("client-ca.crt", client.certificate.fullChain)
      .withFile("server-ca.key", server.key.file)
      .withFile("server-ca.pem", server.certificate.file)
      .withFile("server-ca.crt", server.certificate.fullChain)
      .withFile("request-header-ca.key", requestHeader.key.file)
      .withFile("request-header-ca.pem", requestHeader.certificate.file)
      .withFile("request-header-ca.crt", requestHeader.certificate.fullChain)
      .withFile("etcd/peer-ca.key", etcdPeer.key.file)
      .withFile("etcd/peer-ca.pem", etcdPeer.certificate.file)
      .withFile("etcd/peer-ca.crt", etcdPeer.certificate.fullChain)
      .withFile("etcd/server-ca.key", etcdServer.key.file)
      .withFile("etcd/server-ca.pem", etcdServer.certificate.file)
      .withFile("etcd/server-ca.crt", etcdServer.certificate.fullChain)
      .withFile("client-admin.key", admin.key.file)
      .withFile("client-admin.crt", admin.certificate.fullChain)
      # Record which cluster these certs belong to, so injecting them into a
      # differently named cluster can be caught (see tlsCerts). Stripped before
      # the directory is mounted into k3s.
      .withNewFile(".cluster-name", seed)
  }
}

type RegistryMirror {
  let endpoints: [String!]!
  let rewrites: [String!]!
  let service: Service
}
