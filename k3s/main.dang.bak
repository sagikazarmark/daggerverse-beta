type K3s {
  """
  Generate custom CA certificates for bootstrapping K3s.
  """
  pub certs(seed: String!): Directory! {
    CertGenerator.generate(seed)
  }

  """
  Return a kubeconfig for the generated system:admin client certificate.
  """
  pub kubeconfig(
    seed: String! = "k3s",
    server: String! = "https://k3s:6443",
  ): File! {
    Dagger
      .container
      .from("alpine:latest")
      .withExec(["mkdir", "-p", "/work"])
      .withWorkdir("/work")
      .withDirectory("/certs", self.certs(seed))
      .withEnvVariable("SERVER", server)
      .withExec(["sh", "-c", self.kubeconfigScript], redirectStdout: "kubeconfig")
      .file("/work/kubeconfig")
  }

  """
  Return a K3s server service bootstrapped from generated CA certificates.
  """
  pub service(
    seed: String! = "k3s",
    image: String! = "rancher/k3s:latest",
    enableTraefik: Boolean! = false,
    nodePort: Int = null,
  ): Service! {
    let args = ["k3s", "server", "--debug", "--tls-san", "k3s", "--disable", "metrics-server", "--egress-selector-mode=disabled", "--snapshotter=native"]

    if (!enableTraefik) {
      args = args + ["--disable", "traefik"]
    }

    let container = Dagger
      .container
      .from(image)
      # .withNewFile("/usr/bin/entrypoint.sh", ENTRYPOINT, permissions: 755)
      # .withEntrypoint(["entrypoint.sh"])
      .withDirectory("/var/lib/rancher/k3s/server/tls", self.certs(seed))
      .withMountedTemp("/etc/rancher/k3s")
      .withMountedTemp("/etc/lib/cni")
      .withMountedTemp("/var/lib/kubelet")
      .withMountedTemp("/var/log")
      .withExposedPort(6443)

    if (nodePort != null) {
      container = container.withExposedPort(nodePort, experimentalSkipHealthcheck: true)
    }

    container
      .asService(
        args: args,
        insecureRootCapabilities: true,
        # useEntrypoint: false,
        experimentalPrivilegedNesting: true,
        noInit: true,
      )
  }

  """
  Return a kubectl container configured to talk to the K3s service.
  """
  pub kubectl(
    seed: String! = "k3s",
    k3sImage: String! = "rancher/k3s:latest",
    kubectlImage: String! = "bitnami/kubectl:latest",
    nodePort: Int = null,
  ): Container! {
    Dagger
      .container
      .from(kubectlImage)
      .withoutEntrypoint
      .withServiceBinding(
        "k3s",
        self.service(seed: seed, image: k3sImage, nodePort: nodePort),
      )
      .withFile("/tmp/kubeconfig", self.kubeconfig(seed), permissions: 420)
      .withEnvVariable("KUBECONFIG", "/tmp/kubeconfig")
  }

  # NOTE: written at column 0 on purpose: dang multiline strings preserve
  # indentation and the heredoc terminator (EOF) only works at column 0.
  let kubeconfigScript: String! = """set -eu
  ca="$(base64 < /certs/server-ca.crt | tr -d '\n')"
  cert="$(base64 < /certs/client-admin.crt | tr -d '\n')"
  key="$(base64 < /certs/client-admin.key | tr -d '\n')"

  cat <<EOF
  apiVersion: v1
  kind: Config
  clusters:
  - name: k3s
    cluster:
      server: ${SERVER}
      tls-server-name: k3s
      certificate-authority-data: ${ca}
  users:
  - name: system:admin
    user:
      client-certificate-data: ${cert}
      client-key-data: ${key}
  contexts:
  - name: k3s
    context:
      cluster: k3s
      user: system:admin
  current-context: k3s
  EOF
  """
}
