type StepCertGenerator {
  let container: Container!

  new(
    stepVersion: String = null,
    alpineVersion: String! = "latest",
    container: Container! = Dagger.container.from("alpine:" + alpineVersion),
  ) {
    self.container = withStep(container, stepVersion)

    self
  }

  pub generate(
    seed: String!,
  ): Directory! {
    let container = self
      .container
      .withWorkdir("/work")
      .withExec(["mkdir", "-p", "etcd"])
      .withEnvVariable("SEED", seed) # set the seed for the Dagger cache key

    let suffix = "@" + seed

    container = container.withExec([
      "step", "crypto", "keypair", "service.pub", "service.key",
      "--kty", "RSA", "--size", "2048", "--no-password", "--insecure",
    ])

    # Root CA
    container = container
      .withExec([
        "step", "certificate", "create", "k3s-root-ca" + suffix,
        "root-ca.pem", "root-ca.key",
        "--profile", "root-ca", "--kty", "RSA", "--size", "4096",
        "--not-after", "175200h", "--no-password", "--insecure",
      ])
      .withExec(["cp", "root-ca.pem", "root-ca.crt"])

    # Intermediate CA
    container = container
      .withExec([
        "step", "certificate", "create", "k3s-intermediate-ca" + suffix,
        "intermediate-ca.pem", "intermediate-ca.key",
        "--profile", "intermediate-ca", "--ca", "root-ca.pem", "--ca-key", "root-ca.key",
        "--kty", "RSA", "--size", "4096", "--not-after", "88800h",
        "--no-password", "--insecure",
      ])
      .withExec(
        ["step", "certificate", "bundle", "intermediate-ca.pem", "root-ca.pem", "intermediate-ca.crt", "--force"],
      )

    # Leaf CAs
    container = self.leafCA(container, "client", "k3s-client-ca" + suffix)
    container = self.leafCA(container, "server", "k3s-server-ca" + suffix)
    container = self.leafCA(container, "request-header", "k3s-request-header-ca" + suffix)
    container = self.leafCA(container, "etcd/peer", "k3s-etcd-peer-ca" + suffix)
    container = self.leafCA(container, "etcd/server", "k3s-etcd-server-ca" + suffix)
    container = self.adminCert(container)

    container
      .withExec(["rm", "-f", "service.pub", "client-admin.pem", ".admin.tpl"])
      .directory("/work")
  }

  let leafCA(container: Container!, name: String!, cn: String!): Container! {
    container
      .withExec([
        "step", "certificate", "create", cn,
        name + "-ca.pem", name + "-ca.key",
        "--profile", "intermediate-ca", "--ca", "intermediate-ca.pem", "--ca-key", "intermediate-ca.key",
        "--kty", "EC", "--curve", "P-256", "--not-after", "88800h",
        "--no-password", "--insecure",
      ])
      .withExec(
        ["step", "certificate", "bundle", name + "-ca.pem", "intermediate-ca.crt", name + "-ca.crt", "--force"],
      )
      # step bundle omits the root trust anchor; K3s expects it in CA bundles.
      .withExec(["sh", "-c", "cat root-ca.pem >> " + name + "-ca.crt"])
  }

  let adminCert(container: Container!): Container! {
    container
      .withNewFile(".admin.tpl", self.adminTemplate)
      .withExec([
        "step", "certificate", "create", "system:admin",
        "client-admin.pem", "client-admin.key",
        "--template", ".admin.tpl",
        "--ca", "client-ca.pem", "--ca-key", "client-ca.key",
        "--kty", "RSA", "--size", "2048", "--not-after", "8760h",
        "--no-password", "--insecure",
      ])
      .withExec(
        ["step", "certificate", "bundle", "client-admin.pem", "client-ca.crt", "client-admin.crt", "--force"],
      )
      .withExec(["sh", "-c", "cat intermediate-ca.pem root-ca.pem >> client-admin.crt"])
  }

  let adminTemplate: String! = """{
    "subject": {
      "commonName": {{ toJson .Subject.CommonName }},
      "organization": ["system:masters"]
    },
    "keyUsage": ["digitalSignature"],
    "extKeyUsage": ["clientAuth"]
  }
  """

  let withStep(container: Container!, version: String): Container! {
    let release = Dagger.github.release(version, "smallstep/cli")
    let stepVersion = release.tagName.trimPrefix("v")
    let fileName = "step_linux_" + stepVersion + "_" + arch + ".tar.gz"

    let binary = release
      .asset(fileName)
      .extracted(true)
      .file("bin/step")

    if (binary == null) {
      raise "failed to download step binary"
    }

    container.withFile("/usr/local/bin/step", binary)
  }

  let arch: String! {
    case (Dagger.defaultPlatform) {
      "linux/amd64" => "amd64"
      "linux/arm64" => "arm64"
      else => raise "unsupported platform: " + toString(Dagger.defaultPlatform).trim("\"")
    }
  }
}
