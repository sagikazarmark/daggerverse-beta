type Tests {
  """
  kubectl can reach the generated K3s cluster.
  """
  clusterInfo: String! @check @cache(policy: FunctionCachePolicy.Never) {
    let kubectl = Dagger.kubectl.fromCluster(Dagger.k3S(name: "k3s-test"))

    # Wait for the API server to come up. Unused lets are never evaluated,
    # so the assert below forces this exec before the one under test.
    # The cache seed makes sure the exec runs (and starts the service) even
    # when an identical exec is already cached.
    let ready = kubectl
      .container
      .withEnvVariable("DAGGER_CACHE_SEED", Random.string)
      .withExec(["sh", "-c", "for i in $(seq 1 60); do kubectl cluster-info && exit 0; sleep 1; done; kubectl cluster-info"])
      .stdout

    assert { ready.contains("Kubernetes control plane is running") }

    # The service is still warm here, so a single try is enough.
    let output = kubectl.withExec(["cluster-info"]).stdout

    assert { output.contains("Kubernetes control plane is running") }

    output
  }

  """
  The kubeconfig of the K3s kubectl client points at the default context.
  """
  kubeconfig: String! @check {
    let output = Dagger.kubectl.fromCluster(Dagger.k3S(name: "k3s-test")).config.contents

    assert { output.contains("current-context: default") }

    output
  }

  """
  K3s can be passed directly to kubectl.fromCluster.
  """
  fromCluster: String! @check {
    let output = Dagger
      .kubectl
      .fromCluster(Dagger.k3S(name: "k3s-from-cluster-test"))
      .config
      .contents

    assert { output.contains("server: https://k3s-from-cluster-test:6443") }
    assert { output.contains("tls-server-name: k3s-from-cluster-test") }
    assert { output.contains("current-context: default") }

    output
  }

  """
  kubectl.fromCluster can register a named K3s cluster without clearing existing entries.
  """
  fromClusterNamed: [String!]! @check {
    let kubectl = Dagger
      .kubectl
      .withCluster("existing", "https://existing.example")
      .fromCluster(Dagger.k3S(name: "k3s-from-cluster-named-test"), name: "named")

    assert { kubectl.clusters.contains("existing") }
    assert { kubectl.clusters.contains("named") }
    assert { kubectl.users.contains("named") }
    assert { kubectl.contexts.contains("named") }
    assert { kubectl.currentContext == "named" }

    kubectl.clusters
  }

  """
  kubectl.fromCluster can reset existing kubeconfig entries before registering K3s.
  """
  fromClusterReset: [String!]! @check {
    let cluster = Dagger.k3S(name: "k3s-from-cluster-reset-test")

    let kubectl = Dagger
      .kubectl
      .withCluster("stale-cluster", "https://stale.example")
      .withCredentials("stale-user", cluster.clientCertificate, cluster.clientKey)
      .withContext(
        "stale-context",
        cluster: "stale-cluster",
        user: "stale-user",
        use: true,
      )
      .fromCluster(cluster, true)

    assert { kubectl.clusters.contains("default") }
    assert { !kubectl.clusters.contains("stale-cluster") }
    assert { kubectl.users.contains("default") }
    assert { !kubectl.users.contains("stale-user") }
    assert { kubectl.contexts.contains("default") }
    assert { !kubectl.contexts.contains("stale-context") }
    assert { kubectl.currentContext == "default" }

    kubectl.clusters
  }

  """
  The localhost kubeconfig points at localhost on the configured port with the
  cluster name as the TLS server name.
  """
  localKubeconfig: String! @check {
    let output = Dagger
      .k3S(name: "k3s-local-kubeconfig-test")
      .kubeconfig(port: 7443)
      .contents

    assert { output.contains("server: https://localhost:7443") }
    assert { output.contains("tls-server-name: k3s-local-kubeconfig-test") }
    assert { output.contains("current-context: default") }

    output
  }

  """
  The local access bundle contains a kubeconfig and a certs subdirectory.
  """
  localAccess: [String!]! @check {
    let bundle = Dagger.k3S(name: "k3s-local-access-test").localAccess

    let entries = bundle.entries

    assert { entries.contains("kubeconfig") }
    assert { entries.contains("certs/") }
    assert { bundle.file("kubeconfig").contents.contains("server: https://localhost:6443") }

    entries
  }

  """
  Injecting certificates generated for a different cluster name is rejected.
  """
  certsNameMismatch: Void @check {
    # Generate certs as "owner", then try to use them under a different name.
    let certs = Dagger.k3S(name: "owner").certificates

    try {
      Dagger.k3S(name: "intruder", certs: certs).kubeconfig.contents

      raise "expected the cluster-name guard to reject mismatched certs"
    } catch {
      err => assert { err.message.contains(`generated for cluster "owner"`) }
    }
  }

  """
  A Pod can be started and reached through a fixed NodePort on the K3s service hostname.
  """
  podNodePort: String! @check @cache(policy: FunctionCachePolicy.Never) {
    let output = Dagger
      .kubectl
      .fromCluster(
        Dagger
          .k3S(name: "k3s-pod-test")
          .withNodePort(30080)
          .withNodePort(30080),
      )
      .container
      .withExec(["sh", "-c", self.podNodePortScript])
      .stdout

    assert { output.contains("Welcome to nginx") }

    output
  }

  """
  The K3s kubectl wrapper forwards expected-failure exec options.
  """
  kubectlExpect: Int! @check @cache(policy: FunctionCachePolicy.Never) {
    let result = Dagger
      .kubectl
      .fromCluster(Dagger.k3S(name: "k3s-kubectl-expect-test"))
      .withExec(["get", "pods"], context: "missing", expect: ReturnType.FAILURE)

    assert { result.exitCode > 0 }

    result.exitCode
  }

  """
  Auto-deploying manifests (a single file and a directory) are applied on startup.
  """
  manifest: String! @check @cache(policy: FunctionCachePolicy.Never) {
    let file = Dagger
      .directory
      .withNewFile("namespace.yaml", self.manifestFileYaml)
      .file("namespace.yaml")

    let directory = Dagger.directory.withNewFile("namespace.yaml", self.manifestDirYaml)

    let kubectl = Dagger
      .kubectl
      .fromCluster(
        k3S(name: "k3s-manifest-test")
          .withManifestFile("file-namespace.yaml", file)
          .withManifestDirectory(directory),
      )

    # K3s applies server manifests asynchronously once the API server is up,
    # so poll for the namespaces the manifests create.
    let output = kubectl
      .container
      .withEnvVariable("DAGGER_CACHE_SEED", Random.string)
      .withExec(["sh", "-c", "for i in $(seq 1 90); do kubectl get namespace k3s-manifest-file k3s-manifest-dir && exit 0; sleep 2; done; kubectl get namespace k3s-manifest-file k3s-manifest-dir"])
      .stdout

    assert { output.contains("k3s-manifest-file") }
    assert { output.contains("k3s-manifest-dir") }

    output
  }

  # NOTE: """ strings keep leading whitespace, so the manifest body stays at column 0
  # (its own internal indentation is preserved).
  let manifestFileYaml: String! = """apiVersion: v1
kind: Namespace
metadata:
  name: k3s-manifest-file
"""

  let manifestDirYaml: String! = """apiVersion: v1
kind: Namespace
metadata:
  name: k3s-manifest-dir
"""

  """
  A registry mirror backed by an olareg service serves image pulls for the cluster.
  """
  registry: String! @check @cache(policy: FunctionCachePolicy.Never) {
    # olareg serves the image under a rewritten path on a Dagger service endpoint,
    # so a successful pull can only have gone through the configured mirror.
    let olareg = Dagger
      .olareg
      .withContainer("mirror/nginx", "test", Dagger.container.from("nginx:1.27-alpine"))
      .service

    let rewrites = ["^library/(.*)=mirror/$1"]

    let registry = olareg.endpoint(scheme: "http", port: 5050).trimPrefix("http://")

    let kubectl = Dagger.kubectl.fromCluster(
      Dagger
        .k3S(name: "k3s-registry-test")
        .withRegistryService(olareg, port: 5050, rewrites: rewrites),
    )

    let output = kubectl
      .container
      .withEnvVariable("DAGGER_CACHE_SEED", Random.string)
      .withEnvVariable("REGISTRY", registry)
      .withExec(["sh", "-c", self.registryScript])
      .stdout

    assert { output.contains("phase=Running") }

    output
  }

  let registryScript: String! = """set -eu

  for i in $(seq 1 60); do
    kubectl cluster-info >/dev/null 2>&1 && break
    sleep 1
  done
  kubectl cluster-info >/dev/null

  for i in $(seq 1 60); do
    kubectl get serviceaccount default >/dev/null 2>&1 && break
    sleep 1
  done
  kubectl get serviceaccount default >/dev/null

  # The image path only exists after the mirror rewrite, so a successful pull proves
  # the configured mirror (the olareg service) served it.
  : "${REGISTRY:?}"
  kubectl run web --image="$REGISTRY/library/nginx:test" --port=80 --restart=Never
  kubectl wait --for=condition=Ready pod/web --timeout=180s

  printf 'phase=%s\n' "$(kubectl get pod web -o=jsonpath='{.status.phase}')"
  """

  # NOTE: """ strings keep leading whitespace, so the script must stay at column 0
  # (the heredoc terminator is only recognized unindented).
  let podNodePortScript: String! = """set -eu

for i in $(seq 1 60); do
  kubectl cluster-info >/dev/null 2>&1 && break
  sleep 1
done
kubectl cluster-info >/dev/null

for i in $(seq 1 60); do
  kubectl get serviceaccount default >/dev/null 2>&1 && break
  sleep 1
done
kubectl get serviceaccount default >/dev/null

kubectl run web --image=nginx:1.27-alpine --port=80 --restart=Never --labels app=web
kubectl wait --for=condition=Ready pod/web --timeout=180s

cat <<'EOF' | kubectl apply -f -
apiVersion: v1
kind: Service
metadata:
  name: web
spec:
  type: NodePort
  selector:
    app: web
  ports:
    - name: http
      port: 80
      targetPort: 80
      nodePort: 30080
EOF

for i in $(seq 1 60); do
  endpoint="$(kubectl get endpoints web -o=jsonpath='{.subsets[0].addresses[0].ip}' 2>/dev/null || true)"
  test -n "$endpoint" && break
  sleep 1
done
test -n "$endpoint"

node_port="$(kubectl get service web -o=jsonpath='{.spec.ports[0].nodePort}')"
test "$node_port" = "30080"
printf 'node_port=%s\n' "$node_port"

for i in $(seq 1 30); do
  if wget -q -T 2 -O /tmp/nodeport.html http://k3s-pod-test:30080; then
    break
  fi
  sleep 1
done

cat /tmp/nodeport.html
grep -q "Welcome to nginx" /tmp/nodeport.html
"""
}
