type Kubectl {
  """
  Container with kubectl configured.
  """
  container: Container!

  new(
    """
    Container with `kubectl` installed.
    """
    container: Container! = Dagger.container.from("alpine/kubectl:latest"),
  ) {
    self.container = container
      .withDirectory("/kube", Dagger.directory)
      .withEnvVariable("KUBECONFIG", "/kube/config")

    self
  }

  let with(&fn(container: Container!): Container!): Kubectl! {
    self.container = fn(self.container)

    self
  }

  """
  The merged and flattened kubeconfig file.
  """
  config: File! {
    self
      .container
      .withExec(
        ["kubectl", "config", "view", "--flatten", "--merge", "--output", "yaml"],
        redirectStdout: "/kubeconfig",
      )
      .file("/kubeconfig")
  }

  """
  Set a cluster entry in kubeconfig.
  """
  withCluster(
    """
    Name of the cluster entry in kubeconfig.
    """
    name: String!,
    """
    Server for the cluster entry in kubeconfig.
    """
    server: String!,
    """
    CA certificate for the cluster entry in kubeconfig.
    """
    ca: File,
    """
    TLS server name for the cluster entry in kubeconfig.
    """
    tlsServerName: String,
  ): Kubectl! {
    let caPath = `/kube/certs/servers/${name}/ca.crt`

    let args = [
      "kubectl",
      "config", "set-cluster", name,
      "--server", server,
    ]

    if (tlsServerName != null) {
      args += ["--tls-server-name", tlsServerName]
    }

    args += if (ca != null) {
      ["--certificate-authority", caPath]
    } else {
      ["--insecure-skip-tls-verify"]
    }

    self.with {
      _
        .{ if (ca != null) { _.withMountedFile(caPath, ca) } else { _ } }
        .withExec(args)
    }
  }

  """
  Set a cluster entry from a service in kubeconfig.
  """
  withClusterService(
    """
    Name of the cluster entry in kubeconfig.
    """
    name: String!,
    """
    Service for the cluster entry in kubeconfig.
    """
    service: Service!,
    """
    Port of the service to use (in case the service has multiple ports exposed).
    """
    servicePort: Int,
    """
    CA certificate for the cluster entry in kubeconfig.
    """
    ca: File,
    """
    TLS server name for the cluster entry in kubeconfig.
    """
    serverName: String,
  ): Kubectl! {
    self
      .withCluster(
        name,
        service.endpoint(scheme: "https", port: servicePort),
        ca,
        serverName,
      )
      .with { _.withServiceBinding(service.hostname, service) }
  }

  """
  Set a user entry in kubeconfig using client certificate and key.
  """
  withCredentials(
    """
    Name of the user entry in kubeconfig.
    """
    name: String!,
    """
    Client certificate for the user entry in kubeconfig.
    """
    certificate: File!,
    """
    Client key for the user entry in kubeconfig.
    """
    key: File!,
  ): Kubectl! {
    let path = `/kube/certs/users/${name}/`
    let certPath = path + "client.crt"
    let keyPath = path + "client.key"

    let args = [
      "kubectl",
      "config", "set-credentials", name,
      "--client-certificate", certPath, "--client-key", keyPath,
      "--embed-certs",
    ]

    self.with {
      _
        .withMountedFile(certPath, certificate)
        .withMountedFile(keyPath, key)
        .withExec(args)
    }
  }

  """
  Set a context entry in kubeconfig.
  """
  withContext(
    """
    Name of the context entry in kubeconfig.
    """
    name: String!,
    """
    Name of the cluster entry in kubeconfig.
    """
    cluster: String!,
    """
    Name of the user entry in kubeconfig.
    """
    user: String!,
    """
    Namespace for the context entry in kubeconfig.
    """
    namespace: String,
    """
    Set the context as the current context.
    """
    setCurrent: Boolean! = false,
  ): Kubectl! {
    let args = [
      "kubectl",
      "config", "set-context", name,
      "--cluster", cluster, "--user", user,
    ]

    if (namespace != null) {
      args += ["--namespace", namespace]
    }

    self.with {
      _
        .withExec(args)
        .{
          if (setCurrent) {
            _.withExec(["kubectl", "config", "use-context", name])
          } else { _ }
        }
    }
  }

  """
  Set the namespace (for the current or a specific context).
  """
  withNamespace(
    """
    Namespace for a context entry in kubeconfig.
    """
    namespace: String!,
    """
    Name of the context entry in kubeconfig (default: current context).
    """
    context: String,
  ): Kubectl! {
    let args = [
      "kubectl",
      "config", "set-context",
      if (context != null) { context } else { "--current" },
      "--namespace", namespace,
    ]

    self.with { _.withExec(args) }
  }

  """
  Run a kubectl command.

  The result is never cached: kubectl commands usually act on live cluster state,
  so each evaluation runs the command again.
  """
  withExec(
    """
    Command arguments ("kubectl" is prepended when it is not the first argument).
    """
    args: [String!]!,
    """
    Name of the context entry in kubeconfig to use.
    """
    context: String,
    """
    Content to write to the command's standard input.
    """
    stdin: String,
    """
    Exit codes this command is allowed to exit with without error (default: SUCCESS).
    """
    expect: ReturnType,
  ): Container! @cache(policy: FunctionCachePolicy.Never) {
    let _args = (
      if ((args[0] ?? "") == "kubectl") { args } else { ["kubectl"] + args }
    )

    if (context != null) {
      _args += ["--context", context]
    }

    self
      .container
      .withEnvVariable("DAGGER_CACHE_SEED", Random.string)
      .withExec(_args, stdin: stdin, expect: expect)
  }

  """
  Apply a manifest file to the cluster.
  """
  applyFile(
    """
    Manifest file to apply.
    """
    file: File!,
    """
    Name of the context entry in kubeconfig to use.
    """
    context: String,
    """
    Namespace to apply the manifest in.
    """
    namespace: String,
  ): Container! @cache(policy: FunctionCachePolicy.Never) {
    let path = "/work/manifest.yaml"

    self
      .with { _.withMountedFile(path, file) }
      .withExec(applyArgs(path, namespace), context: context)
  }

  """
  Apply manifests from a directory to the cluster.
  """
  applyDirectory(
    """
    Directory containing the manifests to apply.
    """
    directory: Directory!,
    """
    Name of the context entry in kubeconfig to use.
    """
    context: String,
    """
    Namespace to apply the manifests in.
    """
    namespace: String,
    """
    Process the directory recursively.
    """
    recursive: Boolean! = false,
  ): Container! @cache(policy: FunctionCachePolicy.Never) {
    let path = "/work/manifests"

    let args = applyArgs(path, namespace)

    if (recursive) {
      args += ["--recursive"]
    }

    self
      .with { _.withMountedDirectory(path, directory) }
      .withExec(applyArgs(path, namespace), context: context)
  }
}

let applyArgs(path: String!, namespace: String): [String!]! {
  let args = ["apply", "--filename", path]

  if (namespace != null) {
    args += ["--namespace", namespace]
  }

  args
}
