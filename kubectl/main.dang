type Kubectl {
  let baseContainer: Container!
  let services: Map[Service!] = [:]

  new(
    """
    Container with `kubectl` installed.
    """
    container: Container! = Dagger.container.from("alpine/kubectl:latest"),
  ) {
    self.baseContainer = container
      .withDirectory("/kube", Dagger.directory)
      .withEnvVariable("KUBECONFIG", "/kube/config")

    self
  }

  """
  Container with kubectl configured.
  """
  container: Container! {
    self.services.keys.reduce(self.baseContainer) { container, name =>
      let service = self.services.get(name)!

      container.withServiceBinding(service.hostname, service)
    }
  }

  let with(&fn(container: Container!): Container!): Kubectl! {
    self.baseContainer = fn(self.baseContainer)

    self
  }

  let withService(name: String!, service: Service!): Kubectl! {
    self.services = self.services.with(name, service)

    self
  }

  let withoutService(name: String!): Kubectl! {
    self.services = self.services.without(name)

    self
  }

  """
  The merged and flattened kubeconfig file.
  """
  config: File! {
    self
      .baseContainer
      .withExec(
        ["kubectl", "config", "view", "--flatten", "--merge", "--output", "yaml"],
        redirectStdout: "/kubeconfig",
      )
      .file("/kubeconfig")
  }

  """
  Set a cluster entry in kubeconfig.
  """
  withCluster(
    """
    Name of the cluster entry in kubeconfig.
    """
    name: String!,
    """
    Server for the cluster entry in kubeconfig.
    """
    server: String!,
    """
    CA certificate for the cluster entry in kubeconfig.
    """
    ca: File,
    """
    TLS server name for the cluster entry in kubeconfig.
    """
    tlsServerName: String,
  ): Kubectl! {
    let args = [
      "kubectl",
      "config", "set-cluster", name,
      "--server", server,
    ]

    if (tlsServerName != null) {
      args += ["--tls-server-name", tlsServerName]
    }

    let caPath = `/kube/certs/servers/${name}/ca.crt`

    args += if (ca != null) {
      ["--certificate-authority", caPath]
    } else {
      ["--insecure-skip-tls-verify"]
    }

    self
      .withoutService(name)
      .with {
        if (ca != null) { _ = _.withMountedFile(caPath, ca) }

        _.withExec(args)
      }
  }

  """
  Remove a cluster entry from kubeconfig.
  """
  withoutCluster(
    """
    Name of the cluster entry in kubeconfig.
    """
    name: String!,
  ): Kubectl! {
    self
      .withoutService(name)
      .with { _.withExec(["kubectl", "config", "delete-cluster", name]) }
  }

  """
  List cluster entries in kubeconfig.
  """
  clusters: [String!]! {
    self
      .baseContainer
      .withExec(["kubectl", "config", "get-clusters"])
      .stdout
      .{ configNames(_) }
  }

  """
  Set a cluster entry from a service in kubeconfig.
  """
  withClusterService(
    """
    Name of the cluster entry in kubeconfig.
    """
    name: String!,
    """
    Service for the cluster entry in kubeconfig.
    """
    service: Service!,
    """
    Port of the service to use (in case the service has multiple ports exposed).
    """
    servicePort: Int,
    """
    CA certificate for the cluster entry in kubeconfig.
    """
    ca: File,
    """
    TLS server name for the cluster entry in kubeconfig.
    """
    serverName: String,
  ): Kubectl! {
    self
      .withCluster(
        name,
        service.endpoint(scheme: "https", port: servicePort),
        ca,
        serverName,
      )
      .withService(name, service)
  }

  """
  Set a user entry in kubeconfig using client certificate and key.
  """
  withCredentials(
    """
    Name of the user entry in kubeconfig.
    """
    name: String!,
    """
    Client certificate for the user entry in kubeconfig.
    """
    certificate: File!,
    """
    Client key for the user entry in kubeconfig.
    """
    key: File!,
  ): Kubectl! {
    let path = `/kube/certs/users/${name}/`
    let certPath = path + "client.crt"
    let keyPath = path + "client.key"

    let args = [
      "kubectl",
      "config", "set-credentials", name,
      "--client-certificate", certPath, "--client-key", keyPath,
      "--embed-certs",
    ]

    self.with {
      _
        .withMountedFile(certPath, certificate)
        .withMountedFile(keyPath, key)
        .withExec(args)
    }
  }

  """
  Remove a user entry from kubeconfig.
  """
  withoutUser(
    """
    Name of the user entry in kubeconfig.
    """
    name: String!,
  ): Kubectl! {
    self.with { _.withExec(["kubectl", "config", "delete-user", name]) }
  }

  """
  List user entries in kubeconfig.
  """
  users: [String!]! {
    self
      .baseContainer
      .withExec(["kubectl", "config", "get-users"])
      .stdout
      .{ configNames(_) }
  }

  """
  Set a context entry in kubeconfig.
  """
  withContext(
    """
    Name of the context entry in kubeconfig.
    """
    name: String!,
    """
    Name of the cluster entry in kubeconfig.
    """
    cluster: String!,
    """
    Name of the user entry in kubeconfig.
    """
    user: String!,
    """
    Namespace for the context entry in kubeconfig.
    """
    namespace: String,
    """
    Set the context as the current context.
    """
    use: Boolean! = false,
  ): Kubectl! {
    let args = [
      "kubectl",
      "config", "set-context", name,
      "--cluster", cluster, "--user", user,
    ]

    if (namespace != null) {
      args += ["--namespace", namespace]
    }

    self.with {
      _
        .withExec(args)
        .{
          if (use) {
            _.withExec(["kubectl", "config", "use-context", name])
          } else { _ }
        }
    }
  }

  """
  Remove a context entry from kubeconfig.
  """
  withoutContext(
    """
    Name of the context entry in kubeconfig.
    """
    name: String!,
  ): Kubectl! {
    self.with { _.withExec(["kubectl", "config", "delete-context", name]) }
  }

  """
  List context entries in kubeconfig.
  """
  contexts: [String!]! {
    self
      .baseContainer
      .withExec(["kubectl", "config", "get-contexts", "--output", "name"])
      .stdout
      .{ configNames(_) }
  }

  """
  Name of the current context.
  """
  currentContext: String! {
    self
      .baseContainer
      .withExec(["kubectl", "config", "current-context"])
      .stdout
      .trimSpace
  }

  """
  Rename a context entry in kubeconfig.
  """
  renameContext(
    """
    Existing name of the context entry in kubeconfig.
    """
    name: String!,
    """
    New name for the context entry in kubeconfig.
    """
    newName: String!,
  ): Kubectl! {
    self.with { _.withExec(["kubectl", "config", "rename-context", name, newName]) }
  }

  """
  Set the namespace (for the current or a specific context).
  """
  withNamespace(
    """
    Namespace for a context entry in kubeconfig.
    """
    namespace: String!,
    """
    Name of the context entry in kubeconfig (default: current context).
    """
    context: String,
  ): Kubectl! {
    let args = [
      "kubectl",
      "config", "set-context",
      if (context != null) { context } else { "--current" },
      "--namespace", namespace,
    ]

    self.with { _.withExec(args) }
  }

  """
  Run a kubectl command.

  The result is never cached: kubectl commands usually act on live cluster state,
  so each evaluation runs the command again.
  """
  withExec(
    """
    Command arguments ("kubectl" is prepended when it is not the first argument).
    """
    args: [String!]!,
    """
    Name of the context entry in kubeconfig to use.
    """
    context: String,
    """
    Content to write to the command's standard input.
    """
    stdin: String,
    """
    Redirect the command's standard input from a file in the container.
    """
    redirectStdin: String,
    """
    Redirect the command's standard output to a file in the container.
    """
    redirectStdout: String,
    """
    Redirect the command's standard error to a file in the container.
    """
    redirectStderr: String,
    """
    Exit codes this command is allowed to exit with without error (default: SUCCESS).
    """
    expect: ReturnType,
  ): Container! @cache(policy: FunctionCachePolicy.Never) {
    let command = ["kubectl"]

    if (context != null) {
      command += ["--context", context]
    }

    if (args[0] == "kubectl") {
      args = args.dropFirst
    }

    self
      .container
      .withEnvVariable("DAGGER_CACHE_KEY", Random.string)
      .withExec(
        command + args,
        stdin: stdin,
        redirectStdin: redirectStdin,
        redirectStdout: redirectStdout,
        redirectStderr: redirectStderr,
        expect: expect,
      )
  }

  """
  Apply a manifest file to the cluster.
  """
  applyFile(
    """
    Manifest file to apply.
    """
    file: File!,
    """
    Name of the context entry in kubeconfig to use.
    """
    context: String,
    """
    Namespace to apply the manifest in.
    """
    namespace: String,
  ): Container! @cache(policy: FunctionCachePolicy.Never) {
    let path = "/work/manifest.yaml"

    self
      .with { _.withMountedFile(path, file) }
      .withExec(applyArgs(path, namespace), context: context)
  }

  """
  Apply manifests from a directory to the cluster.
  """
  applyDirectory(
    """
    Directory containing the manifests to apply.
    """
    directory: Directory!,
    """
    Name of the context entry in kubeconfig to use.
    """
    context: String,
    """
    Namespace to apply the manifests in.
    """
    namespace: String,
    """
    Process the directory recursively.
    """
    recursive: Boolean! = false,
  ): Container! @cache(policy: FunctionCachePolicy.Never) {
    let path = "/work/manifests"

    let args = applyArgs(path, namespace)

    if (recursive) {
      args += ["--recursive"]
    }

    self
      .with { _.withMountedDirectory(path, directory) }
      .withExec(args, context: context)
  }
}

let applyArgs(path: String!, namespace: String): [String!]! {
  let args = ["apply", "--filename", path]

  if (namespace != null) {
    args += ["--namespace", namespace]
  }

  args
}

let configNames(output: String!): [String!]! {
  output.trimSpace.split("\n").reject { name => name == "" or name == "NAME" }
}
