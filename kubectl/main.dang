type Kubectl {
  let baseContainer: Container!

  let clusterEntries: Map[Cluster!] = [:]
  let userEntries: Map[User!] = [:]
  let contextEntries: Map[Context!] = [:]

  """
  Name of the current context.
  """
  currentContext: String

  new(
    """
    Container with `kubectl` installed.
    """
    container: Container! = Dagger.container.from("alpine/kubectl:latest"),
  ) {
    self.baseContainer = container
      .withDirectory("/kube", Dagger.directory)
      .withEnvVariable("KUBECONFIG", "/kube/config")

    self
  }

  """
  Container with kubectl configured.
  """
  container: Container! {
    self.clusterEntries.values.reduce(self.configuredContainer) { container, cluster =>
      let service = cluster.service

      if (service != null) {
        container.withServiceBinding(service.hostname, service)
      } else container
    }
  }

  let configuredContainer: Container! {
    self
      .baseContainer
      .{
        self.clusterEntries.keys.reduce(_) { container, name =>
          self.clusterEntries[name]!.apply(name, container)
        }
      }
      .{
        self.userEntries.keys.reduce(_) { container, name =>
          self.userEntries[name]!.apply(name, container)
        }
      }
      .{
        self.contextEntries.keys.reduce(_) { container, name =>
          self.contextEntries[name]!.apply(name, container)
        }
      }
      .{
        let currentContext = self.currentContext
        if (currentContext != null and currentContext != "") {
          _.withExec([
            "kubectl",
            "config", "set", "current-context", currentContext,
          ])
        } else _
      }
  }

  """
  The merged and flattened kubeconfig file.
  """
  config: File! {
    self
      .configuredContainer
      .withExec(
        ["kubectl", "config", "view", "--flatten", "--merge", "--output", "yaml"],
        redirectStdout: "/kubeconfig",
      )
      .file("/kubeconfig")
  }

  """
  Set a cluster entry in kubeconfig.
  """
  withCluster(
    """
    Name of the cluster entry in kubeconfig.
    """
    name: String!,
    """
    Server for the cluster entry in kubeconfig.
    """
    server: String!,
    """
    CA certificate for the cluster entry in kubeconfig.
    """
    ca: File,
    """
    TLS server name for the cluster entry in kubeconfig.
    """
    serverName: String,
  ): Kubectl! {
    self.clusterEntries = self.clusterEntries.with(
      name,
      Cluster(server, ca, serverName, null),
    )

    self
  }

  """
  Remove a cluster entry from kubeconfig.
  """
  withoutCluster(
    """
    Name of the cluster entry in kubeconfig.
    """
    name: String!,
  ): Kubectl! {
    self.clusterEntries = self.clusterEntries.without(name)

    self
  }

  """
  List cluster entries in kubeconfig.
  """
  clusters: [String!]! {
    self.clusterEntries.keys
  }

  """
  Set a cluster entry from a service in kubeconfig.
  """
  withClusterService(
    """
    Name of the cluster entry in kubeconfig.
    """
    name: String!,
    """
    Service for the cluster entry in kubeconfig.
    """
    service: Service!,
    """
    Port of the service to use (in case the service has multiple ports exposed).
    """
    servicePort: Int,
    """
    CA certificate for the cluster entry in kubeconfig.
    """
    ca: File,
    """
    TLS server name for the cluster entry in kubeconfig.
    """
    serverName: String,
  ): Kubectl! {
    self.clusterEntries = self.clusterEntries.with(
      name,
      Cluster(
        service.endpoint(scheme: "https", port: servicePort),
        ca,
        serverName,
        service,
      ),
    )

    self
  }

  """
  Set a user entry in kubeconfig using client certificate and key.
  """
  withCredentials(
    """
    Name of the user entry in kubeconfig.
    """
    name: String!,
    """
    Client certificate for the user entry in kubeconfig.
    """
    certificate: File!,
    """
    Client key for the user entry in kubeconfig.
    """
    key: File!,
  ): Kubectl! {
    self.userEntries = self.userEntries.with(name, User(certificate, key))

    self
  }

  """
  Remove a user entry from kubeconfig.
  """
  withoutUser(
    """
    Name of the user entry in kubeconfig.
    """
    name: String!,
  ): Kubectl! {
    self.userEntries = self.userEntries.without(name)

    self
  }

  """
  List user entries in kubeconfig.
  """
  users: [String!]! {
    self.userEntries.keys
  }

  """
  Set a context entry in kubeconfig.
  """
  withContext(
    """
    Name of the context entry in kubeconfig.
    """
    name: String!,
    """
    Name of the cluster entry in kubeconfig.
    """
    cluster: String!,
    """
    Name of the user entry in kubeconfig.
    """
    user: String!,
    """
    Namespace for the context entry in kubeconfig.
    """
    namespace: String,
    """
    Set the context as the current context.
    """
    use: Boolean! = false,
  ): Kubectl! {
    self.contextEntries = self.contextEntries.with(
      name,
      Context(
        cluster,
        user,
        namespace,
      ),
    )

    if (use) {
      self.currentContext = name
    }

    self
  }

  """
  Remove a context entry from kubeconfig.
  """
  withoutContext(
    """
    Name of the context entry in kubeconfig.
    """
    name: String!,
  ): Kubectl! {
    self.contextEntries = self.contextEntries.without(name)

    self
  }

  """
  List context entries in kubeconfig.
  """
  contexts: [String!]! {
    self.contextEntries.keys
  }

  """
  Rename a context entry in kubeconfig.
  """
  renameContext(
    """
    Existing name of the context entry in kubeconfig.
    """
    name: String!,
    """
    New name for the context entry in kubeconfig.
    """
    newName: String!,
  ): Kubectl! {
    let context = self.contextEntries.get(name)

    if (context == null) {
      raise `context "${name}" not found in kubeconfig`
    }

    if (self.contextEntries.get(newName) != null) {
      raise `context "${newName}" already exists in kubeconfig`
    }

    self.contextEntries = self
      .contextEntries
      .without(name)
      .with(newName, context!)

    if (self.currentContext == name) {
      self.currentContext = newName
    }

    self
  }

  """
  Set the namespace (for the current or a specific context).
  """
  withNamespace(
    """
    Namespace for a context entry in kubeconfig.
    """
    namespace: String!,
    """
    Name of the context entry in kubeconfig (default: current context).
    """
    context: String,
  ): Kubectl! {
    let name = if (context != null) { context } else { self.currentContext }

    if (name == null or name == "") {
      raise "current context is not set in kubeconfig"
    }

    let entry = self.contextEntries.get(name)

    if (entry == null) {
      raise `context "${name}" not found in kubeconfig`
    }

    self.contextEntries = self.contextEntries.with(
      name,
      Context(entry.cluster, entry.user, namespace),
    )

    self
  }

  """
  Run a kubectl command.

  The result is never cached: kubectl commands usually act on live cluster state,
  so each evaluation runs the command again.
  """
  withExec(
    """
    Command arguments ("kubectl" is prepended when it is not the first argument).
    """
    args: [String!]!,
    """
    Name of the context entry in kubeconfig to use.
    """
    context: String,
    """
    Content to write to the command's standard input.
    """
    stdin: String,
    """
    Redirect the command's standard input from a file in the container.
    """
    redirectStdin: String,
    """
    Redirect the command's standard output to a file in the container.
    """
    redirectStdout: String,
    """
    Redirect the command's standard error to a file in the container.
    """
    redirectStderr: String,
    """
    Exit codes this command is allowed to exit with without error (default: SUCCESS).
    """
    expect: ReturnType,
  ): Container! @cache(policy: FunctionCachePolicy.Never) {
    self._withExec(
      self.container,
      args,
      context,
      stdin,
      redirectStdin,
      redirectStdout,
      redirectStderr,
      expect,
    )
  }

  let _withExec(
    container: Container!,
    args: [String!]!,
    context: String,
    stdin: String,
    redirectStdin: String,
    redirectStdout: String,
    redirectStderr: String,
    expect: ReturnType,
  ): Container! @cache(policy: FunctionCachePolicy.Never) {
    let command = ["kubectl"]

    if (context != null) {
      command += ["--context", context]
    }

    if (args[0] == "kubectl") {
      args = args.dropFirst
    }

    container
      .withEnvVariable("DAGGER_CACHE_KEY", Random.string)
      .withExec(
        command + args,
        stdin: stdin,
        redirectStdin: redirectStdin,
        redirectStdout: redirectStdout,
        redirectStderr: redirectStderr,
        expect: expect,
      )
  }

  """
  Apply a manifest file to the cluster.
  """
  applyFile(
    """
    Manifest file to apply.
    """
    file: File!,
    """
    Name of the context entry in kubeconfig to use.
    """
    context: String,
    """
    Namespace to apply the manifest in.
    """
    namespace: String,
  ): Container! @cache(policy: FunctionCachePolicy.Never) {
    let path = "/work/manifest.yaml"

    self._withExec(
      self.container.withMountedFile(path, file),
      applyArgs(path, namespace),
      context: context,
    )
  }

  """
  Apply manifests from a directory to the cluster.
  """
  applyDirectory(
    """
    Directory containing the manifests to apply.
    """
    directory: Directory!,
    """
    Name of the context entry in kubeconfig to use.
    """
    context: String,
    """
    Namespace to apply the manifests in.
    """
    namespace: String,
    """
    Process the directory recursively.
    """
    recursive: Boolean! = false,
  ): Container! @cache(policy: FunctionCachePolicy.Never) {
    let path = "/work/manifests"

    let args = applyArgs(path, namespace)

    if (recursive) {
      args += ["--recursive"]
    }

    self._withExec(self.container.withMountedDirectory(path, directory), args, context: context)
  }
}

type Cluster {
  let server: String!
  let ca: File
  let serverName: String
  let service: Service

  let apply(name: String!, container: Container!): Container! {
    let args = [
      "kubectl",
      "config", "set-cluster", name,
      "--server", self.server,
    ]

    if (self.serverName != null) {
      args += ["--tls-server-name", self.serverName!]
    }

    let ca = self.ca
    if (ca != null) {
      let caPath = `/kube/certs/servers/${name}/ca.crt`

      container = container.withMountedFile(caPath, ca)
      args += ["--certificate-authority", caPath]
    } else {
      args += ["--insecure-skip-tls-verify"]
    }

    container.withExec(args)
  }
}

type User {
  let certificate: File!
  let key: File!

  let apply(name: String!, container: Container!): Container! {
    let path = `/kube/certs/users/${name}/`
    let certPath = path + "client.crt"
    let keyPath = path + "client.key"

    container
      .withMountedFile(certPath, self.certificate)
      .withMountedFile(keyPath, self.key)
      .withExec([
        "kubectl",
        "config", "set-credentials", name,
        "--client-certificate", certPath, "--client-key", keyPath,
        "--embed-certs",
      ])
  }
}

type Context {
  let cluster: String!
  let user: String!
  let namespace: String

  let apply(name: String!, container: Container!): Container! {
    let args = [
      "kubectl",
      "config", "set-context", name,
      "--cluster", self.cluster, "--user", self.user,
    ]

    if (self.namespace != null) {
      args += ["--namespace", self.namespace!]
    }

    container.withExec(args)
  }
}

let applyArgs(path: String!, namespace: String): [String!]! {
  let args = ["apply", "--filename", path]

  if (namespace != null) {
    args += ["--namespace", namespace]
  }

  args
}
