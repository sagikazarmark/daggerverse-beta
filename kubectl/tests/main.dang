type Tests {
  let kubeApiServer: KubeApiServer! { KubeApiServer }

  let kubectl: Kubectl! {
    Dagger
      .kubectl
      .withClusterService("default", self.kubeApiServer.service, ca: self.kubeApiServer.ca)
      .withCredentials("default", self.kubeApiServer.clientCertificate, self.kubeApiServer.clientKey)
      .withContext("default", "default", "default", use: true)
  }

  let multiContextKubectl: Kubectl! {
    Dagger
      .kubectl
      .withCluster("cluster-a", "https://cluster-a.example")
      .withCluster("cluster-b", "https://cluster-b.example")
      .withCredentials("user-a", self.kubeApiServer.clientCertificate, self.kubeApiServer.clientKey)
      .withCredentials("user-b", self.kubeApiServer.clientCertificate, self.kubeApiServer.clientKey)
      .withContext(
        "context-a",
        cluster: "cluster-a",
        user: "user-a",
        namespace: "namespace-a",
        use: true,
      )
      .withContext(
        "context-b",
        cluster: "cluster-b",
        user: "user-b",
        namespace: "namespace-b",
      )
  }

  """
  kubeconfig is assembled from cluster, credentials and context entries.
  """
  default: Container! @check {
    self.kubectl.container
  }

  """
  Cluster entries can be listed without the kubectl header and removed.
  """
  clusters: [String!]! @check {
    let clusters = Dagger
      .kubectl
      .withCluster("kept", "https://kept.example")
      .withCluster("removed", "https://removed.example")
      .clusters

    assert { clusters.contains("kept") }
    assert { clusters.contains("removed") }
    assert { !clusters.contains("NAME") }

    let remaining = Dagger
      .kubectl
      .withCluster("kept", "https://kept.example")
      .withCluster("removed", "https://removed.example")
      .withoutCluster("removed")
      .clusters

    assert { remaining.contains("kept") }
    assert { !remaining.contains("removed") }

    remaining
  }

  """
  User entries can be listed without the kubectl header and removed.
  """
  users: [String!]! @check {
    let users = Dagger
      .kubectl
      .withCredentials("kept", self.kubeApiServer.clientCertificate, self.kubeApiServer.clientKey)
      .withCredentials("removed", self.kubeApiServer.clientCertificate, self.kubeApiServer.clientKey)
      .users

    assert { users.contains("kept") }
    assert { users.contains("removed") }
    assert { !users.contains("NAME") }

    let remaining = Dagger
      .kubectl
      .withCredentials("kept", self.kubeApiServer.clientCertificate, self.kubeApiServer.clientKey)
      .withCredentials("removed", self.kubeApiServer.clientCertificate, self.kubeApiServer.clientKey)
      .withoutUser("removed")
      .users

    assert { remaining.contains("kept") }
    assert { !remaining.contains("removed") }

    remaining
  }

  """
  Context entries can be listed by name only and removed.
  """
  contexts: [String!]! @check {
    let contexts = self.multiContextKubectl.contexts

    assert { contexts.contains("context-a") }
    assert { contexts.contains("context-b") }
    assert { !contexts.contains("cluster-a") }
    assert { !contexts.contains("user-a") }

    let remaining = self.multiContextKubectl.withoutContext("context-b").contexts

    assert { remaining.contains("context-a") }
    assert { !remaining.contains("context-b") }

    remaining
  }

  """
  currentContext returns the selected context name.
  """
  currentContext: String! @check {
    let current = self.multiContextKubectl.currentContext

    assert { current == "context-a" }

    current
  }

  """
  renameContext renames a context entry and preserves it as current.
  """
  renameContext: [String!]! @check {
    let kubectl = self.multiContextKubectl.renameContext("context-a", "renamed-context")
    let contexts = kubectl.contexts

    assert { contexts.contains("renamed-context") }
    assert { !contexts.contains("context-a") }
    assert { kubectl.currentContext == "renamed-context" }

    contexts
  }

  """
  Multiple cluster, user and context writes compose into one kubeconfig.
  """
  composedConfig: Void @check {
    let kubectl = self.multiContextKubectl

    assert { kubectl.clusters.contains("cluster-a") }
    assert { kubectl.clusters.contains("cluster-b") }
    assert { kubectl.users.contains("user-a") }
    assert { kubectl.users.contains("user-b") }
    assert { kubectl.contexts.contains("context-a") }
    assert { kubectl.contexts.contains("context-b") }
    assert { kubectl.currentContext == "context-a" }

    let config = kubectl.config.contents

    assert { config.contains("current-context: context-a") }
    assert { config.contains("namespace: namespace-a") }
    assert { config.contains("namespace: namespace-b") }
  }

  """
  "kubectl" is prepended to the command when it is not the first argument.
  """
  exec: Void @check @cache(policy: neverCache) {
    let output = Dagger.kubectl.withExec(["version", "--client"]).stdout

    assert { output.contains("Client Version") }
  }

  """
  The command is left untouched when it already starts with "kubectl".
  """
  execPrefixed: Void @check @cache(policy: neverCache) {
    let output = Dagger.kubectl.withExec(["kubectl", "version", "--client"]).stdout

    assert { output.contains("Client Version") }
  }

  """
  Commands can target a specific context.
  """
  execContext: Void @check @cache(policy: neverCache) {
    let output = self.kubectl.withExec(["version"], context: "default").stdout

    assert { output.contains("Server Version") }
  }

  """
  Standard input is passed to the command.
  """
  execStdin: Void @check @cache(policy: neverCache) {
    let output = self
      .kubectl
      .withExec(["apply", "--filename", "-"], stdin: namespaceManifest("kubectl-test-stdin"))
      .withExec(["kubectl", "get", "namespace", "kubectl-test-stdin", "--output", "jsonpath={.status.phase}"])
      .stdout

    assert { output == "Active" }
  }

  """
  Running a command with an unknown context fails.
  """
  execUnknownContext: Void @check {
    let result = Dagger.kubectl.withExec(["get", "pods"], context: "missing", expect: ReturnType.FAILURE)

    assert { result.exitCode > 0 }
    assert { result.stderr.contains("context was not found for specified context: missing") }
  }

  """
  The namespace of a context can be changed.
  """
  namespace: Void @check {
    let config = self.kubectl.withNamespace("kube-system", context: "default").config.contents

    assert { config.contains("namespace: kube-system") }
  }

  """
  applyFile applies a manifest file to the cluster.
  """
  applyFile: Void @check @cache(policy: neverCache) {
    let output = self
      .kubectl
      .applyFile(fixture("manifest.yaml"), context: "default")
      .withExec(["kubectl", "get", "configmap", "test", "--namespace", "kubectl-test-file", "--output", "jsonpath={.data.foo}"])
      .stdout

    assert { output == "bar" }
  }

  """
  applyFile can apply a manifest in a specific namespace.
  """
  applyFileNamespace: Void @check @cache(policy: neverCache) {
    let output = self
      .kubectl
      .applyFile(fixture("namespaced-manifest.yaml"), namespace: "kubectl-test-ns")
      .withExec(["kubectl", "get", "configmap", "test", "--namespace", "kubectl-test-ns", "--output", "jsonpath={.data.foo}"])
      .stdout

    assert { output == "bar" }
  }

  """
  applyDirectory applies all manifests from a directory to the cluster.
  """
  applyDirectory: Void @check @cache(policy: neverCache) {
    let output = self
      .kubectl
      .applyDirectory(
        Dagger.currentModule.source.directory("testdata/manifests"),
      )
      .withExec(["kubectl", "get", "namespace", "kubectl-test-dir-1", "kubectl-test-dir-2", "--output", "name"])
      .stdout

    assert { output.contains("namespace/kubectl-test-dir-1") }
    assert { output.contains("namespace/kubectl-test-dir-2") }
  }

  """
  applyDirectory can process a directory recursively.
  """
  applyDirectoryRecursive: Void @check @cache(policy: neverCache) {
    let output = self
      .kubectl
      .applyDirectory(
        Dagger.currentModule.source.directory("testdata/nested-manifests"),
        recursive: true,
      )
      .withExec(["kubectl", "get", "namespace", "kubectl-test-dir-nested", "--output", "name"])
      .stdout

    assert { output.contains("namespace/kubectl-test-dir-nested") }
  }
}

let namespaceManifest(name: String!): String! {
  "apiVersion: v1\nkind: Namespace\nmetadata:\n  name: " + name + "\n"
}

let fixture(path: String!): File! {
  Dagger.currentModule.source.file("testdata/" + path)
}
