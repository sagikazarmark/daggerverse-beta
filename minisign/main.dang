type Minisign {
  let release: GithubRelease!

  """
  Minisign version
  """
  version: String! {
    self.release.tagName
  }

  new(
    """
    Minisign version
    """
    version: String,
  ) {
    self.release = Dagger
      .github
      .release(version, "jedisct1/minisign")

    self
  }

  """
  Download the minisign binary for the given platform.
  """
  download(platform: Platform! = Dagger.defaultPlatform): File! {
    let segments = toString(platform).split("/")

    let os = case (segments[0]) {
      "linux" => "linux"
      "darwin" => "macos"
      else => raise "unsupported os: " + (segments[0] ?? "")
    }

    let arch = case (segments[1]) {
      "amd64" => "x86_64"
      "arm64" => "aarch64"
      else => raise "unsupported arch: " + (segments[1] ?? "")
    }

    let fileName = `minisign-${self.version}-${os}.tar.gz`

    self
      .release
      .asset(fileName)
      .extracted(true)
      .file(arch + "/minisign")!
  }

  """
  Install the minisign binary into the given container.
  """
  install(container: Container!): Container! {
    container.withFile("/usr/local/bin/minisign", self.download(container.platform))
  }

  """
  Return a container with the minisign binary installed.
  """
  container: Container! {
    self.install(
      Dagger
        .container
        .from("alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b"),
    )
  }

  """
  Verify that a signature is valid for a given file.
  """
  verify(
    """
    File to verify.
    """
    file: File!,
    """
    Signature file.
    """
    signature: File!,
    """
    Public key encoded as base64 string.

    Either key or keyFile must be provided.
    """
    key: String,
    """
    Public key file.

    Either key or keyFile must be provided.
    """
    keyFile: File,
  ): File! {
    let args = ["minisign", "-V", "-m", file.name]

    if (key != null) {
      args += ["-P", key]
    }

    self
      .container
      .withWorkdir("/work")
      .withMountedFile(file.name, file)
      .withMountedFile(file.name + ".minisig", signature)
      .{ if (keyFile != null) _.withMountedFile("minisign.pub", keyFile!) else _ }
      .withExec(args)
      .file(file.name)
  }
}
