type Minisign {
  let release: GithubRelease!

  """
  Minisign version
  """
  version: String! {
    self.release.tagName
  }

  new(
    """
    Minisign version
    """
    version: String,
  ) {
    self.release = Dagger.github.release(version, "jedisct1/minisign")

    self
  }

  """
  Download the minisign binary for the given platform.
  """
  binary(platform: Dagger.Platform! = Dagger.defaultPlatform): File! {
    let platform = case (platform) {
      "linux/amd64" => Platform("linux", "x86_64")
      "linux/arm64" => Platform("linux", "aarch64")
      "darwin/amd64" => Platform("macos", "x86_64")
      "darwin/arm64" => Platform("macos", "aarch64")
      else => raise "unsupported platform: " + toString(platform)
    }

    self
      .release
      .{ _.asset(`minisign-${_.tagName}-${platform.os}.tar.gz`) }
      .extracted(true)
      .file(platform.arch + "/minisign")
  }

  """
  Install the minisign binary into the given container.
  """
  install(container: Container!): Container! {
    container.withFile("/usr/local/bin/minisign", self.binary(container.platform))
  }

  """
  Implements the overlay interface.
  """
  apply(container: Container!): Container! {
    self.install(container)
  }

  """
  Returns a container with the minisign binary installed.
  """
  container: Container! {
    self.install(alpine)
  }

  """
  Verify that a signature is valid for a given file.
  """
  verify(
    """
    File to verify.
    """
    file: File!,
    """
    Signature file.
    """
    signature: File!,
    """
    Public key encoded as base64 string.

    Either key or keyFile must be provided.
    """
    key: String,
    """
    Public key file.

    Either key or keyFile must be provided.
    """
    keyFile: File,
  ): File! {
    let args = ["minisign", "-V", "-m", file.name]

    if (key != null) {
      args += ["-P", key]
    }

    self
      .container
      .withWorkdir("/work")
      .withMountedFile(file.name, file)
      .withMountedFile(file.name + ".minisig", signature)
      .{ if (keyFile != null) _.withMountedFile("minisign.pub", keyFile!) else _ }
      .withExec(args)
      .file(file.name)
  }
}

type Platform {
  os: String!
  arch: String!
}
