let VERSION = "0.12"

let testUrl = "https://ziglang.org/download/0.16.0/zig-x86_64-linux-0.16.0.tar.xz"

type Tests {
  """
  Latest version of Minisign is installed and can be executed.
  """
  pub latest: Container! @check {
    minisign.container.withExec(["minisign", "-v"])
  }

  """
  Specific version of Minisign is installed and can be executed.
  """
  pub version: Container! @check {
    minisign(VERSION).container.withExec(["minisign", "-v"])
  }

  """
  Verify that a public key string can be used to verify a signature.
  """
  pub publicKeyString: File! @check {
    minisign(VERSION).verify(
      file: Dagger.http(testUrl),
      signature: Dagger.http(testUrl + ".minisig"),
      key: "RWSGOq2NVecA2UPNdBUZykf1CCb147pkmdtYxgb3Ti+JO/wCYvhbAb/U",
    )
  }

  """
  Verify that a public key file can be used to verify a signature.
  """
  pub publicKeyFile: File! @check {
    minisign(VERSION).verify(
      file: Dagger.http(testUrl),
      signature: Dagger.http(testUrl + ".minisig"),
      keyFile: Dagger.currentModule.source.file("minisign.pub"),
    )
  }
}
