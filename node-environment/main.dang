type NodeEnvironment {
  let defaultContainer: Container!

  let cache: CacheVolume
  let buildEnv: BuildEnvironment!
  let packageRoot: String
  let dependencySource: Directory

  let install: Boolean!
  let locked: Boolean!

  new(
    ws: Workspace!,
    """
    Version (image tag) to use from the official Node image repository.
    """
    version: String! = "latest",
    """
    Custom container to use as the default container.
    """
    container: Container! = Dagger.container.from("node:" + version),
    """
    Ignore paths included in the gitignore file.
    """
    gitignore: Boolean = true,
    """
    Include only artifacts that match the given pattern (e.g., ["app/", "package.*"]).
    """
    include: [String!],
    """
    Exclude artifacts that match the given pattern (e.g., ["node_modules/", ".git*"]).
    """
    exclude: [String!],
    """
    Environment file to load into the container.
    """
    envFile: File,
    """
    Source date epoch to set in the container.
    """
    sourceDateEpoch: String,
    """
    Automatically install dependencies.
    """
    install: Boolean! = false,
    """
    Install dependencies from the lockfile without updating it.
    """
    locked: Boolean! = false,
    """
    Whether to disable automatically mounted cache volumes.
    Useful if you want to mount cache volumes manually or use a different cache volume strategy.
    """
    noCache: Boolean! = false,
    """
    Cache volume for npm's package cache.
    """
    cache: CacheVolume = if (!noCache) { Dagger.cacheVolume("npm") } else null,
  ) {
    self.defaultContainer = container

    self.cache = cache
    self.buildEnv = Dagger.buildEnvironment(
      ws: ws,
      envFile: envFile,
      sourceDateEpoch: sourceDateEpoch,

      gitignore: gitignore,
      include: include,
      exclude: exclude,
    )

    let packageRoot = findPackageRoot(ws)
    self.packageRoot = packageRoot
    if (packageRoot != null) {
      self.dependencySource = ws.directory(
        "/",
        include: [
          "package.json",
          "package-lock.json",
          "npm-shrinkwrap.json",
          ".npmrc",
        ].map { Path(packageRoot!).join(Path(_)).string.trimPrefix("/") },
      )
    }

    self.install = install
    self.locked = locked

    self
  }

  """
  Returns a container with the configured Node environment.
  """
  container(
    """
    Custom base container to use.
    """
    base: Container,
  ): Container! {
    let base = (base ?? self.defaultContainer).{ self.withCache(_) }

    base
      .{ self.buildEnv.container(base: base) }
      .{ self.withDependencies(_, base) }
  }

  let withCache(container: Container!): Container! {
    let cache = self.cache
    if (cache == null) {
      return container
    }

    container
      .{
        if (_.envVariable("NPM_CONFIG_CACHE") == null or _.envVariable("NPM_CONFIG_CACHE") == "") {
          _.withEnvVariable("NPM_CONFIG_CACHE", "/root/.npm")
        } else _
      }
      .withMountedCache("${NPM_CONFIG_CACHE}", cache, expand: true)
  }

  let withDependencies(
    container: Container!,
    installContainer: Container!,
  ): Container! {
    if (!self.install or self.packageRoot == null) {
      return container
    }

    let packageRoot = self.packageRoot!
    let dependencySource = self.dependencySource!

    let installed = installContainer
      .withMountedDirectory("/work/src", dependencySource)
      .withWorkdir(Path("/work/src").join(Path(packageRoot)).string)
      .{
        if (self.locked) {
          _.withExec(["npm", "ci"])
        } else {
          _.withExec(["npm", "install"])
        }
      }

    if (!installed.exists("node_modules")) {
      return container
    }

    let dependencies = installed.directory("node_modules")

    container.withMountedDirectory(
      Path("/work/src").join(Path(packageRoot)).join("node_modules").string,
      dependencies,
    )
  }

  let findPackageRoot(workspace: Workspace!): String {
    [
      "package-lock.json",
      "npm-shrinkwrap.json",
      "package.json",
    ].each { name =>
      let file = workspace.findUp(name)
      if (file != null) {
        return Path(file).parent.string
      }
    }

    null
  }

  """
  Run an npm script in the source.
  """
  withRun(
    """
    npm script to run.
    """
    script: String!,
    """
    Arguments to pass to the script.
    """
    args: [String!]! = [],
  ): Container! {
    let command = ["npm", "run", script]
    if (args.length > 0) {
      command += ["--"] + args
    }

    self.container.withExec(command)
  }
}
