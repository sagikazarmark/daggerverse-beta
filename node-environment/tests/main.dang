let nodeVersion: String! = "22.20.0-bookworm-slim"

let nodeProject: Directory! {
  Dagger.currentModule.source.directory("testdata/basic")
}

let nodeLockedProject: Directory! {
  Dagger.currentModule.source.directory("testdata/locked")
}

let envFile: File! {
  Dagger.currentModule.source.file("testdata/env/.env")
}

type Tests {
  container: Void @check {
    let container = Dagger
      .nodeEnvironment(ws: Dagger.directory.asWorkspace, version: nodeVersion)
      .container

    assert { container.mounts.contains("/root/.npm") }
    assert { container.withExec(["node", "--version"]).stdout.contains("v22.") }
  }

  emptyCacheDir: Void @check {
    let container = Dagger
      .nodeEnvironment(
        ws: Dagger.directory.asWorkspace,
        version: nodeVersion,
        container: Dagger
          .container
          .from("node:" + nodeVersion)
          .withEnvVariable("NPM_CONFIG_CACHE", ""),
      )
      .container

    assert { container.envVariable("NPM_CONFIG_CACHE") == "/root/.npm" }
    assert { container.mounts.contains("/root/.npm") or container.mounts.contains("/root/.npm/") }
  }

  noCache: Void @check {
    let container = Dagger
      .nodeEnvironment(ws: Dagger.directory.asWorkspace, version: nodeVersion, noCache: true)
      .container

    assert { !container.mounts.contains("/root/.npm") }
  }

  envFileAndEpoch: Void @check {
    let container = Dagger
      .nodeEnvironment(
        ws: Dagger.directory.asWorkspace,
        version: nodeVersion,
        envFile: envFile,
        sourceDateEpoch: "1234567890",
      )
      .container

    assert { container.envVariable("NODE_ENV_TEST") == "from-env-file" }
    assert { container.envVariable("SOURCE_DATE_EPOCH") == "1234567890" }
  }

  withRun: Void @check {
    let output = Dagger
      .nodeEnvironment(ws: nodeProject.asWorkspace, version: nodeVersion, install: true)
      .withRun("check")
      .stdout

    assert { output.contains("node-ok") }
  }

  withRunNamedArgs: Void @check {
    let output = Dagger
      .nodeEnvironment(ws: nodeProject.asWorkspace, version: nodeVersion, install: true)
      .withRun(script: "check")
      .stdout

    assert { output.contains("node-ok") }
  }

  withRunScriptArgs: Void @check {
    let output = Dagger
      .nodeEnvironment(ws: nodeProject.asWorkspace, version: nodeVersion, install: true)
      .withRun(script: "args", args: ["one", "two"])
      .stdout

    assert { output.contains("one,two") }
    assert { !output.contains("npm run args") }
  }

  lockedWithRun: Void @check {
    let output = Dagger
      .nodeEnvironment(ws: nodeLockedProject.asWorkspace, version: nodeVersion, install: true, locked: true)
      .withRun(script: "check")
      .stdout

    assert { output.contains("node-ok") }
  }
}
