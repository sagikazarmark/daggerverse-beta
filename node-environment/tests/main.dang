let nodeVersion: String! = "22.20.0-bookworm-slim"

let nodeProject: Directory! {
  Dagger.currentModule.source.directory("testdata/basic")
}

let nodeLockedProject: Directory! {
  Dagger.currentModule.source.directory("testdata/locked")
}

let envFile: File! {
  Dagger.currentModule.source.file("testdata/env/.env")
}

type Tests {
  container: Void @check {
    let container = Dagger
      .nodeEnvironment(version: nodeVersion)
      .container(ws: null)

    assert { container.mounts.contains("/root/.npm") }
    assert { container.withExec(["node", "--version"]).stdout.contains("v22.") }
  }

  noCache: Void @check {
    let container = Dagger
      .nodeEnvironment(version: nodeVersion, noCache: true)
      .container(ws: null)

    assert { !container.mounts.contains("/root/.npm") }
  }

  envFileAndEpoch: Void @check {
    let container = Dagger
      .nodeEnvironment(
        version: nodeVersion,
        envFile: envFile,
        sourceDateEpoch: "1234567890",
      )
      .container(ws: null)

    assert { container.envVariable("NODE_ENV_TEST") == "from-env-file" }
    assert { container.envVariable("SOURCE_DATE_EPOCH") == "1234567890" }
  }

  withRun: Void @check {
    let output = Dagger
      .nodeEnvironment(version: nodeVersion, install: true)
      .withRun(nodeProject.asWorkspace, "check")
      .stdout

    assert { output.contains("node-ok") }
  }

  withRunNamedArgs: Void @check {
    let output = Dagger
      .nodeEnvironment(version: nodeVersion, install: true)
      .withRun(ws: nodeProject.asWorkspace, script: "check")
      .stdout

    assert { output.contains("node-ok") }
  }

  withRunScriptArgs: Void @check {
    let output = Dagger
      .nodeEnvironment(version: nodeVersion, install: true)
      .withRun(ws: nodeProject.asWorkspace, script: "args", args: ["one", "two"])
      .stdout

    assert { output.contains("one,two") }
    assert { !output.contains("npm run args") }
  }

  lockedWithRun: Void @check {
    let output = Dagger
      .nodeEnvironment(version: nodeVersion, install: true, locked: true)
      .withRun(ws: nodeLockedProject.asWorkspace, script: "check")
      .stdout

    assert { output.contains("node-ok") }
  }
}
