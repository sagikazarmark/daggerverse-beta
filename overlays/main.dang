type Overlays {
  """
  Combine a list of overlays into a single overlay.
  """
  combine(overlays: [Overlay]!): List! {
    List(overlays.reject { _ == null }.map { _! })
  }

  """
  Execute a command in the container.
  """
  withExec(
    args: [String!]!,
    useEntrypoint: Boolean,
    stdin: String,
    redirectStdin: String,
    redirectStdout: String,
    redirectStderr: String,
    expect: ReturnType,
    experimentalPrivilegedNesting: Boolean,
    insecureRootCapabilities: Boolean,
    expand: Boolean,
    noInit: Boolean,
  ): WithExec! {
    WithExec(
      args: args,
      useEntrypoint: useEntrypoint,
      stdin: stdin,
      redirectStdin: redirectStdin,
      redirectStdout: redirectStdout,
      redirectStderr: redirectStderr,
      expect: expect,
      experimentalPrivilegedNesting: experimentalPrivilegedNesting,
      insecureRootCapabilities: insecureRootCapabilities,
      expand: expand,
      noInit: noInit,
    )
  }

  """
  Set an environment variable in the container.
  """
  withEnvVariable(
    name: String!,
    value: String!,
    expand: Boolean,
  ): WithEnvVariable! {
    WithEnvVariable(name: name, value: value, expand: expand)
  }

  """
  Add a file to the container at the specified path.
  """
  withFile(
    path: String!,
    source: File!,
    permissions: Int,
    owner: String,
    inheritOwner: Boolean,
    expand: Boolean,
  ): WithFile! {
    WithFile(
      path: path,
      source: source,
      permissions: permissions,
      owner: owner,
      inheritOwner: inheritOwner,
      expand: expand,
    )
  }

  """
  Add multiple files to the container at the specified path.
  """
  withFiles(
    path: String!,
    sources: [File!]!,
    permissions: Int,
    owner: String,
    inheritOwner: Boolean,
    expand: Boolean,
  ): WithFiles! {
    WithFiles(
      path: path,
      sources: sources,
      permissions: permissions,
      owner: owner,
      inheritOwner: inheritOwner,
      expand: expand,
    )
  }

  """
  Mount a file to the container at the specified path.
  """
  withMountedFile(
    path: String!,
    source: File!,
    owner: String,
    inheritOwner: Boolean,
    expand: Boolean,
  ): WithMountedFile! {
    WithMountedFile(
      path: path,
      source: source,
      owner: owner,
      inheritOwner: inheritOwner,
      expand: expand,
    )
  }

  """
  Add a directory to the container at the specified path.
  """
  withDirectory(
    path: String!,
    source: Directory!,
    exclude: [String!]! = [],
    include: [String!]! = [],
    gitignore: Boolean,
    owner: String,
    inheritOwner: Boolean,
    expand: Boolean,
    permissions: Int,
  ): WithDirectory! {
    WithDirectory(
      path: path,
      source: source,
      exclude: exclude,
      include: include,
      gitignore: gitignore,
      owner: owner,
      inheritOwner: inheritOwner,
      expand: expand,
      permissions: permissions,
    )
  }

  """
  Mount a directory to the container at the specified path.
  """
  withMountedDirectory(
    path: String!,
    source: Directory!,
    owner: String,
    inheritOwner: Boolean,
    readOnly: Boolean,
    expand: Boolean,
  ): WithMountedDirectory! {
    WithMountedDirectory(
      path: path,
      source: source,
      owner: owner,
      inheritOwner: inheritOwner,
      readOnly: readOnly,
      expand: expand,
    )
  }
}

"""
Apply changes on top of a container.

The primary use case is to allow extending a container from outside a Dagger module.
"""
interface Overlay {
  apply(container: Container!): Container!
}

type List implements Overlay {
  overlays: [Overlay!]!

  apply(container: Container!): Container! {
    self.overlays.reduce(container) { container, overlay => overlay.apply(container) }
  }
}

type WithExec implements Overlay {
  args: [String!]!
  useEntrypoint: Boolean
  stdin: String
  redirectStdin: String
  redirectStdout: String
  redirectStderr: String
  expect: ReturnType
  experimentalPrivilegedNesting: Boolean
  insecureRootCapabilities: Boolean
  expand: Boolean
  noInit: Boolean

  apply(container: Container!): Container! {
    container.withExec(
      args: self.args,
      useEntrypoint: self.useEntrypoint,
      stdin: self.stdin,
      redirectStdin: self.redirectStdin,
      redirectStdout: self.redirectStdout,
      redirectStderr: self.redirectStderr,
      expect: self.expect,
      experimentalPrivilegedNesting: self.experimentalPrivilegedNesting,
      insecureRootCapabilities: self.insecureRootCapabilities,
      expand: self.expand,
      noInit: self.noInit,
    )
  }
}

type WithEnvVariable implements Overlay {
  name: String!
  value: String!
  expand: Boolean

  apply(container: Container!): Container! {
    container.withEnvVariable(name: self.name, value: self.value, expand: self.expand)
  }
}

type WithFile implements Overlay {
  path: String!
  source: File!
  permissions: Int
  owner: String
  inheritOwner: Boolean
  expand: Boolean

  apply(container: Container!): Container! {
    container.withFile(
      path: self.path,
      source: self.source,
      permissions: self.permissions,
      owner: self.owner,
      inheritOwner: self.inheritOwner,
      expand: self.expand,
    )
  }
}

type WithFiles implements Overlay {
  path: String!
  sources: [File!]!
