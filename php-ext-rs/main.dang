enum PhpVariant {
  NTS
  ZTS
}

type PhpExtRs {
  let rustVersion: String!
  let zigVersion: String!
  let zigBuildVersion: String
  let macosSdkVersion: String!
  let macosDeploymentTarget: String!
  let container: Container!

  new(
    """
    Version (image tag) to use from the official image repository as a build container.
    """
    rustVersion: String! = "1.95-slim-trixie",
    """
    Version of Zig to use.
    """
    zigVersion: String! = "0.16.0",
    """
    Version of cargo-zigbuild to use.
    """
    zigBuildVersion: String = null,
    """
    Version of the macOS SDK to use.
    """
    macosSdkVersion: String! = "15.5",
    """
    Minimum macOS version to target for Darwin builds.
    """
    macosDeploymentTarget: String! = "15.0",
    """
    Custom container to use as a build container.
    """
    container: Container! = Dagger.container.from("rust:" + rustVersion),
  ) {
    self.rustVersion = rustVersion
    self.zigVersion = zigVersion
    self.zigBuildVersion = zigBuildVersion
    self.macosSdkVersion = macosSdkVersion
    self.macosDeploymentTarget = macosDeploymentTarget
    self.container = container

    self
  }

  let phpContainer: Container! {
    let deps = ["autoconf", "bison", "build-essential", "ca-certificates", "clang", "libclang-dev", "curl", "file", "git", "make", "pkg-config", "re2c", "unzip", "xz-utils", "zip"]

    debianSetup(installBase(Dagger.container.from("debian:trixie-slim")), deps)
  }

  let rustContainer(ws: Workspace!): Container! {
    let deps = ["build-essential", "ca-certificates", "clang", "libclang-dev"]

    let container = Dagger
      .rust(
        workspace: ws,
        container: debianSetup(installBase(self.container), deps),
        targets: ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu", "aarch64-apple-darwin"],
      )
      .container

    withZigbuild(container, zigBuildVersion)
  }

  let installBase(container: Container!): Container! {
    container = Dagger.zigDist(self.zigVersion).install(container)
    container = Dagger.macosSdk(self.macosSdkVersion).install(container)

    container
  }

  let debianSetup(container: Container!, packages: [String!]!): Container! {
    container
      .withMountedCache("/var/cache/apt/archives", Dagger.cacheVolume("debian-apt-archives"))
      # .withMountedCache("/var/lib/apt/lists", Dagger.cacheVolume("debian-apt-lists"))
      .withEnvVariable("DEBIAN_FRONTEND", "noninteractive")
      .withExec(["apt-get", "update"])
      .withExec(["apt-get", "install", "-y", "--no-install-recommends"] + packages)
  }

  let withZigbuild(container: Container!, version: String): Container! {
    let release = Dagger.github.release(version, "rust-cross/cargo-zigbuild")

    let name = "cargo-zigbuild"
    let fileName = "cargo-zigbuild-" + arch + "-unknown-linux-gnu.tar.xz"

    let binary = release
      .asset(fileName)
      .extracted(true)
      .file(name)

    if (binary == null) {
      raise "failed to download cargo-zigbuild binary"
    }

    container.withFile("/usr/local/bin/" + name, binary)
  }

  let arch: String! {
    case (Dagger.defaultPlatform) {
      "linux/amd64" => "x86_64"
      "linux/arm64" => "aarch64"
      else => raise "unsupported platform: " + toString(Dagger.defaultPlatform).trim("\"")
    }
  }

  let defaultDarwinArgs: [String!]! {
    [
      "-isysroot", "${SDKROOT}",
      "-isystem", "${SDKROOT}/usr/include",
      "-iframework", "${SDKROOT}/System/Library/Frameworks",
      "-mmacosx-version-min=" + self.macosDeploymentTarget,
    ]
  }

  """
  Builds a matrix of PHP extension builds for the given source directory.
  """
  pub buildExtensionMatrix(
    """
    Source directory containing the PHP extension to build.
    """
    source: Directory!,
    """
    Name of the PHP extension to build.
    """
    extensionName: String!,
    """
    List of PHP versions to build for.
    """
    phpVersions: [String!]!,
    """
    List of PHP variants to build for.
    """
    variants: [PhpVariant!]!,
    """
    List of targets to build for.
    """
    targets: [String!]!,
    """
    Path to the build directory.
    """
    buildPath: String! = ".",
  ): Directory! {
    let result = Dagger.directory

    phpVersions.each { phpVersion =>
      variants.each { variant =>
        targets.each { target =>
          let build = buildExtension(
            source,
            extensionName,
            phpVersion,
            variant,
            target,
            buildPath,
          )

          let path = "php-" + phpVersion
          if (variant == PhpVariant.ZTS) { path += "-zts" }
          path += "/" + target

          result = result.withDirectory(path, build)
        }
      }
    }

    result
  }

  """
  Builds a single PHP extension for the given source directory, PHP version, variant, and target.
  """
  let buildExtension(
    """
    Source directory containing the PHP extension to build.
    """
    source: Directory!,
    """
    Name of the PHP extension to build.
    """
    extensionName: String!,
    """
    PHP version to build for.
    """
    phpVersion: String!,
    """
    PHP variant to build for.
    """
    variant: PhpVariant!,
    """
    Target to build for.
    """
    target: String!,
    """
    Path to the build directory.
    """
    buildPath: String! = "",
  ): Directory! {
    let target = Target(target)

    let container = withPhpHeaders(
      self.rustContainer(source.asWorkspace),
      phpVersion,
      variant,
      target,
    )

    let clangResourceDir = container
      .withExec(["clang", "-print-resource-dir"])
      .stdout
      .trimSpace

    let libclangFile = container
      .withExec(["find", "/usr/lib", "-path", "*/lib/libclang.so", "-print", "-quit"])
      .stdout
      .trimSpace

    let args = ["-resource-dir", clangResourceDir]

    if (target.isDarwin) {
      args += [
        "-nostdinc",
        "-isystem", clangResourceDir + "/include",
      ] + defaultDarwinArgs
    }

    # target.zigLibcIncludeDirs.each { dir => args += ["-isystem", "${ZIG_ROOT}/lib/libc/include/" + dir] }
    # target.systemIncludeDirs.each { dir => args += ["-isystem", dir] }

    let phpIncludes = container.withExec(["php-config", "--includes"]).stdout.trimSpace.split(" ")
    args += phpIncludes

    let cflagsArgs = if (target.isDefaultPlatform) { phpIncludes } else { args }

    let bindgenArgs = args + target.extraBindgenArgs
    # let bindgenArgs = ["--target=" + target.toClangTarget] + args + target.extraBindgenArgs
    let cargoCommand = if (target.isDefaultPlatform) { "build" } else { "zigbuild" }

    # Drop configure-time compiler env before Cargo selects per-target settings.
    let result = container
      .withoutEnvVariable("CC")
      .withoutEnvVariable("CXX")
      .withoutEnvVariable("CFLAGS")
      .withoutEnvVariable("CPPFLAGS")
      .withEnvVariable("AR", "zig ar")
      #.withEnvVariable(target.env("TARGET_TRIPLE"), target.toString)
      #.withEnvVariable("LIBCLANG_PATH", libclangFile)
      .withEnvVariable(
        target.cargoTargetEnv("RUSTFLAGS"),
        target.rustArgs.join(" "),
        expand: true,
      )
      .withEnvVariable(
        target.env("BINDGEN_EXTRA_CLANG_ARGS"),
        bindgenArgs.join(" "),
        expand: true,
      )
      .withEnvVariable(target.env("CFLAGS"), cflagsArgs.join(" "), expand: true)
      .withDirectory("/work/src", source)
      .withWorkdir("/work/src/" + buildPath)
      # .withExec(["rustup", "target", "add", target.toString])
      .withExec(
        [
          "cargo", cargoCommand,
          "--release",
          "--target", target.toString,
          "--message-format", "json-render-diagnostics",
        ],
        redirectStdout: "/work/stdout.json",
      )
      .withExec(["mkdir", "-p", "/work/out"])
      .withExec(["cargo", "artifacts", "copy", "-i", "/work/stdout.json", "--out-dir", "/work/out"])
      .directory("/work/out")

    # let artifactPath = jq
    #   .eval(
    #     expr: """([.[] | select(.reason == "compiler-artifact" and (.package_id | startswith("path+file://")) and .target.name == $cdylibName and ((.target.kind // []) | any(. == "cdylib"))) | .filenames[] | select(endswith("." + $fileExtension))] | first) // error("cdylib artifact not found")""",
    #     input: result.file("/work/stdout.json"),
    #     args: [
    #       jq.arg("cdylibName", cargoCdylibName(source, buildPath)),
    #       jq.arg("fileExtension", target.fileExtension),
    #     ],
    #     slurp: true,
    #   )
    #   .contents
    #   .trimSpace

    # result
    #   .withExec(["cp", artifactPath, "/work/result/" + extensionName + ".so"])
    #   .directory("/work/result")
  }

  let withPhpHeaders(
    rcontainer: Container!,
    phpVersion: String!,
    variant: PhpVariant!,
    target: Target!,
  ): Container! {
    let cflags = ["-g", "-O2", "-Wno-error=date-time"]
    let cppflags = []

    if (target.isDarwin) {
      cflags += defaultDarwinArgs
      cppflags += defaultDarwinArgs
    }

    let container = self
      .phpContainer
      .withEnvVariable("CC", ["zig", "cc", "-target", target.toZigTarget].join(" "))
      .withEnvVariable("CXX", ["zig", "c++", "-target", target.toZigTarget].join(" "))
      .withEnvVariable("CFLAGS", cflags.join(" "), expand: true)
      .withEnvVariable("CPPFLAGS", cppflags.join(" "), expand: true)

    let configureArgs = [
      "--host=" + target.toString,
      "--build=" + container.withExec(["gcc", "-dumpmachine"]).stdout.trimSpace,
      "--disable-all",
      "--disable-cgi",
      "--disable-cli",
      "--disable-phpdbg",
      "--enable-embed=static",
      "--without-pear",
    ]

    # TODO: figure out why this is necessary
    if (target.toString == "x86_64-unknown-linux-gnu") {
      configureArgs += ["php_cv_have_avx512=no", "php_cv_have_avx512vbmi=no"]
    }

    let threadSafety = "disabled"
    let ztsSuffix = ""

    if (variant == PhpVariant.ZTS) {
      configureArgs += ["--enable-zts"]
      threadSafety = "enabled"
      ztsSuffix = "-zts"
    }

    let build = phpDist
      .fromVersion(phpVersion, container)
      .buildconf(force: true)
      .configure(configureArgs)

    let phpShim = Dagger
      .currentModule
      .source
      .file("shims/php")
      .withReplaced("@@PHP_VERSION@@", phpVersion)
      .withReplaced("@@PHP_API_VERSION@@", build.apiVersion)
      .withReplaced("@@PHP_THREAD_SAFETY@@", threadSafety)
      .withReplaced("@@PHP_ZTS_SUFFIX@@", ztsSuffix)

    build
      .install(
        rcontainer,
        [PhpDistComponent.HEADERS, PhpDistComponent.PROGRAMS],
      )
      .withFile(build.config.prefix + "/bin/php", phpShim, permissions: 755)
  }

  # let cargoCdylibName(source: Directory!, buildPath: String!): String! {
  #   let workdir = ("/work/src/" + buildPath).trimSuffix("/")

  #   let metadata = self
  #     .container
  #     .withDirectory("/work/src", source)
  #     .withWorkdir(workdir)
  #     .withExec(
  #       ["cargo", "metadata", "--no-deps", "--format-version", "1"],
  #       redirectStdout: "/work/cargo-metadata.json",
  #     )
  #     .file("/work/cargo-metadata.json")

  #   jq.eval(
  #     expr: """
  #     ([.packages[] | select(.manifest_path == $manifestPath) | .targets[] | select(.kind | index("cdylib")) | .name | gsub("-"; "_")] | first)
  #       // ([.workspace_default_members[] as $id | .packages[] | select(.id == $id) | .targets[] | select(.kind | index("cdylib")) | .name | gsub("-"; "_")] | first)
  #       // ([.packages[] | .targets[] | select(.kind | index("cdylib")) | .name | gsub("-"; "_")] | first)
  #       // error("cdylib target not found")
  #     """,
  #     input: metadata,
  #     args: [jq.arg("manifestPath", workdir + "/Cargo.toml")],
  #   ).contents.trimSpace
  # }
}

type Target {
  let value: String!

  new(value: String!) {
    let valid = [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
    ]

    if (!valid.contains(value)) {
      raise "unsupported target: " + value
    }

    self.value = value

    self
  }

  """
  Returns the target as a string.
  """
  pub toString: String! {
    self.value
  }

  let envTarget: String! {
    self.value
  }

  let cargoEnvTarget: String! {
    case (self.value) {
      "x86_64-unknown-linux-gnu" => "X86_64_UNKNOWN_LINUX_GNU"
      "aarch64-unknown-linux-gnu" => "AARCH64_UNKNOWN_LINUX_GNU"
      "aarch64-apple-darwin" => "AARCH64_APPLE_DARWIN"
    }
  }

  """
  Returns a target-suffixed environment variable name.
  """
  pub env(name: String!): String! {
    name + "_" + self.value
  }

  """
  Returns a Cargo target configuration environment variable name.
  """
  pub cargoTargetEnv(name: String!): String! {
    "CARGO_TARGET_" + self.cargoEnvTarget + "_" + name
  }

  """
  Returns whether the target is a Darwin target (macOS).
  """
  pub isDarwin: Boolean! {
    self.value.hasSuffix("-apple-darwin")
  }

  pub isDefaultPlatform: Boolean! {
    case (Dagger.defaultPlatform) {
      "linux/amd64" => self.value == "x86_64-unknown-linux-gnu"
      "linux/arm64" => self.value == "aarch64-unknown-linux-gnu"
    }
  }

  pub osFamily: String! {
    if (isDarwin) {
      "darwin"
    } else {
      "linux"
    }
  }

  """
  Returns the target as a Zig target string.
  """
  pub toZigTarget: String! {
    case (self.value) {
      "x86_64-unknown-linux-gnu" => "x86_64-linux-gnu"
      "aarch64-unknown-linux-gnu" => "aarch64-linux-gnu"
      "aarch64-apple-darwin" => "aarch64-macos"
    }
  }

  """
  Returns the target as a Clang target string.
  """
  pub toClangTarget: String! {
    case (self.value) {
      "x86_64-unknown-linux-gnu" => "x86_64-linux-gnu"
      "aarch64-unknown-linux-gnu" => "aarch64-linux-gnu"
      "aarch64-apple-darwin" => "arm64-apple-macosx"
    }
  }

  """
  Returns the Zig libc include directories for the target.
  """
  pub zigLibcIncludeDirs: [String!]! {
    let defaults = ["generic-glibc", "any-linux-any"]

    case (self.value) {
      "x86_64-unknown-linux-gnu" => ["x86-linux-any", "x86-linux-gnu"] + defaults
      "aarch64-unknown-linux-gnu" => ["aarch64-linux-any", "aarch64-linux-gnu"] + defaults
      "aarch64-apple-darwin" => []
    }
  }

  pub systemIncludeDirs: [String!]! {
    case (self.value) {
      "x86_64-unknown-linux-gnu" => ["/usr/include/x86_64-linux-gnu"]
      "aarch64-unknown-linux-gnu" => ["/usr/include/aarch64-linux-gnu"]
      "aarch64-apple-darwin" => []
    }
  }

  pub extraBindgenArgs: [String!]! {
    if (self.value == "aarch64-unknown-linux-gnu") {
      # ["-U__aarch64__", "-U_M_ARM64"]
      []
    } else {
      []
    }
  }

  let rustArgs: [String!]! {
    if (isDarwin) {
      ["-C", "link-arg=-undefined", "-C", "link-arg=dynamic_lookup"]
    } else {
      []
    }
  }

  """
  Returns the target file extension string.
  """
  pub fileExtension: String! {
    if (isDarwin) {
      "dylib"
    } else {
      "so"
    }
  }
}
