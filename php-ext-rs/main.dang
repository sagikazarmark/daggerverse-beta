enum PhpVariant {
  NTS
  ZTS
}

"""
Build PHP extensions written in Rust (ext-php-rs) for multiple PHP versions, variants and targets.

PHP is cross-compiled with Zig to obtain headers for each target; the extension itself is built
with rust-cross, which cross-compiles with cargo-zigbuild.
"""
type PhpExtRs {
  let base: Container!

  let zigVersion: String!
  let cargoZigbuildVersion: String!
  let macosSdkVersion: String!
  let macosDeploymentTarget: String!

  let components: [String!]!
  let overlay: Overlay
  let envFile: File
  let sourceDateEpoch: String
  let noCache: Boolean!

  new(
    """
    Version (image tag) to use from the official Rust image repository as a base container.
    """
    rustVersion: String! = "latest",
    """
    Custom container to use as a base container.
    """
    container: Container! = Dagger.container.from("rust:" + rustVersion),
    """
    Zig version to use as the cross-compilation C compiler and linker.
    """
    zigVersion: String! = "0.16.0",
    """
    cargo-zigbuild version to use.

    Pinned below 0.23.4 like rust-cross: https://github.com/rust-cross/cargo-zigbuild/pull/477
    breaks linking cdylibs for Apple targets.
    """
    cargoZigbuildVersion: String! = "0.23.3",
    """
    macOS SDK version to use for Darwin targets.
    """
    macosSdkVersion: String! = "15.5",
    """
    Minimum macOS version to target for Darwin builds.
    """
    macosDeploymentTarget: String! = "15.0",
    """
    Additional Rust components to install.
    """
    components: [String!]! = [],
    """
    Overlay to apply to the Rust build container (after the toolchains are installed).
    """
    overlay: Overlay,
    """
    Env file to load into the Rust build container.
    """
    envFile: File,
    """
    Override the source date epoch for reproducible builds.
    """
    sourceDateEpoch: String,
    """
    Whether to disable automatically mounted cache volumes.
    Useful if you want to mount cache volumes manually or use a different cache volume strategy.
    """
    noCache: Boolean! = false,
  ) {
    self.base = container

    self.zigVersion = zigVersion
    self.cargoZigbuildVersion = cargoZigbuildVersion
    self.macosSdkVersion = macosSdkVersion
    self.macosDeploymentTarget = macosDeploymentTarget

    self.components = components
    self.overlay = overlay
    self.envFile = envFile
    self.sourceDateEpoch = sourceDateEpoch
    self.noCache = noCache

    self
  }

  """
  Builds a matrix of PHP extension builds for the given source directory.
  """
  buildExtensionMatrix(
    """
    Source directory containing the PHP extension to build.
    """
    source: Directory!,
    """
    Name of the PHP extension to build.
    """
    extensionName: String!,
    """
    List of PHP versions to build for.
    """
    phpVersions: [String!]!,
    """
    List of PHP variants to build for.
    """
    variants: [PhpVariant!]!,
    """
    List of targets to build for.
    """
    targets: [String!]!,
    """
    Path to the build directory.
    """
    buildPath: String! = ".",
  ): Directory! {
    let result = Dagger.directory

    phpVersions.each { phpVersion =>
      variants.each { variant =>
        targets.each { target =>
          let build = buildExtension(
            source,
            extensionName,
            phpVersion,
            variant,
            target,
            buildPath,
          )

          let path = "php-" + phpVersion
          if (variant == PhpVariant.ZTS) { path += "-zts" }
          path += "/" + target

          result = result.withDirectory(path, build)
        }
      }
    }

    result
  }

  """
  Builds a single PHP extension for the given source directory, PHP version, variant, and target.
  """
  let buildExtension(
    source: Directory!,
    extensionName: String!,
    phpVersion: String!,
    variant: PhpVariant!,
    target: String!,
    buildPath: String!,
  ): Directory! {
    let target = Target(target)

    let rustCross = self.rustCross(
      source.asWorkspace(buildPath),
      phpVersion,
      variant,
      target,
    )

    let container = rustCross.container

    let clangResourceDir = container
      .withExec(["clang", "-print-resource-dir"])
      .stdout
      .trimSpace

    let phpIncludes = container
      .withExec(["php-config", "--includes"])
      .stdout
      .trimSpace
      .split(" ")

    let clangArgs = ["-resource-dir", clangResourceDir]

    if (target.isDarwin) {
      clangArgs += [
        "-nostdinc",
        "-isystem", clangResourceDir + "/include",
      ] + self.defaultDarwinArgs
    }

    clangArgs += phpIncludes

    # Native builds compile C with the system toolchain, which already knows its own include paths.
    let isHost = rustCross.hostTarget == target.toString
    let cflags = if (isHost) { phpIncludes } else { clangArgs }

    let output = rustCross
      .withEnvVariable("AR", "zig ar")
      .withEnvVariable(target.cargoTargetEnv("RUSTFLAGS"), target.rustArgs.join(" "), expand: true)
      .withEnvVariable(target.env("BINDGEN_EXTRA_CLANG_ARGS"), clangArgs.join(" "), expand: true)
      .withEnvVariable(target.env("CFLAGS"), cflags.join(" "), expand: true)
      .build(target: [target.toString], release: true)

    let artifacts = output.glob("*." + target.fileExtension)
    if (artifacts.isEmpty) {
      raise `no ${target.fileExtension} artifact found for target ${target.toString}`
    }

    # PHP loads extensions as .so on every platform, including macOS.
    Dagger.directory.withFile(extensionName + ".so", output.file(artifacts[0]!))
  }

  """
  rust-cross instance whose base container has the PHP headers for the given build installed.
  """
  let rustCross(
    ws: Workspace!,
    phpVersion: String!,
    variant: PhpVariant!,
    target: Target!,
  ): RustCross! {
    # clang and libclang are required by bindgen
    let deps = ["build-essential", "ca-certificates", "clang", "libclang-dev"]

    let base = self
      .base
      .{ debianSetup(_, deps) }
      .{ self.withPhpHeaders(_, phpVersion, variant, target) }

    Dagger.rustCross(
      ws: ws,
      container: base,
      zigVersion: self.zigVersion,
      cargoZigbuildVersion: self.cargoZigbuildVersion,
      macosSdkVersion: self.macosSdkVersion,
      components: self.components,
      overlay: self.overlay,
      envFile: self.envFile,
      sourceDateEpoch: self.sourceDateEpoch,
      noCache: self.noCache,
    )
  }

  """
  Container used to cross-compile PHP for target headers.
  """
  let phpContainer: Container! {
    let deps = ["autoconf", "bison", "build-essential", "ca-certificates", "clang", "libclang-dev", "curl", "file", "git", "make", "pkg-config", "re2c", "unzip", "xz-utils", "zip"]

    debianSetup(Dagger.container.from("debian:trixie-slim"), deps)
      .{ withPhpToolchain(_, self.zigVersion, self.macosSdkVersion) }
  }

  let defaultDarwinArgs: [String!]! {
    [
      "-isysroot", "${SDKROOT}",
      "-isystem", "${SDKROOT}/usr/include",
      "-iframework", "${SDKROOT}/System/Library/Frameworks",
      "-mmacosx-version-min=" + self.macosDeploymentTarget,
    ]
  }

  """
  Cross-compile PHP (configure only) for the target and install its headers and php-config
  into the given container, along with a php shim answering the queries ext-php-rs makes.
  """
  let withPhpHeaders(
    container: Container!,
    phpVersion: String!,
    variant: PhpVariant!,
    target: Target!,
  ): Container! {
    let cflags = ["-g", "-O2", "-Wno-error=date-time"]
    let cppflags = []

    if (target.isDarwin) {
      cflags += self.defaultDarwinArgs
      cppflags += self.defaultDarwinArgs
    }

    let phpContainer = self
      .phpContainer
      .withEnvVariable("CC", "zig cc -target " + target.toZigTarget)
      .withEnvVariable("CXX", "zig c++ -target " + target.toZigTarget)
      .withEnvVariable("CFLAGS", cflags.join(" "), expand: true)
      .withEnvVariable("CPPFLAGS", cppflags.join(" "), expand: true)

    let configureArgs = [
      "--host=" + target.toString,
      "--build=" + phpContainer.withExec(["gcc", "-dumpmachine"]).stdout.trimSpace,
      "--disable-all",
      "--disable-cgi",
      "--disable-cli",
      "--disable-phpdbg",
      "--enable-embed=static",
      "--without-pear",
    ]

    # TODO: figure out why this is necessary
    if (target.toString == "x86_64-unknown-linux-gnu") {
      configureArgs += ["php_cv_have_avx512=no", "php_cv_have_avx512vbmi=no"]
    }

    let threadSafety = "disabled"
    let ztsSuffix = ""

    if (variant == PhpVariant.ZTS) {
      configureArgs += ["--enable-zts"]
      threadSafety = "enabled"
      ztsSuffix = "-zts"
    }

    let build = Dagger
      .phpDist
      .fromVersion(phpVersion, phpContainer)
      .buildconf(force: true)
      .configure(configureArgs)

    let phpShim = Dagger
      .currentModule
      .source
      .file("shims/php")
      .withReplaced("@@PHP_VERSION@@", phpVersion)
      .withReplaced("@@PHP_API_VERSION@@", build.apiVersion)
      .withReplaced("@@PHP_THREAD_SAFETY@@", threadSafety)
      .withReplaced("@@PHP_ZTS_SUFFIX@@", ztsSuffix)

    build
      .install(container, [PhpDistComponent.HEADERS, PhpDistComponent.PROGRAMS])
      .withFile(build.config.prefix + "/bin/php", phpShim, permissions: 755)
  }
}

let debianSetup(container: Container!, packages: [String!]!): Container! {
  container
    .withMountedCache("/var/cache/apt/archives", Dagger.cacheVolume("debian-apt-archives"))
    .withEnvVariable("DEBIAN_FRONTEND", "noninteractive")
    .withExec(["apt-get", "update"])
    .withExec(["apt-get", "install", "-y", "--no-install-recommends"] + packages)
}

type Target {
  let value: String!

  new(value: String!) {
    let valid = [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
    ]

    if (!valid.contains(value)) {
      raise "unsupported target: " + value
    }

    self.value = value

    self
  }

  """
  Returns the target as a string.
  """
  toString: String! {
    self.value
  }

  """
  Returns a target-suffixed environment variable name (e.g. CFLAGS_x86_64-unknown-linux-gnu).
  """
  env(name: String!): String! {
    name + "_" + self.value
  }

  """
  Returns a Cargo target configuration environment variable name (e.g. CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS).
  """
  cargoTargetEnv(name: String!): String! {
    "CARGO_TARGET_" + self.value.toUpper.replace("-", "_") + "_" + name
  }

  """
  Returns whether the target is a Darwin target (macOS).
  """
  isDarwin: Boolean! {
    self.value.hasSuffix("-apple-darwin")
  }

  """
  Returns the target as a Zig target string.
  """
  toZigTarget: String! {
    case (self.value) {
      "x86_64-unknown-linux-gnu" => "x86_64-linux-gnu"
      "aarch64-unknown-linux-gnu" => "aarch64-linux-gnu"
      "aarch64-apple-darwin" => "aarch64-macos"
      else => raise "unsupported target: " + self.value
    }
  }

  """
  Rust flags for the target.
  """
  let rustArgs: [String!]! {
    if (isDarwin) {
      # PHP symbols are resolved by the host process at load time.
      ["-C", "link-arg=-undefined", "-C", "link-arg=dynamic_lookup"]
    } else {
      []
    }
  }

  """
  Returns the shared library file extension produced by Cargo for the target.
  """
  fileExtension: String! {
    if (isDarwin) {
      "dylib"
    } else {
      "so"
    }
  }
}
