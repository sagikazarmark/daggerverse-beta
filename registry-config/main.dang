type RegistryConfig {
  let registries: Map[Credentials!] = [:]

  """
  Add credentials for a registry.
  """
  withRegistryAuth(
    """
    The registry address that needs authentication.
    """
    address: String!,
    """
    The username to authenticate with.
    """
    username: String!,
    """
    The API key, password or token to authenticate to this registry
    """
    secret: Secret!,
  ): RegistryConfig! @cache(policy: FunctionCachePolicy.PerSession) {
    self.registries = self.registries.with(address, Credentials(username, secret))

    self
  }

  """
  Removes credentials for a registry.
  """
  withoutRegistryAuth(
    """
    The registry address to remove credentials for.
    """
    address: String!,
  ): RegistryConfig! @cache(policy: FunctionCachePolicy.PerSession) {
    self.registries = self.registries.without(address)

    self
  }

  """
  Returns the registry config file as a secret.
  """
  secret: Secret! @cache(policy: FunctionCachePolicy.PerSession) {
    let config = {{
      auths: registries.map { key, value =>
        {{
          auth: `${value.username.trimSpace}:${value.secret.plaintext.trimSpace}`.toBase64.trimSpace
        }}
      }
    }}

    Dagger.setSecret("", JSON.encode(config))
  }
}

type Credentials {
  username: String!
  secret: Secret!
}
