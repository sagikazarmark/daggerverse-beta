type Restate {
  let name: String!
  let deployments: [Deployment!]! = []

  pub container: Container!

  pub service: Service! {
    let cacheName = "restate-" + self.name

    self.deployments.each { deployment =>
      cacheName = cacheName + "-" + deployment.cacheKey
    }

    let container = self
      .container
      # .withMountedCache("/restate-data", Dagger.cacheVolume(cacheName))
      .withExposedPort(8080)
      .withExposedPort(9070)
      .withEnvVariable("CI", "true")
      .withEnvVariable("RESTATE_ADMIN_URL", "http://localhost:9070")
      .withEnvVariable("RESTATE_NODE_NAME", self.name)

    self.deployments.each { deployment =>
      container = container.withServiceBinding(deployment.service.hostname, deployment.service)
    }

    let service = container.asService(args: ["restate-server", "--node-name", self.name])

    let registration = self
      .container
      .withEnvVariable("CI", "true")
      .withEnvVariable("RESTATE_ADMIN_URL", service.endpoint(scheme: "http", port: 9070))
      # .withEnvVariable("RESTATE_DEPLOYMENTS_REGISTERED", "true")
      .withServiceBinding(service.hostname, service)

    self.deployments.each { deployment =>
      registration = registration.withExec(["restate", "deployments", "register", "--yes", "--force", deployment.endpoint])
    }

    registration.sync

    service
  }

  # let registration: Container! {
  #   let registration = self
  #     .container
  #     .withEnvVariable("CI", "true")
  #     .withEnvVariable("RESTATE_ADMIN_URL", "http://restate:9070")
  #     # .withEnvVariable("RESTATE_DEPLOYMENTS_REGISTERED", "true")
  #     .withServiceBinding("restate", self.service)

  #   self.deployments.each { deployment =>
  #     registration = registration.withExec(["restate", "-q", "deployments", "register", "--yes", "--force", deployment.endpoint])
  #   }

  #   registration
  # }

  # pub sync: Restate! {
  #   let registration = self.registration.sync

  #   self
  # }

  # pub withServiceBinding(container: Container!, alias: String! = "restate"): Container! {
  #   let registered = self.registration.envVariable("RESTATE_DEPLOYMENTS_REGISTERED")

  #   if (registered != null) {
  #     return container
  #       .withServiceBinding(alias, self.service)
  #       .withEnvVariable("RESTATE_DEPLOYMENTS_REGISTERED", registered)
  #   }

  #   container.withServiceBinding(alias, self.service)
  # }

  #   pub client: Client! {
  #     Client(
  #       self.withServiceBinding(
  #         self
  #           .container
  #           .withEnvVariable("CI", "true")
  #           .withEnvVariable("RESTATE_ADMIN_URL", "http://restate:9070"),
  #       ),
  #     )
  #   }

  new(
    """
    Restate node name.
    """
    name: String! = "restate",
    """
    Version (image tag) to use from the official image repository.
    """
    version: String! = "latest",
    """
    Custom container to use as a base container.
    """
    container: Container! = Dagger.container.from("docker.restate.dev/restatedev/restate:" + version),
  ) {
    self.name = name
    self.container = container

    self
  }

  pub withDeployment(service: Service!, port: Int = null): Restate! {
    self.deployments += [Deployment(service, port)]

    self
  }

  """
  Returns the version of the Restate server.
  """
  pub version: String! {
    self.container.withExec(["restate-server", "--version"]).stdout.trimPrefix("restate-server ")
  }
}

type Deployment {
  pub service: Service!
  pub port: Int

  pub endpoint: String! {
    self.service.endpoint(self.port, "http")
  }

  pub cacheKey: String! {
    self.service.hostname + "-" + toString(self.port)
  }
}

type Client {
  pub container: Container!
}
