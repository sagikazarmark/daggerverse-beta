type RustEnvironment {
  let defaultContainer: Container!

  let toolchainFile: File
  let toolchainPath: String

  let cwd: String!

  let overlay: Overlay
  let targets: [String!]!
  let components: [String!]!

  let cargoRegistryIndexCache: CacheVolume
  let cargoRegistryArchiveCache: CacheVolume
  let cargoGitDbCache: CacheVolume

  new(
    ws: Workspace!,
    """
    Version (image tag) to use from the official Rust image repository as the default container.
    """
    version: String! = "latest",
    """
    Custom container to use as the default container.
    """
    container: Container! = Dagger.container.from("rust:" + version),
    """
    Overlay to apply to the container after the initial setup.
    """
    overlay: Overlay,
    """
    Targets to install with rustup.
    """
    targets: [String!]! = [],
    """
    Additional components to install with rustup.
    """
    components: [String!]! = [],
    """
    Whether to disable automatically mounted cache volumes.
    Useful if you want to mount cache volumes manually or use a different cache volume strategy.
    """
    noCache: Boolean! = false,
    """
    Cache volume for cargo registry index.
    """
    cargoRegistryIndexCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-registry-index")
    } else null,
    """
    Cache volume for cargo registry archive.
    """
    cargoRegistryArchiveCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-registry-cache")
    } else null,
    """
    Cache volume for cargo git db.
    """
    cargoGitDbCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-git-db")
    } else null,
  ) {
    self.defaultContainer = container

    let toolchainPath = ws.findUp("rust-toolchain.toml")
    self.toolchainPath = toolchainPath
    if (toolchainPath != null) {
      self.toolchainFile = ws.file(toolchainPath)
    }

    self.cwd = ws.cwd

    self.overlay = overlay
    self.targets = targets
    self.components = components

    self.cargoRegistryIndexCache = cargoRegistryIndexCache
    self.cargoRegistryArchiveCache = cargoRegistryArchiveCache
    self.cargoGitDbCache = cargoGitDbCache

    self
  }

  """
  Returns a container with the configured Rust environment.
  """
  container(
    """
    Custom base container to use.
    """
    base: Container,
  ): Container! {
    (base ?? self.defaultContainer)
      .{ self.withDefaults(_) }
      .{ self.withCache(_) }
      .{ self.rustup(_) }
      .{ self.withOverlay(_) }
  }

  let withDefaults(container: Container!): Container! {
    container
      .{
        if (_.envVariable("CARGO_HOME") == null or _.envVariable("CARGO_HOME") == "") {
          _.withEnvVariable("CARGO_HOME", "/usr/local/cargo")
        } else _
      }
      .{
        if (_.envVariable("CARGO_TARGET_DIR") == null or _.envVariable("CARGO_TARGET_DIR") == "") {
          _.withEnvVariable("CARGO_TARGET_DIR", "/target")
        } else _
      }
      .withEnvVariable("CARGO_INCREMENTAL", "0")
      .withExec(["rustup", "set", "auto-self-update", "disable"])
      .withExec(["rustup", "set", "auto-install", "disable"])
  }

  let withCache(container: Container!): Container! {
    container
      .{
        if (cargoRegistryIndexCache != null) {
          _.withMountedCache(
            "${CARGO_HOME}/registry/index",
            cargoRegistryIndexCache,
            expand: true,
            sharing: Dagger.CacheSharingMode.LOCKED,
          )
        } else _
      }
      .{
        if (cargoRegistryArchiveCache != null) {
          _.withMountedCache(
            "${CARGO_HOME}/registry/cache",
            cargoRegistryArchiveCache,
            expand: true,
            sharing: Dagger.CacheSharingMode.LOCKED,
          )
        } else _
      }
      .{
        if (cargoGitDbCache != null) {
          _.withMountedCache(
            "${CARGO_HOME}/git/db",
            cargoGitDbCache,
            expand: true,
            sharing: Dagger.CacheSharingMode.LOCKED,
          )
        } else _
      }
  }

  let rustup(container: Container!): Container! {
    let sourceDir = "/tmp/rust-environment/src"

    let toolchainFile = self.toolchainFile
    let toolchainPath = self.toolchainPath

    container
      .{
        if (toolchainFile != null) {
          _
            .withWorkdir(sourceDir + self.cwd)
            .withMountedFile(sourceDir + toolchainPath!, toolchainFile!)
            .withExec(["rustup", "toolchain", "install", "--no-self-update"])
        } else _
      }
      .{ self.withTargets(_) }
      .{ self.withComponents(_) }
      .{
        if (toolchainFile != null) {
          _
            .withoutMount(sourceDir + toolchainPath!)
            .withoutWorkdir
        } else _
      }
  }

  let withTargets(container: Container!): Container! {
    if (self.targets.isEmpty) {
      return container
    }

    container.withExec(["rustup", "target", "add"] + self.targets.uniq)
  }

  let withComponents(container: Container!): Container! {
    if (self.components.isEmpty) {
      return container
    }

    container.withExec(["rustup", "component", "add"] + self.components.uniq)
  }

  let withOverlay(container: Container!): Container! {
    self.overlay.apply(container) ?? container
  }
}

interface Overlay {
  apply(container: Container!): Container!
}
