type RustEnvironment {
  let baseContainer: Container!

  let targets: [String!]!
  let components: [String!]!
  let cargoTargetCache: CacheVolume

  new(
    """
    Version (image tag) to use from the official Rust image repository as a base container.
    """
    version: String! = "latest",
    """
    Custom container to use as a base container.
    """
    container: Container! = Dagger.container.from("rust:" + version),
    """
    Targets to install with rustup.
    """
    targets: [String!]! = [],
    """
    Additional components to install with rustup.
    """
    components: [String!]! = [],
    """
    Overlay to apply to the base container after the initial setup.
    """
    overlay: Overlay,
    """
    Whether to disable automatically mounted cache volumes.
    Useful if you want to mount cache volumes manually or use a different cache volume strategy.
    """
    noCache: Boolean! = false,
    """
    Cache volume for cargo registry index.
    """
    cargoRegistryIndexCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-registry-index")
    } else null,
    """
    Cache volume for cargo registry archive.
    """
    cargoRegistryArchiveCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-registry-cache")
    } else null,
    """
    Cache volume for cargo git db.
    """
    cargoGitDbCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-git-db")
    } else null,
    """
    Cache volume for cargo target.
    """
    cargoTargetCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-target")
    } else null,
  ) {
    self.baseContainer = container
      .{
        if (_.envVariable("CARGO_HOME") == null) {
          _.withEnvVariable("CARGO_HOME", "/usr/local/cargo")
        } else _
      }
      .withExec(["rustup", "set", "auto-self-update", "disable"])
      .withExec(["rustup", "set", "auto-install", "disable"])
      .{
        if (cargoRegistryIndexCache != null) {
          _.withMountedCache(
            "${CARGO_HOME}/registry/index",
            cargoRegistryIndexCache,
            expand: true,
          )
        } else _
      }
      .{
        if (cargoRegistryArchiveCache != null) {
          _.withMountedCache(
            "${CARGO_HOME}/registry/cache",
            cargoRegistryArchiveCache,
            expand: true,
          )
        } else _
      }
      .{
        if (cargoGitDbCache != null) {
          _.withMountedCache(
            "${CARGO_HOME}/git/db",
            cargoGitDbCache,
            expand: true,
          )
        } else _
      }
      .{ overlay.apply(_) ?? _ }

    self.targets = targets
    self.components = components
    self.cargoTargetCache = cargoTargetCache

    self
  }

  container(ws: Workspace): Container! {
    self
      .baseContainer
      .{ self.withRustToolchain(_, ws) }
      .{ self.withTargets(_) }
      .{ self.withComponents(_) }
      .withoutWorkdir # In case there was a rust-toolchain.toml mounted
      .{ self.withTargetCache(_) }
  }

  let withRustToolchain(container: Container!, workspace: Workspace): Container! {
    if (workspace == null) {
      return container
    }

    let toolchain = workspace.findUp("rust-toolchain.toml")
    if (toolchain == null) {
      return container
    }

    let sourceDir = "/tmp/rust-environment/src"

    container
      .withWorkdir(sourceDir + workspace.cwd)
      .withMountedFile(sourceDir + toolchain, workspace.file(toolchain))
      .withExec(["rustup", "toolchain", "install", "--no-self-update"])
  }

  let withTargets(container: Container!): Container! {
    if (self.targets.isEmpty) {
      return container
    }

    container.withExec(["rustup", "target", "add"] + self.targets.uniq)
  }

  let withComponents(container: Container!): Container! {
    if (self.components.isEmpty) {
      return container
    }

    container.withExec(["rustup", "component", "add"] + self.components.uniq)
  }

  let withTargetCache(container: Container!): Container! {
    let cargoTargetCache = self.cargoTargetCache
    if (cargoTargetCache == null) {
      return container
    }

    container
      .withEnvVariable("CARGO_TARGET_DIR", "/target")
      .withMountedCache("/target", cargoTargetCache)
  }
}

interface Overlay {
  apply(container: Container!): Container!
}
