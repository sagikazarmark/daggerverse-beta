let chefVersion: String! = "0.1.78"

"""
Bin-only crate without dependencies: cooks in seconds.
"""
let binOnlyProject(main: String!): Directory! {
  Dagger
    .directory
    .withNewFile(
      "Cargo.toml",
      "[package]\nname = \"app\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[dependencies]\n",
    )
    .withNewFile(
      "Cargo.lock",
      "# This file is automatically @generated by Cargo.\n# It is not intended for manual editing.\nversion = 4\n\n[[package]]\nname = \"app\"\nversion = \"0.1.0\"\n",
    )
    .withNewFile("src/main.rs", main)
}

"""
Virtual workspace with two bin-only members.
"""
let workspaceProject: Directory! {
  Dagger
    .directory
    .withNewFile("Cargo.toml", "[workspace]\nresolver = \"2\"\nmembers = [\"api\", \"cli\"]\n")
    .withNewFile(
      "Cargo.lock",
      "# This file is automatically @generated by Cargo.\n# It is not intended for manual editing.\nversion = 4\n\n[[package]]\nname = \"api\"\nversion = \"0.1.0\"\n\n[[package]]\nname = \"cli\"\nversion = \"0.1.0\"\n",
    )
    .withNewFile("api/Cargo.toml", "[package]\nname = \"api\"\nversion = \"0.1.0\"\nedition = \"2021\"\n")
    .withNewFile("api/src/main.rs", "fn main() { println!(\"api\"); }")
    .withNewFile("cli/Cargo.toml", "[package]\nname = \"cli\"\nversion = \"0.1.0\"\nedition = \"2021\"\n")
    .withNewFile("cli/src/main.rs", "fn main() { println!(\"cli\"); }")
}

type ChefTests {
  """
  The binary is installed only when chef is enabled.
  """
  install: Void @check {
    let enabled = Dagger
      .rustEnvironment(ws: binOnlyProject("fn main() {}").asWorkspace, chef: true)
      .apply(rustContainer)
      .withExec(["cargo", "chef", "--version"])
      .stdout

    assert { enabled.contains(chefVersion) }

    let disabled = Dagger
      .rustEnvironment(ws: binOnlyProject("fn main() {}").asWorkspace)
      .apply(rustContainer)
      .withExec(["sh", "-c", "test -e /usr/local/bin/cargo-chef && echo present || echo absent"])
      .stdout

    assert { disabled.trimSpace == "absent" }
  }

  """
  Enabling chef without a Cargo.lock fails early.
  """
  missingLock: Void @check {
    assert {
      {
        Dagger.rustEnvironment(ws: Dagger.directory.asWorkspace, chef: true).chef
        false
      } rescue {
        err: Error => err.message.contains("cargo-chef requires a Cargo.lock")
      }
    }
  }

  """
  Cooking without enabling chef fails.
  """
  notEnabled: Void @check {
    let source = binOnlyProject("fn main() {}")

    assert {
      {
        Dagger.rustEnvironment(ws: source.asWorkspace).cook(rustContainer, source).workdir
        false
      } rescue {
        err: Error => err.message.contains("cargo-chef is not enabled")
      }
    }
  }

  """
  The recipe only depends on manifests: editing sources leaves it unchanged,
  editing a manifest changes it.
  """
  recipeStability: Void @check {
    let a = binOnlyProject("fn main() { println!(\"a\"); }")
    let b = binOnlyProject("fn main() { println!(\"b\"); }")
    let c = a.withNewFile(
      "Cargo.toml",
      "[package]\nname = \"app\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\n",
    )

    let env = Dagger.rustEnvironment(ws: a.asWorkspace, chef: true)
    let container = env.apply(rustContainer)

    assert { env.recipe(container, a).digest == env.recipe(container, b).digest }
    assert { env.recipe(container, a).digest != env.recipe(container, c).digest }
  }

  """
  The cooked container holds the dummy skeleton, not the source,
  and the real build afterwards produces the real binary (not the dummy one).
  """
  binOnly: Void @check {
    let source = binOnlyProject("fn main() { println!(\"REAL BINARY\"); }")
    let env = Dagger.rustEnvironment(ws: source.asWorkspace, chef: true)

    let cooked = env
      .apply(rustContainer)
      .{ env.cook(_, source) }

    assert { cooked.file("/work/src/src/main.rs").contents == "fn main() {}" }
    assert { cooked.directory("/target/debug").entries.contains("app") }

    let output = cooked
      .withMountedDirectory("/work/src", source)
      .withWorkdir("/work/src")
      .withExec(["cargo", "build"])
      .withExec(["/target/debug/app"])
      .stdout

    assert { output == "REAL BINARY\n" }
  }

  """
  From a workspace member, the cook runs at the Cargo workspace root
  but selects only the member (as cargo would from that directory).
  """
  workspaceMember: Void @check {
    let ws = workspaceProject.asWorkspace("api")
    let env = Dagger.rustEnvironment(ws: ws, chef: true)

    assert { env.cargoRoot == "/" }
    assert { env.manifestPath == "/api/Cargo.toml" }

    let cooked = env
      .apply(rustContainer)
      .{ env.cook(_, workspaceProject) }

    assert { cooked.workdir == "/work/src" }
    assert { cooked.file("/work/src/Cargo.toml").contents.contains("[workspace]") }

    let built = cooked.directory("/target/debug").entries

    assert { built.contains("api") }
    assert { !built.contains("cli") }
  }

  """
  Cooking a real project compiles its dependencies and removes the dummy library artifacts.
  """
  realProjectDependencies: Void @check {
    let env = Dagger.rustEnvironment(ws: realProject.asWorkspace, chef: true)

    let cooked = env
      .apply(rustContainer)
      .{ env.cook(_, realProject) }

    let deps = cooked.directory("/target/debug/deps").entries

    assert { deps.any { _.hasPrefix("libclap-") } }
    assert { !deps.any { _.hasPrefix("libcargo_artifacts") } }

    # the dummy skeleton is in place of the source
    assert { cooked.file("/work/src/src/lib.rs").contents == "" }
  }
}
