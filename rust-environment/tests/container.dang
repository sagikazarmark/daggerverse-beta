type ContainerTests {
  defaults: Void @check {
    Dagger
      .rustEnvironment(ws: Dagger.directory.asWorkspace)
      .apply(rustContainer)
      .withExec(["cargo", "version"])
      .sync

    null
  }

  cargoHomeDefault: Void @check {
    let container = Dagger
      .rustEnvironment(ws: Dagger.directory.asWorkspace)
      .apply(rustContainer)

    assert { container.envVariable("CARGO_HOME") == "/usr/local/cargo" }
  }

  cargoHomeCustom: Void @check {
    let container = Dagger
      .rustEnvironment(ws: Dagger.directory.asWorkspace)
      .apply(rustContainer.withEnvVariable("CARGO_HOME", "/custom/cargo"))

    assert { container.envVariable("CARGO_HOME") == "/custom/cargo" }
  }

  cargoHomeEmpty: Void @check {
    let container = Dagger
      .rustEnvironment(ws: Dagger.directory.asWorkspace)
      .apply(rustContainer.withEnvVariable("CARGO_HOME", ""))

    assert { container.envVariable("CARGO_HOME") == "/usr/local/cargo" }
  }

  emptyWorkspace: Void @check {
    Dagger
      .rustEnvironment(ws: Dagger.directory.asWorkspace)
      .apply(rustContainer)
      .withExec(["cargo", "version"])
      .sync

    null
  }

  realProjectSource: Void @check {
    Dagger
      .rustEnvironment(ws: realProject.asWorkspace)
      .apply(rustContainer)
      .withExec(["cargo", "version"])
      .sync

    null
  }
}
