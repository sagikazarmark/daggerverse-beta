let rustVersion: String! = "1.96.0-slim-trixie@sha256:082a5849a6870672b5f7a5bf4eddc71723fce38756fd834a0d734a5306a310ab"

let rustContainer: Container! {
  Dagger.container.from("rust:" + rustVersion)
}

let realProject: Directory! {
  Dagger
    .git("https://github.com/sagikazarmark/cargo-artifacts.git")
    .head
    .tree
}

type Tests {
  container: ContainerTests! { ContainerTests }

  toolchain: ToolchainTests! { ToolchainTests }

  apply: Void @check {
    let container = rustContainer.withEnvVariable("FOO", "bar")

    container = Dagger.rustEnvironment(ws: Dagger.directory.asWorkspace).apply(container)

    assert { container.envVariable("FOO") == "bar" }
    assert { container.envVariable("CARGO_INCREMENTAL") == "0" }
  }

  workspace: Void @check {
    assert { realProject.digest == realProject.asWorkspace.directory("").digest }
    assert { realProject.digest == realProject.asWorkspace.directory("/").digest }
  }
}
