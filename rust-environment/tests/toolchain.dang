type ToolchainTests {
  let workspace: Workspace! {
    Dagger
      .directory
      .withFile("rust-toolchain.toml", Dagger.currentModule.source.file("toolchain.toml"))
      .withDirectory("path/to/project", Dagger.directory)
      .asWorkspace("path/to/project")
  }

  defaults: Void @check {
    let container = Dagger
      .rustEnvironment(ws: Dagger.directory.asWorkspace)
      .apply(rustContainer)

    assert { !targets(container).contains("wasm32-unknown-unknown") }
    assert { !components(container).contains("rust-src") }
  }

  constructorConfigured: Void @check {
    let container = Dagger
      .rustEnvironment(
        ws: Dagger.directory.asWorkspace,
        targets: ["wasm32-unknown-unknown"],
        components: ["rust-src"],
      )
      .apply(rustContainer)

    assert { targets(container).contains("wasm32-unknown-unknown") }
    assert { components(container).contains("rust-src") }
  }

  toml: Void @check {
    let container = Dagger
      .rustEnvironment(ws: self.workspace)
      .apply(rustContainer)
      .withMountedDirectory("/work/src", self.workspace.directory("/"))
      .withWorkdir("/work/src" + self.workspace.cwd)

    assert { toolchains(container).any { _.hasPrefix("1.88-") } }
    assert { targets(container).contains("wasm32-unknown-unknown") }
    assert { components(container).contains("rust-src") }
  }

  tomlAndConstructor: Void @check {
    let container = Dagger
      .rustEnvironment(
        ws: self.workspace,
        targets: ["aarch64-unknown-linux-musl"],
        components: ["rustfmt"],
      )
      .apply(rustContainer)
      .withMountedDirectory("/work/src", self.workspace.directory("/"))
      .withWorkdir("/work/src" + self.workspace.cwd)

    assert { toolchains(container).any { _.hasPrefix("1.88-") } }
    assert { targets(container).contains("wasm32-unknown-unknown") }
    assert { targets(container).contains("aarch64-unknown-linux-musl") }
    assert { components(container).contains("rust-src") }
    assert { components(container).any { _.hasPrefix("rustfmt-") } }
  }

  """
  An explicit toolchain is installed, made active with RUSTUP_TOOLCHAIN,
  and receives the requested components.
  """
  override: Void @check {
    let env = Dagger.rustEnvironment(ws: Dagger.directory.asWorkspace, toolchain: "1.88", components: ["rustfmt"])

    assert { env.toolchain == "1.88" }

    let container = env.apply(rustContainer)

    assert { container.envVariable("RUSTUP_TOOLCHAIN") == "1.88" }
    assert { container.withExec(["rustc", "--version"]).stdout.contains("rustc 1.88.") }
    # components are listed for (and were added to) the active toolchain
    assert { components(container).any { _.hasPrefix("rustfmt-") } }
  }

  """
  `msrv` resolves to `package.rust-version`.
  """
  msrv: Void @check {
    let project = Dagger
      .directory
      .withNewFile(
        "Cargo.toml",
        "[package]\nname = \"app\"\nversion = \"0.1.0\"\nedition = \"2021\"\nrust-version = \"1.85\"\n",
      )

    assert { Dagger.rustEnvironment(ws: project.asWorkspace, toolchain: "msrv").toolchain == "1.85" }
  }

  """
  `msrv` follows `rust-version.workspace = true` to the Cargo workspace root,
  and reads a virtual manifest's `[workspace.package]` directly.
  """
  msrvInherited: Void @check {
    let project = Dagger
      .directory
      .withNewFile(
        "Cargo.toml",
        "[workspace]\nresolver = \"2\"\nmembers = [\"api\"]\n\n[workspace.package]\nrust-version = \"1.85\"\n",
      )
      .withNewFile(
        "Cargo.lock",
        "# This file is automatically @generated by Cargo.\n# It is not intended for manual editing.\nversion = 4\n\n[[package]]\nname = \"api\"\nversion = \"0.1.0\"\n",
      )
      .withNewFile(
        "api/Cargo.toml",
        "[package]\nname = \"api\"\nversion = \"0.1.0\"\nedition = \"2021\"\nrust-version.workspace = true\n",
      )

    assert { Dagger.rustEnvironment(ws: project.asWorkspace("api"), toolchain: "msrv").toolchain == "1.85" }
    assert { Dagger.rustEnvironment(ws: project.asWorkspace, toolchain: "msrv").toolchain == "1.85" }
  }

  """
  `msrv` fails early without a rust-version or without a manifest.
  """
  msrvMissing: Void @check {
    let project = Dagger
      .directory
      .withNewFile("Cargo.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\nedition = \"2021\"\n")

    assert {
      {
        Dagger.rustEnvironment(ws: project.asWorkspace, toolchain: "msrv").toolchain
        false
      } rescue {
        err: Error => err.message.contains("requires a rust-version")
      }
    }

    assert {
      {
        Dagger.rustEnvironment(ws: Dagger.directory.asWorkspace, toolchain: "msrv").toolchain
        false
      } rescue {
        err: Error => err.message.contains("requires a Cargo.toml")
      }
    }
  }

  let targets(container: Container!): [String!]! {
    container
      .withExec(["rustup", "target", "list", "--installed"])
      .stdout
      .split("\n")
  }

  let components(container: Container!): [String!]! {
    container
      .withExec(["rustup", "component", "list", "--installed"])
      .stdout
      .split("\n")
  }

  let toolchains(container: Container!): [String!]! {
    container
      .withExec(["rustup", "toolchain", "list"])
      .stdout
      .split("\n")
  }
}
