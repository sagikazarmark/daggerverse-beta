enum CargoAuditDeny {
  WARNINGS
  UNMAINTAINED
  UNSOUND
  YANKED
}

type CargoAuditConfig {
  database: CargoAuditDatabaseConfig
}

type CargoAuditDatabaseConfig {
  url: String
}

let cargoAuditBinary(version: String!): File! {
  let arch = Dagger
    .defaultPlatform
    .{
      case (_) {
        "linux/amd64" => "x86_64"
        "linux/arm64" => "aarch64"
        else => raise "unsupported platform: " + toString(_)
      }
    }

  let version = "v" + version.trimPrefix("v")

  Dagger
    .github
    .release(`cargo-audit/${version}`, "rustsec/rustsec")
    .asset(`cargo-audit-${arch}-unknown-linux-gnu-${version}.tgz`)
    .extracted(true)
    .file("cargo-audit")
}
