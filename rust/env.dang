type Environment {
  let container: Container!

  # Source independent configuration
  let targets: [String!]!
  let components: [String!]!
  let sourceDateEpoch: String

  # Needs remounting on source change
  let cargoTargetCache: CacheVolume

  # Source dependent configuration
  let envFile: File

  let sourceDir(cwd: String): String! {
    Path.join(["/work/src", cwd ?? ""])
  }

  new(
    container: Container!,
    source: Directory,
    cwd: String!,

    # Initial setup
    cargoRegistryIndexCache: CacheVolume,
    cargoRegistryArchiveCache: CacheVolume,
    cargoGitDbCache: CacheVolume,

    targets: [String!]!,
    components: [String!]!,
    overlay: Overlay,
    envFile: File,
    cargoTargetCache: CacheVolume,
    sourceDateEpoch: String,
  ) {
    self.container = container
      .withExec(["rustup", "set", "auto-self-update", "disable"])
      .withExec(["rustup", "set", "auto-install", "disable"])
      .{
        if (cargoRegistryIndexCache != null) {
          _.withMountedCache(
            "${CARGO_HOME}/registry/index",
            cargoRegistryIndexCache,
            expand: true,
          )
        } else _
      }
      .{
        if (cargoRegistryArchiveCache != null) {
          _.withMountedCache(
            "${CARGO_HOME}/registry/cache",
            cargoRegistryArchiveCache,
            expand: true,
          )
        } else _
      }
      .{
        if (cargoGitDbCache != null) {
          _.withMountedCache(
            "${CARGO_HOME}/git/db",
            cargoGitDbCache,
            expand: true,
          )
        } else _
      }
      .withFile(
        "/usr/local/bin/",
        Dagger
          .github
          .release("v0.2.0", "sagikazarmark/cargo-artifacts")
          .asset(`cargo-artifacts-${arch}-unknown-linux-gnu.tar.xz`)
          .extracted(true)
          .file("cargo-artifacts"),
      )
      .{ withCargoAudit(_) }

    self.targets = targets
    self.components = components
    self.envFile = envFile
    self.sourceDateEpoch = sourceDateEpoch
    self.cargoTargetCache = cargoTargetCache

    self.init(if (source != null) { Source(source, cwd) }, overlay)
  }

  let withSource(source: Directory!, cwd: String!, overlay: Overlay): Environment! {
    self.init(Source(source, cwd), overlay)
  }

  let init(source: Source, overlay: Overlay): Environment! {
    self.container = self
      .container
      .{ self.withRustToolchain(_, source) }
      .{ self.withTargets(_) }
      .{ self.withComponents(_) }
      .{ overlay.apply(_) ?? _ }
      .{ self.withEnvFile(_) }
      .{ self.withTargetCache(_) }
      .{ self.withEpoch(_, source) }
      .{ self.withMountedSource(_, source) }

    self
  }

  let withRustToolchain(container: Container!, source: Source): Container! {
    if (source == null) {
      return container
    }

    let toolchain = source.findUp("rust-toolchain.toml")
    if (toolchain == null) {
      return container
    }

    container
      .withWorkdir(self.sourceDir(source.cwd))
      .withMountedFile(self.sourceDir(toolchain), source.file(toolchain))
      .withExec(["rustup", "toolchain", "install", "--no-self-update"])
  }

  let withTargets(container: Container!): Container! {
    if (self.targets.isEmpty) {
      return container
    }

    container.withExec(["rustup", "target", "add"] + self.targets.uniq)
  }

  let withComponents(container: Container!): Container! {
    let components = ["rustfmt", "clippy"] + self.components.uniq

    container.withExec(["rustup", "component", "add"] + components.uniq)
  }

  let withEnvFile(container: Container!): Container! {
    let envFile = self.envFile
    if (envFile == null) {
      return container
    }

    container.withEnvFileVariables(envFile.asEnvFile)
  }

  let withTargetCache(container: Container!): Container! {
    let cargoTargetCache = self.cargoTargetCache
    if (cargoTargetCache == null) {
      return container
    }

    container
      .withEnvVariable("CARGO_TARGET_DIR", "/work/target")
      .withMountedCache("${CARGO_TARGET_DIR}", cargoTargetCache, expand: true)
  }

  let withEpoch(container: Container!, source: Source): Container! {
    let epoch = self.sourceDateEpoch
    if (epoch == null and source != null) {
      epoch = commitDate(source.directory)
    }

    if (epoch == null) {
      return container
    }

    container.withEnvVariable("SOURCE_DATE_EPOCH", epoch)
  }

  let withMountedSource(container: Container!, source: Source): Container! {
    if (source == null) {
      return container
    }

    container
      .withMountedDirectory(self.sourceDir, source.directory)
      .withWorkdir(self.sourceDir(source.cwd))
  }
}

type Source {
  let directory: Directory!
  let cwd: String!

  let findUp(file: String!): String {
    self.directory.findUp(file, self.cwd)
  }

  let file(path: String!): File! {
    self.directory.file(path)
  }
}

interface Overlay {
  apply(container: Container!): Container!
}
