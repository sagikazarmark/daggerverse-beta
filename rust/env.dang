type Environment {
  # Initial cache volumes
  let cargoRegistryIndexCache: CacheVolume
  let cargoRegistryArchiveCache: CacheVolume
  let cargoGitDbCache: CacheVolume
  let overlay: Overlay

  # Source independent configuration
  let targets: [String!]!
  let components: [String!]!

  # Needs remounting on source change
  let cargoTargetCache: CacheVolume

  # Source dependent configuration
  let sourceDateEpoch: String
  let envFile: String

  let sourceDir(cwd: String): String! {
    Path.join(["/work/src", cwd ?? ""])
  }

  let init(container: Container!, source: Directory, cwd: String!): Container! {
    container
      .withExec(["rustup", "set", "auto-self-update", "disable"])
      .withExec(["rustup", "set", "auto-install", "disable"])
      .{
        let cargoRegistryIndexCache = self.cargoRegistryIndexCache
        if (cargoRegistryIndexCache != null) {
          _.withMountedCache(
            "${CARGO_HOME}/registry/index",
            cargoRegistryIndexCache,
            expand: true,
          )
        } else _
      }
      .{
        let cargoRegistryArchiveCache = self.cargoRegistryArchiveCache
        if (cargoRegistryArchiveCache != null) {
          _.withMountedCache(
            "${CARGO_HOME}/registry/cache",
            cargoRegistryArchiveCache,
            expand: true,
          )
        } else _
      }
      .{
        let cargoGitDbCache = self.cargoGitDbCache
        if (cargoGitDbCache != null) {
          _.withMountedCache(
            "${CARGO_HOME}/git/db",
            cargoGitDbCache,
            expand: true,
          )
        } else _
      }
      .withFile(
        "/usr/local/bin/",
        Dagger
          .github
          .release("v0.2.0", "sagikazarmark/cargo-artifacts")
          .asset(`cargo-artifacts-${arch}-unknown-linux-gnu.tar.xz`)
          .extracted(true)
          .file("cargo-artifacts"),
      )
      .{ withCargoAudit(_) }
      .{ self.overlay.apply(_) ?? _ }
      .{
        if (source == null) {
          self.withTargetsComponents(_)
        } else {
          self.withSource(_, source, cwd)
        }
      }
  }

  let withSource(container: Container!, source: Directory!, cwd: String!): Container! {
    container
      .{ withToolchain(_, source, cwd) }
      .{
        let path = self.envFile
        if (path != null) {
          if (!Path.isAbs(path)) {
            path = Path.join([cwd, path])
          }

          _.withEnvFileVariables(source.file(path).asEnvFile)
        } else _
      }
      .withEnvVariable("CARGO_TARGET_DIR", "/work/target")
      .{
        let cargoTargetCache = self.cargoTargetCache
        if (cargoTargetCache != null) {
          _.withMountedCache(
            "${CARGO_TARGET_DIR}",
            cargoTargetCache,
            expand: true,
          )
        } else _
      }
      .{
        let epoch = self.sourceDateEpoch ?? commitDate(source)
        if (epoch != null) {
          _.withEnvVariable("SOURCE_DATE_EPOCH", epoch)
        } else _
      }
      .withMountedDirectory(self.sourceDir, source)
      .withWorkdir(self.sourceDir(cwd))
  }

  let withToolchain(container: Container!, source: Directory!, cwd: String!): Container! {
    container
      .{ self.withRustToolchain(_, source, cwd) }
      .{ self.withTargetsComponents(_) }
  }

  let withRustToolchain(container: Container!, source: Directory!, cwd: String!): Container! {
    let toolchain = source.findUp("rust-toolchain.toml", cwd)

    if (toolchain == null) {
      return container
    }

    container
      .withWorkdir(self.sourceDir(cwd))
      .withMountedFile(self.sourceDir(toolchain), source.file(toolchain))
      .withExec(["rustup", "toolchain", "install", "--no-self-update"])
  }

  let withTargetsComponents(container: Container!): Container! {
    container.{ self.withTargets(_) }.{ self.withComponents(_) }
  }

  let withTargets(container: Container!): Container! {
    if (self.targets.isEmpty) {
      return container
    }

    container.withExec(["rustup", "target", "add"] + self.targets)
  }

  let withComponents(container: Container!): Container! {
    let components = ["rustfmt", "clippy"] + self.components

    container.withExec(["rustup", "component", "add"] + components.uniq)
  }
}

interface Overlay {
  apply(container: Container!): Container!
}
