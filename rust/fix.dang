type Fix {
  let parent: Rust!

  let exec(ws: Workspace!, args: [String!]!): Changeset! {
    parent
      .container(ws)
      .withExec(args)
      .directory("/work/src")
      .filter(gitignore: true)
      .changes(parent.buildEnv.source(ws))
  }

  """
  Run clippy and fix any warnings.
  """
  clippy(ws: Workspace!): Changeset! @generate {
    let args = [
      "cargo", "clippy", "--fix",
      "--allow-dirty", "--allow-staged", "--allow-no-vcs", "--all-targets",
      "--", "-D", "warnings",
    ]

    self.exec(ws, args)
  }
}
