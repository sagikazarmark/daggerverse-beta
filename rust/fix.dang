type Fix {
  let parent: Rust!

  let exec(args: [String!]!): Changeset! {
    parent
      .container
      .withExec(args)
      .directory("/work/src")
      .filter(gitignore: true)
      .changes(parent.buildEnv.source)
  }

  """
  Run clippy and fix any warnings.
  """
  clippy: Changeset! @generate {
    let args = [
      "cargo", "clippy", "--fix",
      "--allow-dirty", "--allow-staged", "--allow-no-vcs", "--all-targets",
      "--", "-D", "warnings",
    ]

    self.exec(args)
  }
}
