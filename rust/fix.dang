type Fix {
  let parent: Rust!

  let exec(workspace: Workspace!, args: [String!]!): Changeset! {
    parent
      .container
      .withExec(args)
      .directory(parent.env.sourceDir)
      .changes(parent.source!)
  }

  """
  Run clippy and fix any warnings.
  """
  clippy(ws: Workspace!): Changeset! @generate {
    let args = [
      "cargo", "clippy", "--fix",
      "--allow-dirty", "--allow-staged", "--allow-no-vcs", "--all-targets",
      "--", "-D", "warnings",
    ]

    self.exec(ws, args)
  }
}
