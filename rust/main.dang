type Rust {
  let baseContainer: Container!

  # Workspace defaults
  let include: [String!]
  let exclude: [String!]

  let targets: [String!]!
  let components: [String!]!
  let sourceDateEpoch: String
  let envFile: String
  let cargoTargetCache: CacheVolume

  new(
    """
    Version (image tag) to use from the official Rust image repository as a base container.
    """
    version: String! = "latest",
    """
    Custom container to use as a base container.
    """
    container: Container! = Dagger.container.from("rust:" + version),
    """
    Include only artifacts that match the given pattern (e.g., ["app/", "package.*"]).
    """
    include: [String!],
    """
    Exclude artifacts that match the given pattern (e.g., ["node_modules/", ".git*"]).
    """
    exclude: [String!],
    """
    Overlay to apply to the base container.
    """
    overlay: Overlay,
    """
    Targets to install for cross-compilation.
    """
    targets: [String!]! = [],
    """
    Additional components to install.
    """
    components: [String!]! = [],
    """
    Override the source date epoch for reproducible builds.

    If not set, the epoch is determined from the git log (if available).
    """
    sourceDateEpoch: String,
    """
    Env file to load into workspace containers.

    Relative paths are resolved from the workspace cwd; absolute paths are resolved from the workspace root.
    """
    envFile: String,
    """
    Whether to disable automatically mounted cache volumes.
    Useful if you want to mount cache volumes manually or use a different cache volume strategy.
    """
    noCache: Boolean! = false,
    """
    Cache volume for cargo registry index.
    """
    cargoRegistryIndexCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-registry-index")
    } else {
      null
    },
    """
    Cache volume for cargo registry archive.
    """
    cargoRegistryArchiveCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-registry-cache")
    } else {
      null
    },
    """
    Cache volume for cargo git db.
    """
    cargoGitDbCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-git-db")
    } else {
      null
    },
    """
    Cache volume for cargo target.
    """
    cargoTargetCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-target")
    } else {
      null
    },
  ) {
    self.baseContainer = container
      .withExec(["rustup", "set", "auto-self-update", "disable"])
      .withExec(["rustup", "set", "auto-install", "disable"])
      .{ withCache(_, "${CARGO_HOME}/registry/index", cargoRegistryIndexCache) }
      .{ withCache(_, "${CARGO_HOME}/registry/cache", cargoRegistryArchiveCache) }
      .{ withCache(_, "${CARGO_HOME}/git/db", cargoGitDbCache) }
      .withFile(
        "/usr/local/bin/",
        Dagger
          .github
          .release("v0.2.0", "sagikazarmark/cargo-artifacts")
          .asset(`cargo-artifacts-${arch}-unknown-linux-gnu.tar.xz`)
          .extracted(true)
          .file("cargo-artifacts"),
      )
      .{ overlay.apply(_) ?? _ }

    self.include = include
    self.exclude = exclude
    self.targets = targets
    self.components = components
    self.sourceDateEpoch = sourceDateEpoch
    self.envFile = envFile
    self.cargoTargetCache = cargoTargetCache

    self
  }

  """
  Container with the Rust toolchain and common components installed.
  """
  container: Container! {
    self.withTargetsComponents(self.baseContainer)
  }

  """
  Mounts the given workspace into the container.
  """
  withWorkspace(
    ws: Workspace!,
    """
    Overlay to apply to the container before mounting the source in the container.
    """
    overlay: Overlay,
  ): WorkspaceContext! {
    self.prepareWorkspace(ws) { overlay.apply(_) ?? _ }
  }

  """
  Mounts the given source directory into the container.
  """
  withSource(
    """
    Source directory to mount in the container.
    """
    source: Directory!,
    """
    Current working directory within the source directory.
    """
    cwd: String! = "/",
    """
    Overlay to apply to the container before mounting the source in the container.
    """
    overlay: Overlay,
  ): WorkspaceContext! {
    let envFile: EnvFile
    if (self.envFile != null) {
      let path = self.envFile!

      # relative path
      if (!path.hasPrefix("/")) {
        path = Path.join([cwd, path])
      }

      envFile = source.file(path).asEnvFile
    }

    self.prepare(source, cwd, envFile) { overlay.apply(_) ?? _ }
  }

  let prepareWorkspace(ws: Workspace!, &fn(container: Container!): Container!): WorkspaceContext! {
    let source = ws.directory(
      "/",
      gitignore: true,
      include: self.include,
      exclude: self.exclude,
    )
    let cwd = ws.cwd

    let envFile: EnvFile
    if (self.envFile != null) {
      envFile = ws.file(self.envFile!).asEnvFile
    }

    self.prepare(source, cwd, envFile) { fn(_) }
  }

  let prepare(
    source: Directory!,
    cwd: String!,
    envFile: EnvFile,
    &fn(container: Container!): Container!,
  ): WorkspaceContext! {
    let container = self
      .baseContainer
      .{ fn(_) }
      .{ withToolchain(_, source, cwd) }
      .{ if (envFile != null) _.withEnvFileVariables(envFile) else _ }
      .withEnvVariable("CARGO_TARGET_DIR", "/work/target")
      .{ withCache(_, "${CARGO_TARGET_DIR}", self.cargoTargetCache) }
      .{ withEnvVariable(_, "SOURCE_DATE_EPOCH", self.sourceDateEpoch ?? commitDate(source)) }
      .withMountedDirectory("/work/src", source)
      .withWorkdir(Path.join(["/work/src", cwd]))

    WorkspaceContext(container, source, cwd)
  }

  let withToolchain(container: Container!, source: Directory!, cwd: String!): Container! {
    container
      .{ self.withRustToolchain(_, source, cwd) }
      .{ self.withTargetsComponents(_) }
  }

  let withRustToolchain(container: Container!, source: Directory!, cwd: String!): Container! {
    let toolchain = source.findUp("rust-toolchain.toml", cwd)

    if (toolchain == null) {
      return container
    }

    container
      .withWorkdir(Path.join(["/work/src", cwd]))
      .withMountedFile(Path.join(["/work/src", toolchain]), source.file(toolchain))
      .withExec(["rustup", "toolchain", "install", "--no-self-update"])
  }

  let withTargetsComponents(container: Container!): Container! {
    container
      .{ self.withTargets(_) }
      .{ self.withComponents(_) }
  }

  let withTargets(container: Container!): Container! {
    if (self.targets.isEmpty) {
      return container
    }

    container.withExec(["rustup", "target", "add"] + self.targets)
  }

  let withComponents(container: Container!): Container! {
    let components = ["rustfmt", "clippy"] + self.components

    container.withExec(["rustup", "component", "add"] + components.uniq)
  }

  """
  Audit Cargo.lock files for vulnerable crates.
  """
  audit(
    ws: Workspace!,
    """
    Exit with an error on any violation.
    """
    deny: CargoAuditDeny = null,
    """
    Advisory id to ignore (can be specified multiple times).
    """
    ignore: [String!]! = [],
    """
    Directory containing the advisory database.
    """
    db: Directory! = Dagger.git("https://github.com/rustsec/advisory-db.git").head.tree,
  ): String! @check {
    let DB_PATH = "/var/cargo-audit/advisory-db"

    let args = [
      "cargo", "audit",
      "--no-fetch", "--stale", "--db", DB_PATH,
    ]

    if (deny != null) {
      args += ["--deny", toString(deny)]
    }

    ignore.each { advisory =>
      args += ["--ignore", advisory]
    }

    self
      .prepareWorkspace(ws) { withCargoAudit(_).withMountedDirectory(DB_PATH, db) }
      .container
      .withExec(args)
      .stdout
  }

  """
  Compile a local package and all of its dependencies.
  """
  build(
    ws: Workspace!,
    """
    Package to build.
    """
    package: [String!]! = [],
    """
    Build all packages in the workspace.
    """
    all: Boolean! = false,
    """
    Exclude packages from the build.
    """
    exclude: [String!]! = [],
    """
    Build only this package's library.
    """
    lib: Boolean! = false,
    """
    Build all binaries.
    """
    bins: Boolean! = false,
    """
    Build only the specified binary.
    """
    bin: [String!]! = [],
    """
    Build all examples.
    """
    examples: Boolean! = false,
    """
    Build only the specified example.
    """
    example: [String!]! = [],
    """
    Build all targets that have `test = true` set.
    """
    tests: Boolean! = false,
    """
    Build only the specified test target.
    """
    test: [String!]! = [],
    """
    Build all targets that have `bench = true` set.
    """
    benches: Boolean! = false,
    """
    Build only the specified bench target.
    """
    bench: [String!]! = [],
    """
    Build all targets.
    """
    allTargets: Boolean! = false,
    """
    Build for the target triple.
    """
    target: [String!]! = [],
    """
    Activate all available features.
    """
    allFeatures: Boolean! = false,
    """
    List of features to activate.
    """
    feature: [String!]! = [],
    """
    Do not activate the `default` feature.
    """
    noDefaultFeatures: Boolean! = false,
    """
    Build artifacts in release mode, with optimizations.
    """
    release: Boolean! = false,
    """
    Build artifacts with the specified profile.
    """
    profile: String! = "",
    """
    Do not abort the build as soon as there is an error.
    """
    keepGoing: Boolean! = false,
  ): Directory! @check {
    let args = CargoCommand.build(
      package,
      all,
      exclude,
      lib,
      bins,
      bin,
      examples,
      example,
      tests,
      test,
      benches,
      bench,
      allTargets,
      target,
      allFeatures,
      feature,
      noDefaultFeatures,
      release,
      profile,
      keepGoing,
    )

    let expect = ReturnType.SUCCESS
    if (keepGoing) {
      expect = ReturnType.ANY
    }

    self
      .withWorkspace(ws)
      .container
      .withExec(
        args,
        expand: true,
        redirectStdout: "/stdout.json",
        expect: expect,
      )
      .withExec(["cargo", "artifacts", "copy", "-i", "/stdout.json", "--out-dir", "/work/out"])
      .directory("/work/out")
  }

  """
  Execute all unit and integration tests and build examples of a local package.
  """
  test(
    ws: Workspace!,
    """
    If specified, only run tests containing this string in their names.
    """
    testName: String! = "",
    """
    Arguments for the test binary.
    """
    args: [String!]! = [],
    """
    Run all tests regardless of failure.
    """
    noFailFast: Boolean! = false,
    """
    Package to run tests for.
    """
    package: [String!]! = [],
    """
    Test all packages in the workspace.
    """
    all: Boolean! = false,
    """
    Exclude packages from the test.
    """
    exclude: [String!]! = [],
    """
    Test only this package's library.
    """
    lib: Boolean! = false,
    """
    Test all binaries.
    """
    bins: Boolean! = false,
    """
    Test only the specified binary.
    """
    bin: [String!]! = [],
    """
    Test all examples.
    """
    examples: Boolean! = false,
    """
    Test only the specified example.
    """
    example: [String!]! = [],
    """
    Test all targets that have `test = true` set.
    """
    tests: Boolean! = false,
    """
    Test only the specified test target.
    """
    test: [String!]! = [],
    """
    Test all targets that have `bench = true` set.
    """
    benches: Boolean! = false,
    """
    Test only the specified bench target.
    """
    bench: [String!]! = [],
    """
    Test all targets (does not include doctests).
    """
    allTargets: Boolean! = false,
    """
    Build for the target triple.
    """
    target: [String!]! = [],
    """
    Test only this library's documentation.
    """
    doc: Boolean! = false,
    """
    Activate all available features.
    """
    allFeatures: Boolean! = false,
    """
    List of features to activate.
    """
    feature: [String!]! = [],
    """
    Do not activate the `default` feature.
    """
    noDefaultFeatures: Boolean! = false,
    """
    Build artifacts in release mode, with optimizations.
    """
    release: Boolean! = false,
    """
    Build artifacts with the specified profile.
    """
    profile: String! = "",
  ): String! @check {
    let args = CargoCommand.test(
      testName,
      args,
      noFailFast,
      package,
      all,
      exclude,
      lib,
      bins,
      bin,
      examples,
      example,
      tests,
      test,
      benches,
      bench,
      allTargets,
      target,
      doc,
      allFeatures,
      feature,
      noDefaultFeatures,
      release,
      profile,
    )

    self.withWorkspace(ws).container.withExec(args).combinedOutput
  }

  """
  Format the codebase using rustfmt.
  """
  fmt(ws: Workspace!): Changeset! @generate {
    let ctx = self.withWorkspace(ws)

    ctx
      .container
      .withExec(["cargo", "fmt", "--", "--check"])
      .directory("")
      .changes(ctx.source)
  }

  """
  Checks a package to catch common mistakes and improve your Rust code.
  """
  clippy(
    ws: Workspace!,
    """
    Run Clippy only on the given crate, without linting the dependencies.
    """
    noDeps: Boolean! = true,
    """
    Set lint warnings.
    """
    warn: [String!]! = [],
    """
    Set lint allowed.
    """
    allow: [String!]! = [],
    """
    Set lint denied.
    """
    deny: [String!]! = [],
    """
    Set lint forbidden.
    """
    forbid: [String!]! = [],
  ): String! @check {
    let args = CargoCommand.generic("clippy")
    if (noDeps) {
      args += ["--no-deps"]
    }

    args += ["--"]

    warn.each { w => args += ["--warn", w] }
    allow.each { a => args += ["--allow", a] }
    deny.each { d => args += ["--deny", d] }
    forbid.each { f => args += ["--forbid", f] }

    self.withWorkspace(ws).container.withExec(args).stdout
  }

  """
  Build a package's documentation.
  """
  doc(
    ws: Workspace!,
    """
    Don't build documentation for dependencies.
    """
    noDeps: Boolean! = true,
    """
    Package to run tests for.
    """
    package: [String!]! = [],
    """
    Test all packages in the workspace.
    """
    all: Boolean! = false,
    """
    Exclude packages from the test.
    """
    exclude: [String!]! = [],
    """
    Test only this package's library.
    """
    lib: Boolean! = false,
    """
    Test all binaries.
    """
    bins: Boolean! = false,
    """
    Test only the specified binary.
    """
    bin: [String!]! = [],
    """
    Test all examples.
    """
    examples: Boolean! = false,
    """
    Test only the specified example.
    """
    example: [String!]! = [],
    """
    Activate all available features.
    """
    allFeatures: Boolean! = false,
    """
    List of features to activate.
    """
    feature: [String!]! = [],
    """
    Do not activate the `default` feature.
    """
    noDefaultFeatures: Boolean! = false,
    """
    Build artifacts in release mode, with optimizations.
    """
    release: Boolean! = false,
    """
    Build artifacts with the specified profile.
    """
    profile: String! = "",
  ): String! @check {
    let args = CargoCommand.doc(
      noDeps,
      package,
      all,
      exclude,
      lib,
      bins,
      bin,
      examples,
      example,
      allFeatures,
      feature,
      noDefaultFeatures,
      release,
      profile,
    )

    self
      .prepareWorkspace(ws) { _.withEnvVariable("RUSTDOCFLAGS", "-D warnings") }
      .container
      .withExec(args)
      .stdout
  }

  """
  Runs a set of fixers and code formatters.
  """
  fix: Fix! {
    Fix(self)
  }
}

"""
Represents a context with a prepared workspace.

Meaning: source code is mounted into the container, workspace specific toolchain (if any) is installed.
"""
type WorkspaceContext {
  """
  The container with the workspace mounted.
  """
  container: Container!

  """
  The source code directory (containing the entire workspace).
  """
  source: Directory!

  """
  The current working directory within the workspace.
  """
  cwd: String!
}
