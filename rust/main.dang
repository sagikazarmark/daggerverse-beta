type Rust {
  let base: Container!

  let env: RustEnvironment!
  let buildEnv: BuildEnvironment!

  let overlay: Overlay

  let prefetch: Boolean!

  let chefArgs: [String!]

  """
  Configuration of this module instance from the project's manifest (see hack.dang).
  """
  let config: ModuleConfig

  """
  Whether tests run with cargo-nextest: the project has a `.config/nextest.toml` (see nextest.dang).
  """
  nextest: Boolean! = false

  new(
    ws: Workspace!,
    """
    Version (image tag) to use from the official Rust image repository as a base container.
    """
    version: String! = "latest",
    """
    Custom container to use as a base container.
    """
    container: Container! = Dagger.container.from("rust:" + version),
    """
    Toolchain to install and use instead of the base container's (rustup name, e.g. `1.85`, `nightly`),
    or `msrv` for the project's `package.rust-version`.

    Takes precedence over a rust-toolchain.toml.
    """
    toolchain: String,
    """
    Targets to install for cross-compilation.
    """
    targets: [String!]! = [],
    """
    Additional components to install.
    """
    components: [String!]! = [],
    """
    Overlay to apply to the base container (after Rust toolchain is installed).
    """
    overlay: Overlay,
    """
    Env file to load into the container.
    """
    envFile: File,
    """
    Override the source date epoch for reproducible builds.

    If not set, the epoch is determined from the git log (if available).
    """
    sourceDateEpoch: String,
    """
    Whether to disable automatically mounted cache volumes.
    Useful if you want to mount cache volumes manually or use a different cache volume strategy.
    """
    noCache: Boolean! = false,
    """
    Whether to prefetch Cargo dependencies before building.
    """
    prefetch: Boolean! = false,
    """
    Cache compiled dependencies in a separate layer using cargo-chef.

    Requires a Cargo.lock. Before each cargo command, its dependencies are compiled
    from the manifests alone (with arguments mirroring the command), so source edits
    only recompile the workspace crates.
    """
    chef: Boolean! = false,
    """
    cargo-chef version to install when `chef` is enabled.
    """
    chefVersion: String,
    """
    Fixed arguments for `cargo chef cook` (e.g. `["--workspace", "--all-targets"]`).

    When set, replaces the arguments derived from each cargo command
    (one shared dependency layer per profile), and also applies to `container`.
    """
    chefArgs: [String!],
  ) {
    self.base = container

    self.env = Dagger.rustEnvironment(
      ws: ws,
      toolchain: toolchain,
      targets: targets,
      components: ["rustfmt", "clippy"] + components,
      noCache: noCache,
      chef: chef,
      chefVersion: chefVersion,
    )

    self.buildEnv = Dagger
      .buildEnvironment
      .withSource(ws.directory("/", gitignore: true), ws.cwd)
      .withEnvFile(envFile)
      .withSourceDateEpoch(sourceDateEpoch)

    self.overlay = overlay

    self.prefetch = prefetch

    self.chefArgs = chefArgs

    self.config = moduleConfig(ws, ws.findUp("Cargo.toml"))

    self.nextest = detectNextest(ws)

    self
  }

  """
  Set an environment variable in the build container.
  """
  withEnvVariable(
    """
    Name of the environment variable (e.g., "RUSTFLAGS").
    """
    name: String!,
    """
    Value of the environment variable (e.g., "-C target-cpu=native").
    """
    value: String!,
    """
    Replace `${VAR}` or `$VAR` in the value according to the current environment
    variables defined in the container (e.g., "/opt/bin:$PATH").
    """
    expand: Boolean,
  ): Rust! {
    self.buildEnv = self.buildEnv.withEnvVariable(name, value, expand)

    self
  }

  """
  Container with the Rust toolchain and common components installed.

  Dependencies are cooked (cargo-chef) only when `chefArgs` is set.
  """
  container: Container! {
    self.assemble(null) { _ }
  }

  """
  Assemble the build container: base, Rust environment, overlays, caller hook,
  build environment variables, cargo-chef cook (optional), then the source.

  The cook runs with the final environment but before the source is mounted:
  its inputs are the environment and the recipe (derived from the manifests), never the sources.
  """
  let assemble(cookArgs: [String!], &fn(c: Container!): Container!): Container! {
    self
      .base
      .{ self.env.apply(_) }
      .{ moduleOverlay("v0.2.0", self.overlay).apply(_) }
      .{ fn(_) }
      .{ self.buildEnv.applyEnvironment(_) }
      .{ self.cook(_, cookArgs) }
      .{ self.buildEnv.applySource(_) }
  }

  """
  Cook dependencies with cargo-chef, when enabled.

  Fixed `chefArgs` take precedence over the derived arguments; `null` means no cook.
  """
  let cook(container: Container!, derivedArgs: [String!]): Container! {
    if (!self.env.chef) {
      return container
    }

    let args = self.chefArgs ?? derivedArgs
    if (args == null) {
      return container
    }

    self.env.cook(container, self.buildEnv.source, self.buildEnv.sourceRoot, args)
  }

  let extendContainer(cookArgs: [String!], &fn(c: Container!): Container!): Container! {
    self
      .assemble(cookArgs) { fn(_) }
      .{
        if (self.prefetch) {
          _.withExec(["cargo", "fetch", "--locked"])
        } else _
      }
  }

  let buildContainer(cookArgs: [String!]): Container! {
    self.extendContainer(cookArgs) { _ }
  }

  """
  Build container for a cargo command, with cargo-hack installed when the command is wrapped by it
  and cargo-nextest when it runs the tests.
  """
  let commandContainer(cookArgs: [String!], hack: [String!], nextest: Boolean! = false): Container! {
    self.extendContainer(cookArgs) {
      _
        .{
          if (hack != null) {
            _.withFile("/usr/local/bin/cargo-hack", cargoHackBinary(defaultHackVersion))
          } else _
        }
        .{
          if (nextest) {
            _.withFile("/usr/local/bin/cargo-nextest", cargoNextestBinary(defaultNextestVersion))
          } else _
        }
    }
  }

  """
  cargo-hack arguments configured for a cargo command (null when not configured).
  """
  let hackArgs(&select(hack: HackConfig!): [String!]): [String!] {
    let config = self.config
    if (config == null) {
      return null
    }

    let hack = config.hack
    if (hack == null) {
      return null
    }

    select(hack)
  }

  """
  Audit Cargo.lock files for vulnerable crates.
  """
  audit(
    """
    Exit with an error on any violation.
    """
    deny: CargoAuditDeny,
    """
    Advisory id to ignore (can be specified multiple times).
    """
    ignore: [String!]! = [],
  ): String! @check {
    let advisoryDb = Dagger.git("https://github.com/rustsec/advisory-db.git").head.tree

    if (self.env.dotCargo.exists("audit.toml", expectedType: ExistsType.REGULAR_TYPE)) {
      let config = TOML.decode(self.env.dotCargo.file("audit.toml").contents) :: CargoAuditConfig

      let url = config.database.url
      if (url != null) {
        advisoryDb = Dagger.git(url).head.tree
      }
    }

    let ADVISORY_DB_PATH = "/opt/rustsec/advisory-db"

    let args = [
      "cargo", "audit",
      "--no-fetch", "--db", ADVISORY_DB_PATH,
    ]

    if (deny != null) {
      args += ["--deny", toString(deny)]
    }

    ignore.each { advisory =>
      args += ["--ignore", advisory]
    }

    # This is necessary, because --no-fetch also skips fetching cargo index
    self.prefetch = true

    self
      .extendContainer(null) {
        _
          .withFile("/usr/local/bin/cargo-audit", cargoAuditBinary("0.22.0"))
          .withMountedDirectory(ADVISORY_DB_PATH, advisoryDb)
      }
      .withExec(args)
      .stdout
  }

  """
  Compile a local package and all of its dependencies.
  """
  build(
    """
    Package to build.
    """
    package: [String!]! = [],
    """
    Build all packages in the workspace.
    """
    all: Boolean! = false,
    """
    Exclude packages from the build.
    """
    exclude: [String!]! = [],
    """
    Build only this package's library.
    """
    lib: Boolean! = false,
    """
    Build all binaries.
    """
    bins: Boolean! = false,
    """
    Build only the specified binary.
    """
    bin: [String!]! = [],
    """
    Build all examples.
    """
    examples: Boolean! = false,
    """
    Build only the specified example.
    """
    example: [String!]! = [],
    """
    Build all targets that have `test = true` set.
    """
    tests: Boolean! = false,
    """
    Build only the specified test target.
    """
    test: [String!]! = [],
    """
    Build all targets that have `bench = true` set.
    """
    benches: Boolean! = false,
    """
    Build only the specified bench target.
    """
    bench: [String!]! = [],
    """
    Build all targets.
    """
    allTargets: Boolean! = false,
    """
    Build for the target triple.
    """
    target: [String!]! = [],
    """
    Activate all available features.
    """
    allFeatures: Boolean! = false,
    """
    List of features to activate.
    """
    feature: [String!]! = [],
    """
    Do not activate the `default` feature.
    """
    noDefaultFeatures: Boolean! = false,
    """
    Build artifacts in release mode, with optimizations.
    """
    release: Boolean! = false,
    """
    Build artifacts with the specified cargo profile.
    """
    cargoProfile: String! = "",
    """
    Do not abort the build as soon as there is an error.
    """
    keepGoing: Boolean! = false,
  ): Directory! @check {
    let args = CargoCommand.build(
      package,
      all,
      exclude,
      lib,
      bins,
      bin,
      examples,
      example,
      tests,
      test,
      benches,
      bench,
      allTargets,
      target,
      allFeatures,
      feature,
      noDefaultFeatures,
      release,
      cargoProfile,
      keepGoing,
    )

    let expect = ReturnType.SUCCESS
    if (keepGoing) {
      expect = ReturnType.ANY
    }

    let cookArgs = CargoCommand.chefCook(
      package: package,
      all: all,
      bins: bins,
      bin: bin,
      examples: examples,
      example: example,
      tests: tests,
      test: test,
      benches: benches,
      bench: bench,
      allTargets: allTargets,
      target: target,
      allFeatures: allFeatures,
      feature: feature,
      noDefaultFeatures: noDefaultFeatures,
      release: release,
      profile: cargoProfile,
    )

    self
      .buildContainer(cookArgs)
      .withExec(
        args,
        expand: true,
        redirectStdout: "/stdout.json",
        expect: expect,
      )
      .withExec(["cargo", "artifacts", "copy", "-i", "/stdout.json", "--out-dir", "/work/out"])
      .directory("/work/out")
  }

  """
  Check a local package and all of its dependencies for errors.

  Wrapped by cargo-hack when `hack.check` is configured in the manifest (see hack.dang).
  """
  check(
    """
    Package to check.
    """
    package: [String!]! = [],
    """
    Check all packages in the workspace.
    """
    all: Boolean! = false,
    """
    Exclude packages from the check.
    """
    exclude: [String!]! = [],
    """
    Check only this package's library.
    """
    lib: Boolean! = false,
    """
    Check all binaries.
    """
    bins: Boolean! = false,
    """
    Check only the specified binary.
    """
    bin: [String!]! = [],
    """
    Check all examples.
    """
    examples: Boolean! = false,
    """
    Check only the specified example.
    """
    example: [String!]! = [],
    """
    Check all targets that have `test = true` set.
    """
    tests: Boolean! = false,
    """
    Check only the specified test target.
    """
    test: [String!]! = [],
    """
    Check all targets that have `bench = true` set.
    """
    benches: Boolean! = false,
    """
    Check only the specified bench target.
    """
    bench: [String!]! = [],
    """
    Check all targets.
    """
    allTargets: Boolean! = false,
    """
    Check for the target triple.
    """
    target: [String!]! = [],
    """
    Activate all available features.
    """
    allFeatures: Boolean! = false,
    """
    List of features to activate.
    """
    feature: [String!]! = [],
    """
    Do not activate the `default` feature.
    """
    noDefaultFeatures: Boolean! = false,
    """
    Check artifacts in release mode, with optimizations.
    """
    release: Boolean! = false,
    """
    Check artifacts with the specified cargo profile.
    """
    cargoProfile: String! = "",
    """
    Do not abort the check as soon as there is an error.
    """
    keepGoing: Boolean! = false,
  ): String! @check {
    let hack = self.hackArgs { _.check }

    let args = withHack(
      CargoCommand.check(
        package,
        all,
        exclude,
        lib,
        bins,
        bin,
        examples,
        example,
        tests,
        test,
        benches,
        bench,
        allTargets,
        target,
        allFeatures,
        feature,
        noDefaultFeatures,
        release,
        cargoProfile,
        keepGoing,
      ),
      hack,
    )

    let cookArgs = CargoCommand.chefCook(
      package: package,
      all: all,
      bins: bins,
      bin: bin,
      examples: examples,
      example: example,
      tests: tests,
      test: test,
      benches: benches,
      bench: bench,
      allTargets: allTargets,
      target: target,
      allFeatures: allFeatures,
      feature: feature,
      noDefaultFeatures: noDefaultFeatures,
      release: release,
      profile: cargoProfile,
      check: true,
    )

    self.commandContainer(cookArgs, hack).withExec(args).combinedOutput
  }

  """
  Execute all unit and integration tests and build examples of a local package.

  Runs with cargo-nextest (followed by `cargo test --doc`) when the project has a
  `.config/nextest.toml` (see nextest.dang).
  Wrapped by cargo-hack when `hack.test` is configured in the manifest (see hack.dang).
  """
  test(
    """
    If specified, only run tests containing this string in their names.
    """
    testName: String! = "",
    """
    Arguments for the test binary.
    """
    args: [String!]! = [],
    """
    Run all tests regardless of failure.
    """
    noFailFast: Boolean! = false,
    """
    Package to run tests for.
    """
    package: [String!]! = [],
    """
    Test all packages in the workspace.
    """
    all: Boolean! = false,
    """
    Exclude packages from the test.
    """
    exclude: [String!]! = [],
    """
    Test only this package's library.
    """
    lib: Boolean! = false,
    """
    Test all binaries.
    """
    bins: Boolean! = false,
    """
    Test only the specified binary.
    """
    bin: [String!]! = [],
    """
    Test all examples.
    """
    examples: Boolean! = false,
    """
    Test only the specified example.
    """
    example: [String!]! = [],
    """
    Test all targets that have `test = true` set.
    """
    tests: Boolean! = false,
    """
    Test only the specified test target.
    """
    test: [String!]! = [],
    """
    Test all targets that have `bench = true` set.
    """
    benches: Boolean! = false,
    """
    Test only the specified bench target.
    """
    bench: [String!]! = [],
    """
    Test all targets (does not include doctests).
    """
    allTargets: Boolean! = false,
    """
    Build for the target triple.
    """
    target: [String!]! = [],
    """
    Test only this library's documentation.
    """
    doc: Boolean! = false,
    """
    Activate all available features.
    """
    allFeatures: Boolean! = false,
    """
    List of features to activate.
    """
    feature: [String!]! = [],
    """
    Do not activate the `default` feature.
    """
    noDefaultFeatures: Boolean! = false,
    """
    Build artifacts in release mode, with optimizations.
    """
    release: Boolean! = false,
    """
    Build artifacts with the specified cargo profile.
    """
    cargoProfile: String! = "",
  ): String! @check {
    let hack = self.hackArgs { _.test }

    # nextest cannot run doctests: `doc` stays with cargo test.
    let nextest = self.nextest and !doc

    let command = withHack(
      CargoCommand.test(
        testName,
        args,
        noFailFast,
        package,
        all,
        exclude,
        lib,
        bins,
        bin,
        examples,
        example,
        tests,
        test,
        benches,
        bench,
        allTargets,
        target,
        doc,
        allFeatures,
        feature,
        noDefaultFeatures,
        release,
        cargoProfile,
        nextest,
      ),
      hack,
    )

    # `cargo test` compiles dev-dependencies: cook them too.
    let cookArgs = CargoCommand.chefCook(
      package: package,
      all: all,
      bins: bins,
      bin: bin,
      examples: examples,
      example: example,
      tests: true,
      benches: benches,
      bench: bench,
      allTargets: allTargets,
      target: target,
      allFeatures: allFeatures,
      feature: feature,
      noDefaultFeatures: noDefaultFeatures,
      release: release,
      profile: cargoProfile,
    )

    let result = self.commandContainer(cookArgs, hack, nextest).withExec(command)

    if (!nextest) {
      return result.combinedOutput
    }

    # Mirror `cargo test`, which runs doctests only as part of the default target set.
    let targetsSelected = lib or bins or !bin.isEmpty or examples or !example.isEmpty
      or tests or !test.isEmpty or benches or !bench.isEmpty or allTargets
    if (targetsSelected) {
      return result.combinedOutput
    }

    let doctestArgs = withHack(
      CargoCommand.test(
        testName,
        args,
        noFailFast,
        package,
        all,
        exclude,
        target: target,
        doc: true,
        allFeatures: allFeatures,
        feature: feature,
        noDefaultFeatures: noDefaultFeatures,
        release: release,
        profile: cargoProfile,
      ),
      hack,
    )

    # Packages without a library have no doctests (cargo test skips them silently).
    let doctests = result.withExec(doctestArgs, expect: ReturnType.ANY)
    if (doctests.exitCode != 0) {
      if (doctests.stderr.contains("no library targets found")) {
        return result.combinedOutput
      }

      raise "doctests failed:\n" + doctests.combinedOutput
    }

    result.combinedOutput + doctests.combinedOutput
  }

  """
  Format the codebase using rustfmt.
  """
  fmt: Changeset! @generate {
    self
      .buildContainer(null)
      .withExec(["cargo", "fmt", "--", "--check"])
      .directory("/work/src")
      .filter(gitignore: true)
      .changes(self.buildEnv.source)
  }

  """
  Checks a package to catch common mistakes and improve your Rust code.

  Wrapped by cargo-hack when `hack.clippy` is configured in the manifest (see hack.dang).
  """
  clippy(
    """
    Run Clippy only on the given crate, without linting the dependencies.
    """
    noDeps: Boolean,
    """
    Package to lint.
    """
    package: [String!]! = [],
    """
    Lint all packages in the workspace.
    """
    all: Boolean! = false,
    """
    Exclude packages from the lint.
    """
    exclude: [String!]! = [],
    """
    Lint only this package's library.
    """
    lib: Boolean! = false,
    """
    Lint all binaries.
    """
    bins: Boolean! = false,
    """
    Lint only the specified binary.
    """
    bin: [String!]! = [],
    """
    Lint all examples.
    """
    examples: Boolean! = false,
    """
    Lint only the specified example.
    """
    example: [String!]! = [],
    """
    Lint all targets that have `test = true` set.
    """
    tests: Boolean! = false,
    """
    Lint only the specified test target.
    """
    test: [String!]! = [],
    """
    Lint all targets that have `bench = true` set.
    """
    benches: Boolean! = false,
    """
    Lint only the specified bench target.
    """
    bench: [String!]! = [],
    """
    Lint all targets.
    """
    allTargets: Boolean! = false,
    """
    Lint for the target triple.
    """
    target: [String!]! = [],
    """
    Activate all available features.
    """
    allFeatures: Boolean! = false,
    """
    List of features to activate.
    """
    feature: [String!]! = [],
    """
    Do not activate the `default` feature.
    """
    noDefaultFeatures: Boolean! = false,
    """
    Lint artifacts in release mode, with optimizations.
    """
    release: Boolean! = false,
    """
    Lint artifacts with the specified cargo profile.
    """
    cargoProfile: String! = "",
    """
    Do not abort the lint as soon as there is an error.
    """
    keepGoing: Boolean! = false,
    """
    Set lint warnings.
    """
    warn: [String!]! = [],
    """
    Set lint allowed.
    """
    allow: [String!]! = [],
    """
    Set lint denied.
    """
    deny: [String!]! = [],
    """
    Set lint forbidden.
    """
    forbid: [String!]! = [],
  ): String! @check {
    let hack = self.hackArgs { _.clippy }

    let command = withHack(
      CargoCommand.clippy(
        noDeps ?? true,
        package,
        all,
        exclude,
        lib,
        bins,
        bin,
        examples,
        example,
        tests,
        test,
        benches,
        bench,
        allTargets,
        target,
        allFeatures,
        feature,
        noDefaultFeatures,
        release,
        cargoProfile,
        keepGoing,
      ),
      hack,
    )

    command += ["--"]

    warn.each { w => command += ["--warn", w] }
    allow.each { a => command += ["--allow", a] }
    deny.each { d => command += ["--deny", d] }
    forbid.each { f => command += ["--forbid", f] }

    let cookArgs = CargoCommand.chefCook(
      package: package,
      all: all,
      bins: bins,
      bin: bin,
      examples: examples,
      example: example,
      tests: tests,
      test: test,
      benches: benches,
      bench: bench,
      allTargets: allTargets,
      target: target,
      allFeatures: allFeatures,
      feature: feature,
      noDefaultFeatures: noDefaultFeatures,
      release: release,
      profile: cargoProfile,
      clippy: true,
    )

    # clippy reports on stderr
    self.commandContainer(cookArgs, hack).withExec(command).combinedOutput
  }

  """
  Build a package's documentation.

  Wrapped by cargo-hack when `hack.doc` is configured in the manifest (see hack.dang).
  """
  doc(
    """
    Don't build documentation for dependencies.
    """
    noDeps: Boolean,
    """
    Package to run tests for.
    """
    package: [String!]! = [],
    """
    Test all packages in the workspace.
    """
    all: Boolean! = false,
    """
    Exclude packages from the test.
    """
    exclude: [String!]! = [],
    """
    Test only this package's library.
    """
    lib: Boolean! = false,
    """
    Test all binaries.
    """
    bins: Boolean! = false,
    """
    Test only the specified binary.
    """
    bin: [String!]! = [],
    """
    Test all examples.
    """
    examples: Boolean! = false,
    """
    Test only the specified example.
    """
    example: [String!]! = [],
    """
    Activate all available features.
    """
    allFeatures: Boolean! = false,
    """
    List of features to activate.
    """
    feature: [String!]! = [],
    """
    Do not activate the `default` feature.
    """
    noDefaultFeatures: Boolean! = false,
    """
    Build artifacts in release mode, with optimizations.
    """
    release: Boolean! = false,
    """
    Build artifacts with the specified cargo profile.
    """
    cargoProfile: String! = "",
  ): String! @check {
    let hack = self.hackArgs { _.doc }

    let args = withHack(
      CargoCommand.doc(
        noDeps,
        package,
        all,
        exclude,
        lib,
        bins,
        bin,
        examples,
        example,
        allFeatures,
        feature,
        noDefaultFeatures,
        release,
        cargoProfile,
      ),
      hack,
    )

    # rustdoc needs the dependencies' metadata only (check mode).
    let cookArgs = CargoCommand.chefCook(
      package: package,
      all: all,
      bins: bins,
      bin: bin,
      examples: examples,
      example: example,
      allFeatures: allFeatures,
      feature: feature,
      noDefaultFeatures: noDefaultFeatures,
      release: release,
      profile: cargoProfile,
      check: true,
    )

    self
      .commandContainer(cookArgs, hack)
      .withEnvVariable("RUSTDOCFLAGS", "-D warnings")
      .withExec(args)
      .stdout
  }

  """
  Runs a set of fixers and code formatters.
  """
  fix: Fix! {
    Fix(self)
  }
}
