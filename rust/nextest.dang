# cargo-nextest: test runner, used in place of `cargo test` when the project has a
# `.config/nextest.toml` (nextest's own configuration file: profiles, retries, timeouts,
# test groups...). The module reads nothing from it; select a profile with NEXTEST_PROFILE.
#
# nextest does not run doctests, so `test` runs `cargo test --doc` afterwards,
# mirroring `cargo test`: only when no targets are selected explicitly, and only for
# packages with a library (cargo's "no library targets found" error is ignored).

"""
Pinned on purpose: the binary sits upstream of every test run.
"""
let defaultNextestVersion: String! = "0.9.143"

let cargoNextestBinary(version: String!): File! {
  let tag = version.trimPrefix("v")

  Dagger
    .github
    .release(`cargo-nextest-${tag}`, "nextest-rs/nextest")
    .asset(`cargo-nextest-${tag}-${arch}-unknown-linux-musl.tar.gz`)
    .extracted # flat archive
    .file("cargo-nextest")
}

"""
Whether the workspace has a nextest configuration file (`.config/nextest.toml`).
"""
let detectNextest(ws: Workspace!): Boolean! {
  let config = ws.findUp(".config")
  if (config == null) {
    return false
  }

  ws.directory(config).exists("nextest.toml", expectedType: ExistsType.REGULAR_TYPE)
}
