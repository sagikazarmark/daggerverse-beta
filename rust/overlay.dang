interface Overlay implements OverlaysOverlay {
  apply(container: Container!): Container!
}

let moduleOverlay(cargoArtifactsVersion: String, overlay: Overlay): OverlaysList! {
  let tag = "v" + cargoArtifactsVersion.trimPrefix("v") ?? null

  Dagger.overlays.combine([
    Dagger.overlays.withFiles(
      "/usr/local/bin/",
      [
        Dagger
          .github
          .release(tag, "sagikazarmark/cargo-artifacts")
          .asset(`cargo-artifacts-${arch}-unknown-linux-gnu.tar.xz`)
          .extracted(true)
          .file("cargo-artifacts"),
      ],
    ),

    overlay,
  ])
}
