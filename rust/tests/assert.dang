type Assert {
  let shouldNegate: Boolean! = false

  let not: Assert! {
    self.shouldNegate = true

    self
  }

  let notNot: Assert! {
    self.shouldNegate = false

    self
  }

  let eval(val: Boolean!): Boolean! {
    if (self.shouldNegate) {
      !val
    } else {
      val
    }
  }

  let hasTarget(container: Container!, target: String!): Assert! {
    let targets = container
      .withExec(["rustup", "target", "list", "--installed"])
      .stdout
      .split("\n")

    assert { self.eval(targets.contains(target)) }

    self
  }

  let hasComponent(container: Container!, component: String!): Assert! {
    let components = container
      .withExec(["rustup", "component", "list", "--installed"])
      .stdout
      .split("\n")

    if (component == "rust-src") {
      assert { self.eval(components.contains(component)) }
    } else {
      assert { self.eval(components.all { !_.hasPrefix(component + "-") }) }
    }

    self
  }
}
