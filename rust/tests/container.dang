type ContainerTests {
  defaults: Container! @check {
    Dagger
      .rust(version: rustVersion)
      .container
      .withExec(["cargo", "version"])
  }

  emptySource: Container! @check {
    Dagger
      .rust(version: rustVersion, source: Dagger.directory)
      .container
      .withExec(["cargo", "version"])
  }

  workspace: Container! @check {
    Dagger
      .rust(Dagger.directory.asWorkspace, version: rustVersion, gitignore: false)
      .container
      .withExec(["cargo", "version"])
  }

  realProjectSource: Container! @check {
    Dagger
      .rust(version: rustVersion, source: realProject)
      .container
      .withExec(["cargo", "version"])
  }
}
