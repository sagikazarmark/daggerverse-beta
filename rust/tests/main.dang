let rustVersion: String! = "1.96.0-slim-trixie@sha256:082a5849a6870672b5f7a5bf4eddc71723fce38756fd834a0d734a5306a310ab"

let realProject: Directory! {
  Dagger
    .git("https://github.com/sagikazarmark/cargo-artifacts.git")
    .head
    .tree
}

type Tests {
  container: ContainerTests! { ContainerTests }

  toolchain: ToolchainTests! { ToolchainTests }

  envFile: EnvFileTests! { EnvFileTests }

  build: Directory! @check {
    Dagger.rust(version: rustVersion, source: realProject).build
  }

  test: String! @check {
    Dagger.rust(version: rustVersion, source: realProject).test
  }

  clippy: String! @check {
    Dagger.rust(version: rustVersion, source: realProject).clippy
  }
}
