let rustVersion: String! = "1.96.0-slim-trixie@sha256:082a5849a6870672b5f7a5bf4eddc71723fce38756fd834a0d734a5306a310ab"

let realProject: Directory! {
  Dagger
    .git("https://github.com/sagikazarmark/cargo-artifacts.git")
    .head
    .tree
}

"""
Dependency-free crate with two features and a `rust` module configuration in its manifest.
"""
let featuresProject: Directory! {
  Dagger.currentModule.source.directory("fixtures/features")
}

type Tests {
  envFile: Void @check {
    let output = Dagger
      .rust(
        ws: Dagger.currentModule.source.asWorkspace,
        version: rustVersion,
        envFile: Dagger.currentModule.source.file(".env.build"),
        sourceDateEpoch: "1234567890",
      )
      .container
      .withExec(["sh", "-c", "printf '%s|%s|%s|%s|%s' \"$BUILD_ONLY\" \"$EXPORTED\" \"$QUOTED\" \"$EQUALS\" \"$SOURCE_DATE_EPOCH\""])
      .stdout

    assert { output == "ok|yes|hello world|a=b|1234567890" }
  }

  build: Directory! @check {
    Dagger.rust(ws: realProject.asWorkspace, version: rustVersion).build
  }

  check: String! @check {
    Dagger.rust(ws: realProject.asWorkspace, version: rustVersion).check
  }

  test: String! @check {
    Dagger.rust(ws: realProject.asWorkspace, version: rustVersion).test
  }

  clippy: String! @check {
    Dagger.rust(ws: realProject.asWorkspace, version: rustVersion).clippy
  }

  """
  `toolchain: "msrv"` runs everything on the manifest's rust-version.
  """
  msrv: Void @check {
    let output = Dagger
      .rust(ws: featuresProject.asWorkspace, version: rustVersion, toolchain: "msrv")
      .container
      .withExec(["rustc", "--version"])
      .stdout

    assert { output.contains("rustc 1.88.") }
  }

  chef: ChefTests! { ChefTests }

  hack: HackTests! { HackTests }
}

let hasTargetDir(container: Container!): Boolean! {
  container
    .withExec(["sh", "-c", "test -d /target && echo yes || echo no"])
    .stdout
    .trimSpace == "yes"
}

type ChefTests {
  """
  Without fixed arguments, the plain container is not cooked.
  """
  containerNotCooked: Void @check {
    let container = Dagger
      .rust(ws: realProject.asWorkspace, version: rustVersion, chef: true)
      .container

    assert { !hasTargetDir(container) }
    assert { container.withExec(["cargo", "chef", "--version"]).stdout.contains("0.1.78") }
  }

  """
  With fixed arguments, the plain container is cooked with them.
  """
  containerCookedWithFixedArgs: Void @check {
    let container = Dagger
      .rust(ws: realProject.asWorkspace, version: rustVersion, chef: true, chefArgs: ["--release"])
      .container

    let deps = container.directory("/target/release/deps").entries

    assert { deps.any { _.hasPrefix("libclap-") } }
    assert { !deps.any { _.hasPrefix("libcargo_artifacts") } }
    assert { container.workdir == "/work/src" }
    assert { container.file("/work/src/src/lib.rs").contents != "" }
  }

  build: Void @check {
    let artifacts = Dagger
      .rust(ws: realProject.asWorkspace, version: rustVersion, chef: true)
      .build(release: true)

    assert { artifacts.entries.contains("cargo-artifacts") }
  }

  test: String! @check {
    Dagger.rust(ws: realProject.asWorkspace, version: rustVersion, chef: true).test
  }

  clippy: String! @check {
    Dagger.rust(ws: realProject.asWorkspace, version: rustVersion, chef: true).clippy
  }
}

type HackTests {
  """
  `hack.check` in the manifest wraps `cargo check` with cargo-hack: one run per feature.
  """
  check: Void @check {
    let output = Dagger.rust(ws: featuresProject.asWorkspace, version: rustVersion).check

    assert { output.contains("cargo check --no-default-features") }
    assert { output.contains("--features b") }
    assert { output.contains("--all-features") }
  }

  """
  `hack.test` in the manifest wraps `cargo test` the same way; every run passes.
  """
  test: Void @check {
    let output = Dagger.rust(ws: featuresProject.asWorkspace, version: rustVersion).test

    assert { output.contains("cargo test --no-default-features") }
    assert { output.contains("--all-features") }
    assert { !output.contains("test result: FAILED") }
  }

  """
  Without a configuration for this module, cargo runs plain (no cargo-hack).
  """
  notConfigured: Void @check {
    let output = Dagger.rust(ws: realProject.asWorkspace, version: rustVersion).check

    assert { !output.contains("cargo hack") }
    assert { !output.contains("running `cargo check") }
  }
}
