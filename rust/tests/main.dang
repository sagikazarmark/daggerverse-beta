type Tests {
  let source: Directory! {
    Dagger
      .git("https://github.com/sagikazarmark/cargo-artifacts.git")
      .head
      .tree
  }

  let rust: Rust! {
    Dagger.rust(version: "1.96.0-slim-trixie@sha256:082a5849a6870672b5f7a5bf4eddc71723fce38756fd834a0d734a5306a310ab")
  }

  container: Container! @check {
    rust.container
  }

  build: Container! @check {
    rust
      .container
      .withWorkdir("/work/src")
      .withMountedDirectory(".", source)
      .withExec(["cargo", "build"])
  }

  # pub build: Directory! @check {
  #   rust.build
  # }

  # pub test: String! @check {
  #   rust.test
  # }

  # pub clippy: String! @check {
  #   rust.clippy
  # }
}
