type WasmPack {
  let rustEnv: RustEnvironment!
  let buildEnv: BuildEnvironment!

  let wasmBindgenVersion: String

  """
  Default browsers to use for testing.
  """
  defaultBrowsers: [Browser!]!

  """
  Default test arguments to pass to `cargo test`.
  """
  defaultTestArgs: [String!]!

  new(
    """
    wasm-pack version to use (default: latest).
    """
    version: String,
    """
    wasm-bindgen CLI version to use (default: auto-detect from Cargo.lock).
    """
    wasmBindgenVersion: String,
    """
    Default browsers to use for testing.
    """
    defaultBrowsers: [Browser!]! = Browser.values,
    """
    Browsers to install.
    """
    installBrowsers: [Browser!]! = defaultBrowsers,
    """
    Default test arguments to pass to `cargo test`.
    """
    defaultTestArgs: [String!]! = [],
    """
    Version (image tag) to use from the official image repository as a Rust base container.
    """
    rustVersion: String! = "latest",
    """
    Custom container to use as a base container.
    """
    container: Container! = Dagger.container.from("rust:" + rustVersion),
    """
    Ignore paths included in the gitignore file.
    """
    gitignore: Boolean = true,
    """
    Include only artifacts that match the given pattern (e.g., ["app/", "Cargo.*"]).
    """
    include: [String!],
    """
    Exclude artifacts that match the given pattern (e.g., ["target/", ".git*"]).
    """
    exclude: [String!],
    """
    Overlay to apply to the base container before the Rust toolchain is installed.
    """
    rustOverlay: Overlay,
    """
    Additional targets to install for cross-compilation.
    """
    targets: [String!]! = [],
    """
    Additional components to install.
    """
    components: [String!]! = [],
    """
    Overlay to apply to the base container.
    """
    overlay: Overlay,
    """
    Env file to load into the container.

    Relative paths are resolved from the working directory absolute paths are resolved from the root.
    """
    envFile: File,
    """
    Override the source date epoch for reproducible builds.
    """
    sourceDateEpoch: String,
    """
    Whether to disable automatically mounted cache volumes.
    Useful if you want to mount cache volumes manually or use a different cache volume strategy.
    """
    noCache: Boolean! = false,
    """
    Cache volume for cargo registry index.
    """
    cargoRegistryIndexCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-registry-index")
    } else null,
    """
    Cache volume for cargo registry archive.
    """
    cargoRegistryArchiveCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-registry-cache")
    } else null,
    """
    Cache volume for cargo git db.
    """
    cargoGitDbCache: CacheVolume = if (!noCache) {
      Dagger.cacheVolume("cargo-git-db")
    } else null,
  ) {
    self.rustEnv = Dagger.rustEnvironment(
      container: container,
      cargoRegistryIndexCache: cargoRegistryIndexCache,
      cargoRegistryArchiveCache: cargoRegistryArchiveCache,
      cargoGitDbCache: cargoGitDbCache,

      overlay: rustOverlay,
      targets: ["wasm32-unknown-unknown"] + targets,
      components: ["rust-std"] + components,
    )

    self.buildEnv = Dagger.buildEnvironment(
      overlay: moduleOverlay(version, installBrowsers, overlay),
      envFile: envFile,
      sourceDateEpoch: sourceDateEpoch,
      gitignore: gitignore,
      include: include,
      exclude: exclude,
    )

    self.wasmBindgenVersion = wasmBindgenVersion

    self.defaultBrowsers = defaultBrowsers
    self.defaultTestArgs = defaultTestArgs

    self
  }

  """
  Container with the Rust toolchain and wasm-pack installed.
  """
  container(
    ws: Workspace,
    """
    Custom base container to use.
    """
    base: Container,
    """
    Ignore paths included in the gitignore file.
    """
    gitignore: Boolean,
    """
    Include only artifacts that match the given pattern (e.g., ["app/", "Cargo.*"]).
    """
    include: [String!],
    """
    Exclude artifacts that match the given pattern (e.g., ["target/", ".git*"]).
    """
    exclude: [String!],
  ): Container! {
    self
      .rustEnv
      .container(ws, base)
      .{
        self.buildEnv.container(
          ws,
          _,
          moduleSourceOverlay(ws, self.wasmBindgenVersion),
          gitignore,
          include,
          exclude,
        )
      }
  }

  """
  Run wasm-pack tests.
  """
  test(
    ws: Workspace!,
    """
    Runs wasm-pack tests using the specified browsers.
    """
    browsers: [Browser!]! = self.defaultBrowsers,
    """
    Additional arguments to pass to `cargo test`.
    """
    args: [String!]! = self.defaultTestArgs,
  ): Container! @check {
    let _args = ["wasm-pack", "test", "--mode", "no-install", "--headless"]

    _args += browsers.uniq.map { "--" + toString(_).toLower }

    _args += ["."]

    if (!args.isEmpty) {
      _args += args
    }

    self.container(ws).withExec(_args, experimentalPrivilegedNesting: true)
  }
}

enum Browser {
  CHROME
  FIREFOX
}
