interface Overlay implements OverlaysOverlay {
  apply(container: Container!): Container!
}

let moduleOverlay(
  wasmPackVersion: String,
  browsers: [Browser!]!,
  overlay: Overlay,
): OverlaysList! {
  Dagger.overlays.combine([
    Dagger.wasmTools.withTool(WasmToolsTool.WASM_PACK, wasmPackVersion),
    browserPackages(browsers),
    overlay,
  ])
}

let moduleSourceOverlay(ws: Workspace, wasmBindgenVersion: String): OverlaysList! {
  wasmBindgenVersion = wasmBindgenVersion ?? packageVersion(ws, "wasm-bindgen")

  Dagger.overlays.combine([
    Dagger.wasmTools.withTool(WasmToolsTool.WASM_BINDGEN, wasmBindgenVersion),
  ])
}

let packageVersion(ws: Workspace, name: String!): String {
  let path = ws.findUp("Cargo.lock")
  if (path == null) {
    return null
  }

  Dagger
    .cargoLock(file: ws.file(path))
    .findOne(name)
    .version
}

let browserPackages(browsers: [Browser!]!): DistroPackages! {
  let apk = []
  let apt = []

  browsers.uniq.each { browser =>
    case (browser) {
      Browser.CHROME => {
        apk += ["chromium", "chromium-chromedriver"]
        # Pin to the trixie/main chromium: the trixie-security update to
        # 150.0.7871.46 deterministically SIGTRAPs headless on arm64. 147 works.
        # chromium-common must be pinned too (chromium depends on the exact ver).
        apt += [
          "chromium=147.0.7727.137-1~deb13u1",
          "chromium-common=147.0.7727.137-1~deb13u1",
          "chromium-driver=147.0.7727.137-1~deb13u1",
        ]
      }

      Browser.FIREFOX => {
        apk += ["firefox-esr", "geckodriver"]
        apt += ["firefox-esr"]
      }
    }

    null
  }

  Dagger.distro.packages(apk: apk, apt: apt)
}
