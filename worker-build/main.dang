type WorkerBuild {
  let base: Container!

  let rustEnv: RustEnvironment!
  let buildEnv: BuildEnvironment!

  let overlay: OverlaysOverlay

  new(
    ws: Workspace!,
    """
    worker-build version to install (default: auto-detect from Cargo.lock worker crate, then latest).
    """
    version: String,
    """
    wasm-bindgen CLI version to use (default: auto-detect from Cargo.lock).
    """
    wasmBindgenVersion: String,
    """
    Version of Binaryen to use. By default, worker-build uses its managed version.
    """
    binaryenVersion: String,
    """
    Version of esbuild to use (default: latest).
    """
    esbuildVersion: String,
    """
    Version (image tag) to use from the official Rust image repository as a base container.
    """
    rustVersion: String! = "latest",
    """
    Custom container to use as a base container.
    """
    container: Container! = Dagger.container.from("rust:" + rustVersion),
    """
    Targets to install for cross-compilation.
    """
    targets: [String!]! = [],
    """
    Additional components to install.
    """
    components: [String!]! = [],
    """
    Overlay to apply to the base container.
    """
    overlay: Overlay,
    """
    Env file to load into the container.

    Relative paths are resolved from the working directory absolute paths are resolved from the root.
    """
    envFile: File,
    """
    Override the source date epoch for reproducible builds.

    If not set, the epoch is determined from the git log (if available).
    """
    sourceDateEpoch: String,
    """
    Whether to disable automatically mounted cache volumes.
    Useful if you want to mount cache volumes manually or use a different cache volume strategy.
    """
    noCache: Boolean! = false,
  ) {
    version = version ?? packageVersion(ws, "worker")
    wasmBindgenVersion = wasmBindgenVersion ?? packageVersion(ws, "wasm-bindgen")

    self.base = container

    self.rustEnv = Dagger.rustEnvironment(
      ws: ws,

      targets: ["wasm32-unknown-unknown"] + targets,
      components: ["rust-std"] + components,

      noCache: noCache,
    )

    self.buildEnv = Dagger
      .buildEnvironment
      .withSource(ws.directory("/", gitignore: true), ws.cwd)
      .withEnvFile(envFile)
      .withSourceDateEpoch(sourceDateEpoch)

    self.overlay = Dagger.overlays.combine([
      moduleOverlay(
        binaryenVersion,
        esbuildVersion,
        wasmBindgenVersion,
      ),

      workerBuildOverlay(version),

      overlay,
    ])

    self
  }

  """
  Set an environment variable in the build container.
  """
  withEnvVariable(
    """
    Name of the environment variable (e.g., "RUSTFLAGS").
    """
    name: String!,
    """
    Value of the environment variable (e.g., "-C target-cpu=native").
    """
    value: String!,
    """
    Replace `${VAR}` or `$VAR` in the value according to the current environment
    variables defined in the container (e.g., "/opt/bin:$PATH").
    """
    expand: Boolean,
  ): WorkerBuild! {
    self.buildEnv = self.buildEnv.withEnvVariable(name, value, expand)

    self
  }

  """
  Container with the Rust toolchain and worker-build installed.
  """
  container: Container! {
    self
      .base
      .{ self.rustEnv.apply(_) }
      .{ self.overlay.apply(_) ?? _ }
      .{ self.buildEnv.apply(_) }
  }

  """
  Run worker-build and return the generated Worker output directory.
  """
  build(
    """
    Build in release mode.
    """
    release: Boolean,
    """
    Create a development build. Enables debug info and disables optimizations.
    """
    dev: Boolean! = false,
    """
    Skip optimization with wasm-opt.
    """
    noOpt: Boolean! = false,
    """
    Enable panic=unwind support.
    """
    panicUnwind: Boolean! = false,
    """
    Additional arguments to pass to `cargo build`.
    """
    args: [String!]! = [],
  ): Directory! @check {
    let buildArgs = ["worker-build"]
    if (dev) {
      buildArgs += ["--dev"]
    } else if (release ?? true) {
      buildArgs += ["--release"]
    }

    if (noOpt) {
      buildArgs += ["--no-opt"]
    }

    if (panicUnwind) {
      buildArgs += ["--panic-unwind"]
    }

    buildArgs += ["--out-dir", "/work/out", self.buildEnv.workdir] + args

    self
      .container
      .withExec(buildArgs)
      .directory("/work/out")
  }

  """
  Run worker-build and return the generated Worker output as a container.

  This is a workaround until module wiring supports Directory.
  """
  buildAsContainer(
    """
    Build in release mode.
    """
    release: Boolean,
    """
    Create a development build. Enables debug info and disables optimizations.
    """
    dev: Boolean! = false,
    """
    Skip optimization with wasm-opt.
    """
    noOpt: Boolean! = false,
    """
    Enable panic=unwind support.
    """
    panicUnwind: Boolean! = false,
    """
    Additional arguments to pass to `cargo build`.
    """
    args: [String!]! = [],
  ): Container! {
    Dagger.container.withDirectory(
      "",
      self.build(release, dev, noOpt, panicUnwind, args),
    )
  }
}
