interface Overlay implements OverlaysOverlay {
  apply(container: Container!): Container!
}

let moduleOverlay(
  binaryenVersion: String,
  esbuildVersion: String,
  wasmBindgenVersion: String,
): OverlaysList! {
  let wasmTools = Dagger
    .wasmTools
    .withTool(WasmToolsTool.ESBUILD, esbuildVersion)

  let customBinaryen = binaryenVersion != null and binaryenVersion != ""
  if (customBinaryen) {
    wasmTools = wasmTools.withTool(WasmToolsTool.BINARYEN, binaryenVersion)
  }

  # worker-build only picks up a wasm-bindgen from PATH when WASM_BINDGEN_BIN points at it;
  # otherwise it downloads the version matching the project's lockfile itself.
  let customWasmBindgen = wasmBindgenVersion != null and wasmBindgenVersion != ""
  if (customWasmBindgen) {
    wasmTools = wasmTools.withTool(WasmToolsTool.WASM_BINDGEN, wasmBindgenVersion)
  }

  Dagger.overlays.combine([
    wasmTools,

    if (customBinaryen) {
      Dagger.overlays.withEnvVariable("WASM_OPT_BIN", "wasm-opt")
    } else null,

    if (customWasmBindgen) {
      Dagger.overlays.withEnvVariable("WASM_BINDGEN_BIN", "wasm-bindgen")
    } else null,

    Dagger.overlays.withEnvVariable("ESBUILD_BIN", "esbuild"),
  ])
}

let workerBuildOverlay(version: String): OverlaysWithExec! {
  let installArgs: [String!]! = ["cargo", "install", "worker-build", "--locked"]
  if (version != null and version != "") {
    installArgs += ["--version", version]
  }

  Dagger.overlays.withExec(installArgs)
}

let packageVersion(ws: Workspace, name: String!): String {
  if (ws == null) {
    return null
  }

  let path = ws.findUp("Cargo.lock")
  if (path == null) {
    return null
  }

  Dagger
    .cargoLock(ws, file: ws.file(path))
    .findOne(name)
    .version
}
