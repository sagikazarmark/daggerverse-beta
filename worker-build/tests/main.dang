let rustVersion: String! = "1.96.0-slim-trixie@sha256:082a5849a6870672b5f7a5bf4eddc71723fce38756fd834a0d734a5306a310ab"

type Tests {
  let version: String!

  let source: Directory!
  let container: Container!

  new(
    """
    workers-rs version.
    """
    version: String,
  ) {
    self.version = version ?? Dagger.github.releases("cloudflare/workers-rs").latest.tagName.trimPrefix("v")

    self.source = Dagger.git("https://github.com/cloudflare/workers-rs.git").tag("v" + self.version).tree

    self.container = Dagger
      .container
      .from("rust:" + rustVersion)
      .withEnvVariable("DEBIAN_FRONTEND", "noninteractive")
      .withExec(["apt-get", "update"])
      .withExec(["apt-get", "install", "-y", "--no-install-recommends", "pkg-config", "libssl-dev"])

    self
  }

  let workerBuild(ws: Workspace!): WorkerBuild! {
    Dagger.workerBuild(
      ws: ws,
      rustVersion: rustVersion,
      container: self.container,
    )
  }

  """
  Use worker-build's managed wasm-opt unless a Binaryen version is explicitly requested.
  """
  binaryenOverride: Void @check {
    let ws = Dagger.directory.asWorkspace
    let defaultContainer = Dagger
      .workerBuild(
        ws: ws,
        version: "0.8.5",
        rustVersion: rustVersion,
        container: self.container,
      )
      .container

    assert { defaultContainer.envVariable("WASM_OPT_BIN") == null }

    let overriddenContainer = Dagger
      .workerBuild(
        ws: ws,
        version: "0.8.5",
        binaryenVersion: "version_130",
        rustVersion: rustVersion,
        container: self.container,
      )
      .container

    assert { overriddenContainer.envVariable("WASM_OPT_BIN") == "wasm-opt" }
  }

  """
  Let worker-build manage wasm-bindgen unless a version is explicitly requested.
  """
  wasmBindgenOverride: Void @check {
    let ws = Dagger.directory.asWorkspace
    let defaultContainer = Dagger
      .workerBuild(
        ws: ws,
        version: "0.8.5",
        rustVersion: rustVersion,
        container: self.container,
      )
      .container

    assert { defaultContainer.envVariable("WASM_BINDGEN_BIN") == null }
    assert { defaultContainer.withExec(["which", "wasm-bindgen"], expect: ReturnType.ANY).exitCode != 0 }

    let overriddenContainer = Dagger
      .workerBuild(
        ws: ws,
        version: "0.8.5",
        wasmBindgenVersion: "0.2.125",
        rustVersion: rustVersion,
        container: self.container,
      )
      .container

    assert { overriddenContainer.envVariable("WASM_BINDGEN_BIN") == "wasm-bindgen" }
    assert { overriddenContainer.withExec(["wasm-bindgen", "--version"]).stdout.contains("0.2.125") }
  }

  """
  Persist worker-build's own downloads in a cache volume unless caching is disabled.
  """
  downloadCache: Void @check {
    let ws = Dagger.directory.asWorkspace
    let cacheDir = "/root/.cache/worker-build"

    let defaultContainer = Dagger
      .workerBuild(
        ws: ws,
        version: "0.8.5",
        rustVersion: rustVersion,
        container: self.container,
      )
      .container

    assert { defaultContainer.mounts.contains(cacheDir) }

    let noCacheContainer = Dagger
      .workerBuild(
        ws: ws,
        version: "0.8.5",
        rustVersion: rustVersion,
        container: self.container,
        noCache: true,
      )
      .container

    assert { !noCacheContainer.mounts.contains(cacheDir) }
  }

  let buildExample(source: Directory! = self.source, name: String!): Directory! {
    let output = self
      .workerBuild(source.asWorkspace("examples/" + name))
      .build
      .withFile(
        "wrangler.toml",
        Dagger
          .currentModule
          .source
          .file("wrangler.toml")
          .withReplaced("REPLACE_NAME", name),
      )

    assert { output.file("index.js").contents.contains("wasm") }

    output
  }

  """
  Build the Cloudflare workers-rs axum example with worker-build.
  """
  axum: Directory! @check {
    let source = self
      .source
      .withoutFile("examples/axum/Cargo.lock")
      .{
        _.withFile(
          "Cargo.toml",
          _.file("Cargo.toml").withReplaced(
            search: """    "examples/axum",
            """,
            replacement: "",
          ),
        )
      }

    self.buildExample(source: source, name: "axum")
  }

  """
  Build the Cloudflare workers-rs digest example with worker-build.
  """
  digest: Directory! @check {
    self.buildExample(name: "digest")
  }

  """
  Build the Cloudflare workers-rs digest example and verify it runs with Wrangler dev.
  """
  digestService: Void @check @cache(policy: FunctionCachePolicy.Never) {
    let service = Dagger.wrangler.dev(self.digest)

    let response = Dagger.http(
      service.endpoint(scheme: "http", port: 8787),
      experimentalServiceHost: service,
    )

    assert { response.contents.contains("Woohoo! Hash of 'Hello, World!' is: dffd6021bb2bd5b0af676290809ec3a53191dd81c7f70a4b28688a362182986f") }

    null
  }

  """
  Build the Cloudflare workers-rs tracing example with worker-build.
  """
  tracing: Directory! @check {
    self.buildExample(name: "tracing")
  }

  """
  With chef enabled, the dependencies are compiled on the skeleton before the real build.

  Uses a standalone copy of the digest example depending on `worker` from crates.io, like a user
  project would: in the workers-rs repository `worker` is a workspace member, whose version cargo-chef
  masks, which worker-build's version check rejects.
  """
  chefDigest: Directory! @check {
    let output = Dagger
      .workerBuild(
        ws: self.standaloneDigest.asWorkspace,
        rustVersion: rustVersion,
        container: self.container,
        chef: true,
      )
      .build

    assert { output.file("index.js").contents.contains("wasm") }

    output
  }

  let standaloneDigest: Directory! {
    let cargoToml = """
      [package]
      name = "digest-stream-on-workers"
      version = "0.1.0"
      edition = "2021"

      [lib]
      crate-type = ["cdylib"]

      [dependencies]
      hex = "0.4"
    """ + "\n" + `worker = "=${self.version}"` + "\n"

    let source = Dagger
      .directory
      .withNewFile("Cargo.toml", cargoToml)
      .withDirectory("src", self.source.directory("examples/digest/src"))

    self
      .container
      .withMountedDirectory("/work/src", source)
      .withWorkdir("/work/src")
      .withExec(["cargo", "generate-lockfile"])
      .directory("/work/src")
  }
}
