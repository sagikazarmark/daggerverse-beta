type Wrangler {
  let baseContainer: Container!

  new(
    """
    Wrangler version to install (default: latest).
    """
    version: String,
    """
    Environment to use for operations, and for selecting .env and .dev.vars files.
    """
    environment: String,
    """
    Account ID for the Cloudflare account.
    """
    accountId: String,
    """
    API token for your Cloudflare account.
    """
    apiToken: Secret,
    """
    Log level to use for Wrangler operations.
    """
    logLevel: LogLevel,
    """
    Docker socket used for local development of Containers.

    Takes precedence over Docker host.
    """
    dockerSocket: Socket,
    """
    Docker host used for local development of Containers.

    Mutually exclusive with Docker socket.
    """
    dockerHost: String,
    """
    Custom HTTPS key when running wrangler dev.
    """
    defaultHttpsKey: File,
    """
    Custom HTTPS certificate when running wrangler dev.
    """
    defaultHttpsCert: File,
    """
    Node version (image tag) to use from the official Node image repository as a base container.
    """
    nodeVersion: String! = "lts",
    """
    Custom container to use as a Node base container.
    """
    container: Container! = Dagger.container.from("node:" + nodeVersion),
  ) {
    self.baseContainer = container
      .withEnvVariable("HOME", "/root")
      .withMountedCache("${HOME}/.npm", Dagger.cacheVolume("npm"), expand: true)
      .withExec(["npm", "install", "-g", `wrangler@${version ?? "latest"}`])
      .withEnvVariable("WRANGLER_SEND_METRICS", "false")
      .withEnvVariable("WRANGLER_SEND_ERROR_REPORTS", "false")
      .withEnvVariable("WRANGLER_CACHE_DIR", "${HOME}/.cache/wrangler", expand: true)
      .withMountedCache("$WRANGLER_CACHE_DIR", Dagger.cacheVolume("wrangler"), expand: true)
      .withEnvVariable("MINIFLARE_CACHE_DIR", "${HOME}/.cache/miniflare", expand: true)
      .withMountedCache(
        "$MINIFLARE_CACHE_DIR",
        Dagger.cacheVolume("miniflare"),
        expand: true,
      )
      .{ prepContainer(_, environment, accountId, apiToken, logLevel) }
      .{
        if (dockerSocket != null) {
          _
            .withUnixSocket("/var/run/docker.sock", dockerSocket)
            .withEnvVariable("DOCKER_HOST", "unix:///var/run/docker.sock")
        } else if (dockerHost != null) {
          _.withEnvVariable("DOCKER_HOST", dockerHost)
        } else {
          _
        }
      }
      .{
        if (defaultHttpsCert != null) {
          _
            .withEnvVariable("WRANGLER_HTTPS_CERT_PATH", "${HOME}/.config/wrangler/https/cert.pem")
            .withMountedFile("$WRANGLER_HTTPS_CERT_PATH", defaultHttpsCert, expand: true)
        } else {
          _
        }
      }
      .withExec(["wrangler", "--version"])

    self
  }

  let prepContainer(
    container: Container!,
    env: String,
    accountId: String,
    apiToken: Secret,
    logLevel: LogLevel,
  ): Container! {
    container
      .{ if (env != null) _.withEnvVariable("CLOUDFLARE_ENV", env) else _ }
      .{ if (accountId != null) _.withEnvVariable("CLOUDFLARE_ACCOUNT_ID", accountId) else _ }
      .{ if (apiToken != null) _.withSecretVariable("CLOUDFLARE_API_TOKEN", apiToken) else _ }
      .{ if (logLevel != null) _.withEnvVariable("WRANGLER_LOG", toString(logLevel).toLower) else _ }
  }

  """
  A container that provides Wrangler for Cloudflare Workers.
  """
  container(
    """
    Environment to use for operations, and for selecting .env and .dev.vars files.
    """
    environment: String,
    """
    Account ID for the Cloudflare account.
    """
    accountId: String,
    """
    API token for your Cloudflare account.
    """
    apiToken: Secret,
    """
    Log level to use for Wrangler operations.
    """
    logLevel: LogLevel,
  ): Container! {
    prepContainer(self.baseContainer, environment, accountId, apiToken, logLevel)
  }

  """
  Runs the Wrangler dev server locally.
  """
  dev(
    """
    Worker source to run locally.
    """
    source: Directory!,
    """
    Port to use for the dev server.
    """
    port: Int! = 8787,
    """
    Environment to use for operations, and for selecting .env and .dev.vars files.
    """
    environment: String,
    """
    Account ID for the Cloudflare account.
    """
    accountId: String,
    """
    API token for your Cloudflare account.
    """
    apiToken: Secret,
    """
    Log level to use for Wrangler operations.
    """
    logLevel: LogLevel,
  ): Service! {
    let args = ["wrangler", "dev", "--ip", "0.0.0.0", "--port", toString(port)]

    self
      .container(environment, accountId, apiToken, logLevel)
      .withWorkdir("/work")
      .withDirectory(".", source)
      .withExposedPort(port)
      .asService(args: args)
  }

  deploy(
    """
    Worker source to deploy.
    """
    source: Directory!,
    """
    Name of the Worker.
    """
    name: String,
    """
    A tag for this Worker version.
    """
    tag: String,
    """
    A descriptive message for this Worker Version
    """
    message: String,
    """
    Skip internal build steps and directly upload Worker.
    """
    noBundle: Boolean! = false,
    """
    Environment to use for operations, and for selecting .env and .dev.vars files.
    """
    environment: String,
    """
    Account ID for the Cloudflare account.
    """
    accountId: String,
    """
    API token for your Cloudflare account.
    """
    apiToken: Secret,
    """
    Log level to use for Wrangler operations.
    """
    logLevel: LogLevel,
  ): Container! @cache(policy: FunctionCachePolicy.Never) {
    let args = ["wrangler", "deploy"]

    if (name != null and name != "") {
      args += ["--name", name]
    }

    if (tag != null and tag != "") {
      args += ["--tag", tag]
    }

    if (message != null and message != "") {
      args += ["--message", message]
    }

    if (noBundle) {
      args += ["--no-bundle"]
    }

    self
      .container(environment, accountId, apiToken, logLevel)
      .withWorkdir("/work")
      .withDirectory(".", source)
      .withExec(args)
  }

  """
  Manage versions of a Worker.
  """
  versions(
    """
    Name of the Worker.
    """
    name: String,
    """
    Environment to use for operations, and for selecting .env and .dev.vars files.
    """
    environment: String,
    """
    Account ID for the Cloudflare account.
    """
    accountId: String,
    """
    API token for your Cloudflare account.
    """
    apiToken: Secret,
    """
    Log level to use for Wrangler operations.
    """
    logLevel: LogLevel,
  ): Versions! {
    Versions(self.container(environment, accountId, apiToken, logLevel), name)
  }
}

"""
Manage versions of a Cloudflare Worker.
"""
type Versions {
  let container: Container!

  let name: String

  new(
    """
    Wrangler container with Cloudflare credentials configured.
    """
    container: Container!,
    """
    Name of the Worker.
    """
    name: String,
  ) {
    self.container = container
    self.name = name

    self
  }

  """
  Lists the 10 most recent versions of the Worker.
  """
  list(
    """
    Worker source, used to resolve the Worker name and configuration.
    """
    source: Directory,
  ): [Version!]!
    @cache(policy: FunctionCachePolicy.Never) {
    let args = ["wrangler", "versions", "list", "--json"]

    let name = self.name
    if (name != null and name != "") {
      args + ["--name", name]
    }

    JSON.decode(self.run(source, args).stdout) :: [Version!]!
  }

  """
  Views the details of a specific version of the Worker.
  """
  view(
    """
    The Worker Version ID to view.
    """
    versionId: String!,
    """
    Worker source, used to resolve the Worker name and configuration.
    """
    source: Directory,
  ): Version! @cache(policy: FunctionCachePolicy.Never) {
    let args = ["wrangler", "versions", "view", versionId, "--json"]

    let name = self.name
    if (name != null and name != "") {
      args + ["--name", name]
    }

    JSON.decode(self.run(source, args).stdout) :: Version!
  }

  """
  Uploads Worker code and config as a new version.

  The uploaded version is not deployed to production; use deploy to roll it out.
  """
  upload(
    """
    Worker source to upload.
    """
    source: Directory!,
    """
    A tag for this Worker version.
    """
    tag: String,
    """
    A descriptive message for this Worker version.
    """
    message: String,
    """
    Skip internal build steps and directly upload Worker.
    """
    noBundle: Boolean! = false,
    """
    Date to use for compatibility checks.
    """
    compatibilityDate: String,
    """
    Name of an alias for this Worker version.
    """
    previewAlias: String,
  ): Container! @cache(policy: FunctionCachePolicy.Never) {
    let args = ["wrangler", "versions", "upload"]

    let name = self.name
    if (name != null and name != "") {
      args + ["--name", name]
    }

    if (tag != null and tag != "") {
      args += ["--tag", tag]
    }

    if (message != null and message != "") {
      args += ["--message", message]
    }

    if (noBundle) {
      args += ["--no-bundle"]
    }

    if (compatibilityDate != null and compatibilityDate != "") {
      args += ["--compatibility-date", compatibilityDate]
    }

    if (previewAlias != null and previewAlias != "") {
      args += ["--preview-alias", previewAlias]
    }

    self.run(source, args)
  }

  let run(source: Directory, args: [String!]!): Container! {
    self
      .container
      .withWorkdir("/work")
      .{ if (source != null) _.withDirectory(".", source) else _ }
      .withExec(args)
  }
}

"""
A version of a Cloudflare Worker.
"""
type Version {
  """
  The Worker Version ID.
  """
  versionId: String! @JSON.field(name: "id")

  """
  The version number.
  """
  number: Int

  let metadata: VersionMetadata!

  let annotations: VersionAnnotations

  """
  The date the version was created.
  """
  createdOn: String! { self.metadata.createdOn }

  """
  The date the version was last modified.
  """
  modifiedOn: String { self.metadata.modifiedOn }

  """
  The source of the version (e.g. the tool used to create it).
  """
  source: String { self.metadata.source }

  """
  The email of the author who created the version.
  """
  author: String { self.metadata.authorEmail }

  """
  The tag associated with the version.
  """
  tag: String {
    if (self.annotations != null) self.annotations!.tag else null
  }

  """
  The descriptive message associated with the version.
  """
  message: String {
    if (self.annotations != null) self.annotations!.message else null
  }
}

type VersionMetadata {
  createdOn: String! @JSON.field(name: "created_on")
  modifiedOn: String @JSON.field(name: "modified_on")
  source: String
  authorId: String @JSON.field(name: "author_id")
  authorEmail: String @JSON.field(name: "author_email")
}

type VersionAnnotations {
  tag: String @JSON.field(name: "workers/tag")
  message: String @JSON.field(name: "workers/message")
  triggeredBy: String @JSON.field(name: "workers/triggered_by")
}

enum LogLevel {
  NONE
  ERROR
  WARN
  INFO
  LOG
  DEBUG
}
