type X509 {
  """
  Container with the smallstep step CLI installed.
  """
  pub container: Container!

  new(
    """
    Version (image tag) to use from the official image repository.
    """
    version: String! = "latest",
    """
    Container to use.
    """
    container: Container! = Dagger.container.from("smallstep/step-cli:" + version).withUser("root"),
  ) {
    self.container = container

    self
  }

  """
  Generate a new certificate.
  """
  pub generate(
    """
    Common name.
    """
    commonName: String!,
    """
    Subject alternative names.
    """
    sans: [String!]! = [],
    """
    Certificate validity start time or duration.
    """
    notBefore: String = null,
    """
    Certificate validity end time or duration.
    """
    notAfter: String = null,
    """
    Certificate or CSR template file.
    """
    template: File = null,
  ): Generator! {
    Generator(self, commonName, sans, notBefore, notAfter, template)
  }

  """
  Bundle a certificate with an issuer certificate or issuer chain.
  """
  pub bundle(
    certificate: File!,
    issuer: File!,
    name: String! = "bundle.crt",
  ): File! {
    self
      .container
      .withWorkdir("/work")
      .withMountedFile("/inputs/certificate.crt", certificate)
      .withMountedFile("/inputs/issuer.crt", issuer)
      .withExec(["step", "certificate", "bundle", "/inputs/certificate.crt", "/inputs/issuer.crt", name, "--force"])
      .file("/work/" + name)
  }

  """
  Wrap existing certificate and key files as a CA.
  """
  pub importCa(
    certificate: File!,
    key: File!,
    password: Secret = null,
    bundle: File = null,
  ): ImportedCA! {
    ImportedCA(certificate, key, bundle ?? certificate, password)
  }

  let baseContainer(certFile: String!, keyFile: String!, bundleFile: String!): Container! {
    self
      .container
      .withWorkdir("/work")
      .withEnvVariable("X509_CERT_FILE", certFile)
      .withEnvVariable("X509_KEY_FILE", keyFile)
      .withEnvVariable("X509_BUNDLE_FILE", bundleFile)
      .withExec(["sh", "-c", "mkdir -p \"$(dirname \"$X509_CERT_FILE\")\" \"$(dirname \"$X509_KEY_FILE\")\" \"$(dirname \"$X509_BUNDLE_FILE\")\""])
  }
}

type Generator {
  let x509: X509!

  let commonName: String!
  let sans: [String!]!
  let notBefore: String
  let notAfter: String
  let template: File

  """
  Generate a new RSA key.
  """
  pub rsa(
    """
    RSA key size.
    """
    size: Int!,
    """
    Password used to encrypt the generated private key.
    """
    password: Secret = null,
  ): RsaGenerator! {
    RsaGenerator(self, size, password)
  }

  """
  Generate a new EC key.
  """
  pub ec(
    """
    EC key curve.
    """
    curve: EcCurve!,
    """
    Password used to encrypt the generated private key.
    """
    password: Secret = null,
  ): EcGenerator! {
    EcGenerator(self, curve, password)
  }

  """
  Generate a new Ed25519 key.
  """
  pub ed25519(
    """
    Password used to encrypt the generated private key.
    """
    password: Secret = null,
  ): Ed25519Generator! {
    Ed25519Generator(self, password)
  }

  """
  Use an existing private key instead of generating one.
  """
  pub key(
    key: File!,
    """
    Password used to decrypt the existing private key.
    """
    password: Secret = null,
  ): KeyGenerator! {
    KeyGenerator(self, key, password)
  }

  let createArgs: [String!]! {
    let args = []

    if (self.template != null) {
      args += ["--template", templateFile]
    }

    args
  }

  let validityArgs: [String!]! {
    let args = []

    if (self.notBefore != null) {
      args += ["--not-before", self.notBefore]
    }

    if (self.notAfter != null) {
      args += ["--not-after", self.notAfter]
    }

    args
  }

  let sanArgs: [String!]! {
    self.sans.reduce([]) { args, san =>
      args + ["--san", san]
    }
  }
}

type RsaGenerator {
  let generator: Generator!
  let size: Int!
  let password: Secret

  let createArgs: [String!]! {
    self.generator.createArgs + ["--kty", keyTypeValue(KeyType.RSA), "--size", toString(self.size)] + self.passwordArgs
  }

  let passwordArgs: [String!]! {
    if (self.password != null) {
      ["--password-file", keyPasswordFile]
    } else {
      ["--no-password", "--insecure"]
    }
  }

  let creator: CertificateGenerator! {
    CertificateGenerator(generator: self.generator, password: self.password, createArgs: self.createArgs)
  }

  """
  Create a self-signed root CA certificate.
  """
  pub rootCa(name: String! = "root-ca"): RootCA! {
    self.creator.rootCa(name)
  }

  """
  Create an intermediate CA certificate signed by an issuer.
  """
  pub intermediateCa(
    issuer: Issuer!,
    name: String! = "intermediate-ca",
    bundle: Boolean! = false,
  ): IntermediateCA! {
    self.creator.intermediateCa(issuer, name, bundle)
  }

  """
  Create a leaf certificate signed by an issuer.
  """
  pub certificate(
    issuer: Issuer!,
    name: String! = "leaf",
    bundle: Boolean! = false,
  ): Certificate! {
    self.creator.certificate(issuer, name, bundle)
  }

  """
  Create a self-signed leaf certificate.
  """
  pub selfSignedLeaf(name: String! = "leaf"): Certificate! {
    self.creator.selfSignedLeaf(name)
  }

  """
  Create a certificate signing request and private key.
  """
  pub csr(name: String! = "certificate"): CertificateRequest! {
    self.creator.csr(name)
  }
}

