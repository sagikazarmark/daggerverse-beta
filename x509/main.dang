type KeyGenerator {
  let generator: Generator!
  let key: File!
  let password: Secret

  let createArgs: [String!]! {
    self.generator.createArgs + ["--key", existingKeyFile] + self.passwordArgs
  }

  let passwordArgs: [String!]! {
    if (self.password != null) {
      ["--password-file", keyPasswordFile]
    } else {
      []
    }
  }

  let creator: CertificateGenerator! {
    CertificateGenerator(
      generator: self.generator,
      key: self.key,
      password: self.password,
      createArgs: self.createArgs,
    )
  }

  """
  Create a self-signed root CA certificate.
  """
  pub rootCa(name: String! = "root-ca"): RootCA! {
    self.creator.rootCa(name)
  }

  """
  Create an intermediate CA certificate signed by an issuer.
  """
  pub intermediateCa(
    issuer: Issuer!,
    name: String! = "intermediate-ca",
    bundle: Boolean! = false,
  ): IntermediateCA! {
    self.creator.intermediateCa(issuer, name, bundle)
  }

  """
  Create a leaf certificate signed by an issuer.
  """
  pub certificate(
    issuer: Issuer!,
    name: String! = "leaf",
    bundle: Boolean! = false,
  ): Certificate! {
    self.creator.certificate(issuer, name, bundle)
  }

  """
  Create a self-signed leaf certificate.
  """
  pub selfSignedLeaf(name: String! = "leaf"): Certificate! {
    self.creator.selfSignedLeaf(name)
  }

  """
  Create a certificate signing request and private key.
  """
  pub csr(name: String! = "certificate"): CertificateRequest! {
    self.creator.csr(name)
  }
}

type CertificateGenerator {
  let generator: Generator!
  let key: File = null
  let password: Secret = null
  let createArgs: [String!]! = []

  new(
    generator: Generator!,
    key: File = null,
    password: Secret = null,
    createArgs: [String!]! = [],
  ) {
    self.generator = generator
    self.key = key
    self.password = password
    self.createArgs = createArgs

    self
  }

  """
  Create a self-signed root CA certificate.
  """
  let rootCa(name: String!): RootCA! {
    let certFile = name + ".crt"
    let keyFile = name + ".key"
    let bundleFile = name + "-bundle.crt"

    let container = self.generator.x509.baseContainer(certFile, keyFile, bundleFile)

    let args = self.commandArgs(certFile, keyFile) + ["--profile", "root-ca", "--force"]
    args += self.createArgs
    args += self.generator.validityArgs

    let prepared = self
      .prepareCreate(container)
      .withExec(args)
      .withExec(["cp", certFile, bundleFile])

    let directory = prepared.directory("/work")
    let resultKey = self.key ?? directory.file(keyFile)

    RootCA(
      commonName: self.generator.commonName,
      certificate: directory.file(certFile),
      key: resultKey,
      bundle: directory.file(bundleFile),
      password: self.password,
      directory: directory,
    )
  }

  """
  Create an intermediate CA certificate signed by an issuer.
  """
  let intermediateCa(
    issuer: Issuer!,
    name: String!,
    bundle: Boolean!,
  ): IntermediateCA! {
    let certFile = name + ".crt"
    let keyFile = name + ".key"
    let bundleFile = name + "-bundle.crt"
    let authority = issuer.authority

    let container = self
      .generator
      .x509
      .baseContainer(certFile, keyFile, bundleFile)
      .withMountedFile(caCertFile, issuer.certificate)
      .withMountedFile(caKeyFile, issuer.key)
      .withMountedFile(issuerBundleFile, issuer.bundle)

    let args = self.commandArgs(certFile, keyFile) + ["--profile", "intermediate-ca", "--ca", caCertFile, "--ca-key", caKeyFile, "--force"]
    args += self.createArgs
    args += self.generator.validityArgs
    args += authority.createArgs

    container = self
      .prepareCreate(container, authority)
      .withExec(args)

    if (bundle) {
      container = container.withExec(["step", "certificate", "bundle", certFile, issuerBundleFile, bundleFile, "--force"])
    }

    let directory = container.directory("/work")
    let resultKey = self.key ?? directory.file(keyFile)
    let certificateBundle = if (bundle) { directory.file(bundleFile) } else { null }

    IntermediateCA(
      commonName: self.generator.commonName,
      certificate: directory.file(certFile),
      key: resultKey,
      bundle: certificateBundle,
      password: self.password,
      directory: directory,
    )
  }

  """
  Create a leaf certificate signed by an issuer.
  """
  let certificate(
    issuer: Issuer!,
    name: String!,
    bundle: Boolean!,
  ): Certificate! {
    let certFile = name + ".crt"
    let keyFile = name + ".key"
    let bundleFile = name + "-bundle.crt"
    let authority = issuer.authority

    let container = self
      .generator
      .x509
      .baseContainer(certFile, keyFile, bundleFile)
      .withMountedFile(caCertFile, authority.certificate)
      .withMountedFile(caKeyFile, authority.key)
      .withMountedFile(issuerBundleFile, authority.bundle)

    let args = self.commandArgs(certFile, keyFile) + ["--profile", "leaf", "--ca", caCertFile, "--ca-key", caKeyFile, "--force"]
    args += self.createArgs
    args += self.generator.validityArgs
    args += self.generator.sanArgs
    args += authority.createArgs

    container = self
      .prepareCreate(container, authority)
      .withExec(args)

    if (bundle) {
      container = container.withExec(["step", "certificate", "bundle", certFile, issuerBundleFile, bundleFile, "--force"])
    }

    let directory = container.directory("/work")

    Certificate(
      commonName: self.generator.commonName,
      certificate: directory.file(certFile),
      key: self.key ?? directory.file(keyFile),
      bundle: if (bundle) { directory.file(bundleFile) } else { null },
      password: self.password,
      directory: directory,
    )
  }

  """
  Create a self-signed leaf certificate.
  """
  let selfSignedLeaf(name: String!): Certificate! {
    let certFile = name + ".crt"
    let keyFile = name + ".key"
    let bundleFile = name + "-bundle.crt"

    let container = self.generator.x509.baseContainer(certFile, keyFile, bundleFile)

    let args = self.commandArgs(certFile, keyFile) + ["--profile", "self-signed", "--subtle", "--force"]
    args += self.createArgs
    args += self.generator.validityArgs
    args += self.generator.sanArgs

    container = self
      .prepareCreate(container)
      .withExec(args)
      .withExec(["cp", certFile, bundleFile])

    let directory = container.directory("/work")

    Certificate(
      commonName: self.generator.commonName,
      certificate: directory.file(certFile),
      key: self.key ?? directory.file(keyFile),
      bundle: directory.file(bundleFile),
      password: self.password,
      directory: directory,
    )
  }

  """
  Create a certificate signing request and private key.
  """
  let csr(name: String!): CertificateRequest! {
    let csrFile = name + ".csr"
    let keyFile = name + ".key"
    let bundleFile = name + "-bundle.crt"

    let container = self.generator.x509.baseContainer(csrFile, keyFile, bundleFile)

    let args = self.commandArgs(csrFile, keyFile) + ["--csr", "--force"]
    args += self.createArgs
    args += self.generator.sanArgs

    container = self
      .prepareCreate(container)
      .withExec(args)

    let directory = container.directory("/work")

    CertificateRequest(
      commonName: self.generator.commonName,
      csr: directory.file(csrFile),
      key: self.key ?? directory.file(keyFile),
      password: self.password,
      directory: directory,
    )
  }

  let commandArgs(certFile: String!, keyFile: String!): [String!]! {
    if (self.key != null) {
      ["step", "certificate", "create", self.generator.commonName, certFile]
    } else {
      ["step", "certificate", "create", self.generator.commonName, certFile, keyFile]
    }
  }

  let prepareCreate(
    container: Container!,
    authority: CertificateAuthority = null,
  ): Container! {
    let password = self.password
    if (password != null) {
      container = container.withMountedSecret(keyPasswordFile, password)
    }

    if (authority != null) {
      if (authority.passwordProtected) {
        container = container.withMountedSecret(caPasswordFile, authority.password)
      }
    }

    let template = self.generator.template
    if (template != null) {
      container = container.withMountedFile(templateFile, template)
    }

    let key = self.key
    if (key != null) {
      container = container.withMountedFile(existingKeyFile, key)
    }

    container
  }
}

type Issuer {
  pub authority: CertificateAuthority!

  pub certificate: File! { self.authority.certificate }

  pub key: File! { self.authority.key }

  pub bundle: File! { self.authority.bundle }

  pub password: Secret! { self.authority.password }

  pub passwordProtected: Boolean! { self.authority.passwordProtected }
}

type CertificateAuthority {
  pub certificate: File!
  pub key: File!
  pub bundle: File!
  pub password: Secret!
  pub passwordProtected: Boolean! = false

  let createArgs: [String!]! {
    if (self.passwordProtected) {
      ["--ca-password-file", caPasswordFile]
    } else {
      []
    }
  }
}

type RootCA {
  pub commonName: String!
  pub certificate: File!
  pub key: File!
  pub bundle: File!
  pub password: Secret
  pub directory: Directory!

  pub authority: CertificateAuthority! {
    CertificateAuthority(
      certificate: self.certificate,
      key: self.key,
      bundle: self.bundle,
      password: self.password ?? emptyPassword,
      passwordProtected: self.password != null,
    )
  }

  pub issuer: Issuer! {
    Issuer(authority: self.authority)
  }
}

type IntermediateCA {
  pub commonName: String!
  pub certificate: File!
  pub key: File!
  pub bundle: File
  pub password: Secret
  pub directory: Directory!

  pub authority: CertificateAuthority! {
    CertificateAuthority(
      certificate: self.certificate,
      key: self.key,
      bundle: self.bundle ?? self.certificate,
      password: self.password ?? emptyPassword,
      passwordProtected: self.password != null,
    )
  }

  pub issuer: Issuer! {
    Issuer(authority: self.authority)
  }
}

type ImportedCA {
  pub certificate: File!
  pub key: File!
  pub bundle: File!
  pub password: Secret

  pub authority: CertificateAuthority! {
    CertificateAuthority(
      certificate: self.certificate,
      key: self.key,
      bundle: self.bundle,
      password: self.password ?? emptyPassword,
      passwordProtected: self.password != null,
    )
  }

  pub issuer: Issuer! {
    Issuer(authority: self.authority)
  }
}

type Certificate {
  pub commonName: String!
  pub certificate: File!
  pub key: File!
  pub bundle: File
  pub password: Secret
  pub directory: Directory!
}

type CertificateRequest {
  pub commonName: String!
  pub csr: File!
  pub key: File!
  pub password: Secret
  pub directory: Directory!
}

enum KeyType {
  EC
  OKP
  RSA
}

enum EcCurve {
  P256
  P384
  P521
}

let keyPasswordFile = "/run/secrets/x509-password"
let caPasswordFile = "/run/secrets/x509-ca-password"
let existingKeyFile = "/inputs/key.pem"
let caCertFile = "/inputs/ca.crt"
let caKeyFile = "/inputs/ca.key"
let issuerBundleFile = "/inputs/issuer-bundle.crt"
let templateFile = "/inputs/template.json"

let emptyPassword: Secret! {
  Dagger.setSecret("x509-empty-password", "")
}

let keyTypeValue(keyType: KeyType!): String! {
  toString(keyType).trim("\"")
}

let ecCurveValue(curve: EcCurve!): String! {
  case (curve) {
    EcCurve.P256 => "P-256"
    EcCurve.P384 => "P-384"
    EcCurve.P521 => "P-521"
  }
}

let arch(platform: Platform!): String! {
  case (platform) {
    "linux/amd64" => "amd64"
    "linux/arm64" => "arm64"
    else => raise "unsupported platform: " + toString(platform).trim("\"")
  }
}
