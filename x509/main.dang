type X509 {
  """
  Container with the smallstep step CLI installed.
  """
  pub container: Container!

  new(
    """
    Version (image tag) to use from the official image repository.
    """
    version: String! = "latest",
    """
    Container to use.
    """
    container: Container! = Dagger.container.from("smallstep/step-cli:" + version).withUser("root"),
  ) {
    self.container = container.withWorkdir("/work")

    self
  }

  """
  Select how certificate keys are provided.
  """
  pub generate: GeneratorKeySelector! {
    GeneratorKeySelector(self)
  }

  """
  Bundle a certificate with an issuer certificate or issuer chain.
  """
  pub bundle(
    certificate: File!,
    issuer: File!,
    name: String! = "bundle.crt",
  ): File! {
    self
      .container
      .withWorkdir("/work")
      .withMountedFile("/inputs/certificate.crt", certificate)
      .withMountedFile("/inputs/issuer.crt", issuer)
      .withExec(["step", "certificate", "bundle", "/inputs/certificate.crt", "/inputs/issuer.crt", name, "--force"])
      .file("/work/" + name)
  }

  """
  Wrap existing certificate and key files as a CA.
  """
  pub importCa(
    """
    Certificate file to import.
    """
    certificate: File!,
    """
    Key file to import.
    """
    key: File!,
    """
    Password used to decrypt the private key.
    """
    password: Secret = null,
    """
    Certificate bundle for intermediate CAs.
    """
    bundle: File = null,
  ): ImportedCA! {
    ImportedCA(certificate, key, bundle ?? certificate, password)
  }
}

type GeneratorKeySelector {
  let x509: X509!

  """
  Generate a new RSA key.
  """
  pub rsa(
    """
    RSA key size.
    """
    size: Int!,
    """
    Password used to encrypt the generated private key.
    """
    password: Secret = null,
  ): Generator! {
    self.generator(GeneratedKey(KeyType.RSA, ["--size", toString(size)]), password)
  }

  """
  Generate a new EC key.
  """
  pub ec(
    """
    EC key curve.
    """
    curve: EcCurve!,
    """
    Password used to encrypt the generated private key.
    """
    password: Secret = null,
  ): Generator! {
    self.generator(GeneratedKey(KeyType.EC, ["--curve", ecCurveValue(curve)]), password)
  }

  """
  Generate a new Ed25519 key.
  """
  pub ed25519(
    """
    Password used to encrypt the generated private key.
    """
    password: Secret = null,
  ): Generator! {
    self.generator(GeneratedKey(KeyType.OKP, ["--curve", "Ed25519"]), password)
  }

  """
  Use an existing private key instead of generating one.
  """
  pub key(
    key: File!,
    """
    Password used to decrypt the existing private key.
    """
    password: Secret = null,
  ): Generator! {
    self.generator(ExistingKey(key), password)
  }

  let generator(keySource: KeySource!, password: Secret): Generator! {
    let key = case (keySource) {
      generated: GeneratedKey => null
      existing: ExistingKey => existing.key
    }

    let container = self.x509.container

    let args = []

    if (key != null) {
      container = container.withMountedFile(existingKeyFile, key)
    }

    if (password != null) {
      container = container.withMountedSecret(keyPasswordFile, password)
    }

    args += case (keySource) {
      generated: GeneratedKey => ["--kty", keyTypeValue(generated.keyType)] + generated.args
      existing: ExistingKey => ["--key", existingKeyFile]
    }

    args += if (password != null) {
      ["--password-file", keyPasswordFile]
    } else {
      case (keySource) {
        generated: GeneratedKey => ["--no-password", "--insecure"]
        existing: ExistingKey => []
      }
    }

    Generator(
      container: container,
      commonArgs: args,
      key: key,
      password: password,
    )
  }
}

type GeneratedKey {
  let keyType: KeyType!
  let args: [String!]!
}

type ExistingKey {
  let key: File!
}

union KeySource = GeneratedKey | ExistingKey

type Generator {
  let container: Container!
  let commonArgs: [String!]!
  let key: File
  let password: Secret

  """
  Generate a self-signed root CA certificate.
  """
  pub rootCa(
    """
    Common name.
    """
    commonName: String!,
    """
    Certificate validity start time or duration.
    """
    notBefore: String = null,
    """
    Certificate validity end time or duration.
    """
    notAfter: String = null,
    """
    Certificate or CSR template file.
    """
    template: File = null,
    """
    Base name of the generated files.
    """
    name: String! = "root-ca",
  ): RootCA! {
    let certFile = name + ".crt"
    let keyFile = name + ".key"

    let args = self.certArgs(
      commonName,
      certFile,
      keyFile,
      template,
      "root-ca",
      notBefore,
      notAfter,
    )
    args += ["--force"]

    let certs = self
      .withTemplate(self.container, template)
      .withExec(args)
      .directory("/work")

    RootCA(
      certificate: certs.file(certFile),
      key: self.resultKey(certs, keyFile),
      password: self.password,
    )
  }

  """
  Create an intermediate CA certificate signed by an issuer.
  """
  pub intermediateCa(
    issuer: Issuer!,
    """
    Common name.
    """
    commonName: String!,
    """
    Certificate validity start time or duration.
    """
    notBefore: String = null,
    """
    Certificate validity end time or duration.
    """
    notAfter: String = null,
    """
    Certificate or CSR template file.
    """
    template: File = null,
    name: String! = "intermediate-ca",
  ): IntermediateCA! {
    let certFile = name + ".crt"
    let keyFile = name + ".key"
    let bundleFile = name + "-bundle.crt"
    let authority = issuer.authority

    let args = self.certArgs(
      commonName,
      certFile,
      keyFile,
      template,
      "intermediate-ca",
      notBefore,
      notAfter,
    )
    args += ["--ca", caCertFile, "--ca-key", caKeyFile, "--force"]
    args += authority.args

    let container = self
      .withTemplate(self.withAuthority(self.container, issuer), template)
      .withExec(args)
      .withExec(["step", "certificate", "bundle", certFile, issuerBundleFile, bundleFile, "--force"])

    let directory = container.directory("/work")

    IntermediateCA(
      certificate: directory.file(certFile),
      key: self.resultKey(directory, keyFile),
      bundle: directory.file(bundleFile),
      password: self.password,
    )
  }

  """
  Create a leaf certificate signed by an issuer.
  """
  pub certificate(
    issuer: Issuer!,
    """
    Common name.
    """
    commonName: String!,
    """
    Subject alternative names.
    """
    sans: [String!]! = [],
    """
    Certificate validity start time or duration.
    """
    notBefore: String = null,
    """
    Certificate validity end time or duration.
    """
    notAfter: String = null,
    """
    Certificate or CSR template file.
    """
    template: File = null,
    name: String! = "leaf",
  ): Certificate! {
    let certFile = name + ".crt"
    let keyFile = name + ".key"
    let bundleFile = name + "-bundle.crt"
    let authority = issuer.authority

    let args = self.certArgs(
      commonName,
      certFile,
      keyFile,
      template,
      "leaf",
      notBefore,
      notAfter,
    )
    args += ["--ca", caCertFile, "--ca-key", caKeyFile, "--force"]
    args += self.sanArgs(sans)
    args += authority.args

    let container = self
      .withTemplate(self.withAuthority(self.container, issuer), template)
      .withExec(args)
      .withExec(["step", "certificate", "bundle", certFile, issuerBundleFile, bundleFile, "--force"])

    let directory = container.directory("/work")

    Certificate(
      certificate: directory.file(certFile),
      key: self.resultKey(directory, keyFile),
      bundle: directory.file(bundleFile),
      password: self.password,
    )
  }

  """
  Create a self-signed leaf certificate.
  """
  pub selfSignedLeaf(
    """
    Common name.
    """
    commonName: String!,
    """
    Subject alternative names.
    """
    sans: [String!]! = [],
    """
    Certificate validity start time or duration.
    """
    notBefore: String = null,
    """
    Certificate validity end time or duration.
    """
    notAfter: String = null,
    """
    Certificate or CSR template file.
    """
    template: File = null,
    name: String! = "leaf",
  ): Certificate! {
    let certFile = name + ".crt"
    let keyFile = name + ".key"
    let bundleFile = name + "-bundle.crt"

    let args = self.certArgs(
      commonName,
      certFile,
      keyFile,
      template,
      "self-signed",
      notBefore,
      notAfter,
    )
    args += ["--subtle", "--force"]
    args += self.sanArgs(sans)

    let container = self
      .withTemplate(self.container, template)
      .withExec(args)
      .withExec(["cp", certFile, bundleFile])

    let directory = container.directory("/work")

    Certificate(
      certificate: directory.file(certFile),
      key: self.resultKey(directory, keyFile),
      bundle: directory.file(bundleFile),
      password: self.password,
    )
  }

  """
  Generate a certificate signing request (CSR) instead of a certificate.
  """
  pub csr(
    """
    Common name.
    """
    commonName: String!,
    """
    Subject alternative names.
    """
    sans: [String!]! = [],
    """
    Certificate or CSR template file.
    """
    template: File = null,
    name: String! = "certificate",
  ): CertificateRequest! {
    let csrFile = name + ".csr"
    let keyFile = name + ".key"

    let args = self.args(commonName, csrFile, keyFile, template)
    args += ["--csr", "--force"]
    args += self.sanArgs(sans)

    let container = self
      .withTemplate(self.container, template)
      .withExec(args)

    let directory = container.directory("/work")

    CertificateRequest(
      csr: directory.file(csrFile),
      key: self.resultKey(directory, keyFile),
      password: self.password,
    )
  }

  let args(
    commonName: String!,
    certFile: String!,
    keyFile: String!,
    template: File,
  ): [String!]! {
    let commandArgs = ["step", "certificate", "create", commonName, certFile]

    if (self.key == null) {
      commandArgs += [keyFile]
    }

    if (template != null) {
      commandArgs += ["--template", templateFile]
    }

    commandArgs += self.commonArgs

    commandArgs
  }

  let certArgs(
    commonName: String!,
    certFile: String!,
    keyFile: String!,
    template: File,
    profile: String!,
    notBefore: String,
    notAfter: String,
  ): [String!]! {
    let args = self.args(commonName, certFile, keyFile, template)
    args += ["--profile", profile]

    args += self.validityArgs(notBefore, notAfter)

    args
  }

  let resultKey(directory: Directory!, keyFile: String!): File! {
    self.key ?? directory.file(keyFile)
  }

  let withAuthority(
    container: Container!,
    issuer: Issuer!,
  ): Container! {
    container = container
      .withMountedFile(caCertFile, issuer.certificate)
      .withMountedFile(caKeyFile, issuer.key)
      .withMountedFile(issuerBundleFile, issuer.bundle)

    let authority = issuer.authority
    if (authority.passwordProtected) {
      container = container.withMountedSecret(caPasswordFile, authority.password)
    }

    container
  }

  let withTemplate(container: Container!, template: File): Container! {
    if (template != null) {
      container = container.withMountedFile(templateFile, template)
    }

    container
  }

  let validityArgs(notBefore: String, notAfter: String): [String!]! {
    let args = []

    if (notBefore != null) {
      args += ["--not-before", notBefore]
    }

    if (notAfter != null) {
      args += ["--not-after", notAfter]
    }

    args
  }

  let sanArgs(sans: [String!]!): [String!]! {
    sans.reduce([]) { args, san =>
      args + ["--san", san]
    }
  }
}

type Issuer {
  pub authority: CertificateAuthority!

  pub certificate: File! { self.authority.certificate }

  pub key: File! { self.authority.key }

  pub bundle: File! { self.authority.bundle }

  pub password: Secret! { self.authority.password }

  pub passwordProtected: Boolean! { self.authority.passwordProtected }
}

type CertificateAuthority {
  pub certificate: File!
  pub key: File!
  pub bundle: File!
  pub password: Secret!
  pub passwordProtected: Boolean! = false

  let args: [String!]! {
    if (self.passwordProtected) {
      ["--ca-password-file", caPasswordFile]
    } else {
      []
    }
  }
}

type RootCA {
  pub certificate: File!
  pub key: File!
  pub password: Secret

  pub bundle: File! {
    self.certificate.withName(self.certificate.name.trimSuffix(".crt") + "-bundle.crt")
  }

  pub authority: CertificateAuthority! {
    CertificateAuthority(
      certificate: self.certificate,
      key: self.key,
      bundle: self.bundle,
      password: self.password ?? emptyPassword,
      passwordProtected: self.password != null,
    )
  }

  pub issuer: Issuer! {
    Issuer(authority: self.authority)
  }
}

type IntermediateCA {
  pub certificate: File!
  pub key: File!
  pub bundle: File!
  pub password: Secret

  pub authority: CertificateAuthority! {
    CertificateAuthority(
      certificate: self.certificate,
      key: self.key,
      bundle: self.bundle,
      password: self.password ?? emptyPassword,
      passwordProtected: self.password != null,
    )
  }

  pub issuer: Issuer! {
    Issuer(authority: self.authority)
  }
}

type ImportedCA {
  pub certificate: File!
  pub key: File!
  pub bundle: File!
  pub password: Secret

  pub authority: CertificateAuthority! {
    CertificateAuthority(
      certificate: self.certificate,
      key: self.key,
      bundle: self.bundle,
      password: self.password ?? emptyPassword,
      passwordProtected: self.password != null,
    )
  }

  pub issuer: Issuer! {
    Issuer(authority: self.authority)
  }
}

type Certificate {
  pub certificate: File!
  pub key: File!
  pub bundle: File!
  pub password: Secret
}

type CertificateRequest {
  pub csr: File!
  pub key: File!
  pub password: Secret
}

enum KeyType {
  EC
  OKP
  RSA
}

enum EcCurve {
  P256
  P384
  P521
}

let keyPasswordFile = "/run/secrets/x509-password"
let caPasswordFile = "/run/secrets/x509-ca-password"
let existingKeyFile = "/inputs/key.pem"
let caCertFile = "/inputs/ca.crt"
let caKeyFile = "/inputs/ca.key"
let issuerBundleFile = "/inputs/issuer-bundle.crt"
let templateFile = "/inputs/template.json"

let emptyPassword: Secret! {
  Dagger.setSecret("x509-empty-password", "")
}

let keyTypeValue(keyType: KeyType!): String! {
  toString(keyType).trim("\"")
}

let ecCurveValue(curve: EcCurve!): String! {
  case (curve) {
    EcCurve.P256 => "P-256"
    EcCurve.P384 => "P-384"
    EcCurve.P521 => "P-521"
  }
}

let arch(platform: Platform!): String! {
  case (platform) {
    "linux/amd64" => "amd64"
    "linux/arm64" => "arm64"
    else => raise "unsupported platform: " + toString(platform).trim("\"")
  }
}
