type X509 {
  let requestedVersion: String = null

  """
  Container with the smallstep step CLI installed.
  """
  pub container: Container!

  new(
    """
    Step CLI version. Use null or an empty string for the latest release.
    """
    version: String = null,
    """
    Alpine version to use for the default container.
    """
    alpineVersion: String! = "latest",
    """
    Container to install the step CLI into.
    """
    container: Container! = Dagger.container.from("alpine:" + alpineVersion),
  ) {
    self.requestedVersion = version
    self.container = container.withFile("/usr/local/bin/step", download(version, container.platform))

    self
  }

  """
  Installed Step CLI version.
  """
  pub version: String! {
    stepRelease(self.requestedVersion).tagName
  }

  """
  Create a reusable certificate generation request.
  """
  pub generate(
    """
    Certificate or CSR common name.
    """
    commonName: String!,
    """
    Subject alternative names.
    """
    sans: [String!]! = [],
    """
    Certificate validity start time or duration.
    """
    notBefore: String = null,
    """
    Certificate validity end time or duration.
    """
    notAfter: String = null,
    """
    Certificate or CSR template file.
    """
    template: File = null,
  ): Generator! {
    Generator(
      x509: self,
      commonName: commonName,
      sans: sans,
      notBefore: notBefore,
      notAfter: notAfter,
      template: template,
    )
  }

  """
  Bundle a certificate with an issuer certificate or issuer chain.
  """
  pub bundle(
    certificate: File!,
    issuer: File!,
    name: String! = "bundle.crt",
  ): File! {
    self
      .container
      .withWorkdir("/work")
      .withMountedFile("/inputs/certificate.crt", certificate)
      .withMountedFile("/inputs/issuer.crt", issuer)
      .withExec(["step", "certificate", "bundle", "/inputs/certificate.crt", "/inputs/issuer.crt", name, "--force"])
      .file("/work/" + name)
  }

  """
  Wrap existing certificate and key files as a CA.
  """
  pub importCa(
    commonName: String!,
    certificate: File!,
    key: File!,
    password: Secret = null,
    bundle: File = null,
  ): ImportedCA! {
    ImportedCA(
      x509: self,
      commonName: commonName,
      certificate: certificate,
      key: key,
      bundle: bundle ?? certificate,
      password: password,
    )
  }

  let baseContainer(certFile: String!, keyFile: String!, bundleFile: String!): Container! {
    self
      .container
      .withWorkdir("/work")
      .withEnvVariable("X509_CERT_FILE", certFile)
      .withEnvVariable("X509_KEY_FILE", keyFile)
      .withEnvVariable("X509_BUNDLE_FILE", bundleFile)
      .withExec(["sh", "-c", "mkdir -p \"$(dirname \"$X509_CERT_FILE\")\" \"$(dirname \"$X509_KEY_FILE\")\" \"$(dirname \"$X509_BUNDLE_FILE\")\""])
  }
}

type Generator {
  let x509: X509!
  let commonName: String!
  let sans: [String!]! = []
  let notBefore: String = null
  let notAfter: String = null
  let template: File = null

  new(
    x509: X509!,
    commonName: String!,
    sans: [String!]! = [],
    notBefore: String = null,
    notAfter: String = null,
    template: File = null,
  ) {
    self.x509 = x509
    self.commonName = commonName
    self.sans = sans
    self.notBefore = notBefore
    self.notAfter = notAfter
    self.template = template

    self
  }

  """
  Use a generated RSA key.
  """
  pub rsa(
    """
    RSA key size.
    """
    size: Int!,
    """
    Password used to encrypt the generated private key.
    """
    password: Secret = null,
  ): KeyedGenerator! {
    KeyedGenerator(generator: self, keyType: KeyType.RSA, size: size, password: password)
  }

  """
  Use a generated EC key.
  """
  pub ec(
    """
    EC key curve.
    """
    curve: EcCurve!,
    """
    Password used to encrypt the generated private key.
    """
    password: Secret = null,
  ): KeyedGenerator! {
    KeyedGenerator(generator: self, keyType: KeyType.EC, curve: ecCurveValue(curve), password: password)
  }

  """
  Use a generated Ed25519 key.
  """
  pub ed25519(
    """
    Password used to encrypt the generated private key.
    """
    password: Secret = null,
  ): KeyedGenerator! {
    KeyedGenerator(generator: self, keyType: KeyType.OKP, curve: "Ed25519", password: password)
  }

  """
  Use an existing private key instead of generating one.
  """
  pub key(
    key: File!,
    """
    Password used to decrypt the existing private key.
    """
    password: Secret = null,
  ): KeyedGenerator! {
    KeyedGenerator(generator: self, key: key, password: password)
  }
}

type KeyedGenerator {
  let generator: Generator!
  let keyType: KeyType = null
  let curve: String = null
  let size: Int = null
  let key: File = null
  let password: Secret = null

  new(
    generator: Generator!,
    keyType: KeyType = null,
    curve: String = null,
    size: Int = null,
    key: File = null,
    password: Secret = null,
  ) {
    self.generator = generator
    self.keyType = keyType
    self.curve = curve
    self.size = size
    self.key = key
    self.password = password

    self
  }

  """
  Create a self-signed root CA certificate.
  """
  pub rootCa(name: String! = "root-ca"): RootCA! {
    let certFile = name + ".crt"
    let keyFile = name + ".key"
    let bundleFile = name + "-bundle.crt"

    let container = self.generator.x509.baseContainer(certFile, keyFile, bundleFile)

    let args = createArgs(self.generator.commonName, certFile, keyFile, self.key)
      + ["--profile", "root-ca", "--force"]
    args = addCommonCreateArgs(args, self.keyType, self.curve, self.size, self.generator.notBefore, self.generator.notAfter, [], self.generator.template)
    args = addKeyArgs(args, self.key, self.password)

    let prepared = prepareCreate(container, self.password, null, self.generator.template, self.key)
      .withExec(args)
      .withExec(["cp", certFile, bundleFile])

    let directory = prepared.directory("/work")
    let resultKey = self.key ?? directory.file(keyFile)

    RootCA(
      x509: self.generator.x509,
      commonName: self.generator.commonName,
      certificate: directory.file(certFile),
      key: resultKey,
      bundle: directory.file(bundleFile),
      password: self.password,
      directory: directory,
    )
  }

  """
  Create an intermediate CA certificate signed by an issuer.
  """
  pub intermediateCa(
    issuer: Issuer!,
    name: String! = "intermediate-ca",
    bundle: Boolean! = false,
  ): IntermediateCA! {
    let certFile = name + ".crt"
    let keyFile = name + ".key"
    let bundleFile = name + "-bundle.crt"
    let authority = issuer.authority

    let container = self.generator.x509
      .baseContainer(certFile, keyFile, bundleFile)
      .withMountedFile(caCertFile, authority.certificate)
      .withMountedFile(caKeyFile, authority.key)
      .withMountedFile(issuerBundleFile, authority.bundle)

    let args = createArgs(self.generator.commonName, certFile, keyFile, self.key)
      + ["--profile", "intermediate-ca", "--ca", caCertFile, "--ca-key", caKeyFile, "--force"]
    args = addCommonCreateArgs(args, self.keyType, self.curve, self.size, self.generator.notBefore, self.generator.notAfter, [], self.generator.template)
    args = addKeyArgs(args, self.key, self.password)
    let signingPassword = authorityPassword(authority)
    args = addCaPasswordArgs(args, signingPassword)

    container = prepareCreate(container, self.password, signingPassword, self.generator.template, self.key)
      .withExec(args)

    if (bundle) {
      container = container.withExec([
        "step", "certificate", "bundle", certFile, issuerBundleFile, bundleFile, "--force",
      ])
    }

    let directory = container.directory("/work")
    let resultKey = self.key ?? directory.file(keyFile)
    let certificateBundle = if (bundle) { directory.file(bundleFile) } else { null }

    IntermediateCA(
      x509: self.generator.x509,
      commonName: self.generator.commonName,
      certificate: directory.file(certFile),
      key: resultKey,
      bundle: certificateBundle,
      password: self.password,
      directory: directory,
    )
  }

  """
  Create a leaf certificate signed by an issuer.
  """
  pub certificate(
    issuer: Issuer!,
    name: String! = "leaf",
    bundle: Boolean! = false,
  ): Certificate! {
    let certFile = name + ".crt"
    let keyFile = name + ".key"
    let bundleFile = name + "-bundle.crt"
    let authority = issuer.authority

    let container = self.generator.x509
      .baseContainer(certFile, keyFile, bundleFile)
      .withMountedFile(caCertFile, authority.certificate)
      .withMountedFile(caKeyFile, authority.key)
      .withMountedFile(issuerBundleFile, authority.bundle)

    let args = createArgs(self.generator.commonName, certFile, keyFile, self.key)
      + ["--profile", "leaf", "--ca", caCertFile, "--ca-key", caKeyFile, "--force"]
    args = addCommonCreateArgs(args, self.keyType, self.curve, self.size, self.generator.notBefore, self.generator.notAfter, self.generator.sans, self.generator.template)
    args = addKeyArgs(args, self.key, self.password)
    let signingPassword = authorityPassword(authority)
    args = addCaPasswordArgs(args, signingPassword)

    container = prepareCreate(container, self.password, signingPassword, self.generator.template, self.key)
      .withExec(args)

    if (bundle) {
      container = container.withExec([
        "step", "certificate", "bundle", certFile, issuerBundleFile, bundleFile, "--force",
      ])
    }

    let directory = container.directory("/work")

    Certificate(
      commonName: self.generator.commonName,
      certificate: directory.file(certFile),
      key: self.key ?? directory.file(keyFile),
      bundle: if (bundle) { directory.file(bundleFile) } else { null },
      password: self.password,
      directory: directory,
    )
  }

  """
  Create a self-signed leaf certificate.
  """
  pub selfSignedLeaf(name: String! = "leaf"): Certificate! {
    let certFile = name + ".crt"
    let keyFile = name + ".key"
    let bundleFile = name + "-bundle.crt"

    let container = self.generator.x509.baseContainer(certFile, keyFile, bundleFile)

    let args = createArgs(self.generator.commonName, certFile, keyFile, self.key)
      + ["--profile", "self-signed", "--subtle", "--force"]
    args = addCommonCreateArgs(args, self.keyType, self.curve, self.size, self.generator.notBefore, self.generator.notAfter, self.generator.sans, self.generator.template)
    args = addKeyArgs(args, self.key, self.password)

    container = prepareCreate(container, self.password, null, self.generator.template, self.key)
      .withExec(args)
      .withExec(["cp", certFile, bundleFile])

    let directory = container.directory("/work")

    Certificate(
      commonName: self.generator.commonName,
      certificate: directory.file(certFile),
      key: self.key ?? directory.file(keyFile),
      bundle: directory.file(bundleFile),
      password: self.password,
      directory: directory,
    )
  }

  """
  Create a certificate signing request and private key.
  """
  pub csr(name: String! = "certificate"): CertificateRequest! {
    let csrFile = name + ".csr"
    let keyFile = name + ".key"
    let bundleFile = name + "-bundle.crt"

    let container = self.generator.x509.baseContainer(csrFile, keyFile, bundleFile)

    let args = createArgs(self.generator.commonName, csrFile, keyFile, self.key) + ["--csr", "--force"]
    args = addCommonCreateArgs(args, self.keyType, self.curve, self.size, null, null, self.generator.sans, self.generator.template)
    args = addKeyArgs(args, self.key, self.password)

    container = prepareCreate(container, self.password, null, self.generator.template, self.key)
      .withExec(args)

    let directory = container.directory("/work")

    CertificateRequest(
      commonName: self.generator.commonName,
      csr: directory.file(csrFile),
      key: self.key ?? directory.file(keyFile),
      password: self.password,
      directory: directory,
    )
  }
}

type Issuer {
  pub authority: CertificateAuthority!

  pub commonName: String! { self.authority.commonName }
  pub certificate: File! { self.authority.certificate }
  pub key: File! { self.authority.key }
  pub bundle: File! { self.authority.bundle }
  pub password: Secret! { self.authority.password }
  pub passwordProtected: Boolean! { self.authority.passwordProtected }
}

type CertificateAuthority {
  pub commonName: String!
  pub certificate: File!
  pub key: File!
  pub bundle: File!
  pub password: Secret!
  pub passwordProtected: Boolean! = false
}

type RootCA {
  let x509: X509!

  pub commonName: String!
  pub certificate: File!
  pub key: File!
  pub bundle: File!
  pub password: Secret
  pub directory: Directory!

  pub authority: CertificateAuthority! {
    CertificateAuthority(
      commonName: self.commonName,
      certificate: self.certificate,
      key: self.key,
      bundle: self.bundle,
      password: self.password ?? emptyPassword(),
      passwordProtected: self.password != null,
    )
  }

  pub issuer: Issuer! {
    Issuer(authority: self.authority)
  }
}

type IntermediateCA {
  let x509: X509!

  pub commonName: String!
  pub certificate: File!
  pub key: File!
  pub bundle: File
  pub password: Secret
  pub directory: Directory!

  pub authority: CertificateAuthority! {
    CertificateAuthority(
      commonName: self.commonName,
      certificate: self.certificate,
      key: self.key,
      bundle: self.bundle ?? self.certificate,
      password: self.password ?? emptyPassword(),
      passwordProtected: self.password != null,
    )
  }

  pub issuer: Issuer! {
    Issuer(authority: self.authority)
  }
}

type ImportedCA {
  let x509: X509!

  pub commonName: String!
  pub certificate: File!
  pub key: File!
  pub bundle: File!
  pub password: Secret

  pub authority: CertificateAuthority! {
    CertificateAuthority(
      commonName: self.commonName,
      certificate: self.certificate,
      key: self.key,
      bundle: self.bundle,
      password: self.password ?? emptyPassword(),
      passwordProtected: self.password != null,
    )
  }

  pub issuer: Issuer! {
    Issuer(authority: self.authority)
  }
}

type Certificate {
  pub commonName: String!
  pub certificate: File!
  pub key: File!
  pub bundle: File
  pub password: Secret
  pub directory: Directory!
}

type CertificateRequest {
  pub commonName: String!
  pub csr: File!
  pub key: File!
  pub password: Secret
  pub directory: Directory!
}

enum KeyType {
  EC
  OKP
  RSA
}

enum EcCurve {
  P256
  P384
  P521
}

let keyPasswordFile = "/run/secrets/x509-password"
let caPasswordFile = "/run/secrets/x509-ca-password"
let existingKeyFile = "/inputs/key.pem"
let caCertFile = "/inputs/ca.crt"
let caKeyFile = "/inputs/ca.key"
let issuerBundleFile = "/inputs/issuer-bundle.crt"
let templateFile = "/inputs/template.json"

let emptyPassword(): Secret! {
  Dagger.setSecret("x509-empty-password", "")
}

let authorityPassword(authority: CertificateAuthority!): Secret {
  if (authority.passwordProtected) { authority.password } else { null }
}

let stepRelease(version: String): GithubRelease! {
  Dagger.github.release(version, "smallstep/cli")
}

let download(version: String, platform: Platform!): File! {
  let release = stepRelease(version)
  let stepVersion = release.tagName.trimPrefix("v")
  let fileName = "step_linux_" + stepVersion + "_" + arch(platform) + ".tar.gz"
  let asset = release.asset(fileName)

  if (asset == null) {
    raise "failed to download step binary"
  }

  let binary = asset.extracted(true).file("bin/step")

  if (binary == null) {
    raise "failed to extract step binary"
  }

  binary
}

let prepareCreate(container: Container!, password: Secret, caPassword: Secret, template: File, key: File): Container! {
  if (password != null) {
    container = container.withMountedSecret(keyPasswordFile, password)
  }

  if (caPassword != null) {
    container = container.withMountedSecret(caPasswordFile, caPassword)
  }

  if (template != null) {
    container = container.withMountedFile(templateFile, template)
  }

  if (key != null) {
    container = container.withMountedFile(existingKeyFile, key)
  }

  container
}

let createArgs(commonName: String!, certFile: String!, keyFile: String!, key: File): [String!]! {
  if (key != null) {
    ["step", "certificate", "create", commonName, certFile]
  } else {
    ["step", "certificate", "create", commonName, certFile, keyFile]
  }
}

let addCommonCreateArgs(
  args: [String!]!,
  keyType: KeyType,
  curve: String,
  size: Int,
  notBefore: String,
  notAfter: String,
  sans: [String!]!,
  template: File,
): [String!]! {
  if (keyType != null) {
    args += ["--kty", keyTypeValue(keyType)]
  }

  if (curve != null) {
    args += ["--curve", curve]
  }

  if (size != null) {
    args += ["--size", toString(size)]
  }

  if (notBefore != null) {
    args += ["--not-before", notBefore]
  }

  if (notAfter != null) {
    args += ["--not-after", notAfter]
  }

  if (template != null) {
    args += ["--template", templateFile]
  }

  sans.reduce(args) { args, san =>
    args + ["--san", san]
  }
}

let addKeyArgs(args: [String!]!, key: File, password: Secret): [String!]! {
  if (key != null) {
    args += ["--key", existingKeyFile]

    if (password != null) {
      args += ["--password-file", keyPasswordFile]
    }

    args
  } else if (password != null) {
    args + ["--password-file", keyPasswordFile]
  } else {
    args + ["--no-password", "--insecure"]
  }
}

let addCaPasswordArgs(args: [String!]!, password: Secret): [String!]! {
  if (password != null) {
    args + ["--ca-password-file", caPasswordFile]
  } else {
    args
  }
}

let keyTypeValue(keyType: KeyType!): String! {
  toString(keyType).trim("\"")
}

let ecCurveValue(curve: EcCurve!): String! {
  case (curve) {
    EcCurve.P256 => "P-256"
    EcCurve.P384 => "P-384"
    EcCurve.P521 => "P-521"
  }
}

let arch(platform: Platform!): String! {
  case (platform) {
    "linux/amd64" => "amd64"
    "linux/arm64" => "arm64"
    else => raise "unsupported platform: " + toString(platform).trim("\"")
  }
}
