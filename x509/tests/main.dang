type Tests {
  """
  Step CLI is installed and can be executed.
  """
  pub step: Container! @check {
    x509.container.withExec(["step", "version"])
  }

  """
  Root CA generation returns certificate and key files.
  """
  pub rootCa: File! @check {
    x509.generate.rsa(2048).rootCa("test-root-ca").certificate
  }

  """
  Intermediate and leaf certificate bundles are generated and can be verified.
  """
  pub leafBundle: String! @check {
    let root = x509.generate.rsa(2048).rootCa("test-root-ca")
    let intermediate = x509.generate.rsa(2048).intermediateCa(
      root.issuer,
      "test-intermediate-ca",
    )
    let leaf = x509.generate.rsa(2048).certificate(
      intermediate.issuer,
      "test.local",
      sans: ["test.local"],
    )

    x509
      .container
      .withWorkdir("/work")
      .withMountedFile("root.crt", root.certificate)
      .withMountedFile("leaf.crt", leaf.bundle)
      .withExec(["step", "certificate", "verify", "--roots", "root.crt", "leaf.crt"])
      .stdout
  }

  """
  Passwords are mounted as secret files for generated keys and CA signing keys.
  """
  pub passwordProtectedCa: File! @check {
    let password = Dagger.setSecret("x509-test-password", "correct horse battery staple")
    let root = x509.generate.rsa(2048, password: password).rootCa("password-root-ca")

    x509.generate.rsa(2048).intermediateCa(root.issuer, "password-intermediate-ca").certificate
  }

  """
  Imported CAs keep their password so they can be used for signing.
  """
  pub importedCaPassword: File! @check {
    let password = Dagger.setSecret("x509-import-test-password", "correct horse battery staple")
    let root = x509.generate.rsa(2048, password: password).rootCa("import-root-ca")
    let imported = x509.importCa(
      root.certificate,
      root.key,
      password: root.password,
      bundle: root.bundle,
    )

    x509.generate.rsa(2048).intermediateCa(imported.issuer, "imported-intermediate-ca").certificate
  }

  """
  Existing private keys can be used instead of generating a new key.
  """
  pub existingKeyCsr: File! @check {
    let first = x509.generate.rsa(2048).csr("existing-key.local")

    x509.generate.key(first.key).csr("existing-key.local", name: "existing-key").csr
  }

  """
  CSR generation returns a CSR file.
  """
  pub csr: File! @check {
    x509.generate.ec(X509EcCurve.P_256).csr("test.local", sans: ["test.local"]).csr
  }
}
