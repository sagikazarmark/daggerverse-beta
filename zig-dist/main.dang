let ZIG_MINISIGN_PUBLIC_KEY = "RWSGOq2NVecA2UPNdBUZykf1CCb147pkmdtYxgb3Ti+JO/wCYvhbAb/U"

let MINISIGN_VERSION = "0.12"

type ZigDist {
  """
  Zig version from https://ziglang.org/download/index.json, for example "0.16.0" or "master".
  """
  pub version: String!

  new(
    """
    Zig version from https://ziglang.org/download/index.json, for example "0.16.0" or "master".
    """
    version: String!,
  ) {
    self.version = version

    self
  }

  """
  Downloads and verifies a Zig release for the requested platform.
  """
  pub download(
    """
    Dagger platform to download Zig for.
    """
    platform: Platform! = Dagger.defaultPlatform,
  ): Directory! {
    let index = Dagger.http("https://ziglang.org/download/index.json").asJSON
    let platform = toZigPlatform(platform)

    let url = index.field([version, platform, "tarball"]).asString
    let checksum = index.field([version, platform, "shasum"]).asString

    let archive = Dagger.http(url, checksum: "sha256:" + checksum)

    archive = minisign(MINISIGN_VERSION).verify(
      archive,
      Dagger.http(url + ".minisig"),
      key: ZIG_MINISIGN_PUBLIC_KEY,
    )

    let fileName = archive.name

    Dagger
      .container
      .from("alpine:3.23.4")
      .withExec(["apk", "add", "libarchive-tools"])
      .withWorkdir("/work")
      .withExec(["mkdir", "-p", "/opt/zig"])
      .withMountedFile(fileName, archive)
      .withExec(["bsdtar", "-xf", fileName, "-C", "/opt/zig", "--strip-components", "1"])
      .directory("/opt/zig")
  }

  """
  Installs a Zig release into the provided container.
  """
  pub install(
    """
    Container to install Zig into.
    """
    container: Container! = Dagger.container.from("alpine:latest"),
  ): Container! {
    container
      .withExec(["mkdir", "-p", "/usr/local/bin"])
      .withExec(["rm", "-rf", "/opt/zig", "/usr/local/bin/zig"])
      .withDirectory("/opt/zig", self.download(container.platform))
      .withSymlink("/opt/zig/zig", "/usr/local/bin/zig")
      .withEnvVariable("ZIG_ROOT", "/opt/zig")
  }

  let toZigPlatform(platform: Platform!): String! {
    case (platform) {
      "linux/amd64" => "x86_64-linux"
      "linux/arm64" => "aarch64-linux"
      "darwin/amd64" => "x86_64-macos"
      "darwin/arm64" => "aarch64-macos"
      else => raise "unsupported platform: " + toString(platform).trim("\"")
    }
  }
}
