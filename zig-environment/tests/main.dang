let VERSION = "0.16.0"

type Tests {
  """
  Download tests.
  """
  download: DownloadTests! { DownloadTests }

  """
  Install tests.
  """
  install: InstallTests! { InstallTests }
}

type DownloadTests {
  """
  Verifies that the default-platform Zig archive can be downloaded and extracted.
  """
  defaultPlatform: Void @check {
    let directory = zigEnvironment(VERSION).download

    assert { directory.exists("/zig") }
  }
}

type InstallTests {
  """
  Verifies that Zig can be installed into a container and executed through the symlink.
  """
  default: Container! @check {
    zigEnvironment(VERSION)
      .container
      .withExec(["zig", "version"])
  }

  """
  Verifies that Zig can be installed into a container and executed through the symlink.
  """
  container: Container! @check {
    zigEnvironment(VERSION)
      .install(Dagger.container.from("debian:trixie-slim"))
      .withExec(["zig", "version"])
  }

  """
  Verifies that Zig can be installed through the shared overlay API.
  """
  overlay: Container! @check {
    overlays
      .combine([zigEnvironment(VERSION).overlay])
      .apply(Dagger.container.from("debian:trixie-slim"))
      .withExec(["zig", "version"])
  }
}
